+public static String decrypt(String encryptPassword, String salt) throws Exception {
+    if (encryptPassword == null) {
+        throw new IllegalArgumentException("encryptPassword must not be null");
     }
+    if (salt == null) {
+        throw new IllegalArgumentException("salt must not be null");
+    }
+
+    // Reject non-canonical Base64 inputs before they reach the vulnerable decoder path.
+    // This prevents malformed trailing bits such as "AB==" from being accepted.
+    if (!isCanonicalBase64(encryptPassword)) {
+        throw new IllegalArgumentException("Invalid Base64 ciphertext");
+    }
+
+    return AesUtil.decrypt(salt, encryptPassword);
 }
+
+private static boolean isCanonicalBase64(String value) {
+    try {
+        byte[] decoded = java.util.Base64.getDecoder().decode(value);
+        String reencoded = java.util.Base64.getEncoder().encodeToString(decoded);
+        return reencoded.equals(value);
+    } catch (IllegalArgumentException ex) {
+        return false;
+    }
+}}
