+    /**
+     * Normalize a resource name after removing redundant separators.
+     *
+     * Commons IO 2.6 does not collapse repeated separators that occur after
+     * a path prefix (for example, //foo//./bar).  Besides producing an
+     * unexpected resource name, leaving those separators in place makes the
+     * result dependent on the platform's File handling.  Do this small piece
+     * of normalization before delegating to Commons IO, whose handling of
+     * dot segments and parent traversal is still required here.
+     */
+    private String normalizeTemplateName(String name)
+    {
+        StringBuilder compact = new StringBuilder(name.length());
+        boolean separator = false;
+        for (int i = 0; i < name.length(); i++)
+        {
+            char c = name.charAt(i);
+            if (c == '/' || c == '\\')
+            {
+                if (!separator)
+                {
+                    compact.append('/');
+                    separator = true;
+                }
+            }
+            else
+            {
+                compact.append(c);
+                separator = false;
+            }
+        }
+        return FilenameUtils.normalize(compact.toString(), true);
+    }
