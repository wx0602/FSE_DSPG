+    private static void validateBase64(String value) {
+        if (value == null || value.length() == 0) {
+            return;
+        }
+        if ((value.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        int padding = value.endsWith("==") ? 2 : (value.endsWith("=") ? 1 : 0);
+        int dataLength = value.length() - padding;
+        for (int i = 0; i < dataLength; i++) {
+            char c = value.charAt(i);
+            if (!isBase64Character(c)) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+        for (int i = dataLength; i < value.length(); i++) {
+            if (value.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+        if (dataLength == 0 || padding == 2 && (value.charAt(dataLength - 1) & 0x0f) != 0
+                || padding == 1 && (value.charAt(dataLength - 1) & 0x03) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 trailing bits");
+        }
+    }
+
+    private static boolean isBase64Character(char c) {
+        return c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z'
+                || c >= '0' && c <= '9' || c == '+' || c == '/';
+    }
