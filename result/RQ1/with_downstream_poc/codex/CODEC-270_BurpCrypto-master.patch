+    /**
+     * Commons Codec 1.13 accepts non-zero bits in the final Base64 symbol.
+     * Validate those bits here rather than changing the pinned dependency.
+     * Whitespace remains accepted, as it is by the Commons Codec decoder.
+     */
+    private static void validateBase64(String value) {
+        if (value == null) {
+            return;
+        }
+
+        String encoded = value.replaceAll("\\s", "");
+        int length = encoded.length();
+        if (length == 0) {
+            return;
+        }
+        if (length % 4 == 1) {
+            throw new IllegalArgumentException("Invalid Base64 length");
+        }
+
+        int padding = 0;
+        while (padding < length && encoded.charAt(length - 1 - padding) == '=') {
+            padding++;
+        }
+        if (padding > 2 || (padding > 0 && length % 4 != 0)) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+
+        int dataEnd = length - padding;
+        for (int i = 0; i < dataEnd; i++) {
+            if (base64Value(encoded.charAt(i)) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+        }
+        for (int i = dataEnd; i < length; i++) {
+            if (encoded.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+
+        int remainder = dataEnd % 4;
+        if (dataEnd > 0 && remainder != 0) {
+            int trailing = base64Value(encoded.charAt(dataEnd - 1));
+            int bits = remainder == 2 ? 4 : 2;
+            if ((trailing & ((1 << bits) - 1)) != 0) {
+                throw new IllegalArgumentException("Non-zero trailing Base64 bits");
+            }
+        } else if (padding > 0) {
+            int trailing = base64Value(encoded.charAt(dataEnd - 1));
+            int bits = padding == 2 ? 4 : 2;
+            if ((trailing & ((1 << bits) - 1)) != 0) {
+                throw new IllegalArgumentException("Non-zero trailing Base64 bits");
+            }
+        }
+    }
