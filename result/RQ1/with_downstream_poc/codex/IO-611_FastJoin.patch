diff --git a/src/main/java/soj/util/SafeFilenameUtils.java b/src/main/java/soj/util/SafeFilenameUtils.java
new file mode 100644
index 0000000000000000000000000000000000000000..df1fafbc0cd64c02a3d1fc2bfbf2e4ca34fa2473
--- /dev/null
+++ b/src/main/java/soj/util/SafeFilenameUtils.java
@@ -0,0 +1,59 @@
+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Compatibility wrapper for the old Commons IO normalizer.
+ *
+ * Commons IO 2.5 can leave repeated separators following an absolute/UNC
+ * prefix.  Canonicalize those separators before asking it to resolve dot
+ * segments, while retaining the prefix itself.
+ */
+final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    static String normalize(String filename) {
+        if (filename == null) {
+            return null;
+        }
+
+        StringBuilder collapsed = new StringBuilder(filename.length());
+        int i = 0;
+        int prefixSeparators = 0;
+        if (filename.length() > 0 && isSeparator(filename.charAt(0))) {
+            prefixSeparators = 1;
+            if (filename.length() > 1 && isSeparator(filename.charAt(1))) {
+                prefixSeparators = 2; // preserve a UNC-style prefix
+            }
+            collapsed.append('/');
+            if (prefixSeparators == 2) {
+                collapsed.append('/');
+            }
+            i = prefixSeparators;
+        } else if (filename.length() > 2 && filename.charAt(1) == ':'
+                && isSeparator(filename.charAt(2))) {
+            collapsed.append(filename, 0, 3);
+            i = 3;
+        }
+
+        boolean previousSeparator = false;
+        for (; i < filename.length(); i++) {
+            char c = filename.charAt(i);
+            if (isSeparator(c)) {
+                if (!previousSeparator) {
+                    collapsed.append('/');
+                }
+                previousSeparator = true;
+            } else {
+                collapsed.append(c);
+                previousSeparator = false;
+            }
+        }
+        return FilenameUtils.normalize(collapsed.toString());
+    }
+
+    private static boolean isSeparator(char c) {
+        return c == '/' || c == '\\';
+    }
+}
