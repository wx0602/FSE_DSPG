 	/**
@@ -116,7 +116,23 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
-		return NumberUtils.createNumber(str);
+		return NumberUtils.createNumber(normalizeSignedHex(str));
+	}
+
+	/**
+	 * Commons Lang versions used by this project do not consistently accept a
+	 * leading plus on hexadecimal integers.  Java's numeric syntax does accept
+	 * it, and NumberUtils.isCreatable/createInteger/createLong already do, so
+	 * remove the sign only for the affected hexadecimal form before calling the
+	 * library.  All other input is passed through unchanged.
+	 */
+	private static String normalizeSignedHex(String str) {
+		if (str != null && str.length() > 3 && str.charAt(0) == '+'
+				&& str.charAt(1) == '0'
+				&& (str.charAt(2) == 'x' || str.charAt(2) == 'X')) {
+			return str.substring(1);
+		}
+		return str;
 	}
 	
 	
