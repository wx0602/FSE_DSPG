+        private static Number createNumberSafely(String value) {
+                String normalizedValue = StringUtils.trimToNull(value);
+                if (normalizedValue == null) {
+                        throw new NumberFormatException("A blank string is not a valid number");
+                }
+
+                char lastChar = normalizedValue.charAt(normalizedValue.length() - 1);
+                if (isNumericTypeQualifier(lastChar) && normalizedValue.length() == 1) {
+                        throw new NumberFormatException(normalizedValue + " is not a valid number");
+                }
+
+                try {
+                        return NumberUtils.createNumber(normalizedValue);
+                } catch (StringIndexOutOfBoundsException ex) {
+                        NumberFormatException numberFormatException = new NumberFormatException(
+                                        normalizedValue + " is not a valid number");
+                        numberFormatException.initCause(ex);
+                        throw numberFormatException;
+                }
+        }
+
+        private static boolean isNumericTypeQualifier(char ch) {
+                return ch == 'l' || ch == 'L' || ch == 'f' || ch == 'F' || ch == 'd' || ch == 'D';
+        }
