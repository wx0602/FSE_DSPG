@@ -0,0 +1,80 @@
+package soj.util;
+
+import static org.apache.commons.io.FilenameUtils.normalize;
+
+final class PathUtils {
+    private PathUtils() {
+    }
+
+    static String normalizePath(String filename) {
+        if (filename == null) {
+            return null;
+        }
+
+        return normalize(collapseDuplicateSeparatorsAfterPrefix(filename));
+    }
+
+    private static String collapseDuplicateSeparatorsAfterPrefix(String filename) {
+        if (filename.isEmpty()) {
+            return filename;
+        }
+
+        StringBuilder normalized = new StringBuilder(filename.length());
+        int prefixLength = getPrefixLength(filename);
+        int index = 0;
+
+        if (prefixLength > 0) {
+            normalized.append(filename, 0, prefixLength);
+            index = prefixLength;
+        }
+
+        boolean previousWasSeparator = false;
+        while (index < filename.length()) {
+            char ch = filename.charAt(index++);
+            if (isSeparator(ch)) {
+                if (!previousWasSeparator) {
+                    normalized.append('/');
+                    previousWasSeparator = true;
+                }
+            }
+            else {
+                normalized.append(ch);
+                previousWasSeparator = false;
+            }
+        }
+
+        return normalized.toString();
+    }
+
+    private static int getPrefixLength(String filename) {
+        int length = filename.length();
+        if (length == 0) {
+            return 0;
+        }
+
+        char first = filename.charAt(0);
+        if (isSeparator(first)) {
+            if (length > 1 && isSeparator(filename.charAt(1))) {
+                int index = 2;
+                while (index < length && !isSeparator(filename.charAt(index))) {
+                    index++;
+                }
+                return index;
+            }
+            return 1;
+        }
+
+        if (length > 1 && filename.charAt(1) == ':') {
+            if (length > 2 && isSeparator(filename.charAt(2))) {
+                return 3;
+            }
+            return 2;
+        }
+
+        return 0;
+    }
+
+    private static boolean isSeparator(char ch) {
+        return ch == '/' || ch == '\\';
+    }
+}
