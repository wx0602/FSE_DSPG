+    /**
+     * Mitigates commons-io 2.6 normalize() leaving repeated separators after a prefix.
+     */
+    protected static String normalizeTemplatePath(final String path, final boolean unixSeparator)
+    {
+        if (path == null)
+        {
+            return null;
+        }
+
+        String normalized = FilenameUtils.normalize(path, unixSeparator);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        String normalizedSeparators = normalized.replace('\\', '/');
+        String collapsed = normalizedSeparators.replaceAll("(?<=.)/{2,}", "/");
+        return unixSeparator ? collapsed : collapsed.replace('/', File.separatorChar);
+    }
