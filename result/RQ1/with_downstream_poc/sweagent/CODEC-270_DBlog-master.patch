+    private static void validateBase64(String encrypted) {
+        if (encrypted == null || encrypted.isEmpty()) {
+            return;
+        }
+        if ((encrypted.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+
+        int padding = 0;
+        int firstPaddingIndex = encrypted.length();
+        for (int i = 0; i < encrypted.length(); i++) {
+            char ch = encrypted.charAt(i);
+            if (ch == '=') {
+                if (padding == 0) {
+                    firstPaddingIndex = i;
+                }
+                padding++;
+                continue;
+            }
+            if (padding > 0 || BASE64_ALPHABET.indexOf(ch) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+
+        if (padding > 2) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        if (padding == 0) {
+            return;
+        }
+
+        int value = BASE64_ALPHABET.indexOf(encrypted.charAt(firstPaddingIndex - 1));
+        if (value < 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+
+        int droppedBits = padding == 2 ? 4 : 2;
+        int mask = (1 << droppedBits) - 1;
+        if ((value & mask) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+    }
