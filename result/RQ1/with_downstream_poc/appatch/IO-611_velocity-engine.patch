+    private String normalizeTemplateName(final String templateName)
+    {
+        String template = FilenameUtils.normalize(templateName, true);
+        if (template == null)
+        {
+            return null;
+        }
+
+        if (template.startsWith("//"))
+        {
+            int prefixEnd = template.indexOf('/', 2);
+            if (prefixEnd > 0)
+            {
+                String prefix = template.substring(0, prefixEnd);
+                String remainder = template.substring(prefixEnd).replaceFirst("/+", "/");
+                return prefix + remainder;
+            }
+        }
+        return template.replaceFirst("(?<!^)/{2,}", "/");
+    }
