+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+public final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    public static String normalize(String filename) {
+        return normalizeInternal(filename, false);
+    }
+
+    public static String normalizeNoEndSeparator(String filename) {
+        return normalizeInternal(filename, true);
+    }
+
+    private static String normalizeInternal(String filename, boolean stripTrailingSeparator) {
+        if (filename == null) {
+            return null;
+        }
+
+        String normalized = FilenameUtils.normalize(filename);
+        if (normalized == null) {
+            return null;
+        }
+
+        String prefix = extractPrefix(normalized);
+        String remainder = normalized.substring(prefix.length());
+        String collapsed = collapseRepeatedSeparators(remainder);
+
+        if (stripTrailingSeparator) {
+            collapsed = stripTrailingSeparator(collapsed);
+        }
+
+        return prefix + collapsed;
+    }
+
+    private static String extractPrefix(String path) {
+        int prefixLength = FilenameUtils.getPrefixLength(path);
+        if (prefixLength <= 0 || prefixLength > path.length()) {
+            return "";
+        }
+        return path.substring(0, prefixLength);
+    }
+
+    private static String collapseRepeatedSeparators(String path) {
+        StringBuilder result = new StringBuilder(path.length());
+        boolean previousSeparator = false;
+
+        for (int i = 0; i < path.length(); i++) {
+            char current = path.charAt(i);
+            boolean separator = current == '/' || current == '\\';
+            if (separator) {
+                if (!previousSeparator) {
+                    result.append('/');
+                    previousSeparator = true;
+                }
+            }
+            else {
+                result.append(current);
+                previousSeparator = false;
+            }
+        }
+
+        return result.toString();
+    }
+
+    private static String stripTrailingSeparator(String path) {
+        int end = path.length();
+        while (end > 1 && path.charAt(end - 1) == '/') {
+            end--;
+        }
+        return path.substring(0, end);
+    }
+}
