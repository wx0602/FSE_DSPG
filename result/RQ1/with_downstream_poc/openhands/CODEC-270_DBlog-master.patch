+    private static byte[] decodeBase64Strict(String encrypted) {
+        Objects.requireNonNull(encrypted, "encrypted");
+        if (encrypted.isEmpty()) {
+            return new byte[0];
+        }
+        if ((encrypted.length() & 3) != 0 || !BASE64_PATTERN.matcher(encrypted).matches()) {
+            throw new IllegalArgumentException("Invalid Base64 ciphertext");
+        }
+
+        int firstPadding = encrypted.indexOf('=');
+        if (firstPadding >= 0 && firstPadding < encrypted.length() - countPadding(encrypted)) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+
+        byte[] decoded = java.util.Base64.getDecoder().decode(encrypted);
+        String canonical = java.util.Base64.getEncoder().encodeToString(decoded);
+        if (!Arrays.equals(canonical.getBytes(StandardCharsets.US_ASCII), encrypted.getBytes(StandardCharsets.US_ASCII))) {
+            throw new IllegalArgumentException("Invalid Base64 trailing bits");
+        }
+        return decoded;
+    }
+
+    private static int countPadding(String encrypted) {
+        int padding = 0;
+        for (int i = encrypted.length() - 1; i >= 0 && encrypted.charAt(i) == '='; i--) {
+            padding++;
+        }
+        return padding;
+    }
