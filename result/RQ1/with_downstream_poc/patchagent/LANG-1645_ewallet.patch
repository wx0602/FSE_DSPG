 	 * @return BigInteger 转换后的BigInteger值。
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
+	private static String normalizeSignedHexPrefix(String str) {
+		if (str != null && str.length() > 2 && str.charAt(0) == '+') {
+			char prefix = str.charAt(1);
+			if (prefix == '#') {
+				return str.substring(1);
+			}
+			if (prefix == '0' && str.length() > 3) {
+				char radix = str.charAt(2);
+				if (radix == 'x' || radix == 'X') {
+					return str.substring(1);
+				}
+			}
+		}
+		return str;
+	}
+
 	public static BigInteger createBigInteger(String str)  {
-		return NumberUtils.createBigInteger(str);
+		return NumberUtils.createBigInteger(normalizeSignedHexPrefix(str));
 	}
 	
