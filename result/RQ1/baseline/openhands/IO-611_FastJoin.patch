index 0000000..ac5a9a3
--- /dev/null
+++ b/src/main/java/soj/util/SafePathUtils.java
@@ -0,0 +1,183 @@
+package soj.util;
+
+import java.io.File;
+import java.nio.file.InvalidPathException;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+public final class SafePathUtils
+{
+    private SafePathUtils() {
+    }
+
+    public static String normalize(String path) {
+        return normalize(path, true);
+    }
+
+    public static String normalizeNoEndSeparator(String path) {
+        return normalize(path, false);
+    }
+
+    private static String normalize(String path, boolean keepEndSeparator) {
+        if (path == null) {
+            return null;
+        }
+
+        String trimmed = path.trim();
+        if (trimmed.isEmpty()) {
+            return trimmed;
+        }
+
+        String separator = detectSeparator(trimmed);
+        String collapsed = collapseSeparators(trimmed, separator);
+        String normalized = lexicalNormalize(collapsed, separator);
+
+        if (keepEndSeparator && hasTrailingSeparator(collapsed)
+                && !hasTrailingSeparator(normalized)) {
+            normalized += separator;
+        }
+
+        if (!keepEndSeparator && normalized.length() > 1
+                && normalized.endsWith(separator)) {
+            normalized = normalized.substring(0, normalized.length() - 1);
+        }
+
+        return normalized;
+    }
+
+    public static String getFullPath(String path) {
+        String normalized = normalize(path);
+        if (normalized == null || normalized.isEmpty()) {
+            return normalized;
+        }
+
+        File file = new File(normalized);
+        String parent = file.getParent();
+        if (parent == null) {
+            return "";
+        }
+
+        String separator = detectSeparator(normalized);
+        return hasTrailingSeparator(parent) ? parent : parent + separator;
+    }
+
+    private static String lexicalNormalize(String path, String separator) {
+        if (path.startsWith("//") || path.startsWith("\\\\")) {
+            return "//" + removeDotSegments(path.substring(2), "/");
+        }
+
+        String candidate = toSystemSeparators(path);
+        try {
+            Path normalizedPath = Paths.get(candidate).normalize();
+            return fromSystemSeparators(normalizedPath.toString(), separator);
+        }
+        catch (InvalidPathException e) {
+            return removeDotSegments(path, separator);
+        }
+    }
+
+    private static String collapseSeparators(String path, String separator) {
+        int prefixLength = prefixLength(path);
+        String prefix = path.substring(0, prefixLength);
+        String remainder = path.substring(prefixLength)
+                .replace('\\', '/')
+                .replaceAll("/++", "/");
+        return prefix + remainder;
+    }
+
+    private static int prefixLength(String path) {
+        if (path.startsWith("//") || path.startsWith("\\\\")) {
+            return 2;
+        }
+
+        int schemeIdx = path.indexOf("://");
+        if (schemeIdx >= 0) {
+            return schemeIdx + 3;
+        }
+
+        if (path.length() >= 3
+                && Character.isLetter(path.charAt(0))
+                && path.charAt(1) == ':'
+                && isSeparator(path.charAt(2))) {
+            return 3;
+        }
+
+        if (path.length() >= 2
+                && Character.isLetter(path.charAt(0))
+                && path.charAt(1) == ':') {
+            return 2;
+        }
+
+        if (!path.isEmpty() && isSeparator(path.charAt(0))) {
+            return 1;
+        }
+
+        return 0;
+    }
+
+    private static String removeDotSegments(String path, String separator) {
+        String systemPath = toSystemSeparators(path);
+        String[] parts = systemPath.split(java.util.regex.Pattern.quote(File.separator));
+        java.util.Deque<String> stack = new java.util.ArrayDeque<>();
+        boolean absolute = new File(systemPath).isAbsolute();
+
+        for (String part : parts) {
+            if (part.isEmpty() || ".".equals(part)) {
+                continue;
+            }
+            if ("..".equals(part)) {
+                if (!stack.isEmpty() && !"..".equals(stack.peekLast())) {
+                    stack.removeLast();
+                }
+                else if (!absolute) {
+                    stack.addLast(part);
+                }
+            }
+            else {
+                stack.addLast(part);
+            }
+        }
+
+        StringBuilder result = new StringBuilder();
+        if (absolute) {
+            result.append(separator);
+        }
+
+        boolean first = true;
+        for (String part : stack) {
+            if (!first) {
+                result.append(separator);
+            }
+            result.append(part);
+            first = false;
+        }
+
+        return result.length() == 0 ? (absolute ? separator : "") : result.toString();
+    }
+
+    private static String detectSeparator(String path) {
+        return path.indexOf('\\') >= 0 ? "\\" : "/";
+    }
+
+    private static boolean hasTrailingSeparator(String path) {
+        return !path.isEmpty() && isSeparator(path.charAt(path.length() - 1));
+    }
+
+    private static boolean isSeparator(char c) {
+        return c == '/' || c == '\\';
+    }
+
+    private static String toSystemSeparators(String path) {
+        if (File.separatorChar == '/') {
+            return path.replace('\\', '/');
+        }
+        return path.replace('/', '\\');
+    }
+
+    private static String fromSystemSeparators(String path, String separator) {
+        if ("/".equals(separator)) {
+            return path.replace('\\', '/');
+        }
+        return path.replace('/', '\\');
+    }
+}
