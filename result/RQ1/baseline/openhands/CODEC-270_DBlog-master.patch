+    private static void validateBase64(String encrypted) {
+        if (encrypted == null || encrypted.isEmpty()) {
+            return;
+        }
+        if ((encrypted.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+
+        int padding = 0;
+        int length = encrypted.length();
+        if (encrypted.charAt(length - 1) == '=') {
+            padding++;
+        }
+        if (length > 1 && encrypted.charAt(length - 2) == '=') {
+            padding++;
+        }
+
+        for (int i = 0; i < length - padding; i++) {
+            if (decodeBase64Char(encrypted.charAt(i)) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+        for (int i = length - padding; i < length; i++) {
+            if (encrypted.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+        if (padding > 2) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        if (padding == 0) {
+            return;
+        }
+
+        int lastDataIndex = length - padding - 1;
+        int lastValue = decodeBase64Char(encrypted.charAt(lastDataIndex));
+        if (padding == 2) {
+            if ((lastValue & 0x0F) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+            return;
+        }
+        if ((lastValue & 0x03) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+    }
+
+    private static int decodeBase64Char(char c) {
+        if (c >= 'A' && c <= 'Z') {
+            return c - 'A';
+        }
+        if (c >= 'a' && c <= 'z') {
+            return c - 'a' + 26;
+        }
+        if (c >= '0' && c <= '9') {
+            return c - '0' + 52;
+        }
+        if (c == '+') {
+            return 62;
+        }
+        if (c == '/') {
+            return 63;
+        }
+        return -1;
+    }
