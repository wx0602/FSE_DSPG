+	static Number parseNumber(String value) {
+		if (value == null) {
+			throw new NumberFormatException("null");
+		}
+
+		String normalized = value.trim();
+		if (normalized.length() == 0) {
+			throw new NumberFormatException("A blank string is not a valid number");
+		}
+
+		char lastChar = normalized.charAt(normalized.length() - 1);
+		if (isTypeSuffix(lastChar)) {
+			if (normalized.length() == 1) {
+				throw new NumberFormatException(value + " is not a valid number");
+			}
+			normalized = normalized.substring(0, normalized.length() - 1).trim();
+			if (normalized.length() == 0) {
+				throw new NumberFormatException(value + " is not a valid number");
+			}
+		}
+
+		if (containsDecimalPart(normalized)) {
+			return new BigDecimal(normalized);
+		}
+
+		try {
+			return Integer.valueOf(normalized);
+		} catch (NumberFormatException ex) {
+			try {
+				return Long.valueOf(normalized);
+			} catch (NumberFormatException e) {
+				return new BigInteger(normalized);
+			}
+		}
+	}
+
+	private static boolean containsDecimalPart(String value) {
+		return value.indexOf('.') >= 0 || value.indexOf('e') >= 0 || value.indexOf('E') >= 0;
+	}
+
+	private static boolean isTypeSuffix(char value) {
+		return value == 'l' || value == 'L' || value == 'f' || value == 'F' || value == 'd' || value == 'D';
+	}
