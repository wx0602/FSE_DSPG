+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Normalizes resource paths while collapsing repeated separators after any
+ * recognized prefix, mitigating commons-io 2.6 normalize behavior.
+ */
+final class SecureResourcePathNormalizer
+{
+    private SecureResourcePathNormalizer()
+    {
+    }
+
+    static String normalize(final String path)
+    {
+        return normalize(path, false);
+    }
+
+    static String normalize(final String path, final boolean unixSeparator)
+    {
+        if (path == null)
+        {
+            return null;
+        }
+
+        final char separator = unixSeparator ? '/' : java.io.File.separatorChar;
+        final String normalizedSeparators = collapseDuplicateSeparators(path, separator);
+        final String normalizedPath = FilenameUtils.normalize(normalizedSeparators, unixSeparator);
+        if (normalizedPath == null)
+        {
+            return null;
+        }
+        return collapseDuplicateSeparators(normalizedPath, separator);
+    }
+
+    private static String collapseDuplicateSeparators(final String path, final char separator)
+    {
+        int prefixLength = FilenameUtils.getPrefixLength(path);
+        if (prefixLength < 0)
+        {
+            return path;
+        }
+
+        final StringBuilder normalized = new StringBuilder(path.length());
+        normalized.append(path, 0, prefixLength);
+
+        boolean lastWasSeparator = prefixLength > 0
+            && (path.charAt(prefixLength - 1) == '/' || path.charAt(prefixLength - 1) == '\\');
+        for (int i = prefixLength; i < path.length(); i++)
+        {
+            final char current = path.charAt(i);
+            if (current == '/' || current == '\\')
+            {
+                if (!lastWasSeparator)
+                {
+                    normalized.append(separator);
+                    lastWasSeparator = true;
+                }
+            }
+            else
+            {
+                normalized.append(current);
+                lastWasSeparator = false;
+            }
+        }
+        return normalized.toString();
+    }
+}
