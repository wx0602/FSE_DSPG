+package com.fr.chain.utils;
+
+import org.apache.commons.lang3.StringUtils;
+import org.apache.commons.lang3.math.NumberUtils;
+
+public final class NumberParser {
+
+	private NumberParser() {
+	}
+
+	public static Number createNumber(String value) {
+		if (value == null) {
+			return null;
+		}
+		String candidate = value.trim();
+		if (candidate.length() == 0) {
+			throw new NumberFormatException("A blank string is not a valid number");
+		}
+		if (isSuffixOnly(candidate)) {
+			throw new NumberFormatException(candidate + " is not a valid number");
+		}
+		return NumberUtils.createNumber(candidate);
+	}
+
+	private static boolean isSuffixOnly(String value) {
+		if (value.length() != 1) {
+			return false;
+		}
+		char ch = value.charAt(0);
+		return StringUtils.contains("lLfFdD", ch);
+	}
+}
