     /**
+     * Normalizes include paths without relying on the vulnerable multiple-slash
+     * behavior of commons-io 2.6.
+     *
+     * @param path raw include path
+     * @return normalized path or null if invalid
+     */
+    public static String normalizeIncludePath(String path)
+    {
+        if (path == null)
+        {
+            return null;
+        }
+
+        String normalized = FilenameUtils.normalize(path, true);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        int prefixLength = FilenameUtils.getPrefixLength(normalized);
+        if (prefixLength < 0)
+        {
+            return null;
+        }
+
+        if (prefixLength >= normalized.length())
+        {
+            return normalized;
+        }
+
+        String prefix = normalized.substring(0, prefixLength);
+        String remainder = normalized.substring(prefixLength);
+        StringBuilder sanitized = new StringBuilder(prefix.length() + remainder.length());
+        sanitized.append(prefix);
+
+        boolean previousSlash = false;
+        for (int i = 0; i < remainder.length(); i++)
+        {
+            char c = remainder.charAt(i);
+            if (c == '/')
+            {
+                if (!previousSlash)
+                {
+                    sanitized.append(c);
+                }
+                previousSlash = true;
+            }
+            else
+            {
+                sanitized.append(c);
+                previousSlash = false;
+            }
+        }
+        return sanitized.toString();
+    }
