+	private static Number createNumberCompat(String str) {
+		String normalized = normalizeLeadingPlusHex(str);
+		if (normalized != null && normalized != str) {
+			Number number = NumberUtils.createNumber(normalized);
+			if (isPositiveHex(normalized) && number instanceof BigInteger) {
+				return new BigInteger(str.substring(1 + hexPrefixLength(str)), 16);
+			}
+			return number;
+		}
+		return NumberUtils.createNumber(str);
+	}
+
+	private static BigInteger createBigIntegerCompat(String str) {
+		String normalized = normalizeLeadingPlusHex(str);
+		if (normalized == null || normalized == str) {
+			return NumberUtils.createBigInteger(str);
+		}
+		int prefixLength = hexPrefixLength(normalized);
+		if (prefixLength > 0) {
+			return new BigInteger(str.substring(1 + prefixLength), 16);
+		}
+		return NumberUtils.createBigInteger(normalized);
+	}
+
+	private static String normalizeLeadingPlusHex(String str) {
+		if (str == null || str.length() < 2 || str.charAt(0) != '+') {
+			return str;
+		}
+		if (hexPrefixLength(str.substring(1)) > 0) {
+			return str.substring(1);
+		}
+		return str;
+	}
+
+	private static boolean isPositiveHex(String str) {
+		return str != null && str.length() > 0 && str.charAt(0) != '-' && hexPrefixLength(str) > 0;
+	}
+
+	private static int hexPrefixLength(String str) {
+		if (str == null) {
+			return 0;
+		}
+		if (str.startsWith("0x") || str.startsWith("0X")) {
+			return 2;
+		}
+		if (str.startsWith("#")) {
+			return 1;
+		}
+		return 0;
+	}
