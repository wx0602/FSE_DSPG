+    private static ZipFile openZipFile(String path) throws IOException {
+        if (path == null) {
+            throw new IllegalArgumentException("zip path must not be null");
+        }
+        return new ZipFile(path, Charset.forName("gbk"));
+    }
+
+    private static File resolveZipEntry(File baseDir, ZipEntry entry) throws IOException {
+        String entryName = entry.getName();
+        if (entryName == null || entryName.trim().isEmpty()) {
+            throw new IOException("zip entry name is empty");
+        }
+        File target = new File(baseDir, entryName);
+        String basePath = baseDir.getCanonicalPath() + File.separator;
+        String targetPath = target.getCanonicalPath();
+        if (!targetPath.startsWith(basePath) && !targetPath.equals(baseDir.getCanonicalPath())) {
+            throw new IOException("illegal zip entry path: " + entryName);
+        }
+        return target;
+    }
