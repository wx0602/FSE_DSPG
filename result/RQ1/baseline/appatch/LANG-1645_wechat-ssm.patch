+	private static Number createBigInteger(String value) {
+		if (value.startsWith("0x") || value.startsWith("0X")) {
+			return new BigInteger(value.substring(2), 16);
+		}
+		if (value.startsWith("#")) {
+			return new BigInteger(value.substring(1), 16);
+		}
+		return new BigInteger(value);
+	}
+
+	private static String normalizeLeadingPlusHex(String value) {
+		if (value != null && value.startsWith("+") && value.length() > 2) {
+			String unsigned = value.substring(1);
+			if (unsigned.startsWith("0x") || unsigned.startsWith("0X") || unsigned.startsWith("#")) {
+				return unsigned;
+			}
+		}
+		return value;
 	}
 
