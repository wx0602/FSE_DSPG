+    private static byte[] decodeBase64(String encrypted) {
+        if (encrypted == null) {
+            return null;
+        }
+        String normalized = encrypted.trim();
+        if (normalized.length() == 0) {
+            return Base64.decodeBase64(normalized);
+        }
+        normalized = normalized.replace('-', '+').replace('_', '/');
+        int paddingStart = normalized.indexOf('=');
+        String content = paddingStart >= 0 ? normalized.substring(0, paddingStart) : normalized;
+        if (!Pattern.matches("[A-Za-z0-9+/]*", content)) {
+            return Base64.decodeBase64(encrypted);
+        }
+        int remainder = content.length() % 4;
+        if (remainder == 1) {
+            return Base64.decodeBase64(encrypted);
+        }
+        StringBuilder builder = new StringBuilder(content);
+        if (paddingStart >= 0) {
+            builder.append(normalized.substring(paddingStart).replace("=", ""));
+        }
+        while (builder.length() % 4 != 0) {
+            builder.append('=');
+        }
+        return Base64.decodeBase64(builder.toString());
+    }
