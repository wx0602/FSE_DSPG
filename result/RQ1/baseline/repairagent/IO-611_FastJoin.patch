+    // Mitigate commons-io normalize handling of repeated separators after a path prefix.
+    private static String safeNormalize(String filename) {
+        if (filename == null) {
+            return null;
+        }
+
+        boolean usesBackslash = filename.indexOf('\\') >= 0;
+        String collapsed = filename.replace('\\', '/');
+        int prefixLength = 0;
+
+        if (collapsed.startsWith("//")) {
+            prefixLength = 2;
+        }
+        else if (collapsed.length() >= 2 && collapsed.charAt(1) == ':') {
+            prefixLength = collapsed.length() >= 3 && collapsed.charAt(2) == '/' ? 3 : 2;
+        }
+        else if (collapsed.startsWith("/")) {
+            prefixLength = 1;
+        }
+
+        String prefix = collapsed.substring(0, prefixLength);
+        String remainder = collapsed.substring(prefixLength);
+        while (remainder.contains("//")) {
+            remainder = remainder.replace("//", "/");
+        }
+
+        String normalized = normalize(prefix + remainder);
+        if (normalized == null || !usesBackslash) {
+            return normalized;
+        }
+        return normalized.replace('/', '\\');
+    }
