     public static String decrypt(String encryptPassword, String salt) throws Exception {
+        if (encryptPassword == null || !encryptPassword.matches("^[A-Za-z0-9+/]+={0,2}$") || (encryptPassword.length() % 4) != 0) {
+            throw new IllegalArgumentException("Invalid encrypted password");
+        }
+        int padding = encryptPassword.endsWith("==") ? 2 : (encryptPassword.endsWith("=") ? 1 : 0);
+        int usefulLength = encryptPassword.length() - padding;
+        if (padding > 0 && encryptPassword.substring(0, usefulLength).indexOf('=') >= 0) {
+            throw new IllegalArgumentException("Invalid encrypted password");
+        }
+        String alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        if (padding == 2) {
+            int value = alphabet.indexOf(encryptPassword.charAt(usefulLength - 1));
+            int mask = (1 << 4) - 1;
+            if (value < 0 || (value & mask) != 0) {
+                throw new IllegalArgumentException("Invalid encrypted password");
+            }
+        } else if (padding == 1) {
+            int value = alphabet.indexOf(encryptPassword.charAt(usefulLength - 1));
+            int mask = (1 << 2) - 1;
+            if (value < 0 || (value & mask) != 0) {
+                throw new IllegalArgumentException("Invalid encrypted password");
