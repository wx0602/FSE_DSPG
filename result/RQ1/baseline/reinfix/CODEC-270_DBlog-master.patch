+public ResponseBean login(@RequestBody User user) {
+    User userExist = userService.getByUserName(user.getUsername());
+    if (userExist == null) {
+        return ResponseBean.error("用户名或密码错误");
+    }
+    String encryptPassword;
+    try {
+        encryptPassword = PasswordUtil.encrypt(user.getPassword(), user.getUsername());
+    } catch (Exception e) {
+        return ResponseBean.error("用户名或密码错误");
+    }
+    if (!encryptPassword.equals(userExist.getPassword())) {
+        return ResponseBean.error("用户名或密码错误");
+    }
+    SessionUtil.setUser(userExist);
+    return ResponseBean.success("登录成功");
+}
