-	}
+public static String toFixedDecimalWithPercent(String value, int scale) {
+		if (value == null) {
+			return toFixedDecimalWithPercent((Number) null, scale);
+		}
+		String normalized = value.trim();
+		if (normalized.length() == 0) {
+			return toFixedDecimalWithPercent((Number) null, scale);
+		}
+		boolean hasPercent = normalized.endsWith("%");
+		if (hasPercent) {
+			normalized = normalized.substring(0, normalized.length() - 1).trim();
+		}
+		if (normalized.length() == 0) {
+			return toFixedDecimalWithPercent((Number) null, scale);
+		}
+		Number number = NumberUtils.createNumber(normalized);
+		return toFixedDecimalWithPercent(number, scale);
+	}
