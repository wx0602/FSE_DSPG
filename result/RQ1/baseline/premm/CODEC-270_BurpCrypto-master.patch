+public String decrypt(String cipherText) {
+    if (cipherText == null) {
+        throw new IllegalArgumentException("cipherText must not be null");
+    }
+    if (!isStrictBase64(cipherText)) {
+        throw new IllegalArgumentException("Invalid Base64 cipherText");
+    }
+    try {
+        byte[] decoded = java.util.Base64.getDecoder().decode(cipherText);
+        byte[] decrypted = crypto.decrypt(decoded);
+        return new String(decrypted, "UTF-8");
+    } catch (IllegalArgumentException e) {
+        throw fail(e);
+    } catch (UnsupportedEncodingException e) {
+        throw fail(e);
+    }
+}
+
+private boolean isStrictBase64(String value) {
+    if (value.isEmpty() || (value.length() % 4) != 0) {
+        return false;
+    }
+    for (int i = 0; i < value.length(); i++) {
+        char ch = value.charAt(i);
+        boolean validChar = (ch >= 'A' && ch <= 'Z')
+                || (ch >= 'a' && ch <= 'z')
+                || (ch >= '0' && ch <= '9')
+                || ch == '+'
+                || ch == '/'
+                || ch == '=';
+        if (!validChar) {
+            return false;
         }
     }
