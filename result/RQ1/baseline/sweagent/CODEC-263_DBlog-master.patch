+package com.zyd.blog.util;
+
+import org.apache.commons.codec.binary.Base64;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * Provides a tolerant Base64 decoder to avoid commons-codec 1.13 validation
+ * exceptions for malformed or non-canonical input.
+ */
+public final class SafeBase64Util {
+
+    private SafeBase64Util() {
+    }
+
+    public static byte[] decode(String value) {
+        if (value == null) {
+            return new byte[0];
+        }
+        String normalized = normalize(value);
+        if (normalized.isEmpty()) {
+            return new byte[0];
+        }
+        return Base64.decodeBase64(normalized.getBytes(StandardCharsets.UTF_8));
+    }
+
+    private static String normalize(String value) {
+        StringBuilder builder = new StringBuilder(value.length() + 4);
+        for (int i = 0; i < value.length(); i++) {
+            char current = value.charAt(i);
+            if (isBase64Char(current) || current == '=') {
+                builder.append(current);
+            }
+        }
+        int remainder = builder.length() % 4;
+        if (remainder > 0) {
+            for (int i = 0; i < 4 - remainder; i++) {
+                builder.append('=');
+            }
+        }
+        return builder.toString();
+    }
+
+    private static boolean isBase64Char(char current) {
+        return (current >= 'A' && current <= 'Z')
+            || (current >= 'a' && current <= 'z')
+            || (current >= '0' && current <= '9')
+            || current == '+'
+            || current == '/';
+    }
+}
