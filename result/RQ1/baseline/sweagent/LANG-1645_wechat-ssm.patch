+	public static Number createNumber(String value) {
+		if (value == null) {
+			return null;
+		}
+
+		if (value.startsWith("+") && isHexNumber(value, 1)) {
+			return createPositiveHexNumber(value);
+		}
+
+		return NumberUtils.createNumber(value);
+	}
+
+	private static Number createPositiveHexNumber(String value) {
+		String unsignedValue = value.substring(1);
+		BigInteger bigInteger = new BigInteger(unsignedValue.substring(2), 16);
+		if (bigInteger.bitLength() <= 31) {
+			return Integer.valueOf(bigInteger.intValue());
+		}
+		if (bigInteger.bitLength() <= 63) {
+			return Long.valueOf(bigInteger.longValue());
+		}
+		return bigInteger;
+	}
+
+	private static boolean isHexNumber(String value, int startIndex) {
+		int prefixIndex = startIndex;
+		if (value.length() <= prefixIndex + 2) {
+			return false;
+		}
+		char firstPrefixChar = value.charAt(prefixIndex);
+		char secondPrefixChar = value.charAt(prefixIndex + 1);
+		if (firstPrefixChar != '0' || (secondPrefixChar != 'x' && secondPrefixChar != 'X')) {
+			return false;
+		}
+		for (int i = prefixIndex + 2; i < value.length(); i++) {
+			if (Character.digit(value.charAt(i), 16) == -1) {
+				return false;
+			}
+		}
+		return true;
+	}
+
