+    private static boolean isSafeBase64(String encrypted) {
+        if (encrypted == null || encrypted.isEmpty()) {
+            return false;
+        }
+        if (!BASE64_PATTERN.matcher(encrypted).matches()) {
+            return false;
+        }
+        int paddingIndex = encrypted.indexOf('=');
+        if (paddingIndex >= 0 && paddingIndex < encrypted.length() - 2) {
+            return false;
+        }
+        if (encrypted.length() % 4 != 0) {
+            return false;
+        }
+
+        int paddingCount = 0;
+        for (int i = encrypted.length() - 1; i >= 0 && encrypted.charAt(i) == '='; i--) {
+            paddingCount++;
+        }
+        if (paddingCount > 2) {
+            return false;
+        }
+        if (paddingCount == 0) {
+            return true;
+        }
+
+        int lastDataCharIndex = encrypted.length() - paddingCount - 1;
+        if (lastDataCharIndex < 0) {
+            return false;
+        }
+        int value = decodeBase64Char(encrypted.charAt(lastDataCharIndex));
+        if (value < 0) {
+            return false;
+        }
+        if (paddingCount == 2) {
+            return (value & 0x0F) == 0;
+        }
+        return (value & 0x03) == 0;
+    }
+
+    private static int decodeBase64Char(char ch) {
+        if (ch >= 'A' && ch <= 'Z') {
+            return ch - 'A';
+        }
+        if (ch >= 'a' && ch <= 'z') {
+            return ch - 'a' + 26;
+        }
+        if (ch >= '0' && ch <= '9') {
+            return ch - '0' + 52;
+        }
+        if (ch == '+') {
+            return 62;
+        }
+        if (ch == '/') {
+            return 63;
+        }
+        return -1;
+    }
