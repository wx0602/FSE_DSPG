diff --git a/src/main/java/soj/util/SafePathUtils.java b/src/main/java/soj/util/SafePathUtils.java
new file mode 100644
index 0000000..8f7739c
--- /dev/null
+++ b/src/main/java/soj/util/SafePathUtils.java
@@ -0,0 +1,78 @@
+package soj.util;
+
+import java.nio.file.InvalidPathException;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.regex.Pattern;
+
+/**
+ * Minimal path sanitization helpers used instead of Apache Commons IO
+ * FilenameUtils normalization methods.
+ *
+ * These helpers collapse repeated separators in a bounded, linear way and rely
+ * on java.nio.file path normalization to remove redundant "." and ".."
+ * segments without touching the filesystem.
+ */
+public final class SafePathUtils {
+    private static final Pattern MULTIPLE_SEPARATORS = Pattern.compile("[\\\\/]+");
+
+    private SafePathUtils() {
+    }
+
+    public static String normalizePath(String filename) {
+        return normalize(filename, false);
+    }
+
+    public static String normalizePathNoEndSeparator(String filename) {
+        return normalize(filename, true);
+    }
+
+    public static String getFullPath(String filename) {
+        String normalized = normalizePath(filename);
+        if (normalized == null || normalized.isEmpty()) {
+            return normalized;
+        }
+
+        int slash = Math.max(normalized.lastIndexOf('/'), normalized.lastIndexOf('\\'));
+        if (slash < 0) {
+            return "";
+        }
+
+        return normalized.substring(0, slash + 1);
+    }
+
+    private static String normalize(String filename, boolean removeEndSeparator) {
+        if (filename == null) {
+            return null;
+        }
+
+        String trimmed = filename.trim();
+        if (trimmed.isEmpty()) {
+            return trimmed;
+        }
+
+        String collapsed = MULTIPLE_SEPARATORS.matcher(trimmed.replace('\\', '/')).replaceAll("/");
+
+        try {
+            Path normalizedPath = Paths.get(collapsed).normalize();
+            String normalized = normalizedPath.toString().replace('\\', '/');
+
+            if (!collapsed.startsWith("/") && normalized.startsWith("/")) {
+                normalized = normalized.substring(1);
+            }
+
+            if (!removeEndSeparator && collapsed.endsWith("/") && !normalized.endsWith("/")) {
+                normalized = normalized + "/";
+            }
+
+            if (removeEndSeparator && normalized.length() > 1 && normalized.endsWith("/")) {
+                normalized = normalized.substring(0, normalized.length() - 1);
+            }
+
+            return normalized;
+        }
+        catch (InvalidPathException ex) {
+            throw new IllegalArgumentException("Invalid path: " + filename, ex);
+        }
+    }
+}
