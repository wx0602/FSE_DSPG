@@ -0,0 +1,62 @@
+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Boundary for the old Commons IO normalizer.
+ *
+ * Commons IO 2.5 can leave repeated separators after a path prefix.  Clean
+ * those separators before calling it so the affected implementation cannot
+ * produce an ambiguous path such as {@code //foo//bar}.
+ */
+public final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    public static String normalize(String filename) {
+        return FilenameUtils.normalize(collapseSeparators(filename));
+    }
+
+    public static String normalizeNoEndSeparator(String filename) {
+        return FilenameUtils.normalizeNoEndSeparator(collapseSeparators(filename));
+    }
+
+    private static String collapseSeparators(String filename) {
+        if (filename == null || filename.length() < 2) {
+            return filename;
+        }
+
+        StringBuilder result = new StringBuilder(filename.length());
+        int index = 0;
+        int leadingSeparators = 0;
+        while (index < filename.length() && isSeparator(filename.charAt(index))) {
+            leadingSeparators++;
+            index++;
+        }
+        // Keep the two-character UNC/prefix form, but never more than two.
+        int prefixSeparators = Math.min(leadingSeparators, 2);
+        for (int i = 0; i < prefixSeparators; i++) {
+            result.append(filename.charAt(i));
+        }
+
+        boolean previousSeparator = prefixSeparators > 0;
+        for (; index < filename.length(); index++) {
+            char current = filename.charAt(index);
+            if (isSeparator(current)) {
+                if (!previousSeparator) {
+                    result.append(current);
+                }
+                previousSeparator = true;
+            }
+            else {
+                result.append(current);
+                previousSeparator = false;
+            }
+        }
+        return result.toString();
+    }
+
+    private static boolean isSeparator(char value) {
+        return value == '/' || value == '\\';
+    }
+}
