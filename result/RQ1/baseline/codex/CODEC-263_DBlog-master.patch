+    private static byte[] decodeEncrypted(String encrypted) {
+        if (encrypted == null) {
+            throw new IllegalArgumentException("Encrypted content must not be null");
+        }
+        String normalized = normalizeBase64(encrypted);
+        byte[] encryptedBytes;
+        try {
+            encryptedBytes = java.util.Base64.getDecoder().decode(normalized);
+        } catch (IllegalArgumentException e) {
+            try {
+                encryptedBytes = java.util.Base64.getUrlDecoder().decode(normalized);
+            } catch (IllegalArgumentException ignored) {
+                throw new IllegalArgumentException("Encrypted content is not valid Base64", e);
+            }
+        }
+        return validateEncryptedBytes(encryptedBytes);
+    }
+
+    private static byte[] validateEncryptedBytes(byte[] encryptedBytes) {
+        if (encryptedBytes.length == 0 || encryptedBytes.length % 16 != 0) {
+            throw new IllegalArgumentException("Encrypted content is not valid AES ciphertext");
+        }
+        return encryptedBytes;
+    }
+
+    private static String normalizeBase64(String encrypted) {
+        String normalized = encrypted.trim().replaceAll("\\s", "");
+        int remainder = normalized.length() % 4;
+        if (remainder == 1) {
+            throw new IllegalArgumentException("Encrypted content is not valid Base64");
+        }
+        if (remainder > 0) {
+            StringBuilder builder = new StringBuilder(normalized);
+            for (int i = remainder; i < 4; i++) {
+                builder.append('=');
+            }
+            normalized = builder.toString();
+        }
+        return normalized;
