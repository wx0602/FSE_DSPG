+package org.apache.velocity.runtime.resource.loader;
+
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one or more
+ * contributor license agreements.  See the NOTICE file distributed with
+ * this work for additional information regarding copyright ownership.
+ */
+
+import java.io.File;
+
+import org.apache.commons.io.FilenameUtils;
+
+/** Utilities for safely normalizing names supplied to resource loaders. */
+final class ResourceNameUtils
+{
+    private ResourceNameUtils()
+    {
+    }
+
+    /**
+     * Commons IO 2.6 can leave repeated separators in a normalized name.
+     * Collapse them after normalization so that a name cannot retain a
+     * different path spelling from the one described by the normalizer.
+     */
+    static String normalize(String name, boolean keepSeparator)
+    {
+        String normalized = FilenameUtils.normalize(name, keepSeparator);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        char separator = File.separatorChar;
+        StringBuilder result = new StringBuilder(normalized.length());
+        boolean separatorWritten = false;
+        for (int i = 0; i < normalized.length(); i++)
+        {
+            char current = normalized.charAt(i);
+            if (current == separator)
+            {
+                if (!separatorWritten)
+                {
+                    result.append(current);
+                    separatorWritten = true;
+                }
+            }
+            else
+            {
+                result.append(current);
+                separatorWritten = false;
+            }
+        }
+        return result.toString();
+    }
+}
