+    private static String normalizeBase64(String encrypted) {
+        if (encrypted == null || !encrypted.matches("^[A-Za-z0-9+/]*={0,2}$")) {
+            return "";
+        }
+        int remainder = encrypted.length() % 4;
+        return remainder == 0 ? encrypted : encrypted.substring(0, encrypted.length() - remainder);
+    }
