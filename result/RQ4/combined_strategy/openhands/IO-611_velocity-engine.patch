+    static String normalizeTemplateName(String name, boolean unixSeparator)
+    {
+        String normalized = FilenameUtils.normalize(name, unixSeparator);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        int prefixLength = FilenameUtils.getPrefixLength(normalized);
+        if (prefixLength < 0)
+        {
+            return null;
+        }
+
+        int start = prefixLength > 0 ? prefixLength : 1;
+        char separator = unixSeparator ? '/' : File.separatorChar;
+        StringBuilder sanitized = new StringBuilder(normalized.length());
+        for (int i = 0; i < normalized.length(); i++)
+        {
+            char ch = normalized.charAt(i);
+            if (i >= start && ch == separator && sanitized.length() > 0
+                && sanitized.charAt(sanitized.length() - 1) == separator)
+            {
+                continue;
+            }
+            sanitized.append(ch);
+        }
+        return sanitized.toString();
+    }
