+package soj.util;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+
+final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    static String normalize(String filename) {
+        if (filename == null) {
+            return null;
+        }
+
+        String sanitized = collapseDuplicateSeparators(filename.replace('\\', '/'));
+        String prefix = extractPrefix(sanitized);
+        String remainder = sanitized.substring(prefix.length());
+        boolean trailingSlash = remainder.endsWith("/") && !remainder.isEmpty();
+
+        Deque<String> segments = new ArrayDeque<String>();
+        for (String segment : remainder.split("/")) {
+            if (segment.isEmpty() || ".".equals(segment)) {
+                continue;
+            }
+            if ("..".equals(segment)) {
+                if (!segments.isEmpty() && !"..".equals(segments.peekLast())) {
+                    segments.removeLast();
+                }
+                else if (prefix.isEmpty()) {
+                    segments.addLast(segment);
+                }
+            }
+            else {
+                segments.addLast(segment);
+            }
+        }
+
+        StringBuilder normalized = new StringBuilder(prefix);
+        boolean needsSeparator = !prefix.isEmpty() && !prefix.endsWith("/");
+        for (String segment : segments) {
+            if (needsSeparator) {
+                normalized.append('/');
+            }
+            normalized.append(segment);
+            needsSeparator = true;
+        }
+
+        if (trailingSlash && normalized.length() > 0 && normalized.charAt(normalized.length() - 1) != '/') {
+            normalized.append('/');
+        }
+
+        if (normalized.length() == 0 && !prefix.isEmpty()) {
+            return prefix;
+        }
+        return normalized.length() == 0 ? "." : normalized.toString();
+    }
+
+    private static String extractPrefix(String value) {
+        if (value.startsWith("//")) {
+            return "//";
+        }
+        if (value.startsWith("/")) {
+            return "/";
+        }
+        if (value.length() >= 3
+                && Character.isLetter(value.charAt(0))
+                && value.charAt(1) == ':'
+                && value.charAt(2) == '/') {
+            return value.substring(0, 3);
+        }
+        if (value.length() >= 2
+                && Character.isLetter(value.charAt(0))
+                && value.charAt(1) == ':') {
+            return value.substring(0, 2);
+        }
+        return "";
+    }
+
+
+    private static String collapseDuplicateSeparators(String value) {
+        if (value.isEmpty()) {
+            return value;
+        }
+
+        StringBuilder normalized = new StringBuilder(value.length());
+        int index = 0;
+        boolean preserveLeadingDoubleSlash = value.startsWith("//");
+        if (preserveLeadingDoubleSlash) {
+            normalized.append("//");
+            index = 2;
+            while (index < value.length() && value.charAt(index) == '/') {
+                index++;
+            }
+        }
+
+        boolean previousWasSlash = normalized.length() > 0 && normalized.charAt(normalized.length() - 1) == '/';
+        for (; index < value.length(); index++) {
+            char current = value.charAt(index);
+            if (current == '/') {
+                if (!previousWasSlash) {
+                    normalized.append(current);
+                }
+                previousWasSlash = true;
+            }
+            else {
+                normalized.append(current);
+                previousWasSlash = false;
+            }
+        }
+
+        return normalized.toString();
+    }
+}
