+    /**
+     * Rejects non-canonical Base64 inputs before the pinned Commons Codec decoder
+     * can silently discard non-zero trailing bits or invalid characters.
+     */
+    private static void validateBase64(String value) {
+        if (value == null || value.length() == 0 || value.length() % 4 != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        int padding = value.endsWith("==") ? 2 : value.endsWith("=") ? 1 : 0;
+        int dataLength = value.length() - padding;
+        for (int i = 0; i < dataLength; i++) {
+            char c = value.charAt(i);
+            if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
+                    || (c >= '0' && c <= '9') || c == '+' || c == '/')) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+        for (int i = dataLength; i < value.length(); i++) {
+            if (value.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+        int lastValue = base64Value(value.charAt(dataLength - 1));
+        if ((padding == 2 && (lastValue & 0x0F) != 0)
+                || (padding == 1 && (lastValue & 0x03) != 0)) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+    }
+
+    private static int base64Value(char c) {
+        if (c >= 'A' && c <= 'Z') {
+            return c - 'A';
+        }
+        if (c >= 'a' && c <= 'z') {
+            return c - 'a' + 26;
+        }
+        if (c >= '0' && c <= '9') {
+            return c - '0' + 52;
+        }
+        return c == '+' ? 62 : 63;
+    }
