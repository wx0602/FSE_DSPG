+	private static Number createNumberCompat(String value) {
+		try {
+			return NumberUtils.createNumber(value);
+		} catch (NumberFormatException ex) {
+			return createPositiveSignedHexNumber(value, ex);
+		}
+	}
+
+	private static Number createPositiveSignedHexNumber(String value, NumberFormatException ex) {
+		if (!isPositiveSignedHex(value)) {
+			throw ex;
+		}
+
+		String normalizedValue = value.substring(1);
+		if (hasHexPrefix(normalizedValue, 0)) {
+			return NumberUtils.createNumber(normalizedValue);
+		}
+
+		if (normalizedValue.startsWith("#")) {
+			return new BigInteger(normalizedValue.substring(1), 16);
+		}
+
+		throw ex;
+	}
+
+	private static boolean isPositiveSignedHex(String value) {
+		return value != null
+				&& value.length() > 2
+				&& value.charAt(0) == '+'
+				&& (hasHexPrefix(value, 1) || value.startsWith("+#"));
+	}
+
+	private static boolean hasHexPrefix(String value, int start) {
+		return value.startsWith("0x", start) || value.startsWith("0X", start);
+	}
