+    private String normalizeResourceName(final String name)
+    {
+        String normalized = FilenameUtils.normalize(name, true);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        int prefix = normalized.startsWith("//") ? 2 : 1;
+        StringBuilder result = new StringBuilder(normalized.length());
+        result.append(normalized, 0, Math.min(prefix, normalized.length()));
+        for (int i = prefix; i < normalized.length(); i++)
+        {
+            if (normalized.charAt(i) == '/' && result.length() > 0 &&
+                    result.charAt(result.length() - 1) == '/')
+            {
+                continue;
+            }
+            result.append(normalized.charAt(i));
+        }
+        return result.toString();
+    }
