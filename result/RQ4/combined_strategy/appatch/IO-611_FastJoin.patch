+    private String normalizePath(String filename) {
+        if (filename == null) {
+            return null;
+        }
+
+        String normalized = normalize(filename);
+        if (normalized == null) {
+            return null;
+        }
+
+        if (normalized.startsWith("//")) {
+            int prefixEnd = 2;
+            while (prefixEnd < normalized.length() && normalized.charAt(prefixEnd) == '/') {
+                prefixEnd++;
+            }
+            if (prefixEnd > 2) {
+                normalized = "//" + normalized.substring(prefixEnd);
+            }
+        }
+
+        return normalized;
+    }
