@@ -59,6 +59,12 @@
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static BigInteger createBigInteger(String str)  {
+		if (str != null && str.startsWith("+") && str.length() > 1) {
+			String unsigned = str.substring(1);
+			if (unsigned.startsWith("0x") || unsigned.startsWith("0X") || unsigned.startsWith("#")) {
+				str = unsigned;
+			}
+		}
 		return NumberUtils.createBigInteger(str);
 	}
 	
