+package org.apache.velocity.runtime.resource.loader;
+
+/** Utilities for sanitizing resource paths before legacy path normalization. */
+final class ResourcePathUtils
+{
+    private ResourcePathUtils()
+    {
+    }
+
+    /**
+     * Removes redundant separators while retaining a leading UNC separator
+     * pair. Commons IO 2.6 otherwise leaves duplicate separators after that
+     * prefix in its normalized result.
+     */
+    static String collapseDuplicateSeparators(String path)
+    {
+        StringBuilder result = new StringBuilder(path.length());
+        int leadingSeparators = 0;
+        while (leadingSeparators < path.length()
+                && (path.charAt(leadingSeparators) == '/'
+                || path.charAt(leadingSeparators) == '\\'))
+        {
+            leadingSeparators++;
+        }
+        int prefixLength = leadingSeparators == 2 ? 2 : (leadingSeparators > 0 ? 1 : 0);
+        boolean previousSeparator = false;
+
+        for (int i = 0; i < path.length(); i++)
+        {
+            char current = path.charAt(i);
+            boolean separator = current == '/' || current == '\\';
+            if (!separator)
+            {
+                previousSeparator = false;
+                result.append(current);
+            }
+            else if (i < prefixLength || !previousSeparator)
+            {
+                result.append(current);
+                previousSeparator = true;
+            }
+        }
+        return result.toString();
+    }
+}
