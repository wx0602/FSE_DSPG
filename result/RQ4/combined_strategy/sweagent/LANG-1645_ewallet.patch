 	/**
@@ -116,7 +116,18 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
-		return NumberUtils.createNumber(str);
+		return NumberUtils.createNumber(normalizePositiveHexPrefix(str));
+	}
+
+	private static String normalizePositiveHexPrefix(String str) {
+		// Commons Lang 3.4 rejects the Java-valid leading plus on hex integers.
+		if (str != null && str.length() > 1 && str.charAt(0) == '+') {
+			String number = str.substring(1);
+			if (number.startsWith("0x") || number.startsWith("0X") || number.startsWith("#")) {
+				return number;
+			}
+		}
+		return str;
 	}
 	
 	
