+    private static byte[] decodeBase64Safely(String encrypted) {
+        if (encrypted == null) {
+            throw new IllegalArgumentException("Encrypted text must not be null");
+        }
+        if (!isSafeBase64(encrypted)) {
+            throw new IllegalArgumentException("Encrypted text is not valid Base64 content");
+        }
+        return Base64.decodeBase64(encrypted.getBytes(StandardCharsets.UTF_8));
+    }
+
+    private static boolean isSafeBase64(String encrypted) {
+        String normalized = encrypted.trim();
+        if (normalized.isEmpty()) {
+            return false;
+        }
+        if ((normalized.length() & 3) == 1) {
+            return false;
+        }
+
+        int paddingStart = normalized.length();
+        while (paddingStart > 0 && normalized.charAt(paddingStart - 1) == '=') {
+            paddingStart--;
+        }
+        if (normalized.length() - paddingStart > 2) {
+            return false;
+        }
+
+        for (int i = 0; i < paddingStart; i++) {
+            char ch = normalized.charAt(i);
+            if (!isBase64Char(ch)) {
+                return false;
+            }
+        }
+        for (int i = paddingStart; i < normalized.length(); i++) {
+            if (normalized.charAt(i) != '=') {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean isBase64Char(char ch) {
+        return (ch >= 'A' && ch <= 'Z')
+            || (ch >= 'a' && ch <= 'z')
+            || (ch >= '0' && ch <= '9')
+            || ch == '+'
+            || ch == '/';
+    }
