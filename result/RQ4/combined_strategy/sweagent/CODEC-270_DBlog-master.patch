+    private static void validateBase64(String encrypted) {
+        if (encrypted == null) {
+            throw new IllegalArgumentException("Encrypted content must not be null");
+        }
+        if (encrypted.isEmpty()) {
+            return;
+        }
+        if ((encrypted.length() & 3) != 0) {
+            throw new IllegalArgumentException("Encrypted content is not valid Base64");
+        }
+        if (!BASE64_PATTERN.matcher(encrypted).matches()) {
+            throw new IllegalArgumentException("Encrypted content is not valid Base64");
+        }
+
+        int firstPadding = encrypted.indexOf('=');
+        if (firstPadding >= 0) {
+            for (int i = firstPadding; i < encrypted.length(); i++) {
+                if (encrypted.charAt(i) != '=') {
+                    throw new IllegalArgumentException("Encrypted content is not valid Base64");
+                }
+            }
+        }
+
+        int paddingCount = encrypted.length() - encrypted.replace("=", "").length();
+        if (paddingCount > 2) {
+            throw new IllegalArgumentException("Encrypted content is not valid Base64");
+        }
+        if (paddingCount == 2) {
+            int value = decodeBase64Char(encrypted.charAt(encrypted.length() - 3));
+            if ((value & 0x0F) != 0) {
+                throw new IllegalArgumentException("Encrypted content is not valid Base64");
+            }
+        } else if (paddingCount == 1) {
+            int value = decodeBase64Char(encrypted.charAt(encrypted.length() - 2));
+            if ((value & 0x03) != 0) {
+                throw new IllegalArgumentException("Encrypted content is not valid Base64");
+            }
+        }
+    }
+
+    private static int decodeBase64Char(char ch) {
+        int value = BASE64_ALPHABET.indexOf(ch);
+        if (value < 0) {
+            throw new IllegalArgumentException("Encrypted content is not valid Base64");
+        }
+        return value;
+    }
