+    private String normalizeFilename(String filename) {
+        if (filename == null) {
+            return null;
+        }
+
+        int prefixLength = getPrefixLength(filename);
+        StringBuilder collapsed = new StringBuilder(filename.length());
+        collapsed.append(filename, 0, prefixLength);
+        boolean previousSeparator = prefixLength > 0
+                && isSeparator(filename.charAt(prefixLength - 1));
+        for (int i = prefixLength; i < filename.length(); i++) {
+            char character = filename.charAt(i);
+            boolean separator = isSeparator(character);
+            if (!separator || !previousSeparator) {
+                collapsed.append(character);
+            }
+            previousSeparator = separator;
+        }
+        return normalize(collapsed.toString());
+    }
