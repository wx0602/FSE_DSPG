+    private static void validateBase64(String str) {
+        if (str == null) {
+            throw new IllegalArgumentException("Base64 input must not be null");
+        }
+        int length = str.length();
+        if (length == 0) {
+            return;
+        }
+        if ((length & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 length");
+        }
+        int padding = 0;
+        if (str.charAt(length - 1) == '=') {
+            padding++;
+            if (str.charAt(length - 2) == '=') {
+                padding++;
+            }
+        }
+        for (int i = 0; i < length - padding; i++) {
+            if (decodeBase64Char(str.charAt(i)) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+        }
+        for (int i = length - padding; i < length; i++) {
+            if (str.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+        if (padding > 0) {
+            int lastValue = decodeBase64Char(str.charAt(length - padding - 1));
+            if (padding == 2) {
+                if ((lastValue & 0x0F) != 0) {
+                    throw new IllegalArgumentException("Invalid Base64 trailing bits");
+                }
+            } else if (padding == 1) {
+                if ((lastValue & 0x03) != 0) {
+                    throw new IllegalArgumentException("Invalid Base64 trailing bits");
+                }
+            } else {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+    }
