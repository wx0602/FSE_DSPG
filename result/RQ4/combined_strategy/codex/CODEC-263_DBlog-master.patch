+    /**
+     * Decode ciphertext without allowing commons-codec 1.13's malformed
+     * trailing Base64 handling to escape as an unchecked exception.  Invalid
+     * remember-me/login data must fail authentication, rather than becoming a
+     * request-level error.
+     */
+    private static byte[] decodeCiphertext(String encrypted) throws GeneralSecurityException {
+        try {
+            return Base64.decodeBase64(encrypted);
+        } catch (IllegalArgumentException e) {
+            throw new GeneralSecurityException("Invalid Base64 ciphertext", e);
+        }
+    }
