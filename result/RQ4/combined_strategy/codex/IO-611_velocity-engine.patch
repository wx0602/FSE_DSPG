+    /**
+     * Normalize a resource name and remove duplicate separators left behind
+     * by Commons IO 2.6.  FilenameUtils.normalize() preserves duplicate
+     * separators after a UNC prefix, which can make the name used for lookup
+     * differ from the normalized path described by its contract.
+     *
+     * @param name resource name
+     * @param keepTrailingSeparator whether to preserve a trailing separator
+     * @return normalized resource name, or {@code null} when it is invalid
+     */
+    private String normalizeTemplateName(final String name, final boolean keepTrailingSeparator)
+    {
+        String normalized = FilenameUtils.normalize(name, keepTrailingSeparator);
+        if (normalized == null || normalized.length() < 2)
+        {
+            return normalized;
+        }
+
+        char separator = File.separatorChar;
+        StringBuilder result = new StringBuilder(normalized.length());
+        boolean uncPrefix = normalized.charAt(0) == separator && normalized.charAt(1) == separator;
+        boolean previousSeparator = false;
+        for (int i = 0; i < normalized.length(); i++)
+        {
+            char current = normalized.charAt(i);
+            if (current == separator)
+            {
+                if (previousSeparator && !(uncPrefix && result.length() < 2))
+                {
+                    continue;
+                }
+                previousSeparator = true;
+            }
+            else
+            {
+                previousSeparator = false;
+            }
+            result.append(current);
+        }
+        return result.toString();
+    }
