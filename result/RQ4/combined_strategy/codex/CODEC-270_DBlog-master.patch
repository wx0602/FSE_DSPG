+    private static void validateBase64(String value) {
+        if (value == null) {
+            throw new IllegalArgumentException("Base64 value must not be null");
+        }
+        if (value.length() == 0) {
+            return;
+        }
+        if ((value.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 length");
+        }
+
+        int padding = value.endsWith("==") ? 2 : value.endsWith("=") ? 1 : 0;
+        int contentLength = value.length() - padding;
+        for (int i = 0; i < contentLength; i++) {
+            if (base64Value(value.charAt(i)) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+        }
+        for (int i = contentLength; i < value.length(); i++) {
+            if (value.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+        if (padding == 1 && contentLength % 4 != 3
+                || padding == 2 && contentLength % 4 != 2) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
