+public String decrypt(String cipherText) {
+        try {
+            if (cipherText == null) {
+                throw new IllegalArgumentException("cipherText must not be null");
+            }
+
+            String normalized = cipherText.trim();
+            int length = normalized.length();
+            if (length == 0 || (length % 4) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+
+            int padding = 0;
+            if (normalized.charAt(length - 1) == '=') {
+                padding++;
+                if (normalized.charAt(length - 2) == '=') {
+                    padding++;
+                }
+            }
+
+            int dataLength = length - padding;
+            for (int i = 0; i < length; i++) {
+                char ch = normalized.charAt(i);
+                boolean base64Char =
+                        (ch >= 'A' && ch <= 'Z')
+                                || (ch >= 'a' && ch <= 'z')
+                                || (ch >= '0' && ch <= '9')
+                                || ch == '+'
+                                || ch == '/';
+
+                if (ch == '=') {
+                    if (i < dataLength) {
+                        throw new IllegalArgumentException("Invalid Base64 padding");
+                    }
+                } else if (!base64Char) {
+                    throw new IllegalArgumentException("Invalid Base64 character");
+                }
+            }
+
+            if (padding == 2) {
+                int last = normalized.charAt(dataLength - 1);
+                int value =
+                        last >= 'A' && last <= 'Z' ? last - 'A'
+                                : last >= 'a' && last <= 'z' ? last - 'a' + 26
+                                : last >= '0' && last <= '9' ? last - '0' + 52
+                                : last == '+' ? 62
+                                : 63;
+                if ((value & 0x0F) != 0) {
+                    throw new IllegalArgumentException("Invalid Base64 trailing bits");
+                }
+            } else if (padding == 1) {
+                int last = normalized.charAt(dataLength - 1);
+                int value =
+                        last >= 'A' && last <= 'Z' ? last - 'A'
+                                : last >= 'a' && last <= 'z' ? last - 'a' + 26
+                                : last >= '0' && last <= '9' ? last - '0' + 52
+                                : last == '+' ? 62
+                                : 63;
+                if ((value & 0x03) != 0) {
+                    throw new IllegalArgumentException("Invalid Base64 trailing bits");
+                }
+            }
+
+            byte[] decrypted = crypto.decrypt(Utils.base64(normalized));
+            return new String(decrypted, "UTF-8");
+        } catch (UnsupportedEncodingException e) {
+            throw fail(e);
+        }
+    }
