+public FileReader(String filename, String splitPunc) throws Exception {
+    if (filename == null) {
+        throw new IllegalArgumentException("filename must not be null");
+    }
+
+    String trimmed = filename.trim();
+    if (trimmed.isEmpty()) {
+        throw new IllegalArgumentException("filename must not be empty");
+    }
+
+    String normalized = normalize(trimmed);
+    if (normalized == null) {
+        throw new IllegalArgumentException("Invalid filename: " + filename);
+    }
+
+    String canonical = new java.io.File(normalized).getPath();
+    if (!canonical.equals(normalized)) {
+        throw new IllegalArgumentException("Invalid filename: " + filename);
+    }
+
+    int prefixLength = org.apache.commons.io.FilenameUtils.getPrefixLength(trimmed);
+    if (prefixLength > 0) {
+        String prefix = trimmed.substring(0, prefixLength);
+        String remainder = trimmed.substring(prefixLength);
+        if (remainder.contains("//") || remainder.contains("\\\\")) {
+            throw new IllegalArgumentException("Invalid filename: " + filename);
+        }
+    }
+
+    _filename = normalized;
+    System.out.println(_filename);
+    _reader = getReader();
+
+    String splitePattern;
+    if (splitPunc == null || splitPunc.trim().isEmpty()) {
+        splitePattern = DEFAULT_SPLIT_PATTERN;
+    }
+    else {
+        splitePattern = splitPunc.trim() + "\\s+";
+    }
+    _splitter = Splitter.on(Pattern.compile(splitePattern)).trimResults();
+}
