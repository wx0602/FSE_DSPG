+    private static String normalizeFilename(String filename) {
+        if (filename == null || filename.isEmpty()) {
+            return normalize(filename);
+        }
+
+        StringBuilder sanitized = new StringBuilder(filename.length());
+        int prefix = 0;
+        if (filename.length() >= 2 && Character.isLetter(filename.charAt(0))
+                && filename.charAt(1) == ':') {
+            prefix = 2;
+            sanitized.append(filename, 0, prefix);
+        }
+        else if (filename.startsWith("//") || filename.startsWith("\\\\")) {
+            prefix = 2;
+            sanitized.append(filename, 0, prefix);
+        }
+
+        boolean previousWasSeparator = false;
+        for (int i = prefix; i < filename.length(); i++) {
+            char c = filename.charAt(i);
+            boolean separator = c == '/' || c == '\\';
+            if (!separator || !previousWasSeparator) {
+                sanitized.append(c);
+            }
+            previousWasSeparator = separator;
+        }
+
+        return normalize(sanitized.toString());
+    }
