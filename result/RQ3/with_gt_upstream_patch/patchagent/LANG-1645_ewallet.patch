@@ -59,6 +59,10 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static BigInteger createBigInteger(String str)  {
+		String normalized = normalizeLeadingPlusHex(str);
+		if (normalized != str) {
+			return NumberUtils.createBigInteger(normalized);
+		}
 		return NumberUtils.createBigInteger(str);
 	}
 	
@@ -116,6 +120,10 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
+		String normalized = normalizeLeadingPlusHex(str);
+		if (normalized != str) {
+			return NumberUtils.createNumber(normalized);
+		}
 		return NumberUtils.createNumber(str);
 	}
 	
@@ -140,6 +148,16 @@ public class NumberUtil {
 	public static boolean isNumber(String str)   {
 		return NumberUtils.isNumber(str);
 	}
+
+	private static String normalizeLeadingPlusHex(String str) {
+		if (str == null || str.length() < 2 || str.charAt(0) != '+') {
+			return str;
+		}
+		if (str.startsWith("+0x") || str.startsWith("+0X") || str.startsWith("+#")) {
+			return str.substring(1);
+		}
+		return str;
+	}
 	
 	
 	
