+    private static byte[] decodeBase64Compat(String encrypted) {
+        if (encrypted == null) {
+            return Base64.decodeBase64((byte[]) null);
+        }
+        try {
+            return Base64.decodeBase64(encrypted);
+        } catch (IllegalArgumentException e) {
+            int length = encrypted.length();
+            int remainder = length & 3;
+            if (remainder == 0) {
+                throw e;
+            }
+            StringBuilder builder = new StringBuilder(length + 4 - remainder);
+            builder.append(encrypted);
+            while ((builder.length() & 3) != 0) {
+                builder.append('=');
+            }
+            return Base64.decodeBase64(builder.toString());
+        }
+    }
 
