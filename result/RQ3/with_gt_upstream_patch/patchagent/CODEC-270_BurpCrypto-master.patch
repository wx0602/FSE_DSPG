+    private static void validateBase64(String str) {
+        if (str == null) {
+            throw new IllegalArgumentException("Base64 input must not be null");
+        }
+        String normalized = str.replaceAll("\\s", "");
+        if (normalized.length() == 0) {
+            return;
+        }
+        if ((normalized.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 length");
+        }
+        int padding = 0;
+        int length = normalized.length();
+        while (padding < 2 && length - 1 - padding >= 0 && normalized.charAt(length - 1 - padding) == '=') {
+            padding++;
+        }
+        int contentLength = length - padding;
+        for (int i = 0; i < contentLength; i++) {
+            char c = normalized.charAt(i);
+            if (!(c >= 'A' && c <= 'Z') && !(c >= 'a' && c <= 'z') && !(c >= '0' && c <= '9') && c != '+' && c != '/') {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+        }
+        for (int i = contentLength; i < length; i++) {
+            if (normalized.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+        if (padding > 0 && contentLength == 0) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+        if (padding == 1) {
+            int value = decodeBase64Char(normalized.charAt(contentLength - 1));
+            if ((value & 3) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+        } else if (padding == 2) {
+            int value = decodeBase64Char(normalized.charAt(contentLength - 1));
+            if ((value & 15) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+        }
+    }
