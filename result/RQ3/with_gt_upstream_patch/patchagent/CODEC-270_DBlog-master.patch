+    private static void validateBase64(String value) {
+        if (value == null || value.isEmpty()) {
+            return;
+        }
+
+        int length = value.length();
+        int padding = 0;
+        if (value.charAt(length - 1) == '=') {
+            padding++;
+            if (length > 1 && value.charAt(length - 2) == '=') {
+                padding++;
+            }
+        }
+
+        for (int i = 0; i < length - padding; i++) {
+            if (decodeBase64Char(value.charAt(i)) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+        for (int i = length - padding; i < length; i++) {
+            if (value.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+
+        int remainder = length % 4;
+        if (remainder == 1) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+
+        int dataChars = length - padding;
+        if (padding == 2 || remainder == 2) {
+            int bits = decodeBase64Char(value.charAt(dataChars - 1));
+            if ((bits & 0x0f) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        } else if (padding == 1 || remainder == 3) {
+            int bits = decodeBase64Char(value.charAt(dataChars - 1));
+            if ((bits & 0x03) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+        }
+    }
+
+    private static int decodeBase64Char(char ch) {
+        if (ch >= 'A' && ch <= 'Z') {
+            return ch - 'A';
+        }
+        if (ch >= 'a' && ch <= 'z') {
+            return ch - 'a' + 26;
+        }
+        if (ch >= '0' && ch <= '9') {
+            return ch - '0' + 52;
+        }
+        if (ch == '+') {
+            return 62;
+        }
+        if (ch == '/') {
+            return 63;
+        }
+        return -1;
+    }
