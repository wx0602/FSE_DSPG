+	private static Number createPositiveHexNumber(String digits) {
+		int firstSigDigit = 0;
+		while (firstSigDigit < digits.length() && digits.charAt(firstSigDigit) == '0') {
+			firstSigDigit++;
+		}
+		int hexDigits = digits.length() - firstSigDigit;
+		if (hexDigits <= 8) {
+			return Integer.decode("+0x" + digits);
+		}
+		if (hexDigits <= 16) {
+			return Long.decode("+0x" + digits);
+		}
+		return new BigInteger(digits, 16);
 	}
 
