+    protected String normalizeTemplatePath(String path, boolean unixSeparator)
+    {
+        if (path == null)
+        {
+            return null;
+        }
+
+        String collapsed = collapseAdjacentSeparators(path, unixSeparator ? '/' : '\\');
+        return FilenameUtils.normalize(collapsed, unixSeparator);
+    }
+
+    private String collapseAdjacentSeparators(String path, char separator)
+    {
+        int prefixLength = FilenameUtils.getPrefixLength(path);
+        if (prefixLength < 0)
+        {
+            return path;
+        }
+
+        StringBuilder normalized = new StringBuilder(path.length());
+        normalized.append(path, 0, prefixLength);
+
+        int index = prefixLength != 0 ? prefixLength : 1;
+        if (prefixLength == 0 && !path.isEmpty())
+        {
+            normalized.append(path.charAt(0));
+        }
+
+        for (; index < path.length(); index++)
+        {
+            char current = path.charAt(index);
+            if (current == separator && normalized.charAt(normalized.length() - 1) == separator)
+            {
+                continue;
+            }
+            normalized.append(current);
+        }
+        return normalized.toString();
+    }
