index d4b42d7..71bbb68 100644
--- a/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
+++ b/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
@@ -116,8 +116,23 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
+		if (isUnsafeLongSuffixOnlyValue(str)) {
+			throw new NumberFormatException(str + " is not a valid number.");
+		}
 		return NumberUtils.createNumber(str);
 	}
+
+	private static boolean isUnsafeLongSuffixOnlyValue(String str) {
+		if (str == null || str.isEmpty()) {
+			return false;
+		}
+		char lastChar = str.charAt(str.length() - 1);
+		if (lastChar != 'l' && lastChar != 'L') {
+			return false;
+		}
+		String numeric = str.substring(0, str.length() - 1);
+		return numeric.isEmpty();
+	}
 	
 	
 	
