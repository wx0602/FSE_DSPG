@@ -0,0 +1,70 @@
+package soj.util;
+
+import java.io.File;
+
+import org.apache.commons.io.FilenameUtils;
+
+public final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    public static String normalize(String filename) {
+        return normalizeInternal(filename, true);
+    }
+
+    public static String normalizeNoEndSeparator(String filename) {
+        return normalizeInternal(filename, false);
+    }
+
+    private static String normalizeInternal(String filename, boolean keepEndSeparator) {
+        if (filename == null) {
+            return null;
+        }
+
+        char separator = File.separatorChar;
+        String sanitized = collapseDuplicateSeparators(filename, separator);
+        return keepEndSeparator
+                ? FilenameUtils.normalize(sanitized, true)
+                : FilenameUtils.normalizeNoEndSeparator(sanitized, true);
+    }
+
+    static String collapseDuplicateSeparators(String filename, char separator) {
+        if (filename == null || filename.isEmpty()) {
+            return filename;
+        }
+
+        char otherSeparator = separator == '/' ? '\\' : '/';
+        String unified = filename.replace(otherSeparator, separator);
+
+        StringBuilder collapsed = new StringBuilder(unified.length());
+        int index = 0;
+        boolean preserveDoubleLeadingSeparator = unified.length() > 1
+                && unified.charAt(0) == separator
+                && unified.charAt(1) == separator;
+
+        if (preserveDoubleLeadingSeparator) {
+            collapsed.append(separator).append(separator);
+            index = 2;
+            while (index < unified.length() && unified.charAt(index) == separator) {
+                index++;
+            }
+        }
+
+        boolean previousWasSeparator = preserveDoubleLeadingSeparator;
+        for (; index < unified.length(); index++) {
+            char current = unified.charAt(index);
+            if (current == separator) {
+                if (!previousWasSeparator) {
+                    collapsed.append(current);
+                }
+                previousWasSeparator = true;
+            }
+            else {
+                collapsed.append(current);
+                previousWasSeparator = false;
+            }
+        }
+
+        return collapsed.toString();
+    }
+}
