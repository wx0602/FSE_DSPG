+	private static boolean isPositiveHexNumber(String str) {
+		return str != null && NumberUtils.isCreatable(str)
+				&& (str.startsWith("+0x") || str.startsWith("+0X") || str.startsWith("+#"));
+	}
+
+	private static String stripLeadingPlus(String str) {
+		return str != null && str.startsWith("+") ? str.substring(1) : str;
+	}
+
+	private static Number createPositiveHexNumber(String str) {
+		String normalized = stripLeadingPlus(str);
+		String hexDigits = normalized.startsWith("#") ? normalized.substring(1) : normalized.substring(2);
+		int firstSigDigit = 0;
+		for (; firstSigDigit < hexDigits.length(); firstSigDigit++) {
+			if (hexDigits.charAt(firstSigDigit) != '0') {
+				break;
+			}
+		}
+		int hexDigitsCount = hexDigits.length() - firstSigDigit;
+		if (hexDigitsCount > 16 || (hexDigitsCount == 16 && hexDigits.charAt(firstSigDigit) > '7')) {
+			return createPositiveHexBigInteger(str);
+		}
+		if (hexDigitsCount > 8 || (hexDigitsCount == 8 && hexDigits.charAt(firstSigDigit) > '7')) {
+			return NumberUtils.createLong(normalized);
+		}
+		return NumberUtils.createInteger(normalized);
+	}
+
+	private static BigInteger createPositiveHexBigInteger(String str) {
+		String normalized = stripLeadingPlus(str);
+		int pos = 0;
+		int radix = 10;
+		if (normalized.startsWith("0x") || normalized.startsWith("0X")) {
+			radix = 16;
+			pos = 2;
+		} else if (normalized.startsWith("#")) {
+			radix = 16;
+			pos = 1;
+		} else if (normalized.startsWith("0") && normalized.length() > 1) {
+			radix = 8;
+			pos = 1;
+		}
+		return new BigInteger(normalized.substring(pos), radix);
+	}
