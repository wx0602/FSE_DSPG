+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+public final class PathUtils
+{
+    private PathUtils() {
+    }
+
+    public static String normalizeSafe(String path) {
+        if (path == null) {
+            return null;
+        }
+
+        String collapsed = collapseDuplicateSeparators(path);
+        return FilenameUtils.normalize(collapsed);
+    }
+
+    public static String normalizeNoEndSeparatorSafe(String path) {
+        if (path == null) {
+            return null;
+        }
+
+        String collapsed = collapseDuplicateSeparators(path);
+        return FilenameUtils.normalizeNoEndSeparator(collapsed);
+    }
+
+    static String collapseDuplicateSeparators(String path) {
+        StringBuilder sb = new StringBuilder(path.length());
+        char previous = 0;
+        for (int i = 0; i < path.length(); i++) {
+            char current = path.charAt(i);
+            boolean slash = current == '/' || current == '\\';
+            boolean prevSlash = previous == '/' || previous == '\\';
+            if (slash && prevSlash) {
+                continue;
+            }
+            sb.append(current);
+            previous = current;
+        }
+        return sb.toString();
+    }
+}
