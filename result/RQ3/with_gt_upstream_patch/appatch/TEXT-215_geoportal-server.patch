+  private static void translateNumericEntitiesSafely(String input, StringWriter out) throws IOException {
+    int index = 0;
+    int length = input.length();
+    while (index < length) {
+      if (input.charAt(index) == '&' && index + 2 < length && input.charAt(index + 1) == '#') {
+        int consumed = translateNumericEntitySafely(input, index, out);
+        if (consumed > 0) {
+          index += consumed;
+          continue;
+        }
+      }
+      out.write(input.charAt(index));
+      index++;
+    }
+  }
+
+  private static int translateNumericEntitySafely(CharSequence input, int index, StringWriter out) throws IOException {
+    int seqEnd = input.length();
+    int start = index + 2;
+    boolean isHex = false;
+    if (start >= seqEnd) {
+      return 0;
+    }
+    char firstChar = input.charAt(start);
+    if (firstChar == 'x' || firstChar == 'X') {
+      isHex = true;
+      start++;
+      if (start == seqEnd) {
+        return 0;
+      }
+    }
+
+    int end = start;
+    while (end < seqEnd) {
+      char ch = input.charAt(end);
+      boolean digit = ch >= '0' && ch <= '9';
+      boolean hexDigit = isHex && ((ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'));
+      if (!digit && !hexDigit) {
+        break;
+      }
+      end++;
+    }
+    if (end == start) {
+      return 0;
+    }
+    boolean semiNext = end < seqEnd && input.charAt(end) == ';';
+    int entityValue = Integer.parseInt(input.subSequence(start, end).toString(), isHex ? 16 : 10);
+    if (entityValue > 0xFFFF) {
+      out.write(Character.toChars(entityValue));
+    } else {
+      out.write(entityValue);
+    }
+    return 2 + (isHex ? 1 : 0) + (end - start) + (semiNext ? 1 : 0);
+  }
