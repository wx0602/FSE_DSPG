+    private static String sanitizeIncludePath(String includeResourcePath)
+    {
+        if (includeResourcePath == null)
+        {
+            return null;
+        }
+
+        String normalized = includeResourcePath.replace('\\', '/');
+        if (normalized.isEmpty())
+        {
+            return normalized;
+        }
+
+        StringBuilder sanitized = new StringBuilder(normalized.length());
+        boolean previousSlash = false;
+        for (int i = 0; i < normalized.length(); i++)
+        {
+            char current = normalized.charAt(i);
+            if (current == '/')
+            {
+                if (!previousSlash || i == 0)
+                {
+                    sanitized.append(current);
+                }
+                previousSlash = true;
+            }
+            else
+            {
+                sanitized.append(current);
+                previousSlash = false;
+            }
+        }
+
+        String candidate = sanitized.toString();
+        if (candidate.contains("/../") || candidate.startsWith("../")
+            || candidate.endsWith("/..") || candidate.contains("/./"))
+        {
+            return null;
+        }
+        return candidate;
+    }
