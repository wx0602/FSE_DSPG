+
+	public static Number createNumber(String value) {
+		String normalized = normalizePositiveHexPrefix(value);
+		if (normalized != value) {
+			if (normalized.startsWith("+0x") || normalized.startsWith("+0X")) {
+				return createPositiveHexNumber(normalized.substring(1));
+			}
+			if (normalized.startsWith("+#")) {
+				return createPositiveHexNumber("0x" + normalized.substring(2));
+			}
+		}
+		return NumberUtils.createNumber(normalized);
+	}
+
+	private static Number createPositiveHexNumber(String value) {
+		BigInteger bigInteger = new BigInteger(value.substring(2), 16);
+		if (bigInteger.bitLength() <= 31) {
+			return Integer.valueOf(bigInteger.intValue());
+		}
+		if (bigInteger.bitLength() <= 63) {
+			return Long.valueOf(bigInteger.longValue());
+		}
+		return bigInteger;
+	}
+
+	private static String normalizePositiveHexPrefix(String value) {
+		if (StringUtils.isBlank(value)) {
+			return value;
+		}
+		if (value.startsWith("+0x") || value.startsWith("+0X") || value.startsWith("+#")) {
+			return value;
+		}
+		return value;
 	}
 
