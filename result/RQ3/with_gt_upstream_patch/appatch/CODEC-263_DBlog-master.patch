+    private static String normalizeBase64(final String value) {
+        if (value == null) {
+            return null;
+        }
+        int end = value.length();
+        while (end > 0 && value.charAt(end - 1) == '=') {
+            end--;
+        }
+        int modulus = end % 4;
+        if (modulus != 2 && modulus != 3) {
+            return value;
+        }
+        int last = end - 1;
+        int decoded = BASE64_ALPHABET.indexOf(value.charAt(last));
+        if (decoded < 0) {
+            return value;
+        }
