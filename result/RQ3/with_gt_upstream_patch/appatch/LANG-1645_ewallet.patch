+	private static boolean isSignedHexNumber(String str) {
+		if (str == null || str.length() < 2) {
+			return false;
+		}
+		for (String prefix : SIGNED_HEX_PREFIXES) {
+			if (str.startsWith(prefix) && str.length() > prefix.length()) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	private static BigInteger parseSignedHexBigInteger(String str) {
+		int sign = str.charAt(0) == '-' ? -1 : 1;
+		String value = str.substring(1);
+		for (String prefix : HEX_PREFIXES) {
+			if (value.startsWith(prefix)) {
+				BigInteger result = new BigInteger(value.substring(prefix.length()), 16);
+				return sign < 0 ? result.negate() : result;
+			}
+		}
+		throw new NumberFormatException(str + " is not a valid number.");
+	}
+
+	private static Number createSignedHexNumber(String str) {
+		BigInteger value = parseSignedHexBigInteger(str);
+		if (value.bitLength() <= 31) {
+			return Integer.valueOf(value.intValue());
+		}
+		if (value.bitLength() <= 63) {
+			return Long.valueOf(value.longValue());
+		}
+		return value;
+	}
 }
