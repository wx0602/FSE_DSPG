+package org.apache.velocity.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Path normalization used by resource loaders.
+ *
+ * Commons IO 2.6 does not remove repeated separators after a path prefix.
+ * Keep the dependency version fixed, but apply the missing final step here.
+ */
+public final class NormalizedPath
+{
+    private NormalizedPath()
+    {
+    }
+
+    public static String normalize(final String path)
+    {
+        final String normalized = FilenameUtils.normalize(path);
+        return collapseSeparators(normalized);
+    }
+
+    public static String normalize(final String path, final boolean unixSeparator)
+    {
+        final String normalized = FilenameUtils.normalize(path, unixSeparator);
+        return collapseSeparators(normalized);
+    }
+
+    private static String collapseSeparators(final String path)
+    {
+        if (path == null || path.length() < 2)
+        {
+            return path;
+        }
+
+        // A leading double separator is a UNC-style prefix and is retained.
+        int start = path.startsWith("//") ? 2 : (path.charAt(0) == '/' ? 1 : 0);
+        StringBuilder result = new StringBuilder(path.length());
+        result.append(path, 0, start);
+        boolean previousSeparator = start > 0 && path.charAt(start - 1) == '/';
+        for (int i = start; i < path.length(); i++)
+        {
+            char character = path.charAt(i);
+            boolean separator = character == '/' || character == '\\';
+            if (!separator || !previousSeparator)
+            {
+                result.append(character);
+            }
+            previousSeparator = separator;
+        }
+        return result.toString();
+    }
+}
