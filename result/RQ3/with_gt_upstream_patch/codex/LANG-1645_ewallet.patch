 	/**
@@ -116,7 +116,21 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
-		return NumberUtils.createNumber(str);
+		return NumberUtils.createNumber(normalizePositiveHex(str));
+	}
+
+	/**
+	 * Commons Lang versions used by this project recognize a leading '+' for
+	 * hexadecimal numbers in some NumberUtils methods, but not in
+	 * createBigInteger/createNumber. Normalize that one unsupported spelling at
+	 * the facade boundary; all other input is passed through unchanged.
+	 */
+	private static String normalizePositiveHex(String str) {
+		if (str != null && str.length() > 2 && str.charAt(0) == '+'
+				&& (str.startsWith("+0x") || str.startsWith("+0X") || str.startsWith("+#"))) {
+			return str.substring(1);
+		}
+		return str;
 	}
 	
 	
