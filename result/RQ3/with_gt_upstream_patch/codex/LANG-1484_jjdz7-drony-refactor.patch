+    private static boolean isParsable(String str) {
+        if (NumberUtils.isParsable(str)) {
+            return true;
+        }
+        return str != null
+                && str.length() > 1
+                && str.charAt(str.length() - 1) == '.'
+                && NumberUtils.isParsable(str.substring(0, str.length() - 1));
+    }
+
+    private static int createInteger(String str) {
+        return NumberUtils.createInteger(str.endsWith(".")
+                ? str.substring(0, str.length() - 1) : str);
+    }
