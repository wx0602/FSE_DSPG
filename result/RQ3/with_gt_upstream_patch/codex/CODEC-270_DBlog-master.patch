+    /**
+     * Commons Codec 1.13 does not correctly mask the unused bits in the last
+     * Base64 character.  Check them before handing the value to that version
+     * of the decoder (the dependency is intentionally not upgraded here).
+     */
+    private static void validateBase64TrailingBits(final String value) {
+        int end = value.length();
+        while (end > 0 && Character.isWhitespace(value.charAt(end - 1))) {
+            end--;
+        }
+        while (end > 0 && value.charAt(end - 1) == '=') {
+            end--;
+        }
+        int significantLength = 0;
+        int last = -1;
+        for (int i = 0; i < end; i++) {
+            if (!Character.isWhitespace(value.charAt(i))) {
+                significantLength++;
+                last = value.charAt(i);
+            }
+        }
+        final int bitsToDrop;
+        if ((significantLength & 3) == 2) {
+            bitsToDrop = 4;
+        } else if ((significantLength & 3) == 3) {
+            bitsToDrop = 2;
+        } else {
+            return;
+        }
+        final int alphabetValue = base64Value(last);
+        if ((alphabetValue & ((1 << bitsToDrop) - 1)) != 0) {
+            throw new IllegalArgumentException("Base64 input has non-zero trailing bits");
+        }
+    }
+
+    private static int base64Value(final int character) {
+        if (character >= 'A' && character <= 'Z') return character - 'A';
+        if (character >= 'a' && character <= 'z') return character - 'a' + 26;
+        if (character >= '0' && character <= '9') return character - '0' + 52;
+        if (character == '+') return 62;
+        if (character == '/') return 63;
+        return 0;
+    }
