@@ -0,0 +1,50 @@
+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Filename operations which protect callers from the duplicate-separator
+ * handling bug in the version of Commons IO used by this project.
+ */
+public final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    public static String normalize(String filename) {
+        return FilenameUtils.normalize(collapseSeparators(filename));
+    }
+
+    public static String normalizeNoEndSeparator(String filename) {
+        return FilenameUtils.normalizeNoEndSeparator(collapseSeparators(filename));
+    }
+
+    private static String collapseSeparators(String filename) {
+        if (filename == null || filename.length() < 2) {
+            return filename;
+        }
+
+        StringBuilder result = new StringBuilder(filename.length());
+        int index = 0;
+        boolean previousSeparator = false;
+        // Retain the UNC/prefix double separator, but never retain a third.
+        if (isSeparator(filename.charAt(0)) && isSeparator(filename.charAt(1))) {
+            result.append(filename.charAt(0)).append(filename.charAt(1));
+            index = 2;
+            previousSeparator = true;
+        }
+        for (; index < filename.length(); index++) {
+            char current = filename.charAt(index);
+            boolean separator = isSeparator(current);
+            if (separator && previousSeparator) {
+                continue;
+            }
+            result.append(current);
+            previousSeparator = separator;
+        }
+        return result.toString();
+    }
+
+    private static boolean isSeparator(char value) {
+        return value == '/' || value == '\\';
+    }
+}
