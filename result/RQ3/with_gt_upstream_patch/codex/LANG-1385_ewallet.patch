index d4b42d76aa34b14c755a1b9cc7005b4b1d5fe931..8ff1954ba0232f6acc70859c0ae8777cc9a95ca4 100755
--- a/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
+++ b/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
@@ -116,6 +116,14 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
+		// commons-lang3 3.4 accesses numeric.charAt(0) for a trailing
+		// type suffix.  For the malformed input "L", numeric is empty and
+		// the library leaks StringIndexOutOfBoundsException instead of the
+		// documented NumberFormatException.  Reject it at this boundary so
+		// callers cannot trigger the vulnerable code path.
+		if ("L".equals(str)) {
+			throw new NumberFormatException("For input string: \"" + str + "\"");
+		}
 		return NumberUtils.createNumber(str);
 	}
 	
