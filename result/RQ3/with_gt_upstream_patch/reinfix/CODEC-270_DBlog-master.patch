+public static String decrypt(String encryptPassword, String salt) throws Exception {
+    if (encryptPassword == null || encryptPassword.trim().isEmpty()) {
+        throw new IllegalArgumentException("Encrypted password must not be null or empty");
+    }
+    String cipherText = encryptPassword.trim();
+    int length = cipherText.length();
+    if ((length & 3) != 0) {
+        throw new IllegalArgumentException("Encrypted password is not valid Base64");
+    }
+
+    int padding = 0;
+    if (length > 0 && cipherText.charAt(length - 1) == '=') {
+        padding++;
+        if (length > 1 && cipherText.charAt(length - 2) == '=') {
+            padding++;
+        }
+    }
+
+    for (int i = 0; i < length; i++) {
+        char ch = cipherText.charAt(i);
+        boolean isPadding = ch == '=';
+        boolean isBase64Char = (ch >= 'A' && ch <= 'Z')
+                || (ch >= 'a' && ch <= 'z')
+                || (ch >= '0' && ch <= '9')
+                || ch == '+'
+                || ch == '/';
+        if (!isPadding && !isBase64Char) {
+            throw new IllegalArgumentException("Encrypted password contains invalid Base64 characters");
+        }
+        if (isPadding && i < length - padding) {
+            throw new IllegalArgumentException("Encrypted password has invalid Base64 padding");
+        }
+    }
+
+    if (padding > 2) {
+        throw new IllegalArgumentException("Encrypted password has invalid Base64 padding");
+    }
+
+    if (padding > 0) {
+        char lastDataChar = cipherText.charAt(length - padding - 1);
+        int value;
+        if (lastDataChar >= 'A' && lastDataChar <= 'Z') {
+            value = lastDataChar - 'A';
+        } else if (lastDataChar >= 'a' && lastDataChar <= 'z') {
+            value = lastDataChar - 'a' + 26;
+        } else if (lastDataChar >= '0' && lastDataChar <= '9') {
+            value = lastDataChar - '0' + 52;
+        } else if (lastDataChar == '+') {
+            value = 62;
+        } else if (lastDataChar == '/') {
+            value = 63;
+        } else {
+            throw new IllegalArgumentException("Encrypted password contains invalid Base64 characters");
+        }
+
+        if (padding == 2) {
+            if ((value & 0x0F) != 0) {
+                throw new IllegalArgumentException("Encrypted password has non-zero discarded Base64 trailing bits");
+            }
+        } else if (padding == 1) {
+            if ((value & 0x03) != 0) {
+                throw new IllegalArgumentException("Encrypted password has non-zero discarded Base64 trailing bits");
+            }
+        }
+    }
+
+    return AesUtil.decrypt(salt, cipherText);
+}
