+public String decrypt(String cipherText) {
+    try {
+        if (cipherText == null) {
+            throw new IllegalArgumentException("cipherText must not be null");
+        }
+        if (!cipherText.matches("^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$")) {
+            throw new IllegalArgumentException("cipherText is not valid Base64");
+        }
+
+        int padding = 0;
+        int length = cipherText.length();
+        if (length > 0 && cipherText.charAt(length - 1) == '=') {
+            padding++;
+            if (length > 1 && cipherText.charAt(length - 2) == '=') {
+                padding++;
+            }
+        }
+        if (padding > 0) {
+            int unpaddedLength = length - padding;
+            int tailLength = unpaddedLength % 4;
+            if (tailLength != 2 && tailLength != 3) {
+                throw new IllegalArgumentException("cipherText has invalid Base64 padding");
+            }
+            String alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+            int lastValue = alphabet.indexOf(cipherText.charAt(unpaddedLength - 1));
+            if (lastValue < 0) {
+                throw new IllegalArgumentException("cipherText contains invalid Base64 characters");
+            }
+            if ((padding == 2 && (lastValue & 0x0F) != 0) || (padding == 1 && (lastValue & 0x03) != 0)) {
+                throw new IllegalArgumentException("cipherText has invalid trailing Base64 bits");
+            }
+        }
+
+        byte[] decrypted = crypto.decrypt(Utils.base64(cipherText));
+        return new String(decrypted, "UTF-8");
+    } catch (UnsupportedEncodingException e) {
+        throw fail(e);
+    }
+}
