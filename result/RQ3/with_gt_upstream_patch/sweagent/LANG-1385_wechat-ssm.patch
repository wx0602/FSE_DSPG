@@ -0,0 +1,93 @@
+package org.apache.commons.lang3.math;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+
+public final class NumberUtils {
+
+private NumberUtils() {
+}
+
+public static Number createNumber(String value) {
+if (value == null) {
+throw new NumberFormatException("null");
+}
+
+String numeric = value.trim();
+if (numeric.isEmpty()) {
+throw new NumberFormatException("Empty string is not a valid number: " + value);
+}
+
+char lastChar = numeric.charAt(numeric.length() - 1);
+if (lastChar == 'l' || lastChar == 'L') {
+String body = numeric.substring(0, numeric.length() - 1);
+if (body.isEmpty()) {
+throw new NumberFormatException("Invalid number: " + value);
+}
+return parseIntegerNumber(body, value);
+}
+
+if (lastChar == 'f' || lastChar == 'F') {
+return parseFloatingNumber(numeric.substring(0, numeric.length() - 1), value, true);
+}
+
+if (lastChar == 'd' || lastChar == 'D') {
+return parseFloatingNumber(numeric.substring(0, numeric.length() - 1), value, false);
+}
+
+if (looksLikeDecimal(numeric)) {
+try {
+return new BigDecimal(numeric);
+} catch (NumberFormatException ex) {
+throw invalidNumber(value, ex);
+}
+}
+
+return parseIntegerNumber(numeric, value);
+}
+
+public static float toFloat(String value) {
+return toFloat(value, 0.0f);
+}
+
+public static float toFloat(String value, float defaultValue) {
+if (value == null) {
+return defaultValue;
+}
+try {
+return Float.parseFloat(value.trim());
+} catch (NumberFormatException ex) {
+return defaultValue;
+}
+}
+
+private static Number parseIntegerNumber(String numeric, String originalValue) {
+try {
+return Long.valueOf(numeric);
+} catch (NumberFormatException ex) {
+try {
+return new BigInteger(numeric);
+} catch (NumberFormatException bigIntegerEx) {
+throw invalidNumber(originalValue, bigIntegerEx);
+}
+}
+}
+
+private static Number parseFloatingNumber(String numeric, String originalValue, boolean floatType) {
+try {
+return floatType ? Float.valueOf(numeric) : Double.valueOf(numeric);
+} catch (NumberFormatException ex) {
+throw invalidNumber(originalValue, ex);
+}
+}
+
+private static boolean looksLikeDecimal(String value) {
+return value.indexOf('.') >= 0 || value.indexOf('e') >= 0 || value.indexOf('E') >= 0;
+}
+
+private static NumberFormatException invalidNumber(String value, Exception cause) {
+NumberFormatException numberFormatException = new NumberFormatException("Invalid number: " + value);
+numberFormatException.initCause(cause);
+return numberFormatException;
+}
+}
