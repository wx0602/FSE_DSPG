+package burp.utils;
+
+import org.apache.commons.codec.binary.Base64;
+
+public final class SafeBase64 {
+    private SafeBase64() {
+    }
+
+    public static byte[] decodeBase64(String str) {
+        if (str == null) {
+            return null;
+        }
+
+        String normalized = str.replaceAll("\\s", "");
+        if (hasInvalidTrailingBits(normalized)) {
+            throw new IllegalArgumentException("Invalid base64 input: non-zero trailing bits");
+        }
+
+        return Base64.decodeBase64(str);
+    }
+
+    private static boolean hasInvalidTrailingBits(String normalized) {
+        int padIndex = normalized.indexOf('=');
+        if (padIndex < 0) {
+            return false;
+        }
+
+        String payload = normalized.substring(0, padIndex);
+        int padCount = normalized.length() - padIndex;
+        if (padCount > 2) {
+            return true;
+        }
+
+        int dataChars = payload.length();
+        if (dataChars == 0) {
+            return true;
+        }
+
+        int bitCount;
+        int mask;
+        if (padCount == 2) {
+            if ((dataChars % 4) != 2) {
+                return true;
+            }
+            bitCount = 4;
+            mask = (1 << bitCount) - 1;
+        } else {
+            if ((dataChars % 4) != 3) {
+                return true;
+            }
+            bitCount = 2;
+            mask = (1 << bitCount) - 1;
+        }
+
+        int last = decodeBase64Char(payload.charAt(payload.length() - 1));
+        return last < 0 || (last & mask) != 0;
+    }
+
+    private static int decodeBase64Char(char c) {
+        if (c >= 'A' && c <= 'Z') {
+            return c - 'A';
+        }
+        if (c >= 'a' && c <= 'z') {
+            return c - 'a' + 26;
+        }
+        if (c >= '0' && c <= '9') {
+            return c - '0' + 52;
+        }
+        if (c == '+') {
+            return 62;
+        }
+        if (c == '/') {
+            return 63;
+        }
+        return -1;
+    }
+}
