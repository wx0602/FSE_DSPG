+    private static byte[] safeDecodeBase64(final String value) {
+        if (value == null) {
+            return new byte[0];
+        }
+
+        String normalized = value.trim();
+        if (normalized.isEmpty()) {
+            return new byte[0];
+        }
+
+        try {
+            return Base64.decodeBase64(normalized);
+        } catch (IllegalArgumentException ex) {
+            return java.util.Base64.getDecoder().decode(normalized);
+        }
+    }
