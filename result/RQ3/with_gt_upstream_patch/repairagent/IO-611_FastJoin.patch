+    private String normalizeSafely(String filename) {
+        String normalized = normalize(filename);
+        if (normalized == null || normalized.length() < 2) {
+            return normalized;
+        }
+
+        char separator = normalized.indexOf('\\') >= 0 ? '\\' : '/';
+        int prefixLength = 0;
+        if (normalized.length() >= 2 && Character.isLetter(normalized.charAt(0))
+                && normalized.charAt(1) == ':') {
+            prefixLength = 2;
+        }
+        else if (normalized.length() >= 2
+                && normalized.charAt(0) == separator
+                && normalized.charAt(1) == separator) {
+            prefixLength = 2;
+        }
+        else if (normalized.charAt(0) == separator) {
+            prefixLength = 1;
+        }
+
+        StringBuilder sanitized = new StringBuilder(normalized.length());
+        for (int i = 0; i < normalized.length(); i++) {
+            char current = normalized.charAt(i);
+            if (current == separator && sanitized.length() > 0
+                    && sanitized.charAt(sanitized.length() - 1) == separator
+                    && i > (prefixLength == 0 ? 0 : prefixLength - 1)) {
+                continue;
+            }
+            sanitized.append(current);
+        }
