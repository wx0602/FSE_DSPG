+public static BigInteger createBigInteger(String str)  {
+	if (str == null) {
+		return NumberUtils.createBigInteger(null);
+	}
+	String value = str;
+	if (value.startsWith("+")) {
+		value = value.substring(1);
+	}
+	return NumberUtils.createBigInteger(value);
+}	
