@@ -0,0 +1,43 @@
+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Path normalization kept local so the application does not rely on the
+ * broken duplicate-separator handling in the pinned Commons IO release.
+ */
+final class FilePathUtils {
+    private FilePathUtils() {
+    }
+
+    static String normalize(String filename) {
+        String normalized = FilenameUtils.normalize(filename);
+        if (normalized == null || normalized.length() < 2) {
+            return normalized;
+        }
+
+        int start = 0;
+        // Keep the leading UNC marker, but sanitize separators after it.
+        if (normalized.charAt(0) == '/') {
+            start = normalized.charAt(1) == '/' ? 2 : 1;
+        }
+
+        StringBuilder result = new StringBuilder(normalized.length());
+        result.append(normalized, 0, start);
+        boolean previousSeparator = false;
+        for (int i = start; i < normalized.length(); i++) {
+            char current = normalized.charAt(i);
+            if (current == '/') {
+                if (!previousSeparator) {
+                    result.append(current);
+                }
+                previousSeparator = true;
+            }
+            else {
+                result.append(current);
+                previousSeparator = false;
+            }
+        }
+        return result.toString();
+    }
+}
