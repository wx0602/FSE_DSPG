diff --git a/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java b/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
index d4b42d76aa34b14c755a1b9cc7005b4b1d5fe931..6c795f800d873345fd56085fd97a8034c18cde43 100755
--- a/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
+++ b/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
@@ -116,6 +116,17 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
+		// Commons Lang 3.7 indexes the first character while parsing a type
+		// suffix.  A suffix by itself (for example, "L") therefore leaks an
+		// StringIndexOutOfBoundsException instead of reporting bad input.
+		// Reject this malformed form at the application boundary and retain the
+		// documented NumberFormatException contract.
+		if (str != null && str.length() == 1
+				&& (str.charAt(0) == 'L' || str.charAt(0) == 'l'
+						|| str.charAt(0) == 'F' || str.charAt(0) == 'f'
+						|| str.charAt(0) == 'D' || str.charAt(0) == 'd')) {
+			throw new NumberFormatException("Invalid number: " + str);
+		}
 		return NumberUtils.createNumber(str);
 	}
 	
