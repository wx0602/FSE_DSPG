+package org.apache.velocity.runtime.resource.loader;
+
+/** Utilities for making resource paths safe for the pinned Commons IO version. */
+final class ResourcePathUtils
+{
+    private ResourcePathUtils()
+    {
+    }
+
+    /**
+     * Commons IO 2.6 does not collapse repeated separators after a path
+     * prefix.  Collapse them here, retaining the two separators of a UNC
+     * prefix, before delegating to FilenameUtils.
+     */
+    static String collapseSeparators(String path)
+    {
+        StringBuilder result = new StringBuilder(path.length());
+        int index = 0;
+        int prefixSeparators = 0;
+        while (index < path.length() && isSeparator(path.charAt(index)))
+        {
+            prefixSeparators++;
+            index++;
+        }
+        if (prefixSeparators > 0)
+        {
+            result.append('/');
+            if (prefixSeparators > 1)
+            {
+                result.append('/');
+            }
+        }
+        boolean separator = prefixSeparators > 0;
+        for (; index < path.length(); index++)
+        {
+            char character = path.charAt(index);
+            if (isSeparator(character))
+            {
+                if (!separator)
+                {
+                    result.append('/');
+                    separator = true;
+                }
+            }
+            else
+            {
+                result.append(character);
+                separator = false;
+            }
+        }
+        return result.toString();
+    }
+
+    private static boolean isSeparator(char character)
+    {
+        return character == '/' || character == '\\';
+    }
+}
