+
+	/**
+	 * Commons Lang versions used by this application accept a leading '+' for
+	 * decimal values, but not for hexadecimal values.  Java's number syntax
+	 * permits that sign, so remove it before delegating only for the affected
+	 * hexadecimal form.  Do not trim or otherwise rewrite the input: the
+	 * delegate's validation and exception behaviour must remain unchanged.
+	 */
+	private static String normalizePositiveHexPrefix(String str) {
+		if (str != null && str.length() > 2 && str.charAt(0) == '+'
+				&& str.charAt(1) == '0'
+				&& (str.charAt(2) == 'x' || str.charAt(2) == 'X')) {
+			return str.substring(1);
+		}
+		return str;
 	}
 	
 	
