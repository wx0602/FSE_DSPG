+	public static Number createNumber(String value) {
+		if (StringUtils.isBlank(value)) {
+			return NumberUtils.createNumber(value);
+		}
+		if (value.startsWith("+0x") || value.startsWith("+0X") || value.startsWith("+#")) {
+			try {
+				return Integer.decode(value);
+			} catch (NumberFormatException ex) {
+				try {
+					return Long.decode(value);
+				} catch (NumberFormatException ignored) {
+					return createBigInteger(value);
+				}
+			}
+		}
+		return NumberUtils.createNumber(value);
+	}
+
+	public static BigInteger createBigInteger(String value) {
+		if (value == null) {
+			return null;
+		}
+		int pos = 0;
+		int radix = 10;
+		boolean negate = false;
+		if (value.startsWith("-") || value.startsWith("+")) {
+			negate = value.startsWith("-");
+			pos = 1;
+		}
+		if (value.startsWith("0x", pos) || value.startsWith("0X", pos)) {
+			radix = 16;
+			pos += 2;
+		} else if (value.startsWith("#", pos)) {
+			radix = 16;
+			pos++;
+		} else if (value.startsWith("0", pos) && value.length() > pos + 1) {
+			radix = 8;
+			pos++;
+		}
+		BigInteger number = new BigInteger(value.substring(pos), radix);
+		return negate ? number.negate() : number;
+	}
