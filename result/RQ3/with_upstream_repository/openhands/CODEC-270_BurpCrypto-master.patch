+    private static void validateStrictBase64(String str) {
+        String normalized = normalizeBase64(str);
+        if (normalized.isEmpty()) {
+            return;
+        }
+        if (!BASE64_ALLOWED_PATTERN.matcher(normalized).matches()) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        int paddingIndex = normalized.indexOf('=');
+        String dataPart = paddingIndex >= 0 ? normalized.substring(0, paddingIndex) : normalized;
+        String paddingPart = paddingIndex >= 0 ? normalized.substring(paddingIndex) : "";
+        if (paddingPart.indexOf('=') == -1 && paddingIndex >= 0) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+        for (int i = 0; i < paddingPart.length(); i++) {
+            if (paddingPart.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+        int remainder = dataPart.length() % 4;
+        if (remainder == 1) {
+            throw new IllegalArgumentException("Invalid Base64 length");
+        }
+        if ((paddingPart.length() == 1 && remainder != 3) || (paddingPart.length() == 2 && remainder != 2) || paddingPart.length() > 2) {
