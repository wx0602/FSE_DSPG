+        }
+        if (paddingPart.isEmpty() && remainder != 0) {
+            throw new IllegalArgumentException("Missing Base64 padding");
+        }
+        if (!dataPart.isEmpty()) {
+            char lastChar = dataPart.charAt(dataPart.length() - 1);
+            int lastValue = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".indexOf(lastChar);
+            if (lastValue < 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+            if (paddingPart.length() == 2 && (lastValue & 0x0F) != 0) {
+                throw new IllegalArgumentException("Invalid trailing Base64 bits");
+            }
+            if (paddingPart.length() == 1 && (lastValue & 0x03) != 0) {
+                throw new IllegalArgumentException("Invalid trailing Base64 bits");
+            }
+        }
+    }
