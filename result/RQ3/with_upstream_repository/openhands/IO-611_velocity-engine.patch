+    private String normalizeTemplateName(String templateName)
+    {
+        String normalizedSeparators = templateName.replace('\\', '/');
+        while (normalizedSeparators.startsWith("//"))
+        {
+            normalizedSeparators = normalizedSeparators.substring(1);
+        }
+        while (normalizedSeparators.startsWith("/"))
+        {
+            normalizedSeparators = normalizedSeparators.substring(1);
+        }
+
+        try
+        {
+            Path normalizedPath = Paths.get(normalizedSeparators).normalize();
+            if (normalizedPath.isAbsolute())
+            {
+                return null;
+            }
+
+            String normalized = normalizedPath.toString().replace(File.separatorChar, '/');
+            if (normalized.length() == 0 || ".".equals(normalized))
+            {
+                return null;
+            }
+
+            for (Path segment : normalizedPath)
+            {
+                if ("..".equals(segment.toString()))
+                {
+                    return null;
+                }
+            }
+
+            return normalized;
+        }
+        catch (InvalidPathException e)
+        {
+            return null;
+        }
+    }
