+private static String safeNormalize(String filename) {
+    String normalized = normalize(filename);
+    if (normalized == null) {
+        return null;
     }
 
+    boolean isUncPath = normalized.startsWith("//") || normalized.startsWith("\\\\");
+    String prefix = "";
+    String remainder = normalized;
+
+    if (isUncPath) {
+        prefix = normalized.substring(0, 2);
