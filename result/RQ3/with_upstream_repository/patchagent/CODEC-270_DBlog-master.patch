+    private static boolean isStrictBase64(String value) {
+        if (value == null || value.isEmpty() || value.length() % 4 != 0) {
+            return false;
+        }
+        int padding = 0;
+        for (int i = 0; i < value.length(); i++) {
+            char ch = value.charAt(i);
+            if (ch == '=') {
+                if (i < value.length() - 2) {
+                    return false;
+                }
+                padding++;
+            } else {
+                if (padding > 0 || !isBase64Char(ch)) {
+                    return false;
+                }
+            }
+        }
+        return padding < 3;
+    }
+
+    private static boolean isBase64Char(char ch) {
+        return ch >= 'A' && ch <= 'Z'
+            || ch >= 'a' && ch <= 'z'
+            || ch >= '0' && ch <= '9'
+            || ch == '+'
+            || ch == '/';
+    }
