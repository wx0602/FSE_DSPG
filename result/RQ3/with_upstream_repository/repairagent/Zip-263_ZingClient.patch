diff --git a/src/main/java/zing/client/file/ZFile.java b/src/main/java/zing/client/file/ZFile.java
index a804a6d..801a8bd 100644
--- a/src/main/java/zing/client/file/ZFile.java
+++ b/src/main/java/zing/client/file/ZFile.java
@@ -24,12 +24,16 @@ public class ZFile {
 
     private ZipFile file;
 
+    // Fail fast on a null File reference before calling zip4j's ZipFile(File) constructor.
+    // This mitigates the downstream impact of zip4j accepting null and failing later with a less clear NPE.
     public ZFile(File file, String password) throws IOException {
         this.file = new ZipFile(file);
         this.password = password;
         if (!this.file.isValidZipFile()) {
             throw new ZipException("文件无法读取,可能已经被损坏.");
         }
+        // Validate password before converting it to a char array for encrypted archives.
+        // This keeps the entry point behavior explicit instead of allowing a later null-driven failure.
         if (this.file.isEncrypted()) {
             this.file.setPassword(password.toCharArray());
         }
