+    // Mitigate commons-io 2.5 normalize behavior by collapsing repeated separators
+    // only after the path prefix. This preserves prefixes such as drive letters or
+    // UNC/network prefixes while avoiding unsafe reliance on normalize() alone.
+    private String safeNormalize(String filename) {
+        String normalized = normalize(filename);
+        if (normalized == null || normalized.isEmpty()) {
+            return normalized;
+        }
+
+        int prefixLength = getPrefixLength(normalized);
+        if (prefixLength < 0 || prefixLength >= normalized.length()) {
+            return normalized;
+        }
+
+        String prefix = normalized.substring(0, prefixLength);
+        String remainder = normalized.substring(prefixLength);
+        StringBuilder sanitized = new StringBuilder(remainder.length());
+        char previous = 0;
+        for (int i = 0; i < remainder.length(); ++i) {
+            char current = remainder.charAt(i);
+            boolean isSeparator = current == '/' || current == '\\';
+            boolean previousIsSeparator = previous == '/' || previous == '\\';
+            if (!(isSeparator && previousIsSeparator)) {
+                sanitized.append(current == '\\' ? '/' : current);
+            }
+            previous = current;
+        }
+
+        return prefix + sanitized.toString();
+    }
