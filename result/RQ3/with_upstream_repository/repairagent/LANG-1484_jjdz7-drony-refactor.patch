+public class IoTools {
+
+    private static final Scanner sc = new Scanner(in).useLocale(Locale.US);
+    // Accept numeric strings that Java parses as valid numbers, including forms like "100.",
+    // and convert them safely to integral menu/domain values only when they are finite whole numbers in range.
+    private static boolean isPositiveWholeNumberWithinRange(String token, long minInclusive, long maxInclusive) {
+        try {
+            double parsed = Double.parseDouble(token);
+            if (!Double.isFinite(parsed) || parsed != Math.rint(parsed)) {
+                return false;
+            }
+            long wholeNumber = (long) parsed;
+            return wholeNumber >= minInclusive && wholeNumber <= maxInclusive;
+        } catch (NumberFormatException exception) {
+            return false;
+        }
+    }
+    
+    // Parse integral user input through Double.parseDouble first to mitigate dependency-style
+    // parsability mismatches for valid trailing-dot numbers while keeping the public API integral.
+    private static short getValidatedShortToken() {
+        String token = sc.nextLine().trim();
+        while (!isPositiveWholeNumberWithinRange(token, Short.MIN_VALUE, Short.MAX_VALUE)) {
+            out.println(token + ": nie jest liczbą z zakresu 1 do 32767. Spróbuj ponownie:");
+            token = sc.nextLine().trim();
+        }
+        return (short) Double.parseDouble(token);
+    }
+    
+    // Parse integral user input through Double.parseDouble first to mitigate dependency-style
+    // parsability mismatches for valid trailing-dot numbers while keeping the public API integral.
+    private static byte getValidatedByteToken() {
+        String token = sc.nextLine().trim();
+        while (!isPositiveWholeNumberWithinRange(token, Byte.MIN_VALUE, Byte.MAX_VALUE)) {
+            out.println(token + ": nie jest liczbą z zakresu 1 do 127. Spróbuj ponownie:");
+            token = sc.nextLine().trim();
+        }
+        return (byte) Double.parseDouble(token);
+    }
+    
+    // Parse integral user input through Double.parseDouble first to mitigate dependency-style
+    // parsability mismatches for valid trailing-dot numbers while keeping the public API integral.
+    private static int getValidatedIntToken() {
+        String token = sc.nextLine().trim();
+        while (!isPositiveWholeNumberWithinRange(token, Integer.MIN_VALUE, Integer.MAX_VALUE)) {
+            out.println(token + ": nie jest liczbą. Spróbuj ponownie:");
+            token = sc.nextLine().trim();
+        }
+        return (int) Double.parseDouble(token);
+    }
