+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+        if (str.endsWith("==")) {
+            int val = decodeBase64Alphabet(str.charAt(str.length() - 3));
+            if ((val & 0x0F) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+        } else if (str.endsWith("=")) {
+            int val = decodeBase64Alphabet(str.charAt(str.length() - 2));
+            if ((val & 0x03) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+        }
+    }
+
+    private static int decodeBase64Alphabet(char ch) {
+        if (ch >= 'A' && ch <= 'Z') {
+            return ch - 'A';
+        }
+        if (ch >= 'a' && ch <= 'z') {
+            return ch - 'a' + 26;
+        }
+        if (ch >= '0' && ch <= '9') {
+            return ch - '0' + 52;
+        }
+        if (ch == '+') {
+            return 62;
+        }
+        if (ch == '/') {
+            return 63;
+        }
+        throw new IllegalArgumentException("Invalid Base64 character");
+    }
