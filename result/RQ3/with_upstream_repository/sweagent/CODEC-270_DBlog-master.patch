+package com.zyd.blog.util;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Base64;
+
+/**
+ * Strict Base64 helper used to avoid accepting malformed payloads that older commons-codec versions may decode.
+ */
+public final class SafeBase64Util {
+
+    private static final int[] DECODE_TABLE = new int[256];
+
+    static {
+        Arrays.fill(DECODE_TABLE, -1);
+        for (int i = 'A'; i <= 'Z'; i++) {
+            DECODE_TABLE[i] = i - 'A';
+        }
+        for (int i = 'a'; i <= 'z'; i++) {
+            DECODE_TABLE[i] = i - 'a' + 26;
+        }
+        for (int i = '0'; i <= '9'; i++) {
+            DECODE_TABLE[i] = i - '0' + 52;
+        }
+        DECODE_TABLE['+'] = 62;
+        DECODE_TABLE['/'] = 63;
+    }
+
+    private SafeBase64Util() {
+    }
+
+    public static byte[] decodeStrict(String value) {
+        if (value == null || value.isEmpty()) {
+            return new byte[0];
+        }
+        validateTrailingBits(value);
+        try {
+            return Base64.getDecoder().decode(value.getBytes(StandardCharsets.UTF_8));
+        } catch (IllegalArgumentException ex) {
+            throw new IllegalArgumentException("Invalid Base64 input", ex);
+        }
+    }
+
+    private static void validateTrailingBits(String value) {
+        int usefulLength = 0;
+        int padding = 0;
+        for (int i = 0; i < value.length(); i++) {
+            char ch = value.charAt(i);
+            if (Character.isWhitespace(ch)) {
+                continue;
+            }
+            usefulLength++;
+            if (ch == '=') {
+                padding++;
+            }
+        }
+        if (padding == 0 || usefulLength == 0) {
+            return;
+        }
+
+        int modulus = usefulLength % 4;
+        if (modulus != 0) {
+            return;
+        }
+
+        int bitsToDrop;
+        if (padding == 2) {
+            bitsToDrop = 4;
+        } else if (padding == 1) {
+            bitsToDrop = 2;
+        } else {
+            return;
+        }
+
+        int lastData = -1;
+        for (int i = value.length() - 1; i >= 0; i--) {
+            char ch = value.charAt(i);
+            if (Character.isWhitespace(ch) || ch == '=') {
+                continue;
+            }
+            if (ch >= DECODE_TABLE.length || DECODE_TABLE[ch] < 0) {
+                throw new IllegalArgumentException("Invalid Base64 input");
+            }
+            lastData = DECODE_TABLE[ch];
+            break;
+        }
+        if (lastData < 0) {
+            return;
+        }
+
+        int mask = (1 << bitsToDrop) - 1;
+        if ((lastData & mask) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+    }
+}
