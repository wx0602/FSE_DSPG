+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Normalizes resource paths while mitigating Commons IO's handling of
+ * repeated separators immediately following a UNC-style prefix.
+ */
+final class ResourcePathNormalizer
+{
+    private ResourcePathNormalizer()
+    {
+    }
+
+    static String normalize(String path)
+    {
+        return normalize(path, false);
+    }
+
+    static String normalize(String path, boolean unixSeparator)
+    {
+        if (path == null)
+        {
+            return null;
+        }
+
+        String normalized = unixSeparator ? FilenameUtils.normalize(path, true) : FilenameUtils.normalize(path);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        if (!path.startsWith("//") && !path.startsWith("\\\\"))
+        {
+            return normalized;
+        }
+
+        final char separator = unixSeparator ? '/' : java.io.File.separatorChar;
+        final char otherSeparator = separator == '/' ? '\\' : '/';
+        String candidate = normalized.replace(otherSeparator, separator);
+        int prefixLength = FilenameUtils.getPrefixLength(candidate);
+        if (prefixLength <= 0 || candidate.length() <= prefixLength)
+        {
+            return candidate;
+        }
+
+        String prefix = candidate.substring(0, prefixLength);
+        String remainder = candidate.substring(prefixLength);
+        while (remainder.startsWith(String.valueOf(separator)))
+        {
+            remainder = remainder.substring(1);
+        }
+        return prefix + remainder;
+    }
+}
