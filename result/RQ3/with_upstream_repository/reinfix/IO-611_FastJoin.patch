+public FileReader(String filename, String splitPunc) throws Exception {
+        String normalized = FilenameUtils.normalize(filename, true);
+        if (normalized == null) {
+            throw new IllegalArgumentException("Invalid file path: " + filename);
+        }
+
+        int prefixLength = FilenameUtils.getPrefixLength(normalized);
+        if (prefixLength < 0) {
+            throw new IllegalArgumentException("Invalid file path: " + filename);
+        }
+
+        String suffix = normalized.substring(prefixLength);
+        if (suffix.contains("//") || suffix.contains("\\\\")) {
+            throw new IllegalArgumentException("Suspicious normalized file path: " + filename);
+        }
+
+        _filename = normalized;
+        System.out.println(_filename);
+        _reader = getReader();
+
+        String splitePattern;
+        if (splitPunc == null || splitPunc.trim().isEmpty()) {
+            splitePattern = DEFAULT_SPLIT_PATTERN;
+        }
+        else {
+            splitePattern = splitPunc.trim() + "\\s+";
+        }
+        _splitter = Splitter.on(Pattern.compile(splitePattern)).trimResults();
+    }
