+    private String sanitizeNormalizedPath(String path) {
+        if (path == null) {
+            return null;
+        }
+
+        String normalized = normalizeNoEndSeparator(path);
+        if (normalized == null) {
+            throw new IllegalStateException("Invalid output directory: " + path);
+        }
+
+        if (normalized.isEmpty()) {
+            return ".";
+        }
+
+        final char sep = File.separatorChar;
+        final char altSep = sep == '/' ? '\\' : '/';
+
+        int prefixLen = 0;
+        if (normalized.length() >= 2 && normalized.charAt(0) == sep
+                && normalized.charAt(1) == sep) {
+            prefixLen = 2;
+        }
+        else if (normalized.length() >= 2 && normalized.charAt(0) == altSep
+                && normalized.charAt(1) == altSep) {
+            prefixLen = 2;
+        }
+        else if (normalized.length() >= 1
+                && (normalized.charAt(0) == sep || normalized.charAt(0) == altSep)) {
+            prefixLen = 1;
+        }
+
+        StringBuilder sb = new StringBuilder();
+        sb.append(normalized.substring(0, prefixLen));
+        boolean lastWasSep = false;
+        for (int i = prefixLen; i < normalized.length(); i++) {
+            char ch = normalized.charAt(i);
+            boolean isSep = ch == sep || ch == altSep;
+            if (isSep) {
+                if (!lastWasSep) {
+                    sb.append(sep);
+                }
+            }
+            else {
+                sb.append(ch);
+            }
+            lastWasSep = isSep;
+        }
+        return sb.toString();
+    }
