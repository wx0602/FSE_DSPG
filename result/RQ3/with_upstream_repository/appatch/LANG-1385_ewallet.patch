+	/**
+	 * 安全地将字符串解析为数字。
+	 * <p>
+	 * 对仅包含类型后缀但没有数字内容的值（如 "L"、"l"、"F"、"D"）显式抛出 NumberFormatException，
+	 * 避免底层库在某些版本下抛出 StringIndexOutOfBoundsException。
+	 * </p>
+	 * @param value 需要解析的字符串
+	 * @return Number
+	 * @throws NumberFormatException 非法数字格式时抛出
+	 */
+	public static Number safeCreateNumber(String value) {
+		if (value == null) {
+			return null;
+		}
+		String source = value.trim();
+		if (source.length() == 0) {
+			throw new NumberFormatException("A blank string is not a valid number");
+		}
+		if (source.length() == 1) {
+			char ch = source.charAt(0);
+			if (ch == 'l' || ch == 'L' || ch == 'f' || ch == 'F' || ch == 'd' || ch == 'D') {
+				throw new NumberFormatException(source + " is not a valid number");
+			}
+		}
+		ParsePosition position = new ParsePosition(0);
+		Number number = java.text.NumberFormat.getInstance().parse(source, position);
+		if (number == null || position.getIndex() != source.length()) {
+			throw new NumberFormatException(source + " is not a valid number");
+		}
+		return number;
+		} catch (Exception e) {
+			e.printStackTrace();
 		} catch (Exception e) {
 			e.printStackTrace();
 		}
