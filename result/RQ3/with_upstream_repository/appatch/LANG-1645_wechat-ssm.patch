+	private static String normalizeLeadingPlusForRadixPrefixedInteger(String value) {
+		String str = StringUtils.trim(value);
+		if (StringUtils.length(str) < 2 || str.charAt(0) != '+') {
+			return str;
+		}
+		String unsigned = str.substring(1);
+		if (startsWithAny(unsigned, HEX_PREFIXES) || isOctalValue(unsigned)) {
+			return unsigned;
+		}
+		return str;
+	}
+
+	private static boolean isOctalValue(String value) {
+		if (!value.startsWith("0") || value.length() <= 1) {
+			return false;
+		}
+		char lastChar = value.charAt(value.length() - 1);
+		if (lastChar == 'l' || lastChar == 'L') {
+			value = value.substring(0, value.length() - 1);
+		}
+		for (int i = 1; i < value.length(); i++) {
+			char ch = value.charAt(i);
+			if (ch < '0' || ch > '7') {
+				return false;
+			}
+		}
+		return true;
+	}
+
+	private static boolean startsWithAny(String value, String[] prefixes) {
+		for (String prefix : prefixes) {
+			if (value.startsWith(prefix)) {
+				return true;
+			}
+		}
+		return false;
 	}
 
