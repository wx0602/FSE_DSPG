+	private static String normalizePositiveHexNumber(String str) {
+		if (str == null) {
+			return null;
+		}
+		Matcher matcher = POSITIVE_HEX_PREFIX.matcher(str);
+		if (matcher.matches()) {
+			return str;
+		}
+		return null;
+	}
+
+	private static Number createPositiveHexNumber(String str) {
+		Matcher matcher = POSITIVE_HEX_PREFIX.matcher(str);
+		if (!matcher.matches()) {
+			return NumberUtils.createNumber(str);
+		}
+		String digits = matcher.group(2);
+		int hexDigits = digits.length();
+		if (hexDigits > 16) {
+			return new BigInteger(digits, 16);
+		}
+		if (hexDigits == 16 && isSignificantHexDigit(digits.charAt(0), '7')) {
+			return new BigInteger(digits, 16);
+		}
+		if (hexDigits > 8) {
+			return Long.valueOf(Long.parseLong(digits, 16));
+		}
+		if (hexDigits == 8 && isSignificantHexDigit(digits.charAt(0), '7')) {
+			return Long.valueOf(Long.parseLong(digits, 16));
+		}
+		return Integer.valueOf(Integer.parseInt(digits, 16));
+	}
+
+	private static boolean isSignificantHexDigit(char digit, char maxPositiveDigit) {
+		char upperDigit = Character.toUpperCase(digit);
+		char upperMax = Character.toUpperCase(maxPositiveDigit);
+		return upperDigit > upperMax;
+	}
