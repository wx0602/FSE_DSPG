+    public static void validateCanonicalBase64(String str) {
+        if (str == null) {
+            throw new IllegalArgumentException("Base64 value must not be null");
+        }
+        byte[] decoded = Base64.decodeBase64(str);
+        String normalizedInput = str.replaceAll("\\s", "");
+        String canonical = Base64.encodeBase64String(decoded);
+        if (!canonical.equals(normalizedInput)) {
+            throw new IllegalArgumentException("Invalid Base64 encoding");
+        }
+    }
+
+    public static void validateCanonicalBase32(String str) {
+        if (str == null) {
+            throw new IllegalArgumentException("Base32 value must not be null");
+        }
+        Base32 codec = new Base32();
+        byte[] decoded = codec.decode(str);
+        String normalizedInput = str.replaceAll("\\s", "");
+        String canonical = codec.encodeAsString(decoded);
+        if (!canonical.equalsIgnoreCase(normalizedInput)) {
+            throw new IllegalArgumentException("Invalid Base32 encoding");
+        }
