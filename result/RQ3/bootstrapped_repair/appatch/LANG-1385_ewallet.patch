--- a/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
+++ b/wallet-base/src/main/java/com/fr/chain/utils/NumberUtil.java
@@ -115,8 +115,19 @@
 	 * @return Number 转换后的Number值。
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
-	public static Number createNumber(String str)    {
-		return NumberUtils.createNumber(str);
+	public static Number createNumber(String str) {
+		if (str == null) {
+			return null;
+		}
+		String value = str;
+		if (value.length() == 1) {
+			char lastChar = value.charAt(0);
+			if (lastChar == 'l' || lastChar == 'L' || lastChar == 'f' || lastChar == 'F'
+					|| lastChar == 'd' || lastChar == 'D') {
+				throw new NumberFormatException(value + " is not a valid number.");
+			}
+		}
+		return NumberUtils.createNumber(value);
 	}
 	
 	
