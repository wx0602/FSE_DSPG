+package org.apache.commons.text.translate;
+
+import java.io.IOException;
+import java.io.Writer;
+import java.util.Arrays;
+import java.util.EnumSet;
+
+/**
+ * Local security-patched implementation of the Commons Text translator.
+ *
+ * <p>The project intentionally remains on its existing Commons Text version.
+ * Decimal entities must not consume hexadecimal characters.</p>
+ */
+public class NumericEntityUnescaper extends CharSequenceTranslator {
+
+  public enum OPTION {
+    semiColonRequired,
+    semiColonOptional,
+    errorIfNoSemiColon
+  }
+
+  private final EnumSet<OPTION> options;
+
+  public NumericEntityUnescaper(final OPTION... options) {
+    if (options == null) {
+      this.options = EnumSet.noneOf(OPTION.class);
+    } else {
+      this.options = EnumSet.copyOf(Arrays.asList(options));
+    }
+  }
+
+  @Override
+  public int translate(final CharSequence input, final int index, final Writer out)
+      throws IOException {
+    if (input.charAt(index) != '&' || index + 2 >= input.length()
+        || input.charAt(index + 1) != '#') {
+      return 0;
+    }
+
+    boolean isHex = false;
+    int start = index + 2;
+    if (input.charAt(start) == 'x' || input.charAt(start) == 'X') {
+      isHex = true;
+      start++;
+    }
+
+    int end = start;
+    while (end < input.length() && isValidEntityCharacter(input.charAt(end), isHex)) {
+      end++;
+    }
+    if (end == start) {
+      return 0;
+    }
+
+    boolean semiColonNext = end < input.length() && input.charAt(end) == ';';
+    if (!semiColonNext) {
+      if (options.contains(OPTION.semiColonRequired)) {
+        return 0;
+      }
+      if (options.contains(OPTION.errorIfNoSemiColon)) {
+        throw new IllegalArgumentException("Semi-colon required at end of entity");
+      }
+    }
+
+    final int radix = isHex ? 16 : 10;
+    final int entityValue;
+    try {
+      entityValue = Integer.parseInt(input.subSequence(start, end).toString(), radix);
+    } catch (NumberFormatException ex) {
+      return 0;
+    }
+
+    if (entityValue > 0xffff) {
+      out.write(Character.toChars(entityValue));
+    } else {
+      out.write(entityValue);
+    }
+    return end - index + (semiColonNext ? 1 : 0);
+  }
+
+  private static boolean isValidEntityCharacter(final char ch, final boolean isHex) {
+    if (ch >= '0' && ch <= '9') {
+      return true;
+    }
+    return isHex && ((ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'));
+  }
+}
