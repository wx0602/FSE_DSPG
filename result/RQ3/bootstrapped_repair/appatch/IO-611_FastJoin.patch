+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+public final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    public static String normalize(String filename) {
+        String normalized = FilenameUtils.normalize(filename);
+        if (normalized == null) {
+            return null;
+        }
+        int prefix = normalized.startsWith("//") ? 2
+                : (normalized.startsWith("/") ? 1 : 0);
+        StringBuilder result = new StringBuilder(normalized.length());
+        for (int i = 0; i < normalized.length(); i++) {
+            if (i >= prefix && i > 0 && normalized.charAt(i) == '/'
+                    && normalized.charAt(i - 1) == '/') {
+                continue;
+            }
+            result.append(normalized.charAt(i));
+        }
+        return result.toString();
+    }
+}
