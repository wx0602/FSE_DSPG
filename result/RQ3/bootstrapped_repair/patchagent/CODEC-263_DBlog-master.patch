+    private static String normalizeBase64(String value) {
+        if (value == null) {
+            return null;
+        }
+        String normalized = value.trim();
+        if (normalized.length() == 0) {
+            return normalized;
+        }
+        int paddingIndex = normalized.indexOf('=');
+        if (paddingIndex >= 0) {
+            normalized = normalized.substring(0, paddingIndex);
+        }
+        int remainder = normalized.length() % 4;
+        if (remainder == 1) {
+            throw new IllegalArgumentException("Invalid Base64 input length");
+        }
+        if (remainder == 0) {
+            return normalized;
+        }
+        return normalized + (remainder == 2 ? "==" : "=");
+    }
+
