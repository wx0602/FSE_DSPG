+        if (!STRICT_BASE64_PATTERN.matcher(str).matches()) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        int padding = 0;
+        int length = str.length();
+        if (length > 0 && str.charAt(length - 1) == '=') {
+            padding++;
+            if (length > 1 && str.charAt(length - 2) == '=') {
+                padding++;
+            }
+        }
+        if (padding > 0) {
+            int usefulLength = length - padding;
+            int lastValue = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".indexOf(str.charAt(usefulLength - 1));
+            int mask = padding == 2 ? 0x0f : 0x03;
+            if ((lastValue & mask) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+        }
+    }
