+
+	/**
+	 * Commons Lang 3.4 does not accept a plus sign before hexadecimal prefixes.
+	 * Normalize only that valid Java numeric form before delegating parsing.
+	 */
+	private static String normalizePositiveHexPrefix(String str) {
+		if (str != null && str.length() > 1 && str.charAt(0) == '+'
+				&& ((str.length() > 2 && str.charAt(1) == '0'
+						&& (str.charAt(2) == 'x' || str.charAt(2) == 'X')) || str.charAt(1) == '#')) {
+			return str.substring(1);
+		}
+		return str;
 	}
 	
 	
