+    static byte[] decodeBase64Compat(String value) {
+        if (value == null) {
+            return new byte[0];
+        }
+        try {
+            return Base64.decodeBase64(value);
+        } catch (IllegalArgumentException ex) {
+            String normalized = normalizeBase64(value);
+            if (normalized.equals(value)) {
+                throw ex;
+            }
+            return java.util.Base64.getDecoder().decode(normalized);
+        }
+    }
+
+    private static String normalizeBase64(String value) {
+        String normalized = value.replaceAll("\\s", "");
+        if (!BASE64_CHARS.matcher(normalized).matches()) {
+            return value;
+        }
+        int remainder = normalized.length() % 4;
+        if (remainder == 1) {
+            return value;
+        }
+        if (remainder > 0) {
+            normalized = normalized + "====".substring(remainder);
+        }
+        return normalized;
