+    private static byte[] decodeStrictBase64(String value) {
+        if (value == null || value.isEmpty()) {
+            return new byte[0];
+        }
+        if (!BASE64_PATTERN.matcher(value).matches()) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        byte[] decoded = java.util.Base64.getDecoder().decode(value);
+        validateTrailingBase64Bits(value);
+        return decoded;
+    }
+
+    private static void validateTrailingBase64Bits(String value) {
+        int padding = 0;
+        int length = value.length();
+        while (padding < length && value.charAt(length - 1 - padding) == '=') {
+            padding++;
+        }
+        if (padding == 0) {
+            return;
+        }
+        char last = value.charAt(length - padding - 1);
+        int bitsToDrop = padding == 2 ? 4 : 2;
+        int mask = (1 << bitsToDrop) - 1;
+        if ((decodeBase64Char(last) & mask) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+    }
+
+    private static int decodeBase64Char(char ch) {
+        if (ch >= 'A' && ch <= 'Z') {
+            return ch - 'A';
+        }
+        if (ch >= 'a' && ch <= 'z') {
+            return ch - 'a' + 26;
+        }
+        if (ch >= '0' && ch <= '9') {
+            return ch - '0' + 52;
+        }
+        if (ch == '+') {
+            return 62;
+        }
+        if (ch == '/') {
+            return 63;
+        }
+        throw new IllegalArgumentException("Invalid Base64 input");
+    }
