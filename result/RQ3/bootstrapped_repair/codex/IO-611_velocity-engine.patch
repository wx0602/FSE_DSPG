+package org.apache.velocity.runtime.resource.loader;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Path handling for resource names.
+ *
+ * Commons IO 2.6 can leave repeated separators behind when normalizing a
+ * path with a prefix.  Resource names are not UNC paths, so retaining that
+ * prefix would allow different spellings of the same resource to reach the
+ * lookup code.  Collapse separators after Commons IO has performed its
+ * traversal checks.
+ */
+final class ResourcePathUtils
+{
+    private ResourcePathUtils()
+    {
+    }
+
+    static String normalize(final String path, final boolean keepSeparator)
+    {
+        final String normalized = FilenameUtils.normalize(path, keepSeparator);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        final StringBuilder result = new StringBuilder(normalized.length());
+        boolean separator = false;
+        for (int i = 0; i < normalized.length(); i++)
+        {
+            final char character = normalized.charAt(i);
+            if (character == '/')
+            {
+                if (!separator)
+                {
+                    result.append(character);
+                }
+                separator = true;
+            }
+            else
+            {
+                result.append(character);
+                separator = false;
+            }
+        }
+        return result.toString();
+    }
+}
