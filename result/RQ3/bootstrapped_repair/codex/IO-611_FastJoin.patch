@@ -0,0 +1,45 @@
+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Sanitizes separator runs before using the version of Commons IO bundled by
+ * this project.  In Commons IO 2.5, normalize leaves separator runs after a
+ * prefix intact, which can make the resulting path different from the
+ * normalized path promised by its API.
+ */
+public final class FilenameNormalizer {
+    private FilenameNormalizer() {
+    }
+
+    public static String normalize(String filename) {
+        return FilenameUtils.normalize(collapseSeparators(filename));
+    }
+
+    public static String normalizeNoEndSeparator(String filename) {
+        return FilenameUtils.normalizeNoEndSeparator(collapseSeparators(filename));
+    }
+
+    private static String collapseSeparators(String filename) {
+        if (filename == null || filename.length() < 2) {
+            return filename;
+        }
+
+        StringBuilder result = new StringBuilder(filename.length());
+        int separatorRun = 0;
+        for (int i = 0; i < filename.length(); i++) {
+            char character = filename.charAt(i);
+            if (character == '/' || character == '\\') {
+                separatorRun++;
+                // Keep only the two separators that form a UNC prefix.
+                if (separatorRun == 1 || (i < 2 && separatorRun == 2)) {
+                    result.append(character);
+                }
+            } else {
+                separatorRun = 0;
+                result.append(character);
+            }
+        }
+        return result.toString();
+    }
+}
