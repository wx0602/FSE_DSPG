+    /**
+     * Commons Codec 1.13 accepts non-zero bits which are discarded by the
+     * final Base64 quantum (for example, "AB==").  Validate the canonical
+     * representation before passing it to the library decoder.
+     */
+    private static byte[] decodeBase64Strict(String value) {
+        if (value == null || value.isEmpty()) {
+            return new byte[0];
+        }
+        if ((value.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 length");
+        }
+
+        int padding = value.endsWith("==") ? 2 : (value.endsWith("=") ? 1 : 0);
+        int dataEnd = value.length() - padding;
+        for (int i = 0; i < dataEnd; i++) {
+            char c = value.charAt(i);
+            if (!isBase64Character(c)) {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+        }
+        for (int i = dataEnd; i < value.length(); i++) {
+            if (value.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+        if (padding == 0 && dataEnd % 4 != 0) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+
+        int last = base64Value(value.charAt(dataEnd - 1));
+        int discardedBits = padding == 2 ? 4 : (padding == 1 ? 2 : 0);
+        if (discardedBits != 0 && (last & ((1 << discardedBits) - 1)) != 0) {
+            throw new IllegalArgumentException("Non-zero discarded Base64 bits");
+        }
