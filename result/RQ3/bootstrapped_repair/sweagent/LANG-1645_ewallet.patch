 	/**
@@ -116,7 +116,21 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
-		return NumberUtils.createNumber(str);
+		return NumberUtils.createNumber(normalizePositiveHexNumber(str));
+	}
+
+	/**
+	 * Commons Lang recognizes a leading '+' for hexadecimal values in some
+	 * numeric factories, but not in createBigInteger or createNumber. Remove
+	 * it only for hexadecimal prefixes so the accepted syntax stays aligned.
+	 */
+	private static String normalizePositiveHexNumber(String str) {
+		if (str != null && str.length() > 2 && str.charAt(0) == '+'
+				&& ((str.charAt(1) == '0' && (str.charAt(2) == 'x' || str.charAt(2) == 'X'))
+						|| str.charAt(1) == '#')) {
+			return str.substring(1);
+		}
+		return str;
 	}
 	
 	
