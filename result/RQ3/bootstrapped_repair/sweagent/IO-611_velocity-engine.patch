+/**
+ * Filename operations used by resource loaders.
+ */
+public final class FilenameUtils
+{
+    private FilenameUtils()
+    {
+    }
+
+    /**
+     * Normalizes a path using Commons IO and repairs the duplicate-separator
+     * handling in the Commons IO version retained by this project.
+     *
+     * @param filename path to normalize
+     * @param unixSeparator whether the result should use '/'
+     * @return normalized path, or {@code null} when it escapes its root
+     */
+    public static String normalize(String filename, boolean unixSeparator)
+    {
+        String normalized = org.apache.commons.io.FilenameUtils.normalize(filename, unixSeparator);
+        if (normalized == null || normalized.length() < 2)
+        {
+            return normalized;
+        }
+
+        char separator = unixSeparator ? '/' : java.io.File.separatorChar;
+        int start = normalized.startsWith("" + separator + separator) ? 2 : 0;
+        StringBuilder result = new StringBuilder(normalized.length());
+        for (int i = 0; i < normalized.length(); i++)
+        {
+            char current = normalized.charAt(i);
+            if (i >= start && current == separator && result.length() > 0
+                    && result.charAt(result.length() - 1) == separator)
+            {
+                continue;
+            }
+            result.append(current);
+        }
+        return result.toString();
+    }
+
+    public static String normalize(String filename)
+    {
+        String normalized = org.apache.commons.io.FilenameUtils.normalize(filename);
+        if (normalized == null || normalized.length() < 2)
+        {
+            return normalized;
+        }
+
+        char separator = java.io.File.separatorChar;
+        int start = normalized.startsWith("" + separator + separator) ? 2 : 0;
+        StringBuilder result = new StringBuilder(normalized.length());
+        for (int i = 0; i < normalized.length(); i++)
+        {
+            char current = normalized.charAt(i);
+            if (i >= start && current == separator && result.length() > 0
+                    && result.charAt(result.length() - 1) == separator)
+            {
+                continue;
+            }
+            result.append(current);
+        }
+        return result.toString();
+    }
+}
