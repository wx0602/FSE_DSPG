+        public static String toFixedDecimal(String value, int scale) {
+                return toFixedDecimal(createSafeNumber(value), scale);
+        }
+
+        public static String toFixedDecimal(Number value, int scale) {
+                NumberFormat numberFormat = NumberFormat.getInstance();
+                numberFormat.setRoundingMode(RoundingMode.HALF_UP);
+                numberFormat.setMaximumFractionDigits(scale);
+
+                return numberFormat.format(value);
+        }
+
+        public static String toFixedDecimalWithPercent(String value, int scale) {
+                return toFixedDecimalWithPercent(createSafeNumber(value), scale);
+        }
+
+        private static Number createSafeNumber(String value) {
+                if (value == null) {
+                        throw new NumberFormatException("null");
+                }
+
+                String trimmedValue = value.trim();
+                if (trimmedValue.isEmpty()) {
+                        throw new NumberFormatException(trimmedValue + " is not a valid number.");
+                }
+
+                char lastChar = trimmedValue.charAt(trimmedValue.length() - 1);
+                if (lastChar == 'l' || lastChar == 'L') {
+                        String numeric = trimmedValue.substring(0, trimmedValue.length() - 1);
+                        if (numeric.isEmpty() || "-".equals(numeric) || "+".equals(numeric)) {
+                                throw new NumberFormatException(trimmedValue + " is not a valid number.");
+                        }
+                }
+
+                return NumberUtils.createNumber(trimmedValue);
+        }
+
+        public static String toFixedDecimalWithPercent(Number value, int scale) {
+                NumberFormat numberFormat = NumberFormat.getPercentInstance();
+                numberFormat.setRoundingMode(RoundingMode.HALF_UP);
+                numberFormat.setMaximumFractionDigits(scale);
+
+                return numberFormat.format(value);
+        }
+
+        public static void main(String[] args) {
