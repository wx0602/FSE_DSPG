+	private static boolean hasEmptyNumericPortionWithTypeSuffix(String str) {
+		if (str == null || str.length() < 1) {
+			return false;
+		}
+		char lastChar = str.charAt(str.length() - 1);
+		if (lastChar != 'l' && lastChar != 'L') {
+			return false;
+		}
+		String numeric = str.substring(0, str.length() - 1);
+		return numeric.length() == 0 || "-".equals(numeric) || "+".equals(numeric);
+	}
