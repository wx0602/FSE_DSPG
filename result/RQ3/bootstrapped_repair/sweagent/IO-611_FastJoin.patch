diff --git a/src/main/java/soj/util/PathUtils.java b/src/main/java/soj/util/PathUtils.java
new file mode 100644
index 0000000..e166114
--- /dev/null
+++ b/src/main/java/soj/util/PathUtils.java
@@ -0,0 +1,45 @@
+package soj.util;
+
+import org.apache.commons.io.FilenameUtils;
+
+/** Normalizes paths safely while retaining compatibility with Commons IO 2.5. */
+public final class PathUtils
+{
+    private PathUtils() {
+    }
+
+    public static String normalize(String filename) {
+        return FilenameUtils.normalize(collapseRepeatedSeparators(filename));
+    }
+
+    public static String normalizeNoEndSeparator(String filename) {
+        return FilenameUtils.normalizeNoEndSeparator(collapseRepeatedSeparators(filename));
+    }
+
+    private static String collapseRepeatedSeparators(String filename) {
+        if (filename == null || filename.length() < 2) {
+            return filename;
+        }
+
+        int prefix = isSeparator(filename.charAt(0)) &&
+                filename.charAt(0) == filename.charAt(1) ? 2 : 0;
+        StringBuilder result = new StringBuilder(filename.length());
+        result.append(filename, 0, prefix);
+        boolean previousSeparator = false;
+
+        for (int i = prefix; i < filename.length(); i++) {
+            char current = filename.charAt(i);
+            boolean separator = isSeparator(current);
+            if (separator && previousSeparator) {
+                continue;
+            }
+            result.append(current);
+            previousSeparator = separator;
+        }
+        return result.toString();
+    }
+
+    private static boolean isSeparator(char character) {
+        return character == '/' || character == '\\';
+    }
+}
