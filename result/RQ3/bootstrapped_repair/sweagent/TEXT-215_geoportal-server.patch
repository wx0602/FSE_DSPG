+  static final class HtmlEntityDecoder {
+
+    private static final Map<String, Integer> NAMED_ENTITIES = buildNamedEntities();
+
+    private HtmlEntityDecoder() {
+    }
+
+    static String unescapeHtml4(String value) {
+      StringBuilder out = new StringBuilder(value.length());
+      int length = value.length();
+      for (int i = 0; i < length; i++) {
+        char ch = value.charAt(i);
+        if (ch != '&') {
+          out.append(ch);
+          continue;
+        }
+
+        int semi = value.indexOf(';', i + 1);
+        if (semi < 0) {
+          out.append(ch);
+          continue;
+        }
+
+        String entityBody = value.substring(i + 1, semi);
+        String decoded = decodeEntity(entityBody);
+        if (decoded == null) {
+          out.append(ch);
+          continue;
+        }
+
+        out.append(decoded);
+        i = semi;
+      }
+      return out.toString();
+    }
+
+    private static String decodeEntity(String entityBody) {
+      if (entityBody.isEmpty()) {
+        return null;
+      }
+
+      if (entityBody.charAt(0) == '#') {
+        return decodeNumericEntity(entityBody);
+      }
+
+      Integer codePoint = NAMED_ENTITIES.get(entityBody);
+      if (codePoint == null) {
+        return null;
+      }
+      return new String(Character.toChars(codePoint));
+    }
+
+    private static String decodeNumericEntity(String entityBody) {
+      boolean isHex = entityBody.length() > 2
+          && (entityBody.charAt(1) == 'x' || entityBody.charAt(1) == 'X');
+      int digitsStart = isHex ? 2 : 1;
+      if (entityBody.length() <= digitsStart) {
+        return null;
+      }
+
+      for (int i = digitsStart; i < entityBody.length(); i++) {
+        char ch = entityBody.charAt(i);
+        if (isHex) {
+          if (!isHexDigit(ch)) {
+            return null;
+          }
+        } else if (!Character.isDigit(ch)) {
+          return null;
+        }
+      }
+
+      try {
+        int codePoint = Integer.parseInt(entityBody.substring(digitsStart), isHex ? 16 : 10);
+        if (!Character.isValidCodePoint(codePoint)) {
+          return null;
+        }
+        return new String(Character.toChars(codePoint));
+      } catch (NumberFormatException ex) {
+        return null;
+      }
+    }
+
+    private static boolean isHexDigit(char ch) {
+      return (ch >= '0' && ch <= '9')
+          || (ch >= 'a' && ch <= 'f')
+          || (ch >= 'A' && ch <= 'F');
+    }
+
+    private static Map<String, Integer> buildNamedEntities() {
+      Map<String, Integer> entities = new HashMap<String, Integer>();
+      for (HTML.NamedCharacterReference reference : HTML.NamedCharacterReference.values()) {
+        entities.put(reference.getName(), (int) reference.getCode());
+      }
+      return entities;
+    }
+  }
