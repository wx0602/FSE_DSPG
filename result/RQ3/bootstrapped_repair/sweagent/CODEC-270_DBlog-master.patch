+    private static void validateBase64(String encrypted) {
+        if (encrypted == null || encrypted.isEmpty()) {
+            return;
+        }
+        if ((encrypted.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input length");
+        }
+
+        int padding = 0;
+        int length = encrypted.length();
+        if (encrypted.charAt(length - 1) == '=') {
+            padding++;
+        }
+        if (length > 1 && encrypted.charAt(length - 2) == '=') {
+            padding++;
+        }
+
+        int firstPadding = encrypted.indexOf('=');
+        if (firstPadding >= 0 && firstPadding < length - padding) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+
+        for (int i = 0; i < length - padding; i++) {
+            if (BASE64_ALPHABET.indexOf(encrypted.charAt(i)) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+        }
+
+        if (padding > 0) {
+            int lastValue = BASE64_ALPHABET.indexOf(encrypted.charAt(length - padding - 1));
+            if (lastValue < 0) {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+            int mask = padding == 1 ? 0x03 : 0x0F;
+            if ((lastValue & mask) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+        }
+    }
