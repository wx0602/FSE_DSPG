+public String decrypt(String cipherText) {
+    try {
+        byte[] encrypted = decodeBase64Strict(cipherText);
+        byte[] decrypted = crypto.decrypt(encrypted);
+        return new String(decrypted, "UTF-8");
+    } catch (UnsupportedEncodingException e) {
+        throw fail(e);
     }
+}
 
+private byte[] decodeBase64Strict(String value) {
+    byte[] decoded = Utils.base64(value);
+    String normalized = new String(decoded);
+    String reencoded = java.util.Base64.getEncoder().encodeToString(decoded);
+    String strippedInput = value == null ? null : value.replaceAll("\\s", "");
+    if (strippedInput == null || !reencoded.equals(strippedInput)) {
+        throw new IllegalArgumentException("Invalid Base64 input");
+    }
+    return decoded;
+}
     private IllegalStateException fail(Exception e) {
         return new IllegalStateException(e);
     }
