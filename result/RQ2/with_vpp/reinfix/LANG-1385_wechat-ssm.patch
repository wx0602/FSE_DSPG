-		return toFixedDecimalWithPercent(NumberUtils.createNumber(value), scale);
-	}
+public static String toFixedDecimalWithPercent(String value, int scale) {
+		String normalized = value == null ? null : value.trim();
+		if (normalized == null || normalized.length() == 0) {
+			throw new NumberFormatException("A blank string is not a valid number");
+		}
+		boolean hasDigit = false;
+		for (int i = 0; i < normalized.length(); i++) {
+			if (Character.isDigit(normalized.charAt(i))) {
+				hasDigit = true;
+				break;
+			}
+		}
+		if (!hasDigit) {
+			throw new NumberFormatException(normalized + " is not a valid number");
+		}
+		return toFixedDecimalWithPercent(NumberUtils.createNumber(normalized), scale);
+	}
