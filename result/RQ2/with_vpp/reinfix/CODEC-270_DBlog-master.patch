index 0000000..0000000 100644
--- a/blog-core/src/main/java/com/zyd/blog/util/PasswordUtil.java
+++ b/blog-core/src/main/java/com/zyd/blog/util/PasswordUtil.java
@@ -33,3 +33,16 @@
-    public static String decrypt(String encryptPassword, String salt) throws Exception {
-        return AesUtil.decrypt(salt, encryptPassword);
-    }
+public static String decrypt(String encryptPassword, String salt) throws Exception {
+    if (!isCanonicalBase64(salt)) {
+        throw new IllegalArgumentException("Invalid Base64 salt");
+    }
+    if (!isCanonicalBase64(encryptPassword)) {
+        throw new IllegalArgumentException("Invalid Base64 encrypted password");
+    }
+    return AesUtil.decrypt(salt, encryptPassword);
+}
+
+private static boolean isCanonicalBase64(String value) {
+    if (value == null || value.isEmpty() || (value.length() % 4) != 0) {
+        return false;
+    }
+    return value.matches("^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$");
+}
