+public static String decrypt(String encryptPassword, String salt) throws Exception {
+    if (encryptPassword == null || encryptPassword.trim().isEmpty()) {
+        return null;
+    }
+    String normalized = encryptPassword.trim();
+    if ((normalized.length() & 3) != 0 || !normalized.matches("^[A-Za-z0-9+/]*={0,2}$")) {
+        return null;
+    }
+    try {
+        return AesUtil.decrypt(Md5Util.MD5(salt + CommonConst.ZYD_SECURITY_KEY), normalized);
+    } catch (IllegalArgumentException e) {
+        return null;
+    }
+}
