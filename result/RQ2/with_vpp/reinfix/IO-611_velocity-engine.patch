+public Reader getResourceReader(String templateName, String encoding)
+            throws ResourceNotFoundException {
+        /*
+         * Make sure we have a valid templateName.
+         */
+        if (org.apache.commons.lang3.StringUtils.isEmpty(templateName))
+        {
+            /*
+             * If we don't get a properly formed templateName then
+             * there's not much we can do. So we'll forget about
+             * trying to search any more paths for the template.
+             */
+            throw new ResourceNotFoundException(
+                    "Need to specify a file name or file path!");
+        }
+
+        String template = FilenameUtils.normalize(templateName, true);
+        if (template == null || template.length() == 0)
+        {
+            String msg = "File resource error: argument " + template +
+                    " contains .. and may be trying to access " +
+                    "content outside of template root.  Rejected.";
+
+            log.error("FileResourceLoader: {}", msg);
+
+            throw new ResourceNotFoundException(msg);
+        }
+
+        for (String path : paths)
+        {
+            InputStream rawStream = null;
+            Reader reader = null;
+
+            try
+            {
+                File baseDirectory = getFile(path);
+                File candidate = new File(baseDirectory, template);
+                File canonicalBaseDirectory = baseDirectory.getCanonicalFile();
+                File canonicalCandidate = candidate.getCanonicalFile();
+                String basePath = canonicalBaseDirectory.getPath();
+                String candidatePath = canonicalCandidate.getPath();
+
+                if (!candidatePath.equals(basePath)
+                        && !candidatePath.startsWith(basePath + File.separator))
+                {
+                    String msg = "File resource error: argument " + templateName +
+                            " resolves to a path outside of template root. Rejected.";
+                    log.warn("FileResourceLoader: {}", msg);
+                    continue;
+                }
+
+                if (canonicalCandidate.canRead() && canonicalCandidate.isFile())
+                {
+                    rawStream = new FileInputStream(canonicalCandidate);
+                    reader = buildReader(rawStream, encoding);
+                }
+            }
+            catch (IOException ioe)
+            {
+                closeQuiet(rawStream);
+                String msg = "Exception while loading Template " + template;
+                log.error(msg, ioe);
+                throw new VelocityException(msg, ioe);
+            }
+
+            if (reader != null)
+            {
+                /*
+                 * Store the path that this template came
+                 * from so that we can check its modification
+                 * time.
+                 */
+                templatePaths.put(templateName, path);
+                return reader;
+            }
+        }
+
+        /*
+         * We have now searched all the paths for
+         * templates and we didn't find anything so
+         * throw an exception.
+         */
+        throw new ResourceNotFoundException("FileResourceLoader: cannot find " + template);
+    }
