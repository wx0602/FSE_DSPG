+    private static void validateStrictBase64(String str) {
+        if (str == null) {
+            throw new IllegalArgumentException("Base64 input must not be null");
+        }
+        String normalized = str.replaceAll("\\s", "");
+        if (normalized.length() == 0 || normalized.length() % 4 != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        if (!normalized.matches("^[A-Za-z0-9+/]*={0,2}$")) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+
+        int padding = 0;
+        int firstPad = normalized.indexOf('=');
+        if (firstPad >= 0) {
+            for (int i = firstPad; i < normalized.length(); i++) {
+                if (normalized.charAt(i) != '=') {
+                    throw new IllegalArgumentException("Invalid Base64 padding");
+                }
+                padding++;
+            }
+        }
+
+        if (padding > 2) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+
+        Base64 codec = new Base64();
+        byte[] decoded = codec.decode(normalized);
+        if (decoded == null) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+
+        String canonical = Base64.encodeBase64String(decoded);
+        if (!normalized.equals(canonical)) {
+            throw new IllegalArgumentException("Invalid Base64 trailing bits");
+        }
+    }
+
     public static byte[] base64(String str) {
+        validateStrictBase64(str);
         return Base64.decodeBase64(str);
     }
 
