+    private static byte[] safeDecodeBase64(String encrypted) throws Exception {
+        if (StringUtils.isEmpty(encrypted)) {
+            throw new IllegalArgumentException("Encrypted text must not be empty");
+        }
+        try {
+            return Base64.decodeBase64(encrypted.getBytes("utf-8"));
+        } catch (RuntimeException ex) {
+            throw new BadPaddingException("Invalid Base64 content");
+        }
+    }
+
+    public static boolean isEncryptedTextValid(String encrypted) {
+        if (StringUtils.isEmpty(encrypted)) {
+            return false;
+        }
+        try {
+            return safeDecodeBase64(encrypted).length > 0;
+        } catch (Exception ex) {
+            return false;
+        }
+    }
