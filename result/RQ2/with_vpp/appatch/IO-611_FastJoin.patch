+package soj.util;
+
+import static org.apache.commons.io.FilenameUtils.normalize;
+import static org.apache.commons.io.FilenameUtils.normalizeNoEndSeparator;
+
+public final class SafeFilenameUtils
+{
+    private SafeFilenameUtils() {
+    }
+
+    public static String normalize(String path) {
+        return collapseRepeatedSeparators(normalize(path));
+    }
+
+    public static String normalizeNoEndSeparator(String path) {
+        return collapseRepeatedSeparators(normalizeNoEndSeparator(path));
+    }
+
+    private static String collapseRepeatedSeparators(String path) {
+        if (path == null || path.isEmpty()) {
+            return path;
+        }
+
+        StringBuilder sb = new StringBuilder(path.length());
+        char slash = 0;
+        for (int i = 0; i < path.length(); ++i) {
+            char ch = path.charAt(i);
+            if (ch == '/' || ch == '\\') {
+                if (sb.length() == 0) {
+                    slash = ch;
+                    sb.append(ch);
+                }
+                else if (sb.charAt(sb.length() - 1) != '/' && sb.charAt(sb.length() - 1) != '\\') {
+                    slash = ch;
+                    sb.append(ch);
+                }
+                else if (i == 1 && isDriveLessPrefix(path)) {
+                    slash = ch;
+                    sb.append(ch);
+                }
+            }
+            else {
+                if ((sb.length() == 2) && isDriveLessPrefix(sb.toString()) && ch == slash) {
+                    continue;
+                }
+                sb.append(ch);
+            }
+        }
+        return sb.toString();
+    }
+
+    private static boolean isDriveLessPrefix(String path) {
+        return path.length() >= 2
+                && (path.charAt(0) == '/' || path.charAt(0) == '\\')
+                && (path.charAt(1) == '/' || path.charAt(1) == '\\');
+    }
+}
