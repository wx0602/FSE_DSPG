+	private static Number createCompatibleNumber(String value) {
+		if (value == null) {
+			throw new NumberFormatException("A null string is not a valid number");
+		}
+
+		if (hasPositiveHexPrefix(value)) {
+			return parsePositiveHexNumber(value);
+		}
+
+		return NumberUtils.createNumber(value);
+	}
+
+	private static boolean hasPositiveHexPrefix(String value) {
+		return value.startsWith("+0x") || value.startsWith("+0X") || value.startsWith("+#");
+	}
+
+	private static Number parsePositiveHexNumber(String value) {
+		if (value.length() <= 3) {
+			throw new NumberFormatException(value + " is not a valid number.");
+		}
+
+		String normalized = value.substring(1);
+		try {
+			return NumberUtils.createInteger(normalized);
+		} catch (NumberFormatException ex) {
+			try {
+				return NumberUtils.createLong(normalized);
+			} catch (NumberFormatException ignored) {
+				String digits = normalized.startsWith("#") ? normalized.substring(1) : normalized.substring(2);
+				return new BigInteger(digits, 16);
+			}
+		}
+	}
