+    /**
+     * Normalizes a template path while collapsing repeated separators that
+     * commons-io 2.6 may leave behind after a prefix.
+     *
+     * @param templateName input template name
+     * @return normalized template path or null if rejected
+     */
+    protected String normalizeTemplatePath(final String templateName)
+    {
+        String sanitized = sanitizeRepeatedSeparators(templateName);
+        if (sanitized == null)
+        {
+            return null;
+        }
+        return FilenameUtils.normalize(sanitized, true);
+    }
+
+    private String sanitizeRepeatedSeparators(final String path)
+    {
+        if (path == null)
+        {
+            return null;
+        }
+        StringBuilder normalized = new StringBuilder(path.length());
+        char previous = 0;
+        for (int i = 0; i < path.length(); i++)
+        {
+            char current = path.charAt(i);
+            if ((current == '/' || current == '\\') && (previous == '/' || previous == '\\'))
+            {
+                continue;
+            }
+            normalized.append(current);
+            previous = current;
+        }
+        return normalized.toString();
+    }
