+  private static String translate(CharSequenceTranslator translator, String value) {
+    try {
+      StringWriter writer = new StringWriter(value.length() * 2);
+      translator.translate(value, writer);
+      return writer.toString();
+    } catch (IOException ex) {
+      throw new RuntimeException(ex);
+    }
+  }
+
+  private static boolean isDecimalDigit(char c) {
+    return c >= '0' && c <= '9';
+  }
+
+  private static boolean isHexDigit(char c) {
+    return (c >= '0' && c <= '9')
+        || (c >= 'a' && c <= 'f')
+        || (c >= 'A' && c <= 'F');
+  }
+
+  private static String unescapeNumericEntitySafely(String v) {
+    StringBuilder sb = new StringBuilder(v.length());
+    int i = 0;
+    while (i < v.length()) {
+      char ch = v.charAt(i);
+      if (ch == '&' && i + 2 < v.length() && v.charAt(i + 1) == '#') {
+        int start = i;
+        int index = i + 2;
+        boolean hex = false;
+        if (index < v.length() && (v.charAt(index) == 'x' || v.charAt(index) == 'X')) {
+          hex = true;
+          index++;
+        }
+        int digitsStart = index;
+        while (index < v.length() && (hex ? isHexDigit(v.charAt(index)) : isDecimalDigit(v.charAt(index)))) {
+          index++;
+        }
+        if (index > digitsStart) {
+          boolean hasSemicolon = index < v.length() && v.charAt(index) == ';';
+          String entity = v.substring(start, hasSemicolon ? index + 1 : index);
+          String decoded = translate(NUMERIC, entity);
+          if (!decoded.equals(entity)) {
+            sb.append(decoded);
+            i = hasSemicolon ? index + 1 : index;
+            continue;
+          }
+        }
+      }
+      sb.append(ch);
+      i++;
+    }
+    return sb.toString();
+  }
