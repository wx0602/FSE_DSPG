+    /**
+     * Decode only canonical Base64.  commons-codec 1.13 accepts non-zero
+     * trailing bits (for example, {@code AB==}) and silently discards them.
+     * Such values have multiple textual representations of the same bytes and
+     * must not be accepted as encrypted credentials.
+     */
+    private static byte[] decodeStrictBase64(String value) {
+        if (value == null || (value.length() & 3) != 0
+                || !value.matches("[A-Za-z0-9+/]*={0,2}")) {
+            throw new IllegalArgumentException("Invalid Base64 ciphertext");
+        }
+        byte[] decoded = Base64.decodeBase64(value);
+        if (!Base64.encodeBase64String(decoded).equals(value)) {
+            throw new IllegalArgumentException("Non-canonical Base64 ciphertext");
+        }
+        return decoded;
+    }
