--- /dev/null
+++ b/src/main/java/soj/util/SafeFilenameUtils.java
@@ -0,0 +1,25 @@
+package soj.util;
+
+import java.io.File;
+import java.util.regex.Matcher;
+
+/**
+ * Filename normalization used at filesystem boundaries.
+ *
+ * Commons IO 2.5 can leave repeated separators in the result of normalize
+ * (for example, after a prefix).  Normalize those separators explicitly so
+ * the canonical path represented by the result is unambiguous.
+ */
+final class SafeFilenameUtils {
+    private SafeFilenameUtils() {
+    }
+
+    static String normalize(String filename) {
+        String normalized = org.apache.commons.io.FilenameUtils.normalize(filename);
+        if (normalized == null) {
+            return null;
+        }
+        return normalized.replaceAll("[/\\\\]+", Matcher.quoteReplacement(
+                File.separator));
+    }
+}
