+    /**
+     * FilenameUtils 2.6 does not remove repeated separators following a
+     * path prefix.  Normalize those separators before handing the name to
+     * the library.  Keep a leading double separator intact since it is a
+     * meaningful UNC/path prefix, but never allow duplicate separators in
+     * the remainder of a resource name.
+     */
+    private String normalizeResourceName(String name, boolean failOnAboveRoot)
+    {
+        StringBuilder collapsed = new StringBuilder(name.length());
+        int index = 0;
+        int leadingSeparators = 0;
+        while (index < name.length() && isSeparator(name.charAt(index)))
+        {
+            leadingSeparators++;
+            index++;
+        }
+        if (leadingSeparators > 0)
+        {
+            collapsed.append('/');
+            if (leadingSeparators > 1)
+            {
+                collapsed.append('/');
+            }
+        }
+        boolean separatorPending = false;
+        for (; index < name.length(); index++)
+        {
+            char character = name.charAt(index);
+            if (isSeparator(character))
+            {
+                separatorPending = true;
+            }
+            else
+            {
+                if (separatorPending)
+                {
+                    collapsed.append('/');
+                    separatorPending = false;
+                }
+                collapsed.append(character);
+            }
+        }
+        return FilenameUtils.normalize(collapsed.toString(), failOnAboveRoot);
+    }
+
+    private boolean isSeparator(char character)
+    {
+        return character == '/' || character == '\\';
+    }
