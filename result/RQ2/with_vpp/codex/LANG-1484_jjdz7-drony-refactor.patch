+    private boolean isDecimalInteger(String str) {
+        if (str == null || str.isEmpty()) {
+            return false;
+        }
+        int firstDigit = (str.charAt(0) == '-' || str.charAt(0) == '+') ? 1 : 0;
+        if (firstDigit == str.length()) {
+            return false;
+        }
+        for (int i = firstDigit; i < str.length(); i++) {
+            if (str.charAt(i) < '0' || str.charAt(i) > '9') {
+                return false;
+            }
+        }
+        return true;
+    }
