+    // Strictly validate Base64 input before decoding so malformed trailing bits are rejected downstream.
+    private static boolean isStrictBase64(String encrypted) {
+        if (encrypted == null || encrypted.isEmpty()) {
+            return false;
+        }
+        if ((encrypted.length() & 3) != 0) {
+            return false;
+        }
+        int paddingStart = encrypted.length();
+        while (paddingStart > 0 && encrypted.charAt(paddingStart - 1) == '=') {
+            paddingStart--;
+        }
+        int paddingCount = encrypted.length() - paddingStart;
+        if (paddingCount > 2) {
+            return false;
+        }
+        for (int i = 0; i < paddingStart; i++) {
+            char ch = encrypted.charAt(i);
+            boolean upper = ch >= 'A' && ch <= 'Z';
+            boolean lower = ch >= 'a' && ch <= 'z';
+            boolean digit = ch >= '0' && ch <= '9';
+            if (!(upper || lower || digit || ch == '+' || ch == '/')) {
+                return false;
+            }
+        }
+        for (int i = paddingStart; i < encrypted.length(); i++) {
+            if (encrypted.charAt(i) != '=') {
+                return false;
+            }
+        }
+        if (paddingCount == 0) {
+            return true;
+        }
+        int lastValue = base64Value(encrypted.charAt(paddingStart - 1));
+        if (lastValue < 0) {
+            return false;
+        }
+        int mask = paddingCount == 1 ? 0x03 : 0x0F;
+        return (lastValue & mask) == 0;
+    }
+
+    // Map Base64 alphabet characters to their 6-bit values for trailing-bit validation.
+    private static int base64Value(char ch) {
+        if (ch >= 'A' && ch <= 'Z') {
+            return ch - 'A';
+        }
+        if (ch >= 'a' && ch <= 'z') {
+            return ch - 'a' + 26;
+        }
+        if (ch >= '0' && ch <= '9') {
+            return ch - '0' + 52;
+        }
+        if (ch == '+') {
+            return 62;
+        }
+        if (ch == '/') {
+            return 63;
+        }
+        return -1;
+    }
