+    // Validate Base64 input before decoding so malformed trailing bits and non-canonical encodings are rejected.
+    private static final Pattern STRICT_BASE64_PATTERN = Pattern.compile("^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$");
+
+    // Perform strict downstream Base64 validation to mitigate acceptance of malformed inputs by the library decoder.
+    private static byte[] decodeBase64Strict(String str) {
+        if (str == null) {
+            return null;
+        }
+        if (!STRICT_BASE64_PATTERN.matcher(str).matches()) {
+            throw new IllegalArgumentException("Invalid Base64 input");
+        }
+        byte[] decoded = Base64.decodeBase64(str);
+        String canonical = Base64.encodeBase64String(decoded);
+        if (!str.equals(canonical)) {
+            throw new IllegalArgumentException("Non-canonical Base64 input");
+        }
+        return decoded;
+    }
