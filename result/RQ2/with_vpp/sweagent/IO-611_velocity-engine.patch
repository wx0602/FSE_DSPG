+    private String normalizeTemplatePath(final String templateName, final boolean unixSeparator)
+    {
+        return FilenameUtils.normalize(collapseDuplicateSeparators(templateName), unixSeparator);
+    }
+
+    /**
+     * Commons IO 2.6 does not collapse repeated separators that appear after a prefix,
+     * so sanitize those before delegating to FilenameUtils.normalize(...).
+     */
+    private String collapseDuplicateSeparators(final String path)
+    {
+        if (path == null || path.length() < 2)
+        {
+            return path;
+        }
+
+        StringBuilder sanitized = new StringBuilder(path.length());
+        char previous = 0;
+
+        for (int i = 0; i < path.length(); i++)
+        {
+            char current = path.charAt(i);
+            if (isFileSeparator(current) && isFileSeparator(previous))
+            {
+                continue;
+            }
+            sanitized.append(current);
+            previous = current;
+        }
+
+        return sanitized.toString();
+    }
+
+    private boolean isFileSeparator(final char candidate)
+    {
+        return candidate == '/' || candidate == '\\';
+    }
