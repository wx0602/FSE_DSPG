+    private static void validateBase64(String encrypted) {
+        if (encrypted == null || encrypted.isEmpty()) {
+            return;
+        }
+        if ((encrypted.length() & 3) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 input length");
+        }
+
+        int padding = countPadding(encrypted);
+        int firstPadding = encrypted.indexOf('=');
+        if (firstPadding >= 0 && firstPadding < encrypted.length() - padding) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+
+        for (int i = 0; i < encrypted.length(); i++) {
+            char current = encrypted.charAt(i);
+            if (current == '=') {
+                continue;
+            }
+            if (BASE64_ALPHABET.indexOf(current) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 character");
+            }
+        }
+
+        if (padding == 1) {
+            validateTrailingBits(encrypted.charAt(encrypted.length() - 2), 0x03);
+        } else if (padding == 2) {
+            validateTrailingBits(encrypted.charAt(encrypted.length() - 3), 0x0F);
+        } else if (padding > 2) {
+            throw new IllegalArgumentException("Invalid Base64 padding");
+        }
+    }
+
+    private static int countPadding(String encrypted) {
+        int padding = 0;
+        for (int i = encrypted.length() - 1; i >= 0 && encrypted.charAt(i) == '='; i--) {
+            padding++;
+        }
+        return padding;
+    }
+
+    private static void validateTrailingBits(char value, int mask) {
+        int index = BASE64_ALPHABET.indexOf(value);
+        if (index < 0 || (index & mask) != 0) {
+            throw new IllegalArgumentException("Invalid Base64 trailing bits");
+        }
+    }
