+    private static void validateBase64Ciphertext(String encrypted) {
+        if (encrypted == null || encrypted.isEmpty()) {
+            return;
+        }
+        if (encrypted.length() % 4 != 0) {
+            throw new IllegalArgumentException("Invalid Base64 ciphertext length");
+        }
+
+        int padding = 0;
+        int length = encrypted.length();
+        if (encrypted.charAt(length - 1) == '=') {
+            padding++;
+            if (encrypted.charAt(length - 2) == '=') {
+                padding++;
+            }
+        }
+        if (padding > 2) {
+            throw new IllegalArgumentException("Invalid Base64 ciphertext padding");
+        }
+
+        for (int i = 0; i < length - padding; i++) {
+            if (decodeBase64Char(encrypted.charAt(i)) < 0) {
+                throw new IllegalArgumentException("Invalid Base64 ciphertext character");
+            }
+        }
+        for (int i = length - padding; i < length; i++) {
+            if (i >= 0 && encrypted.charAt(i) != '=') {
+                throw new IllegalArgumentException("Invalid Base64 ciphertext padding");
+            }
+        }
+        for (int i = 0; i < length - padding; i++) {
+            if (encrypted.charAt(i) == '=') {
+                throw new IllegalArgumentException("Invalid Base64 ciphertext padding");
+            }
+        }
+
+        if (padding == 1) {
+            int lastValue = decodeBase64Char(encrypted.charAt(length - 2));
+            if ((lastValue & 0x03) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 ciphertext trailing bits");
+            }
+        } else if (padding == 2) {
+            int lastValue = decodeBase64Char(encrypted.charAt(length - 3));
+            if ((lastValue & 0x0F) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 ciphertext trailing bits");
+            }
+        }
+    }
+
+    private static int decodeBase64Char(char ch) {
+        if (ch >= 'A' && ch <= 'Z') {
+            return ch - 'A';
+        }
+        if (ch >= 'a' && ch <= 'z') {
+            return ch - 'a' + 26;
+        }
+        if (ch >= '0' && ch <= '9') {
+            return ch - '0' + 52;
+        }
+        if (ch == '+') {
+            return 62;
+        }
+        if (ch == '/') {
+            return 63;
+        }
+        return -1;
+    }
