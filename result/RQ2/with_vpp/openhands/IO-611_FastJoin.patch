index 0000000..a1f8123
--- /dev/null
+++ b/src/main/java/soj/util/SafePaths.java
@@ -0,0 +1,80 @@
+package soj.util;
+
+import java.io.File;
+import java.nio.file.InvalidPathException;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+public final class SafePaths {
+    private SafePaths() {
+    }
+
+    public static String normalizePath(String path) {
+        if (path == null) {
+            return null;
+        }
+
+        String normalized = collapseDuplicateSeparators(path.replace('\\', '/'));
+        boolean hasDoubleSlashPrefix = normalized.startsWith("//") && (normalized.length() == 2 || normalized.charAt(2) != '/');
+        String pathForNormalization = hasDoubleSlashPrefix ? normalized.substring(2) : normalized;
+        try {
+            Path safePath = Paths.get(pathForNormalization).normalize();
+            normalized = safePath.toString().replace(File.separatorChar, '/');
+            if (hasDoubleSlashPrefix && !normalized.isEmpty()) {
+                normalized = "//" + normalized;
+            }
+        }
+        catch (InvalidPathException e) {
+            return normalized;
+        }
+
+        return normalized;
+    }
+
+    public static String normalizePathNoEndSeparator(String path) {
+        String normalized = normalizePath(path);
+        if (normalized == null || normalized.isEmpty() || "/".equals(normalized) || "//".equals(normalized)) {
+            return normalized;
+        }
+
+        int end = normalized.length();
+        while (end > 0 && normalized.charAt(end - 1) == '/') {
+            end--;
+        }
+
+        return normalized.substring(0, end);
+    }
+
+    private static String collapseDuplicateSeparators(String path) {
+        if (path.isEmpty()) {
+            return path;
+        }
+
+        StringBuilder builder = new StringBuilder(path.length());
+        int index = 0;
+        if (path.startsWith("//")) {
+            builder.append("//");
+            index = 2;
+            while (index < path.length() && path.charAt(index) == '/') {
+                index++;
+            }
+        }
+
+        boolean previousSlash = false;
+        for (; index < path.length(); index++) {
+            char ch = path.charAt(index);
+            if (ch == '/') {
+                if (!previousSlash) {
+                    builder.append(ch);
+                }
+                previousSlash = true;
+            }
+            else {
+                builder.append(ch);
+                previousSlash = false;
+            }
+        }
+
+        return builder.toString();
+    }
+}
