+package org.apache.velocity.runtime.resource.loader;
+
+import org.apache.commons.io.FilenameUtils;
+
+/**
+ * Normalizes resource paths without trusting commons-io 2.6 to collapse
+ * repeated separators after a path prefix.
+ */
+final class SecureResourcePathNormalizer
+{
+    private SecureResourcePathNormalizer()
+    {
+    }
+
+    static String normalize(String path)
+    {
+        if (path == null)
+        {
+            return null;
+        }
+
+        String unixPath = path.replace('\\', '/');
+        String prefix = "";
+        String remainder = unixPath;
+
+        if (unixPath.startsWith("//") && (unixPath.length() == 2 || unixPath.charAt(2) != '/'))
+        {
+            prefix = "//";
+            remainder = unixPath.substring(2);
+        }
+
+        remainder = collapseSlashes(remainder);
+        String normalized = FilenameUtils.normalize(prefix + remainder, true);
+        if (normalized == null)
+        {
+            return null;
+        }
+
+        if (prefix.isEmpty())
+        {
+            return collapseSlashes(normalized);
+        }
+
+        if (normalized.startsWith(prefix))
+        {
+            return prefix + collapseSlashes(normalized.substring(prefix.length()));
+        }
+
+        return collapseSlashes(normalized);
+    }
+
+    private static String collapseSlashes(String path)
+    {
+        StringBuilder collapsed = new StringBuilder(path.length());
+        boolean previousSlash = false;
+        for (int i = 0; i < path.length(); i++)
+        {
+            char ch = path.charAt(i);
+            if (ch == '/')
+            {
+                if (!previousSlash)
+                {
+                    collapsed.append(ch);
+                }
+                previousSlash = true;
+            }
+            else
+            {
+                collapsed.append(ch);
+                previousSlash = false;
+            }
+        }
+        return collapsed.toString();
+    }
+}
