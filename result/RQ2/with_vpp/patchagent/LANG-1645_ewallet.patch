@@ -116,6 +116,17 @@ public class NumberUtil {
 	 * @throws 如果String值不能被转换或null，将抛出NumberFormatException异常
 	 */
 	public static Number createNumber(String str)    {
+		if (str != null && str.length() > 2 && str.charAt(0) == '+') {
+			char prefix = str.charAt(1);
+			if (prefix == '0' && str.length() > 3) {
+				char radixPrefix = str.charAt(2);
+				if (radixPrefix == 'x' || radixPrefix == 'X') {
+					str = str.substring(1);
+				}
+			} else if (prefix == '#') {
+				str = str.substring(1);
+			}
+		}
 		return NumberUtils.createNumber(str);
 	}
 	
