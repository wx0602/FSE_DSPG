+    static String sanitizeNormalizedPath(String filename) {
+        String normalized = normalize(filename);
+        if (normalized == null || normalized.length() < 2) {
+            return normalized;
+        }
+
+        StringBuilder sanitized = new StringBuilder(normalized.length());
+        char previous = 0;
+        for (int i = 0; i < normalized.length(); i++) {
+            char current = normalized.charAt(i);
+            if ((current == '/' || current == '\\') && current == previous) {
+                continue;
+            }
+            sanitized.append(current);
+            previous = current;
+        }
+
+        if (sanitized.length() > 1 && sanitized.charAt(0) == '/' && sanitized.charAt(1) != '/') {
+            return "/" + sanitized.substring(1);
+        }
+
+        return sanitized.toString();
