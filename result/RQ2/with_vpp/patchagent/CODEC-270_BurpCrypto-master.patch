+        int length = str.length();
+        if (length >= 4) {
+            if (str.charAt(length - 2) == '=' && (values[length - 3] & 0x0f) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+            if (str.charAt(length - 1) == '=' && str.charAt(length - 2) != '=' && (values[length - 2] & 0x03) != 0) {
+                throw new IllegalArgumentException("Invalid Base64 trailing bits");
+            }
+        }
