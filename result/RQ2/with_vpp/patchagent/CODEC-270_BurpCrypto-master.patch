+    private static void validateBase64(String str) {
+        if (str == null) {
+            throw new IllegalArgumentException("Base64 input must not be null");
+        }
+        if (str.length() % 4 != 0) {
+            throw new IllegalArgumentException("Invalid Base64 length");
+        }
+
+        int paddingStart = str.indexOf('=');
+        if (paddingStart >= 0) {
+            for (int i = paddingStart; i < str.length(); i++) {
+                if (str.charAt(i) != '=') {
+                    throw new IllegalArgumentException("Invalid Base64 padding");
+                }
+            }
+            if (str.length() - paddingStart > 2) {
+                throw new IllegalArgumentException("Invalid Base64 padding");
+            }
+        }
+
+        int[] values = new int[str.length()];
+        Arrays.fill(values, -1);
+        for (int i = 0; i < str.length(); i++) {
+            char ch = str.charAt(i);
+            if (ch == '=') {
+                if (i < str.length() - 2) {
+                    throw new IllegalArgumentException("Invalid Base64 padding");
+                }
+                continue;
+            }
+            int value = base64Value(ch);
+            if (value < 0) {
