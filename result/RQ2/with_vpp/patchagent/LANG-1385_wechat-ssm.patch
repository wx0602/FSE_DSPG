+	private static Number createNumberSafely(String value) {
+		if (value == null) {
+			throw new NumberFormatException("null");
+		}
+		String trimmedValue = value.trim();
+		if (trimmedValue.isEmpty()) {
+			throw new NumberFormatException(trimmedValue + " is not a valid number.");
+		}
+		char lastChar = trimmedValue.charAt(trimmedValue.length() - 1);
+		if (trimmedValue.length() == 1 && !Character.isDigit(lastChar)) {
+			throw new NumberFormatException(trimmedValue + " is not a valid number.");
+		}
+		return NumberUtils.createNumber(trimmedValue);
+	}
