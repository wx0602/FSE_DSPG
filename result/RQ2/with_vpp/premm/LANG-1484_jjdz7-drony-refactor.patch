+public boolean validateInteger(String str) {
+    logger.info("Validating integer: " + str);
+    if (str == null) {
+        return false;
     }
 
+    String value = str.trim();
+    if (value.isEmpty()) {
+        return false;
+    }
+
+    // Mitigate LANG-1484: avoid relying on NumberUtils.isParsable/isCreatable
+    // for integer validation because affected parsing helpers can disagree on
+    // valid numeric forms such as values ending with a decimal point.
+    try {
+        Integer.parseInt(value);
+        return true;
+    } catch (NumberFormatException ex) {
+        logger.warn("Invalid integer value: {}", str);
+        return false;
+    }
+}
