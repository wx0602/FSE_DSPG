+public static String decrypt(String encryptPassword, String salt) throws Exception {
+        if (StringUtils.isEmpty(encryptPassword) || StringUtils.isEmpty(salt)) {
+            return null;
+        }
+        try {
+            return AesUtil.decrypt(Md5Util.MD5(salt + CommonConst.ZYD_SECURITY_KEY), encryptPassword);
+        } catch (IllegalArgumentException e) {
+            // commons-codec 1.13 may throw IllegalArgumentException when Base64 input is malformed.
+            // Treat invalid ciphertext as an authentication failure instead of propagating the exception.
+            return null;
+        }
+    }}
