-    public static String decrypt(String encryptPassword, String salt) throws Exception {
-        return AesUtil.decrypt(salt, encryptPassword);
+public static String decrypt(String encryptPassword, String salt) throws Exception {
+    if (encryptPassword == null || salt == null) {
+        return null;
     }
+    if (!isStrictBase64(encryptPassword)) {
+        throw new IllegalArgumentException("Illegal Base64 input");
+    }
+    return AesUtil.decrypt(salt, encryptPassword);
 }
+
+private static boolean isStrictBase64(String value) {
+    String candidate = value.trim();
+    if (candidate.isEmpty() || (candidate.length() % 4) != 0) {
+        return false;
+    }
+    for (int i = 0; i < candidate.length(); i++) {
+        char ch = candidate.charAt(i);
+        if ((ch >= 'A' && ch <= 'Z')
+                || (ch >= 'a' && ch <= 'z')
+                || (ch >= '0' && ch <= '9')
+                || ch == '+' || ch == '/' || ch == '=') {
+            continue;
+        }
+        return false;
+    }
+
+    int firstPadding = candidate.indexOf('=');
+    if (firstPadding >= 0) {
+        for (int i = firstPadding; i < candidate.length(); i++) {
+            if (candidate.charAt(i) != '=') {
+                return false;
+            }
+        }
+        if (candidate.length() - firstPadding > 2) {
+            return false;
+        }
+    }
+
+    int padding = 0;
+    for (int i = candidate.length() - 1; i >= 0 && candidate.charAt(i) == '='; i--) {
+        padding++;
+    }
+
+    int effectiveLength = candidate.length() - padding;
+    if (effectiveLength <= 0) {
+        return false;
+    }
+
+    int bitsInLastChar;
+    if (padding == 0) {
+        bitsInLastChar = 8;
+    } else if (padding == 1) {
+        bitsInLastChar = 4;
+    } else if (padding == 2) {
+        bitsInLastChar = 2;
+    } else {
+        return false;
+    }
+
+    char lastChar = candidate.charAt(effectiveLength - 1);
+    int decoded = base64Value(lastChar);
+    if (decoded < 0) {
+        return false;
+    }
+
+    int droppedBits = 6 - bitsInLastChar;
+    int mask = (1 << droppedBits) - 1;
+    return (decoded & mask) == 0;
+}
+
+private static int base64Value(char ch) {
+    if (ch >= 'A' && ch <= 'Z') {
+        return ch - 'A';
+    }
+    if (ch >= 'a' && ch <= 'z') {
+        return ch - 'a' + 26;
+    }
+    if (ch >= '0' && ch <= '9') {
+        return ch - '0' + 52;
+    }
+    if (ch == '+') {
+        return 62;
+    }
+    if (ch == '/') {
+        return 63;
+    }
+    return -1;
+}}
