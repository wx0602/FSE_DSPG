  month={},}@INPROCEEDINGS{11121210,
  author={Liao, Ben and Lin, Sophia and Etta, Dheeraj and Afridi, Khurram K.},
  booktitle={2025 IEEE 26th Workshop on Control and Modeling for Power Electronics (COMPEL)}, 
  title={A Full State Feedback Controller for Dynamic Capacitive Wireless Power Transfer Systems}, 
  year={2025},
