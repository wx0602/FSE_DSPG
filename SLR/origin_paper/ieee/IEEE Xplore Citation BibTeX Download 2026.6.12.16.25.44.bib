  title={Design TLBO Fuzzy Fractional Order PID Filter Controller for AVR Excitation System}, 
  year={2025},
  volume={13},
  number={},
  pages={216466-216495},
  abstract={Power grid stability depends on precise voltage regulation in synchronous generators. Conventional Automatic Voltage Regulator (AVR) systems face ongoing challenges, including slow dynamic response, oscillations, and sensitivity to load variations. To address these issues, this paper proposes two advanced controllers optimized using the Teaching–Learning–Based Optimization (TLBO) algorithm, which simulates classroom learning processes to minimize fitness functions: Fuzzy Fractional Order PID Derivative Filters (TLBO–FFOPIDF) and Fractional Order PID Derivative Filters (TLBO–FOPIDF). By improving the dynamic response to disturbances and time delays, these controllers ensure the generator’s output voltage remains within the specified limits. The TLBO–optimized controllers demonstrate superior performance in managing voltage fluctuations ranging from 0.5 to 1.2 (pu). The TLBO–FFOPIDF achieves a 32% faster settling time and 47% lower overshoot compared to traditional methods. Compared to fractional–order alternatives, the proposed controller reduces steady–state noise amplitude by 21% and mitigates noise variance by 68%. The TLBO–FFOPIDF shows a 23.7% lower peak deviation and a 41.2% faster stabilization time under sudden load changes. Robustness evaluations under 25% parameter variations reveal maximum deviations of less than 0.8%, confirming exceptional stability. Comparisons with other metaheuristic–based PID and FOPID controllers further validate its effectiveness. Due to its exceptional flexibility, precision, and robustness, the TLBO–FFOPIDF controller can enhance the performance of AVR systems in modern power grids.},
  keywords={Optimization;Tuning;Voltage control;Noise;Robustness;Real-time systems;Filtering algorithms;Metaheuristics;Computational efficiency;Heuristic algorithms;Fuzzy logic controller;fractional order PID;TLBO;AVR system},
  doi={10.1109/ACCESS.2025.3647583},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11381084,
  author={Kaur, Kanwalinderjit and Koli, Atharva R.},
  booktitle={2025 IEEE 16th Annual Information Technology, Electronics and Mobile Communication Conference (IEMCON)}, 
  title={Secure and Reusable Memory Protection for AVR Microcontrollers Using an External Tamper-Detection Countermeasure}, 
  year={2025},
  volume={},
  number={},
  pages={0358-0363},
  abstract={This paper presents a novel hardware-based countermeasure for securing memory in AVR microcontrollers against physical tampering. The system integrates a secondary AVR device that continuously monitors the target's UART RX/TX pins for unauthorized serial communication activity and triggers a fast 30-ms backup-and-wipe routine upon detection, followed by bootloader restoration for reusability. This response includes a backup of application firmware using a logger to a Wi-Fi enabled SD card and a secure memory wipe, followed by automatic bootloader restoration, thereby preserving device reusability. Unlike traditional self-destruct mechanisms that render devices permanently inoperable, this solution balances data protection with operational recovery. Implemented using off-the-shelf components and standard communication protocols (UART, SPI), the system offers an accessible, low-cost approach to embedded hardware security. Experimental results show consistent triggering within 30 milliseconds, an average backup duration of 26.8 s, and an erase latency of 33 ms, validating applicability in critical environments such as industrial controllers, automotive ECUs, and offline embedded systems.},
  keywords={Reduced instruction set computing;Protocols;Microcontrollers;Memory management;Protection;Sustainable development;Monitoring;Wireless fidelity;Standards;Microprogramming;AVR;RISC;countermeasure;self-destruct;zeroization;microcontroller;ATmega;Arduino;Adafruit},
  doi={10.1109/IEMCON67450.2025.11381084},
