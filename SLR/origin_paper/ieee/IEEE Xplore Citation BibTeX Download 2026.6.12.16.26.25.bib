@INPROCEEDINGS{11334222,
  author={Yuan, Hang and Hou, Xizhi and Yu, Lei and Yang, Li and Tang, Jiayue and Xu, Jiadong and Liu, Yifei and Zhang, Fengjun and Zuo, Chun},
  booktitle={2025 40th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={Leveraging Mixture-of-Experts Framework for Smart Contract Vulnerability Repair with Large Language Model}, 
  year={2025},
  volume={},
  number={},
  pages={1667-1679},
  abstract={Smart contracts are a core component of blockchain ecosystems, but their transparency and immutability make them vulnerable to attacks, leading to significant financial losses. Thus, repairing vulnerabilities in smart contracts is crucial for establishing a trustworthy blockchain environment. Existing smart contract vulnerability repair methods suffer from a critical "one-for-all" design limitation, where a single model is tasked with fixing diverse vulnerability types, leading to suboptimal performance due to insufficient specialization. To address this, we propose MoEFix, a novel framework leveraging a Mixture-of-Experts (MoE) architecture tailored for smart contract characteristics. MoEFix partitions vulnerabilities into subspaces, trains specialized experts for each type (e.g., reentrancy, integer overflow), and employs a vulnerability-aware router to dynamically allocate repairs. We further redesign the repair workflow to align with large language models, enabling end-to-end secure contract generation instead of partial patches, and to achieve this, we curated a dataset of 1,391 contracts covering five critical vulnerability types.To validate our approach, we extend the benchmark PVD test suite. Experiments demonstrate that MoEFix outperforms state-of-the-art methods by 21.64% in overall accuracy, achieving improvements of 26.19% (reentrancy) and 23.08% (delegatecall) for specific vulnerabilities.},
  keywords={Accuracy;Large language models;Smart contracts;Maintenance engineering;Routing;Reliability engineering;Blockchains;Software reliability;Security;Software engineering;Smart Contract;Large Language Models;Mixture of Experts},
  doi={10.1109/ASE63991.2025.00140},
  ISSN={2643-1572},
  month={Nov},}@INPROCEEDINGS{10851068,
  author={Garidzira, Tinashe Crispen and Matobobo, Courage},
  booktitle={2024 4th International Multidisciplinary Information Technology and Engineering Conference (IMITEC)}, 
  title={A GraphQL API for Product Recommendation in Women's Clothing Based on Deep Learning Analysis of Product Reviews}, 
  year={2024},
  volume={},
  number={},
  pages={321-327},
  abstract={Automated Product Recommendation (APR) plays a vital role in modern technology by leveraging Artificial Neural Network (ANN) models powered by deep learning techniques. This study focuses on improving consumer decision-making for women's clothing through an APR system that analyzes review text and approval ratings. GraphQL Application Programming Interface (API) integration facilitates seamless interaction with the recommendation system, allowing efficient querying and retrieval of personalized product recommendations. The developed ANN model showed remarkable effectiveness, achieving an accuracy of 51% in predicting product ratings and an accuracy of 87% in recommending products.},
  keywords={Deep learning;Accuracy;Reviews;Clothing;Artificial neural networks;Predictive models;Prediction algorithms;Servers;Recommender systems;Application programming interfaces;Automated Product Recommendation (APR);Artificial Neural Network (ANN);Deep Learning;GraphQL API;Women's Clothing},
  doi={10.1109/IMITEC60221.2024.10851068},
  ISSN={},
  month={Nov},}@ARTICLE{10521633,
  author={Chen, Jianqi and Zhang, Yilan and Liu, Chenyang and Chen, Keyan and Zou, Zhengxia and Shi, Zhenwei},
  journal={IEEE Transactions on Geoscience and Remote Sensing}, 
  title={Digital-to-Physical Visual Consistency Optimization for Adversarial Patch Generation in Remote Sensing Scenes}, 
  year={2024},
  volume={62},
  number={},
  pages={1-17},
  abstract={In contrast to digital image adversarial attacks, adversarial patch attacks involve physical operations that project crafted perturbations into real-world scenarios. During the digital-to-physical transition, adversarial patches inevitably undergo information distortion. Existing approaches focus on data augmentation and printer color gamut regularization to improve the generalization of adversarial patches to the physical world. However, these efforts overlook a critical issue within the adversarial patch crafting pipeline—namely, the significant disparity between the appearance of adversarial patches during the digital optimization phase and their manifestation in the physical world. This unexplored concern, termed “digital-to-physical visual inconsistency,” introduces inconsistent objectives between the digital and physical realms, potentially skewing optimization directions for adversarial patches. To tackle this challenge, we propose a novel harmonization-based adversarial patch attack. Our approach involves the design of a self-supervised harmonization method, seamlessly integrated into the adversarial patch generation pipeline. This integration aligns the appearance of adversarial patches overlaid on digital images with the imaging environment of the background, ensuring a consistent optimization direction with the primary physical attack goal. We validate our method through extensive testing on the aerial object detection task. To enhance the controllability of environmental factors for method evaluation, we construct a dataset of 3-D simulated scenarios using a graphics rendering engine. Extensive experiments on these scenarios demonstrate the efficacy of our approach. Our code and dataset are publicly accessible at https://github.com/WindVChen/VCO-AP.},
  keywords={Optimization;Visualization;Perturbation methods;Remote sensing;Digital images;Three-dimensional displays;Training;Adversarial patch;object detection;physical adversarial attack;remote sensing},
  doi={10.1109/TGRS.2024.3397678},
  ISSN={1558-0644},
  month={},}@INPROCEEDINGS{11094358,
  author={Pei, Gensheng and Chen, Tao and Wang, Yujia and Cai, Xinhao and Shu, Xiangbo and Zhou, Tianfei and Yao, Yazhou},
  booktitle={2025 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={Seeing What Matters: Empowering CLIP with Patch Generation-to-Selection}, 
  year={2025},
  volume={},
  number={},
  pages={24862-24872},
  abstract={The CLIP model has demonstrated significant advancements in aligning visual and language modalities through large-scale pre-training on image-text pairs, enabling strong zero-shot classification and retrieval capabilities on various domains. However, CLIP’s training remains computationally intensive, with high demands on both data processing and memory. To address these challenges, recent masking strategies have emerged, focusing on the selective removal of image patches to improve training efficiency. Although effective, these methods often compromise key semantic information, resulting in suboptimal alignment between visual features and text descriptions. In this work, we present a concise yet effective approach called Patch Generation-to-Selection (CLIP-PGS) to enhance CLIP’s training efficiency while preserving critical semantic con tent. Our method introduces a gradual masking process in which a small set of candidate patches is first pre-selected as potential mask regions. Then, we apply Sobel edge detection across the entire image to generate an edge mask that prioritizes the retention of the primary object areas. Finally, similarity scores between the candidate mask patches and their neighboring patches are computed, with optimal transport normalization refining the selection process to ensure a balanced similarity matrix. Our approach, CLIP-PGS, sets new state-of-the-art results in zero-shot classification and retrieval tasks, achieving superior performance in robustness evaluation and language compositionality benchmarks.},
  keywords={Training;Adaptation models;Visualization;Computational modeling;Image edge detection;Semantics;Refining;Self-supervised learning;Robustness;Pattern recognition;language-image pre-training;masked image modeling;patch-wise masking},
  doi={10.1109/CVPR52734.2025.02315},
  ISSN={2575-7075},
  month={June},}@ARTICLE{10530890,
  author={Liu, Bing and Yuan, Di and Li, Xiaofang},
  journal={IEEE Transactions on Emerging Topics in Computational Intelligence}, 
  title={APR-Net Tracker: Attention Pyramidal Residual Network for Visual Object Tracking}, 
  year={2025},
  volume={9},
  number={1},
  pages={552-564},
  abstract={Visual object tracking has attracted much attention thanks to its remarkable capability to identify a moving target accurately in real-world video scenarios. Recently, tracking performance has improved significantly. However, there is still a lot of progress space to achieve consummate tracking performance because of the complex and varied target and its surrounding background. How to trade-off between accuracy, robustness, and approximately real-time performance is crucial for visual object tracking. We find that when attention mechanisms are integrated into the pyramidal residual network, they can subtly describe the appearance of the target object, which provides a strong guarantee for accurate, robust, and high-performance visual object tracking. Based on this find, we propose a simple yet powerful visual object tracking algorithm, APR-Net, that automatically searches various scales and significant regions. The comprehensive experimental results on multiple benchmarks demonstrate that the proposed APR-Net tracker attains the desired performance improvement in accuracy and robustness while achieving near real-time tracking performance in various real-world applications.},
  keywords={Target tracking;Visualization;Object tracking;Residual neural networks;Feature extraction;Task analysis;Robustness;Attention mechanism;visual object tracking;pyramidal convolutional residual network;deep learning},
  doi={10.1109/TETCI.2024.3398011},
  ISSN={2471-285X},
  month={Feb},}@ARTICLE{10663553,
  author={Dai, Fei and Gao, Song},
  journal={IEEE Access}, 
  title={Optimal Design of a PIDD2 Controller for an AVR System Using Hybrid Whale Optimization Algorithm}, 
  year={2024},
  volume={12},
  number={},
  pages={128525-128540},
  abstract={Many meta-heuristic algorithms have been used in designing PID controllers to control automatic voltage regulator (AVR) system. PIDD2 controller is a PID controller with second-order derivative gain. The fireworks whale optimization algorithm is an advanced metaheuristic algorithm that combines fireworks and whale optimization algorithms. It has good exploratory properties because it explores a large potential space and avoids premature local optima. This paper presents a PIDD2 controller for improving the performance of the AVR system using the hybrid whale optimization algorithm. The simulation results, divided into two parts based on whether the limitation of the excitation voltage is considered or not, include a detailed analysis of the proposed controller in terms of step response, stability analysis, trajectory tracking, parameter uncertainty, and rejection of disturbance. To demonstrate the effectiveness of the proposed controller of the AVR system, it was compared with the controllers in recent literature in each of the aforementioned terms. The proposed controller, in most comparisons, provides better results than other controllers. All these results demonstrate that the performance and robustness of the proposed controller are competitive.},
  keywords={Voltage control;Generators;Whale optimization algorithms;Transfer functions;Tuning;Synchronous generators;Automatic voltage control;Optimal control;Automatic voltage regulator;PIDD² controller;optimal control;hybrid whale optimization algorithm},
  doi={10.1109/ACCESS.2024.3454107},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11411286,
  author={Mahapatra, Mou Das and Mahata, Shibendu and Saha Roy, Biman Kumar},
  booktitle={2025 First International Conference of Advances in Engineering and Computing Technologies for Sustainable Development (AECTSD)}, 
  title={Geometric mean optimizer-based optimal tuning of FOPIDD2 controller for AVR system}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Voltage variation at the generator terminal is a key concern in power systems. For an automatic voltage regulator (AVR) system, the current research extends the traditional PID controller by combining a fractional-order integral and derivative terms along with an extra second-order derivative term (FOPIDD2). The parameters of the proposed controller are optimized by a relatively new metaheuristic approach called geometric mean optimizer (GMO), which effectively navigate complex search spaces. The GMO algorithm minimizes the fitness function (FF) based on integral time-weighted absolute error (ITAE) in MATLAB R2023b. Comparative analysis shows that the GMO-tuned FOPIDD2 controller performs much better than other metaheuristic-based PID and FOPID controllers. It provides smoother transient response, lower peak overshoot, and settles faster. The simulation outputs also show that the efficient search ability of GMO technique and dynamics of fractional-order double derivative behavior improve voltage regulation in AVR systems. Lastly, the proposed controller show a high degree of robustness against uncertainty on plant parameters providing a strong design for practical AVR.},
  keywords={Transient response;Uncertainty;Regulators;Metaheuristics;Power system dynamics;Robustness;Automatic voltage control;MATLAB;Transient analysis;Tuning;automatic voltage regulator;fractional-order control;double derivative control;geometric mean optimizer;integral time absolute error;transient analysis and robustness analysis},
  doi={10.1109/AECTSD65988.2025.11411286},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11297707,
  author={Piovesan, Talis and Lenz, João Manoel and Bolsi, Pedro C. and Mendonça, Luan A. C. and Teckio, Erick P. R. and Prado, Edemar O. and Sartori, Hamiltom C. and Pinheiro, José Renes},
  booktitle={2025 17th Seminar on Power Electronics and Control (SEPOC)}, 
  title={Lifetime and Reliability Analysis of Electromagnetic Relays in UPS-AVR Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a lifetime estimation for a 12V general purpose electromagnetic relay, commonly used in industrial and automotive applications, and widely employed in uninterruptible power supply (UPS) systems to perform the Automatic Voltage Regulator (AVR) process. This analysis is based on the FIDES Guide methodology, which provides a framework to calculate the failure rate of mechanical, electromechanical, and electronic components. In this work, a commercial line-interactive UPS product is used as a case study for the analysis. In addition, three potential scenarios for the AVR are evaluated, each influencing the number of relay switching operations required to regulate the output voltage. The analysis performed for Scenario 1 demonstrates that the reliability of the electromagnetic relays which are part of the UPS AVR is influenced by multiple interdependent factors. In addition, the step-time control algorithm has a significant impact on both the operational performance and the long-term durability of the relays. Therefore, the power converter designer is faced with a critical trade-off: determining an appropriate control step time and voltage regulation strategy that not only ensures stable and periodic voltage regulation but also avoids a substantial increase in relay failure rates during the first year of operation.},
  keywords={Warranties;Regulators;Automotive applications;Switches;Transformers;Reliability;Relays;Voltage control;Electromagnetics;Uninterruptible power systems;Automatic Voltage Regulator;Electromagnetic Relay;FIDES Guide Methodology;Uninterruptible Power Supply},
  doi={10.1109/SEPOC67005.2025.11297707},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10723906,
  author={Pandey, Pranjal Mohan and Pandey, Vedant and Mitra, Sakalya and Pandey, Shruti and Singh, Arpit and Avr, Mayuri},
  booktitle={2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Scale Invariant Feature Modelling with Integrated Transfer Learning for Parkinson’s Disease Diagnosis}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={A common brain illness known as Parkinson’s Disease (PD) has been a topic of research for decades. The disease, well known for causing several impairments, affecting daily life activities of the sufferers need promising treatments to reduce the agony of the patients. Since, there are no known cures and proved underlying causes for this disease, diagnosing it at an early stage becomes a challenge. AI based solutions have proven out to serve as a potential approach for the early-stage diagnosis of the disease. Several types of datasets comprising of genetic data, clinical data, medical image, voice samples and hand-drawings are being utilized for training these AI based solutions. However, there exists a few problems which are not yet addressed: a. lack of models trained on hand drawings dataset having different categories of shapes, b. lack of scale invariant feature modelling, c. lack of study combining high level features and scale invariant features. This work proposes a solution to these issues by employing a model capable of extracting both scale invariant and high-level features from a hand-drawn image dataset having various shapes which are finally classified using a dense layer. When evaluating, the model has outperformed the existing best solutions for the considered performance metrics.},
  keywords={Training;Measurement;Shape;Transfer learning;Predictive models;Feature extraction;Medical diagnosis;Artificial intelligence;Medical diagnostic imaging;Diseases;Brain Disease;Parkinson’s Disease;SIFT;Scale Invariant Features;High Level Features},
  doi={10.1109/ICCCNT61001.2024.10723906},
  ISSN={2473-7674},
  month={June},}@INPROCEEDINGS{11518689,
  author={AshaRani, K. and Balaji, A. and Chauhan, Jyoti and Mayuri, AVR and Periyanayagi, S},
  booktitle={2026 3rd International Conference on Research Methodologies in Knowledge Management, Artificial Intelligence and Telecommunication Engineering (RMKMATE)}, 
  title={Diabetic Retinopathy Detection Using Deep Learning Using Generative Adversarial Networks (GANs) With Enhanced Cat Swarm Optimization (ECSO) Algorithm}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Diabetic retinopathy (DR) is a serious side effect of long-term diabetes that causes eye problems and eventually blindness. In the early stages of DR, affected individuals typically exhibit no visible symptoms. Manual identification is difficult because to the alterations and progression of tiny lesions in the retina. The complications of recognizing lesion signs have made it particularly challenging to classify the numerous stages of DR. As a result, having an effective technique for detecting retinal disorders throughout the screening process is essential. Deep learning algorithms play an significant role in the early detection and diagnosis of these illnesses. This study presents a novel deep learning model to improve DR detection using retinal fundus images by combining Generative Adversarial Networks (GANs) with an Enhanced Cat Swarm Optimization (ECSO) technique. Class imbalance issues are resolved and the dataset is supplemented with high-quality synthetic images produced by the GAN component. Meanwhile, ECSO is used to optimize hyperparameters and the process of selecting the features of the deep learning model to progress the convergence rate and the accuracy of the classification. The experimental findings made on publicly available DR datasets indicate that the GAN-ECSO method is more sensitive, specific, and accurate in general compared to the conventional methods. The results of the research outline the consequence of utilizing a combination of data augmentation and metaheuristic optimization to detect DR and be robust and efficient in a scalable manner.},
  keywords={Modeling;Equations;Medical services;Signal detection;Deep learning;Diabetic retinopathy;Printing;Accuracy;Retina;Optimization;DR;DL;Feature Selection;Generative Adversarial Networks (GANs);Enhanced Cat Swarm Optimization (ECSO)},
  doi={10.1109/RMKMATE69073.2026.11518689},
  ISSN={},
  month={April},}@INPROCEEDINGS{11326853,
  author={Kar, Manoj Kumar and Kumaraswamy, A and Tripathy, Prashanta Kumar and Pradhan, Pratap Chandra and Puhan, Abhijita and Mahto, Tarkeshwar},
  booktitle={2025 5th IEEE International Conference on Applied Electromagnetics, Signal Processing, & Communication (AESPC)}, 
  title={Grey Wolf Optimizer-Based Tuning of an Automatic Voltage Regulator for Enhanced Stability}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={An Automatic Voltage Regulator (AVR) is used in synchronous generator systems to maintain a consistent output voltage by controlling the excitation current. Ensuring optimal performance of the AVR requires effective tuning of its controller parameters, especially in the presence of load disturbances and system nonlinearities. In this study, the Grey Wolf Optimizer (GWO) is employed to design and optimize the AVR system. Its ability to avoid local minima and converge toward a global optimum makes it a suitable candidate for dynamic controller tuning problems. Different cases such as transient, bode, root locus, and sensitivity analysis has been carried out to justify the effectiveness of the GWO method.},
  keywords={Regulators;Sensitivity analysis;Power system dynamics;Power system stability;Stability analysis;Automatic voltage control;Synchronous generators;Robustness;Transient analysis;Tuning;AVR;GWO;PID;Transient analysis;Sensitivity analysis},
  doi={10.1109/AESPC67542.2025.11326853},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11029841,
  author={Parasaram, Nikhil and Yan, Huijie and Yang, Boyu and Flahy, Zineb and Qudsi, Abriele and Ziaber, Damian and Barr, Earl T. and Mechtaev, Sergey},
  booktitle={2025 IEEE/ACM 47th International Conference on Software Engineering (ICSE)}, 
  title={The Fact Selection Problem in LLM-Based Program Repair}, 
  year={2025},
  volume={},
  number={},
  pages={2574-2586},
  abstract={Recent research has shown that incorporating bug-related facts, such as stack traces and GitHub issues, into prompts enhances the bug-fixing capabilities of large language models (LLMs). Considering the ever-increasing context window of these models, a critical question arises: what and how many facts should be included in prompts to maximise the chance of correctly fixing bugs? To answer this question, we conducted a large-scale study, employing over 19K prompts featuring various combinations of seven diverse facts to rectify 314 bugs from open -source Python projects within the BugsInPy benchmark. Our findings revealed that each fact, ranging from simple syntactic details like code context to semantic information previously unexplored in the context of LLMs such as angelic values, is beneficial. Specifically, each fact aids in fixing some bugs that would remain unresolved or only be fixed with a low success rate without it. Importantly, we discovered that the effectiveness of program repair prompts is non-monotonic over the number of used facts; using too many facts leads to subpar outcomes. These insights led us to define the fact selection problem: determining the optimal set of facts for inclusion in a prompt to maximise LLM's performance on a given task instance. We found that there is no one-size-fits-all set of facts for bug repair. Therefore, we developed a basic statistical model, named Maniple, which selects facts specific to a given bug to include in the prompt. This model significantly surpasses the performance of the best generic fact set. To underscore the significance of the fact selection problem, we benchmarked Maniple against the state-of-the-art zero-shot, non-conversational LLM-based bug repair methods. On our testing dataset of 157 bugs, Maniple repairs 88 bugs, 17% above the best configuration.},
  keywords={Systematics;Large language models;Computer bugs;Semantics;Maintenance engineering;Benchmark testing;Syntactics;Software engineering;Software development management;Python;automated program repair;large language models;prompt engineering},
  doi={10.1109/ICSE55347.2025.00162},
  ISSN={1558-1225},
  month={April},}@INPROCEEDINGS{11121734,
  author={Rondon, Pat and Wei, Renyao and Cambronero, José and Cito, Jürgen and Sun, Aaron and Sanyam, Siddhant and Tufano, Michele and Chandra, Satish},
  booktitle={2025 IEEE/ACM 47th International Conference on Software Engineering: Software Engineering in Practice (ICSE-SEIP)}, 
  title={Evaluating Agent-Based Program Repair at Google}, 
  year={2025},
  volume={},
  number={},
  pages={365-376},
  abstract={Agent-based program repair offers to automatically resolve complex bugs end-to-end by combining the planning, tool use, and code generation abilities of modern LLMs. Recent work has explored the use of agent-based repair approaches on the popular open-source SWE-Bench [1], a collection of bugs from highly-rated GitHub Python projects. In addition, various agentic approaches such as SWE-Agent [2] have been proposed to solve bugs in this benchmark. This paper explores the viability of using an agentic approach to address bugs in an enterprise context. To investigate this, we curate an evaluation set of 178 bugs drawn from Google's issue tracking system. This dataset spans both human-reported (78) and machine-reported bugs (100). To establish a repair performance baseline on this benchmark, we implement Passerine, an agent similar in spirit to SWE-Agent that can work within Google's development environment. We show that with 20 trajectory samples and Gemini 1.5 Pro, Passerine can produce a patch that passes bug tests (i.e., plausible) for 73% of machine-reported and 25.6% of human-reported bugs in our evaluation set. After manual examination, we found that 43% of machine-reported bugs and 17.9% of human-reported bugs have at least one patch that is semantically equivalent to the ground-truth patch. These results establish a baseline on an industrially relevant benchmark, which as we show, contains bugs drawn from a different distribution—in terms of language diversity, size, and spread of changes, etc.—compared to those in the popular SWE-Bench dataset.},
  keywords={Codes;Computer bugs;Symbols;Manuals;Maintenance engineering;Benchmark testing;Internet;Trajectory;Software engineering;Software development management;automated program repair;large language models;agentic systems},
  doi={10.1109/ICSE-SEIP66354.2025.00038},
  ISSN={2832-7659},
  month={April},}@INPROCEEDINGS{11028362,
  author={Ramos, Daniel and Mamede, Claudia and Jain, Kush and Canelas, Paulo and Gamboa, Catarina and Le Goues, Claire},
  booktitle={2025 IEEE/ACM International Workshop on Large Language Models for Code (LLM4Code)}, 
  title={Are Large Language Models Memorizing Bug Benchmarks?}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Large Language Models (LLMs) have become integral to various software engineering tasks, including code generation, bug detection, and repair. To evaluate model performance in these domains, numerous bug benchmarks containing real-world bugs from software projects have been developed. However, a growing concern within the software engineering community is that these benchmarks may not reliably reflect true LLM performance due to the risk of data leakage. Despite this concern, limited research has been conducted to quantify the impact of potential leakage.In this paper, we systematically evaluate popular LLMs to assess their susceptibility to data leakage from widely used bug benchmarks. To identify potential leakage, we use multiple metrics, including a study of benchmark membership within commonly used training datasets, as well as analyses of negative log-likelihood and 5-gram accuracy. Our findings show that certain models, in particular codegen-multi, exhibit significant evidence of memorization in widely used benchmarks like Defects4J, while newer models trained on larger datasets like LLaMa 3.1 exhibit limited signs of leakage. These results highlight the need for careful benchmark selection and the adoption of robust metrics to adequately assess models capabilities.},
  keywords={Training;Measurement;Codes;Accuracy;Large language models;Computer bugs;Benchmark testing;Maintenance engineering;Data models;Software engineering;Automated Program Repair;Large Language Model;Data Leakage},
  doi={10.1109/LLM4Code66737.2025.00005},
  ISSN={},
  month={May},}@INPROCEEDINGS{11190120,
  author={Blyth, Scott and Licorish, Sherlock A. and Treude, Christoph and Wagner, Markus},
  booktitle={2025 IEEE International Conference on Source Code Analysis & Manipulation (SCAM)}, 
  title={Static Analysis as a Feedback Loop: Enhancing LLM-Generated Code Beyond Correctness}, 
  year={2025},
  volume={},
  number={},
  pages={100-109},
  abstract={Large language models (LLMs) have demonstrated impressive capabilities in code generation, achieving high scores on benchmarks such as HumanEval and MBPP. However, these benchmarks primarily assess functional correctness and neglect broader dimensions of code quality, including security, reliability, readability, and maintainability. In this work, we systematically evaluate the ability of LLMs to generate high-quality code across multiple dimensions using the PythonSecurityEval benchmark. We introduce an iterative static analysis-driven prompting algorithm that leverages Bandit and Pylint to identify and resolve code quality issues. Our experiments with GPT-4o show substantial improvements: security issues reduced from >40% to 13%, readability violations from >80% to 11%, and reliability warnings from >50% to 11% within ten iterations. These results demonstrate that LLMs, when guided by static analysis feedback, can significantly enhance code quality beyond functional correctness.},
  keywords={Resistance;Measurement;Codes;Large language models;Static analysis;Benchmark testing;Maintenance engineering;Iterative algorithms;Security;Reliability;Static analysis;automated program repair;large language models;code quality;code generation},
  doi={10.1109/SCAM67354.2025.00017},
  ISSN={2470-6892},
  month={Sep.},}@INPROCEEDINGS{11029932,
  author={Shabani, Taha and Nashid, Noor and Alian, Parsa and Mesbah, Ali},
  booktitle={2025 IEEE/ACM 47th International Conference on Software Engineering (ICSE)}, 
  title={Dockerfile Flakiness: Characterization and Repair}, 
  year={2025},
  volume={},
  number={},
  pages={1793-1805},
  abstract={Dockerfile flakiness-unpredictable temporal build failures caused by external dependencies and evolving environments-undermines deployment reliability and increases debugging overhead. Unlike traditional Dockerfile issues, flakiness occurs without modifications to the Dockerfile itself, complicating its resolution. In this work, we present the first comprehensive study of Dockerfile flakiness, featuring a nine-month analysis of 8,132 Dockerized projects, revealing that around 10% exhibit flaky behavior. We propose a taxonomy categorizing common flakiness causes, including dependency errors and server connectivity issues. Existing tools fail to effectively address these challenges due to their reliance on pre-defined rules and limited generalizability. To overcome these limitations, we introduce FLAKIDOCK, a novel repair framework combining static and dynamic analysis, similarity retrieval, and an iterative feedback loop powered by Large Language Models (LLMs). Our evaluation demonstrates that FLAKIDOCK achieves a repair accuracy of 73.55%, significantly surpassing state-of-the-art tools and baselines.},
  keywords={Feedback loop;Accuracy;Large language models;Taxonomy;Retrieval augmented generation;Maintenance engineering;Reliability;Iterative methods;Servers;Software engineering;Docker;Flakiness;Large Language Models;Automated Program Repair},
  doi={10.1109/ICSE55347.2025.00238},
  ISSN={1558-1225},
  month={April},}@INPROCEEDINGS{11024295,
  author={Fan, Zhiyu and Noller, Yannic and Dandekar, Ashish and Roychoudhury, Abhik},
  booktitle={2025 IEEE/ACM 37th International Conference on Software Engineering Education and Training (CSEE&T)}, 
  title={Software Engineering Educational Experience in Building an Intelligent Tutoring System}, 
  year={2025},
  volume={},
  number={},
  pages={75-86},
  abstract={The growing number of students enrolling in Computer Science (CS) programmes is pushing CS educators to their limits. This poses significant challenges to computing education, particularly the teaching of introductory programming and advanced software engineering (SE) courses. First-year programming courses often face overwhelming enrollments, including interdisciplinary students who are not CS majors. The high teacher-to-student ratio makes it challenging to provide timely and highquality feedback. Meanwhile, software engineering education comes with inherent difficulties like acquiring industry partners and the dilemma that such software projects are often under or over-specified and one-time efforts within one team or one course. To address these challenges, we designed a novel foundational SE course. This SE course envisions building a full-fledged Intelligent Tutoring System (ITS) of Programming Assignments to provide automated, real-time feedback for novice students in programming courses over multiple years. Each year, SE students contribute to specific short-running SE projects that improve the existing ITS implementation, while at the same time, we can deploy the ITS for usage by students for learning programming. This project setup builds awareness among SE students about their contribution to a “to-be-deployed” software project. In this multi-year teaching effort, we have incrementally built an ITS that is now deployed in various programming courses. This paper discusses the Intelligent Tutoring System architecture, our teaching concept in the SE course, our experience with the built ITS, and our view of future computing education.},
  keywords={Industries;Large language models;Education;Buildings;Systems architecture;Maintenance engineering;Software;Real-time systems;Programming profession;Software engineering;computer science education;software engineering;CS-1;automated program repair;large language models;intelligent tutoring},
  doi={10.1109/CSEET66350.2025.00015},
  ISSN={2832-7578},
  month={April},}@INPROCEEDINGS{11185877,
  author={Zerin, Tasmia and Asad, Moumita and Hossain, B M Mainul and Sakib, Kazi},
  booktitle={2025 IEEE International Conference on Software Maintenance and Evolution (ICSME)}, 
  title={Repairing Responsive Layout Failures Using Retrieval Augmented Generation}, 
  year={2025},
  volume={},
  number={},
  pages={845-850},
  abstract={Responsive websites frequently experience distorted layouts at specific screen sizes, called Responsive Layout Failures (RLFs). Manually repairing these RLFs involves tedious trial-and-error adjustments of HTML elements and CSS properties. In this study, an automated repair approach, leveraging LLM combined with domainspecific knowledge is proposed. The approach is named ReDeFix, a Retrieval-Augmented Generation (RAG)-based solution that utilizes Stack Overflow (SO) discussions to guide LLM on CSS repairs. By augmenting relevant SO knowledge with RLF-specific contexts, ReDeFix creates a prompt that is sent to the LLM to generate CSS patches. Evaluation demonstrates that our approach achieves an $\text{8 8 \%}$ accuracy in repairing RLFs. Furthermore, a study from software engineers reveals that generated repairs produce visually correct layouts while maintaining aesthetics.},
  keywords={Software maintenance;Accuracy;Web design;Layout;Retrieval augmented generation;Maintenance engineering;Responsive Web Design;Automated Program Repair;RAG-based tool;LLM;Stack Overflow},
  doi={10.1109/ICSME64153.2025.00090},
  ISSN={2576-3148},
  month={Sep.},}@INPROCEEDINGS{11360011,
  author={Li, Haoxuan},
  booktitle={2025 5th International Conference on Computer, Internet of Things and Control Engineering (CITCE)}, 
  title={Graph Neural Network-Based Automatic Detection and Repair of Code Vulnerabilities}, 
  year={2025},
  volume={},
  number={},
  pages={77-82},
  abstract={In modern software systems, security vulnerabilities remain a major cause of system crashes, data breaches, and service outages. Traditional static and dynamic analysis tools still suffer from high false-positive rates, limited ability to capture long-range semantic dependencies, and weak support for automated repair, which leaves security teams with large manual workloads. This paper presents an automatic code vulnerability detection and repair framework that combines graph neural networks (GNNs) with a generative patch synthesis module. Source code is first transformed into a joint abstract syntax tree (AST) and controlflow graph (CFG), yielding a heterogeneous program graph. An attention-enhanced GNN encoder extracts joint syntactic, semantic, and dependency features, which feed a vulnerability classifier and a vulnerability-type predictor. For repair, we couple the detector with a generative adversarial network (GAN)-style patch generator that operates on suspicious code hunks and is guided by a learned vulnerability template library and unit tests. Experiments on the Vul4J and SARD benchmark datasets show that the proposed framework achieves a vulnerability detection accuracy of 89.7%, reduces the false-positive rate to 7.2%, and improves accuracy by 12.5 percentage points over conventional machine-learning baselines. The repair module reaches a patch success rate of 78.3 % and improves repair efficiency by more than 20% over a static template-based tool, while covering 92% of common vulnerability types such as buffer overflows and nullpointer dereferences. These results suggest that tight integration of graph-based detection and generative repair can provide a practical foundation for large-scale automated software hardening.},
  keywords={Codes;Trees (botanical);Source coding;Semantics;Maintenance engineering;Syntactics;Generative adversarial networks;Feature extraction;Graph neural networks;Generators;code vulnerability detection;graph neural networks;automated program repair;generative adversarial networks;software security},
  doi={10.1109/CITCE67565.2025.11360011},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11334231,
  author={Li, Yuanpeng and Long, Qi and Yao, Zhiyuan and Xu, Jian and Xie, Lintao and He, Xu and Geng, Lu and Han, Xin and Chen, Yueyan and Duan, Wenbo},
  booktitle={2025 40th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={BitsAI-Fix: LLM-Driven Approach for Automated Lint Error Resolution in Practice}, 
  year={2025},
  volume={},
  number={},
  pages={3486-3497},
  abstract={As enterprise codebases continue to grow in scale and complexity, the volume of lint errors far exceeds engineers' manual remediation capacity, leading to continuous accumulation of technical debt and hindered development efficiency. This paper presents BitsAI-Fix, an automated lint error remediation workflow based on Large Language Models (LLMs), designed to address this critical challenge in industrial-scale environments. BitsAI-Fix employs tree-sitter for context expansion and generates search-and-replace format patches through specially trained LLMs, followed by lint scan re-verification to output final remediation results. Additionally, our approach introduces an innovative progressive reinforcement learning (RL) training strategy that can automatically acquire verifiable training data during the project cold-start phase and continuously iterate the model by collecting online samples through feedback after system deployment. Furthermore, we designed a targeted rule-based reward mechanism that combines format rewards and correctness rewards while penalizing redundant modifications. We also propose a "code diff matching" methodology to continuously track online effectiveness. In production deployment at ByteDance, our solution has supported over 5,000 engineers, resolved more than 12,000 static analysis issues, achieved approximately 85% remediation accuracy, with around 1,000 weekly active adopters. This work demonstrates the practical feasibility of LLM-based code remediation solutions in enterprise environments and serves as a reference for automated code fix in large-scale industrial scenarios.},
  keywords={Training;Codes;Target tracking;Large language models;Training data;Reinforcement learning;Static analysis;Production;Manuals;Software engineering;Lint Error;Automated Program Repair;Large Language Model;Reinforcement Learning},
  doi={10.1109/ASE63991.2025.00288},
  ISSN={2643-1572},
  month={Nov},}@INPROCEEDINGS{11024462,
  author={Choi, Dongwook and Lee, Eunseok},
  booktitle={2025 IEEE/ACM 37th International Conference on Software Engineering Education and Training (CSEE&T)}, 
  title={Automated Feedback Generation for Programming Assignments Through Diversification}, 
  year={2025},
  volume={},
  number={},
  pages={230-241},
  abstract={Immediate and personalized feedback on students' programming assignments is important for improving their programming skills. However, it is challenging for instructors to give personalized feedback to every student since each program is written differently. To address this problem, the Automated Feedback Generation (AFG) technique has been proposed, which identifies faults from the wrong program, generates patches, and provides feedback if validation is passed. AFG relies on students' correct programs to find faults and generate patches. Therefore, having diverse correct programs is important for the performance of AFG. However, in small-scale programming courses or new online judge problems, there might be a lack of diversity in correct programs. In this paper, we propose Mentored, a new AFG for students' programming assignments through diversification. Mentored generates new structures of programs through various combinations of programs to gener-ate modifications optimized for wrong programs while solving the problem of dependency on correct programs. Additionally, Mentored provides transparent feedback on the process of repairing wrong programs. We evaluate Mentored on real student programming assignments and compare it with state-of-the-art AFG approaches. Our dataset includes real university in-troductory programming assignments and online judge problems. Experimental results show that Mentored generates higher repair rates and more diverse program structures than other AFG approaches. Moreover, by providing a transparent sequence of repair processes, Mentored is expected to improve students' programming skills and reduce instructors' manual effort in feedback generation. These results indicate that Mentored can be a useful tool in proaramming education.},
  keywords={Fault diagnosis;Education;Genetic programming;Manuals;Maintenance engineering;Iterative methods;Programming profession;Faces;Automated Program Repair;Automated Feed-back Generation;Programming Assignments},
  doi={10.1109/CSEET66350.2025.00030},
  ISSN={2832-7578},
  month={April},}@INPROCEEDINGS{11387924,
  author={Chen, Yuwei and Zhang, Haoxi and Szczerbicki, Edward},
  booktitle={2025 IEEE 6th International Conference on Computer, Big Data, Artificial Intelligence (ICCBD+AI)}, 
  title={AVR-ADF: An Adaptive Visual Retrieval-Augmented Diagnostic Framework for Confusable Skin Diseases}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Multimodal Large Language Models (MLLMs) have demonstrated significant potential in medical diagnostics, yet their accuracy is severely constrained when diagnosing visually confusable skin diseases. Retrieval-Augmented Generation (RAG) offers a promising paradigm to address this issue without fine-tuning. However, applying this paradigm to fine-grained diagnostic tasks through the standard Visual RAG framework reveals two critical bottlenecks: poor retrieval quality from general-purpose models lacking domain specificity, and ineffective context presentation stemming from rigid context lengths and uncertainty over optimal prompt design. To overcome these challenges, we propose the Adaptive Visual Retrieval-Augmented Diagnostic Framework (AVR-ADF). The crux of our framework lies in a novel retriever fine-tuning strategy, which combines Supervised Contrastive (SupCon) learning with domain-specific data augmentation and is optimized using our proposed Clinical Confusion Rate (CCR) metric. This is complemented by SN-EA-k, a hyperparameter-free adaptive context selection algorithm that dynamically determines the optimal number of examples, alongside the finding that a simple In-Context Learning (ICL) prompt is more effective than complex Chain-of-Thought (CoT) counterparts for this task. Experiments on the public PAD dataset show that AVR-ADF substantially boosts the diagnostic accuracy of the baseline model from 53.75% to 83.75% for pigmented lesions and from 55.64% to 76.32% for keratotic lesions. The framework's superiority and generalizability are further validated against state-of-the-art specialized vision-language models, such as PanDerm, and on the public ISIC 2019 benchmark, confirming its effectiveness.},
  keywords={Visualization;Adaptation models;Accuracy;Uncertainty;Benchmark testing;Skin;Robustness;Lesions;Standards;Diseases;deep learning;RAG;MLLMs;dermatology;prompt engineering},
  doi={10.1109/ICCBDAI66607.2025.11387924},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11481249,
  author={Badr, Ahmed O. and Hesham, Omar M. and Attia, Mahmoud A. and Mansour, S. and Mosaad, Ahmed M. and Shaaban, Mostafa F.},
  booktitle={2026 8th International Youth Conference on Radio Electronics, Electrical and Power Engineering (REEPE)}, 
  title={Improved Dynamic Performance of Integrated LFC-AVR Systems Using WHO-Tuned Cascaded Control}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a coordinated control framework for combined Load Frequency Control (LFC) and Automatic Voltage Regulation (AVR) in power systems using a Wild Horse Optimizer (WHO)-tuned cascaded PID-PIDA controller. Unlike conventional decoupled or single-layer PID designs, the proposed approach explicitly accounts for the different dynamic characteristics of frequency and voltage loops by employing a cascaded structure that enhances damping and transient response. The WHO algorithm is utilized to optimally tune all controller parameters simultaneously by minimizing composite performance indices based on voltage and frequency deviations. Simulation studies conducted on a single-area integrated LFC-AVR model demonstrate that the proposed strategy significantly reduces overshoot, undershoot, peak-topeak deviations, and settling time compared with conventional PID controllers optimized using established metaheuristic techniques such as GA, PSO, and FA. The results confirm the effectiveness and robustness of the proposed coordinated control scheme in improving overall power system dynamic performance.},
  keywords={Radio broadcasting;Frequency modulation;Filtering;Oscillators;Filters;Circuits and systems;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Modulation;automatic voltage regulation;cascaded control;load Frequency control;optimization},
  doi={10.1109/REEPE69046.2026.11481249},
  ISSN={2831-7262},
  month={April},}@INPROCEEDINGS{11213320,
  author={Yu, Jun and Yang, Yu and Namboodiri, Vinod},
  booktitle={2025 International Conference on Indoor Positioning and Indoor Navigation (IPIN)}, 
  title={Large-Scale Benchmarking of Vision-Based Indoor Localization Using Absolute Pose Regression}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Navigating indoor environments is challenging due to the absence of satellite signals. Existing solutions often rely on auxiliary sensors such as Bluetooth or LiDAR to estimate user location and provide turn-by-turn navigation cues. However, these approaches typically require the deployment of beacons or transponders throughout a building, increasing installation costs and limiting scalability. In contrast, computer vision-based methods operate independently using only a camera on the user’s device, capturing richer visual information than traditional sensors. This paper focuses on benchmarking absolute pose regression (APR) techniques, which predict a camera’s absolute pose (position and orientation) from a single image in an end-to-end manner. Unlike conventional vision-based approaches, APR does not rely on matching to a 3D model or performing explicit geometric computations such as PnP. While prior work has largely evaluated APR in small-scale environments, we introduce a large-scale image dataset collected in a multi-floor research facility and conduct a comprehensive evaluation of state-of-the-art APR methods. Our results show that APR can achieve robust sub-meter localization accuracy in complex indoor settings, supporting its use as a practical backend for vision-based indoor navigation systems.},
  keywords={Location awareness;Three-dimensional displays;Indoor navigation;Buildings;Artificial neural networks;Benchmark testing;Cameras;Satellite navigation systems;Sensors;Indoor environment;dataset;benchmarking;absolute pose regression (APR);deep neural networks;computer vision},
  doi={10.1109/IPIN66788.2025.11213320},
  ISSN={2471-917X},
  month={Sep.},}@INPROCEEDINGS{11344988,
  author={Irhami, Novi Ayu and Adji, Teguh Bharata and Ardiyanto, Igi},
  booktitle={2025 8th International Conference on Information and Communications Technology (ICOIACT)}, 
  title={Automatic Personality Recognition in Indonesian Informal Chat: An Expert-Annotated Corpus and a Reproducible Within-Corpus Benchmark}, 
  year={2025},
  volume={},
  number={},
  pages={238-243},
  abstract={Automatic Personality Recognition (APR) from text seeks to infer psychological traits from linguistic signals in everyday communication. Most prior work on Indonesian APR has focused on tweet-style posts, leaving dialogic chat-richer in turn-taking, pragmatics, and code-mixing-Iargely unexplored. We address this gap by constructing a manually curated corpus of 3,000 informal chat utterances drawn from 400 sessions and 789 speakers. All messages are de-identified and double-annotated for the Big Five personality traits (OCEAN) by two postgraduate psychology students, with disagreements resolved via adjudication and Cohen's κ ranging from 0.53 to 0.67 (macro-average 0.62). We cast APR as a multi-label classification task and develop a unified, speaker-disjoint training-evaluation protocol for three architectures: APR_ConvBiLSTM, IndoBERT, and RoBERTa-base, each fine-tuned under identical preprocessing, optimization, and multi-seed settings. On the held-out test set, IndoBERT attains the best overall performance (element accuracy 0.762, macro-F1 0.638), outperforming RoBERTa-base (0.735, 0.593) and APR_ConvBiLSTM (0.726, 0.597). Trait-wise F1 scores and multi-label confusion matrix further show that transformers yield clearer gains for Openness, Conscientiousness, Extraversion, and Agreeableness, while Neuroticism remains more challenging. The resulting corpus, protocol, and baseline results provide the first reproducible within-corpus benchmark for Indonesian informal chat and offer a transparent reference point for future work on affective and psycholinguistic NLP in low-resource conversational settings.},
  keywords={Protocols;Accuracy;Text recognition;Oceans;Psychology;Benchmark testing;Transformers;Robustness;Optimization;Pragmatics;Automatic Personality Recognition;Big Five Personality Traits (OCEAN);RoBERTa;IndoBERT;APR_ConvBiLSTM;MLCM},
  doi={10.1109/ICOIACT67584.2025.11344988},
  ISSN={2770-4661},
  month={Dec},}@ARTICLE{11535318,
  author={Maddila, Chandra and Tait, Adam and Chang, Claire and Cheng, Daniel and Ahmad, Nauman and Murali, Vijayaraghavan and Roch, Marshall and Avondet, Arnaud and Meltzer, Aaron and Montalvao, Victor and Hopko, Michael and Waterson, Chris and Thakkar, Parth and Fernandez, Renuka and Kristensen, Kristian and Barzily, Sivan and Chen, Sherry and Abreu, Rui and Nagappan, Nachiappan and Shodjai, Payam and Murphy, Killian and Everingham, James and Ramani, Aparna and Rigby, Peter C.},
  journal={IEEE Transactions on Software Engineering}, 
  title={Agentic Program Repair from Test Failures at Scale: A Neuro-symbolic approach with static analysis and test execution feedback}, 
  year={2026},
  volume={},
  number={},
  pages={1-17},
  abstract={Aim. With the advent of LLMs, agentic program repair has become viable in large organizations with large codebases. While APR research frequently motivates its techniques around helping developers, Winter et al. [1] report that studies with substantial industrial participants are rare (2%). In this work, we develop an Engineering Agent that fixes source code from test failures at scale across diverse software offerings internally. Method. Using Llama as the base model, we employ a ReAct harness to build an agent that starts from a test failure triaged by a rule-based test failure bot. The agent operates in an agentic harness with 15 actions (e.g., reading files, searching code, running tests, and generating patches), and it iteratively refines solutions using feedback from static analysis and test execution. After validations pass, we apply an LLM-as-a-Judge to filter low-quality patches before notifying a human reviewer, who can accept and land the change in our monorepo. Because we can progressively roll out the system with layered validation and human review, we use offline benchmarks primarily as readiness gates and complement them with production evaluation based on review and landing outcomes. Benchmark Findings. We curated offline benchmarks for patch generation, the agent loop, and the LLM-as-a-Judge. We found that a specialized 70B model, internally fine-tuned for patch generation in a search-and-replace format, is highly competitive with a much larger vanilla Llama-405B. We also found that patch format strongly impacts performance, with search-and-replace outperforming unified diff. In ablation studies, symbolic feedback from static analysis and test execution improves the ReAct agent. The balanced configuration achieves a benchmark solve rate of 42.3% using an average 11.8 feedback iterations. Production Findings. Over a three month period, 80% of the generated fixes were reviewed, of which 31.5% were landed (25.5% of the total number of generated fixes). Engineer Feedback and Adoption. We used open coding to extract qualitative themes from engineer feedback, including quick approvals, gratitude, and surprise, and we used negative feedback (e.g., test flakiness) to refine the production system. We also analyzed reviewed-but-not merged diffs to understand why validated patches are rejected in practice, including workflow timing, intent mismatches (revert vs. fix-forward), and broader patch acceptability concerns.},
  keywords={Testing;Codes;Modeling;Maintenance engineering;Reviews;Feedback;Tools;Programming;Software engineering;AI;Agents;Program Repair;Test Failures;Patch Generation;LLMs;Benchmarking;AI in Production;Engineer Feedback},
  doi={10.1109/TSE.2026.3696849},
  ISSN={1939-3520},
  month={},}@INPROCEEDINGS{10710696,
  author={Dursun, Emre Hasan},
  booktitle={2024 8th International Artificial Intelligence and Data Processing Symposium (IDAP)}, 
  title={PID and PID-F Controller Design based on Particle Swarm Optimization for Automatic Voltage Regulator System}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study presents the implementation of two distinct controller designs, optimized with particle swarm optimization (PSO), for the conventional automatic voltage regulator system (AVR). These designs are proportional integral derivative (PID) controller without filter, which is known as ideal in the literature, and PID-F controller with filter. This study aims to identify the optimal parameters of controllers by employing the PSO algorithm. While a variety of objective functions are considered in the study, a current objective function, ZLG+ITAE, which represents a combination of Zwe-Lee Gaing (ZLG) and the integral-time absolute error (ITAE) objectives, is also employed in the tests. Thus, five different controllers are developed for the objective functions used. The study is initially modeled in a simulation environment with known standard AVR system parametric data. A comparison of the obtained performance data reveals that the GLZ+ITAE objective function yields more successful results. The system is evaluated both transiently and in steady state, according to specific criteria. The results demonstrate that more optimal dynamic response can be achieved. Furthermore, the comprehensive results illustrate that the four-parameter PID-F controller structure optimized via PSO can yield improved outcomes compared to those of the ideal PID.},
  keywords={Regulators;Filtering algorithms;Linear programming;Control systems;Automatic voltage control;Steady-state;Particle swarm optimization;Transient analysis;Optimization;Standards;AVR system;filtered PID-F controller;ideal PID controller;optimal control system design;PSO optimization},
  doi={10.1109/IDAP64064.2024.10710696},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10688905,
  author={Haider, Mohammad Zakaria and Mali, Prabin and Rahman, Mohammad Ashiqur and Paudyal, Sumit},
  booktitle={2024 IEEE Power & Energy Society General Meeting (PESGM)}, 
  title={Impact Analysis of False Data Injection Attacks on Automatic Voltage Regulators of Synchronous Generators}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Automatic Voltage Regulator (AVR) is a pivotal control within the domain of power systems engineering, specifically due to its importance in providing constant and reliable voltage. This research analyzes AVR’s vulnerability to False Data Injection (FDI) attacks. With the escalating integration of the Internet of Things (IoT) and communication technologies in power grids, cybersecurity risks have emerged as a significant concern. The investigation concentrates on elucidating the impact of FDI attacks on synchronous generators equipped with AVRs, employing advanced mathematical computations to simulate scenarios involving voltage fluctuations and grid disturbances. The research presents innovative insights into the cascading repercussions of multiple compromised AVRs on terminal voltage and the destabilization of reactive power. By scrutinizing the intricate dynamics of AVRs in the context of FDI attacks, the study aims to inform the grid operator of the risks posed by cyber threats in the evolving landscape of modern energy infrastructure, thus assisting in developing more resilient and secure power systems.},
  keywords={Reactive power;Regulators;Power system dynamics;Power system stability;Synchronous generators;Power grids;Generators;Power system reliability;Internet of Things;Modeling;Automatic Voltage Regulator(AVR);Cyber Security;False Data Injection(FDI);Smart Grid;Voltage Instability},
  doi={10.1109/PESGM51994.2024.10688905},
  ISSN={1944-9933},
  month={July},}@INPROCEEDINGS{10717495,
  author={Rambabu, K. and Seethanveshi, A and Ramakrishna, S and Dileep, G N and Veerababu, Kokkiligadda and Babu, Naladi Ram},
  booktitle={2024 International Conference on Computational Intelligence for Green and Sustainable Technologies (ICCIGST)}, 
  title={V-F Control of a Thermal-Wind System Using BSA Optimized Cascade FOPI-TID Controller}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This article address the study of an unified two-area thermal-wind system with a combined voltage and frequency control. An original attempt was made to integrate the cascade FOPI-TID controller in both AVR and LFC. The proposed controller gains are optimized by using bird swarm algorithm (BSA) in a unified power system. The proposed FOPI-TID controller outdoes over PID and TID. Moreover, a case study on performance of BSA is conducted found to be superior over firefly, flower pollination and cuckoo search algorithms. Further, the influence of AVR loop is carried and shows better dynamics over LFC loop. Furthermore, impact of wind systems is studied and shows enhanced dynamics over thermal system alone.},
  keywords={Reactive power;Power demand;System dynamics;Heuristic algorithms;Power system dynamics;Power system stability;Voltage control;Particle swarm optimization;Frequency control;Thermal stability;BSA technique;wind;AVR;LFC;FOPI-TID controller},
  doi={10.1109/ICCIGST60741.2024.10717495},
  ISSN={},
  month={July},}@INPROCEEDINGS{10499043,
  author={Kalyan, Ch. Naga Sai and Tellapati, Anuradha Devi and Kalyani, Thalanki Venkata Sai and Goud, B. Srikanth and Rao, Kambhampati Venkata Govardhan and Kumar, I Vijaya},
  booktitle={2024 International Conference on Integrated Circuits and Communication Systems (ICICACS)}, 
  title={Revealing the Effect of Excitation Cross Coupling on the LFC Performance in Two Area Hybrid Source System}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In this paper, the significant effect of excitation coupling with multi area hybrid system (MAHS) for load frequency control (LFC) is analyzed. Initially, MAHS is considered with excitation coupling or automatic voltage regulator (AVR) for analysis purposes. Area-1 of MAHS system is loaded with 10%SLP under the supervision of water cycle algorithm (WCA) based PIDD controller with respect to the minimization of integral square error (ISE) function. By contrasting PI/PID, the effectiveness of PIDD is showcased. To further illustrate its impact, dynamical analysis is performed on the LFC of MAHS for instances of with and without taking the coupling AVR into account.},
  keywords={Couplings;Integrated circuits;Regulators;Communication systems;Heuristic algorithms;Minimization;Voltage control;Multi-area hybrid source;LFC-AVR;PIDD;10%SLP;Water cycle algorithm},
  doi={10.1109/ICICACS60521.2024.10499043},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11213262,
  author={Balakrishna, G Vamshi and Kumar, B Naveen Karun and Haritha, A and Kejiya, Gera and Vavilala, Satish Kumar and Reddy, D V Sudarsan},
  booktitle={2025 11th International Conference on Electrical Energy Systems (ICEES)}, 
  title={Enhanced Voltage Regulation: PIDD Controller Optimization a Using Hybrid Whale Optimization Algorithm}, 
  year={2025},
  volume={},
  number={},
  pages={755-758},
  abstract={In power systems, automatic voltage regulators, or AVRs, are essential for preserving voltage stability. This research suggests the ideal design of a Proportional-Integral-Derivative-Derivative-Second Derivative (PIDD2) controller to improve the dynamic performance and resilience of an AVR system. The controller parameters are adjusted using a Hybrid Whale Optimization Algorithm (HWOA), which combines an adaptive local search mechanism to avoid premature convergence with the exploratory effectiveness of the Whale Optimization Algorithm (WOA). Time-domain and frequency-domain evaluations are utilized to compare the performance of the suggested HWOA-PIDD2 controller with traditional PID and PIDD2 controllers that have been optimized using different metaheuristic approaches. Simulation findings show that by reducing steady-state error, overshoot, settling time, and guaranteeing strong stability throughout a range of operating conditions, the suggested method greatly enhances system response conditions. The findings validate the superiority of the HWOA-based HDD2 controller in enhancing AVR system performance.},
  keywords={Regulators;Heuristic algorithms;System performance;Power system stability;Whale optimization algorithms;Stability analysis;Steady-state;Voltage control;Time-domain analysis;Resilience;HWOA;PIDD;AVR},
  doi={10.1109/ICEES67011.2025.11213262},
  ISSN={2693-3934},
  month={Aug},}@INPROCEEDINGS{11231934,
  author={Zakaria, Ariesa Budi and Anam, Syaiful and Nandiwardhana, Diwyastra and Ramadhani, Fikri and Susanto, Ircham and Nurholis},
  booktitle={2025 International Conference on Technology and Policy in Energy and Electric Power (ICT-PEP)}, 
  title={Optimization of High Voltage Protection: Evaluation of Voltage Dip Mitigation Strategies in the Bali Subsystem}, 
  year={2025},
  volume={},
  number={},
  pages={13-18},
  abstract={Disturbances in the Bali subsystem, especially on the 150 kV Kapal-Celukan Bawang high voltage line, have caused voltage dip phenomena with durations ranging from 0.4 to 2.8 seconds and a voltage drop of 40% to 60%. These disturbances lead to power outages and significantly affect the stability of the network and electricity supply to customers in the area. This study aims to evaluate the system's performance in responding to disturbances through various simulation scenarios. The scenarios evaluated include activating the Three Pole Auto Reclose (TPAR) on the Celukan Bawang side, autoclose capacitor scenarios, adjusting the set points of the Automatic Voltage Regulator (AVR) at Gas Turbine and Diesel Pesanggaran power plants, and installing a Synchronous Condenser and Static Synchronous Compensator (STATCOM) to improve the system's response to voltage changes. Simulation results show that these strategies can significantly improve voltage stability after disturbances by reducing the duration and magnitude of voltage dips. Notably, adjusting the AVR set points and installing STATCOM proved most effective in enhancing overall system performance. The proposed solutions offer promising results in mitigating the negative impact of voltage disturbances in the Bali subsystem, thereby improving the reliability and quality of electricity service to customers.},
  keywords={Voltage fluctuations;System performance;Electricity;Simulation;Power quality;Capacitors;High-voltage techniques;Automatic voltage control;Stability analysis;Turbines;voltage dip;TPAR;autoclose;STATCOM;AVR},
  doi={10.1109/ICT-PEP67281.2025.11231934},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10990646,
  author={Suman, Suraj Kumar and Kumar, Dipesh and Kumar, Rahul},
  booktitle={2024 2nd International Conference on Signal Processing, Communication, Power and Embedded System (SCOPES)}, 
  title={Combined Frequency and Voltage Control of Multi-Area Power System Integrated with RES and SMES Using Neuro-Fuzzy-2DOFPIDN Controller}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This article deals with a three-area, interlinked system that controls voltage, frequency and inter-area power flow under a conventional scenario. A first attempt was made to use a two-degree-of-freedom (2DOF) Proportional-Integral-Derivative in Filter coefficient (PIDN) with a hybrid Neuro-fuzzy controller (NF) as a supplementary controller. In the unified automatic load frequency control and automatic voltage regulator (AVR) research, a meta-heuristic approach known as the recent skill optimization algorithm is successfully utilized to tune the controls parameters, demonstrating that the NF-2DOFPIDN controller in time-domain indices. The AVR effect indicates a significant improvement in dynamic responses. The effects of wind plant, superconducting magnetic energy storage and system dynamics are investigated. Integral Squared Error with 1% perturbation is utilized to measure the overall system performance. Regarding maximum overshoot, undershoot, and settling time, the proposed controller (NF-2DOFPIDN) performs better than the conventional controller.},
  keywords={System dynamics;System performance;Power system dynamics;Signal processing;Superconducting filters;Wind turbines;Time-domain analysis;Superconducting magnetic energy storage;Oscillators;Frequency control;AVR;ALFC;NF-2DOFPIDN controller;SMES;SOA;wind plant},
