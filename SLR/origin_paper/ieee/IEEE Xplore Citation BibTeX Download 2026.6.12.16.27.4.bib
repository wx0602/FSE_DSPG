  title={Deep Reinforcement Learning Technique for Automatic Voltage Regulation}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This article focuses on the major components of an Automatic Voltage Regulator (AVR) and aims to improve the performance of AVR by improving its transient response, adaptation to changing conditions, and resilience. Its goal is to use deep reinforcement learning (DRL) to operate the AVR system. The research is significant because it compares the performance of the system without a controller, the PID controller, the FPID, and the suggested DRL-FPID. This paper demonstrates an innovative application of DRL-FPID for the AVR system taking into account its enhanced control characteristics and raised tuning flexibility over the conventional PID regulator. Based on the suggested approach's superior performance of AVR's voltage stability and comparative MATLAB/Simulink results with graphs and tables are presented in this study and can be used to ease real-time operations.},
  keywords={Transient response;Power engineering;Regulators;Deep reinforcement learning;Control systems;Real-time systems;Steady-state;Voltage control;Tuning;Resilience;AVR;DRL;DDPG;FPI},
  doi={10.1109/ODICON62106.2024.10797546},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10719126,
  author={Setiawan, Muhammad Haryo and Ma'arif, Alfian and Suwarno, Iswanto},
  booktitle={2024 IEEE Third International Conference on Power Electronics, Intelligent Control and Energy Systems (ICPEICES)}, 
  title={Optimal of PID Controller for Enhanced Performance in an AVR System}, 
  year={2024},
  volume={},
  number={},
  pages={304-311},
  abstract={This research rigorously examines the effectiveness of an automatic voltage regulator (AVR) system controlled by a carefully designed PID controller. Precise manual tuning with parameters $\text{Kp}=1.2261, \text{Ki}=0.2902$, and $\text{Kd}=0.2836$ achieved optimal voltage control, with particular emphasis on transient response characteristics, including overshoot, rise time, and settling time. The results demonstrate the superior capabilities of our custom PID controller. It not only maintains a minimal overshoot of 0.06093%, but also achieves a fast-settling time of only 0.623713 seconds, outperforming other algorithms studied. In addition, the system exhibits an exceptionally negligible steady state error of 0.000016. These technical achievements confirm the advantages of manual tuning over automated approaches and highlight the unsurpassed capabilities of the PID controller in A VR applications. The results contribute significantly to the discourse on A VR systems.},
  keywords={Transient response;Regulators;Manuals;Control systems;Robustness;Power electronics;Steady-state;Transient analysis;Tuning;Risk mitigation;A Vr;Pid Controller;Manual Tuning;Transient Response;System Stability},
  doi={10.1109/ICPEICES62430.2024.10719126},
  ISSN={},
  month={April},}@INPROCEEDINGS{11326192,
  author={Musa, Zulkifli and Suid, Mohd Helmi and Ahmad, Mohd Ashraf and Aziz, Nor Azlina Ab and Tumari, Mohd Zaidi Mohd and Tsuboi, Yusei},
  booktitle={2025 IEEE 13th Conference on Systems, Process & Control (ICSPC)}, 
  title={Cubature Kalman Optimizer with Fixed Neighborhood Radius for AVR System}, 
  year={2025},
  volume={},
  number={},
  pages={141-145},
  abstract={This paper presents the Cubature Kalman Optimizer (CKO) as a novel approach for tuning the proportional–integral–derivative (PID) controller parameters in an automatic voltage regulator (AVR) system. The proposed method employs the Cubature Transformation Technique (CTT) to perform a multi-point search within a dynamically controlled local neighborhood. In each trial, the neighborhood radius is kept constant throughout all iterations but systematically varied between trials, enabling the algorithm to balance exploration and exploitation effectively. By generating multiple candidate solutions through cubature propagation, CKO achieves rapid and precise convergence toward optimal PID parameters. The performance of the proposed PID-CKO controller is validated through time-domain simulations, demonstrating superior transient response, faster settling time, and improved robustness compared with PID controllers tuned using Sine Cosine Algorithm (SCA), Biogeography-Based Optimization (BBO), Artificial Bee Colony (ABC), Differential Evolution (DE), and the classical Ziegler–Nichols (ZN) method.},
  keywords={Transient response;Regulators;Uncertainty;Automatic voltage control;Robustness;Kalman filters;Time factors;Time-domain analysis;Tuning;Convergence;Metaheuristic Algorithm;Automatic Voltage Regular},
  doi={10.1109/ICSPC68261.2025.11326192},
  ISSN={2769-7916},
  month={Dec},}@INPROCEEDINGS{11503603,
  author={Alkaoui, Najwa and Nahas, Nabil and Abouheaf, Mohammed},
  booktitle={2026 IEEE International Systems Conference (SysCon)}, 
  title={Integrated AVR-LFC Optimization for Multi-Area Power Systems Using Simulated Annealing}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper proposes an integrated control framework for Automatic Voltage Regulation (AVR) and LoadFrequency Control (LFC) in multi-area power systems based on the Simulated Annealing (SA) metaheuristic. Unlike conventional approaches that tune these controllers independently, the proposed method explicitly accounts for their dynamic coupling by simultaneously optimizing all PID controller gains within a unified search space. The SA algorithm is employed to efficiently explore the resulting non-convex optimization landscape and minimize the Integral of Time-weighted Squared Error (ITSE), leading to enhanced suppression of transient oscillations. The proposed approach is validated using a two-area interconnected power system model. Its performance is benchmarked against several well-known metaheuristic techniques, including Particle Swarm Optimization (PSO), Differential Evolution (DE) and Artificial Bee Colony (ABC), as well as classical analytical tuning methods such as Routh-Padé-based approach. Simulation results demonstrate that the joint SA-based optimization significantly outperforms separate tuning strategies, reducing the total ITSE value from 38.93 to 8.57. In particular, terminal voltage responses exhibit lower overshoots and faster settling times, while frequency deviations show improved damping with minimal undershoot (approximately 1.15 p.u.). These results confirm that the proposed integrated tuning strategy provides a robust and stable control solution for modern synchronous generators operating under varying load conditions.},
  keywords={Oscillators;Filtering;Circuits and systems;Filters;Protocols;HTTP;Communication systems;Consensus protocol;Radio access networks;Regional area networks;Load frequency control;Automatic voltage regulation;Multi-area power systems;optimization;simulated Annealing},
  doi={10.1109/SysCon66367.2026.11503603},
  ISSN={2472-9647},
  month={April},}@INPROCEEDINGS{11512169,
  author={Bouguenna, Elouahab and Ladaci, Samir and Taghezouit, Bilal},
  booktitle={2025 First International Conference on Mechanical and Electrical Engineering for Green Energy Technologies (MEEGET)}, 
  title={Robustness-Driven Optimization of Fractional PIλ Dμ Control for AVR in Renewable Energy Systems Using Hyperbolic Sine-Cosine Algorithm}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper introduces the sinh–cosh optimizer (SCHO), a metaheuristic algorithm inspired by the gradient-like behavior of hyperbolic sine and cosine functions, to achieve an effective balance between exploration and exploitation in optimization tasks. The proposed method is applied to the automatic voltage regulator (AVR), a feedback-based system that ensures voltage stability in renewable energy sources where nonlinear dynamics, unmodeled systems, and parameter uncertainties frequently arise. In this framework, a fractional-order PID (FOPID) controller incorporating incommensurate non-integer differintegral is optimized using SCHO to enhance tracking accuracy, convergence speed, and robustness against unmodeled dynamics. Simulation results demonstrate that the controller maintains smooth bounded signals, reduces overshoot by 32.115%, and decreases the integral of time-weighted squared error (ITSE) by 33.3335% compared with conventional PID and standard FOPID approaches. The proposed strategy exhibits strong adaptability under load disturbances and parameter variations, confirming its reliability for practical voltage regulation. Consequently, this work provides a scalable and accurate control solution for nonlinear power systems with uncertain dynamics.},
  keywords={Equations;Timing;Optimization;Arrays;Algorithms;Printing;Modeling;Tagging;Transfer functions;Voltage;fractional-order control;sinh-cosh optimizer;automatic voltage regulators;robustness;dynamic stability},
  doi={10.1109/MEEGET65999.2025.11512169},
  ISSN={},
  month={Nov},}@ARTICLE{11175150,
  author={Wilcox, Logan M. and Hook, Alexander and Bohannon, Emma T. and Donnell, Kristen M.},
  journal={IEEE Open Journal of Instrumentation and Measurement}, 
  title={Active Microwave-Thermographic Signal Reconstruction With Adaptive Polynomial Regression}, 
  year={2025},
  volume={4},
  number={},
  pages={1-11},
  abstract={Active microwave thermography (AMT) is a coupled electromagnetic (EM) and thermographic nondestructive testing and evaluation (NDT&E) technique. AMT utilizes a radiating EM source (e.g., an antenna) that induces dielectric/magnetic heating on a specimen under test (SUT). The inspection surface of the SUT is imaged with an infrared (IR) camera over the inspection time. As the thermal excitation originates from a spatially varying radiated power density, a nonuniform thermal excitation results within (or on the surface of) the SUT that is directly related to this power density. This nonuniform heating causes uncertainty in defect detection and has the potential to lead to false positives and/or negatives. To this end, thermographic signal reconstruction (TSR), a well-established thermographic signal processing technique, is considered as a method to alleviate the effects of nonuniform thermal excitation. It was found that while the application of TSR improved defect indication, a modified variant, referred to as active microwave TSR (or AM-TSR), further improved defect indication. AM-TSR utilizes both the heating and cooling periods within the inspection time for analysis (whereas TSR only considers the cooling period). While AM-TSR improved defect indication over traditional TSR, thermal nonuniformity within the defect indication inhibited potential quantification. Thus, an additional modification to AM-TSR is necessary to improve defect quantification potential. To this end, a conditional polynomial regression, referred to as adaptive polynomial regression (APR), is incorporated into the AM-TSR process in order to improve the representation of the thermographic signal and quantification of the indication. The entire (modified) process is referred to as AM-TSR with APR. It was found that the error associated with defect quantification using AM-TSR with APR is less than 15%. This is significant as defect quantification using other techniques (spatiotemporal variance reconstruction, thermal contrast, AM-TSR, etc.) was not possible.},
  keywords={Inspection;Heating systems;Cooling;Polynomials;Infrared imaging;Electromagnetic heating;Image reconstruction;Signal reconstruction;Microwave theory and techniques;Temperature measurement;active microwave thermography (AMT);adaptive polynomial regression (APR);image reconstruction;nondestructive testing and evaluation (NDT&E);thermographic signal reconstruction (TSR);thermography},
  doi={10.1109/OJIM.2025.3612738},
  ISSN={2768-7236},
  month={},}@INPROCEEDINGS{11365341,
  author={Johnson, Preston T.},
  booktitle={2025 Saudi Arabia Smart Grid (SASG)}, 
  title={From Reliability to Intelligence: Building a Roadmap to Smart Asset Management for Transmission and Distribution}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Foundational reliability practices continue to guide advances in intelligent asset management. With the aid of technology, guided by industry's best practices, many process industries are making their asset management practices smarter and automated. Industry's best practices apply to SMART GRID assets such as transformers and switch gear. This paper explores how to evolve from basic equipment tracking and fault detection to implementing condition monitoring, predictive maintenance, and ultimately, a Monitoring & Diagnostics Center with decision support capabilities.},
  keywords={Temperature sensors;Temperature measurement;Fault detection;Switches;Transformers;Asset management;Smart grids;Reliability;Monitoring;Best practices;Transformer;Reliability;Fault Detection;Switching;COLM;APR;M&D;FMA;Temperature;Dissolved Gas;Monitoring},
  doi={10.1109/SASG68584.2025.11365341},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10607185,
  author={Chuang, Quek Li and Chong, Ang Boon and Cheng, Lee Chia and Ian, Koh Jid and Farahanim, Nordin Nor and Lok, Mei Ghee and Hong, Phang Eng},
  booktitle={2024 IEEE Symposium on Industrial Electronics & Applications (ISIEA)}, 
  title={Design Space Exploration with Machine Learning Co-Optimization}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={In recent years, electronic design automation has been preoccupied with machine learning. The application of machine learning is being utilized by the design industry to increase the predictability of physical design and signoff. Presently, machine learning applications in the field of integrated circuit design are primarily concerned with yield modeling, lithography hotspot identification, noise and process variation modeling, analog circuit performance modeling, and implementation space exploration. This paper will share the idea of design space exploration with machine learning co-optimization for design development phase. The optimum tool app option for best performance during design development phase will be extracted and co-optimized with machine learning during RTL frozen phase. The proposed approach will preserved the previous machine and tool resources for the actual design deployment phase while achieving the optimum design performance. Hopefully, the sharing will benefit the community.},
  keywords={Integrated circuit synthesis;Industries;Design automation;Noise;Lithography;Machine learning;Analog circuits;EDA;machine learning;APR;physical design},
  doi={10.1109/ISIEA61920.2024.10607185},
  ISSN={2472-7660},
  month={July},}@INPROCEEDINGS{10549166,
  author={Zhong, Wenkang and Li, Chuanyi and Liu, Kui and Xu, Tongtong and Ge, Jidong and Bissyandé, Tegawendé F. and Luo, Bin and Ng, Vincent},
  booktitle={2024 IEEE/ACM 46th International Conference on Software Engineering (ICSE)}, 
  title={Practical Program Repair via Preference-based Ensemble Strategy}, 
  year={2024},
  volume={},
  number={},
  pages={25-37},
  abstract={To date, over 40 Automated Program Repair (APR) tools have been designed with varying bug-fixing strategies, which have been demonstrated to have complementary performance in terms of being effective for different bug classes. Intuitively, it should be feasible to improve the overall bug-fixing performance of APR via assembling existing tools. Unfortunately, simply invoking all available APR tools for a given bug can result in unacceptable costs on APR execution as well as on patch validation (via expensive testing). Therefore, while assembling existing tools is appealing, it requires an efficient strategy to reconcile the need to fix more bugs and the requirements for practicality. In light of this problem, we propose a Preference-based Ensemble Program Repair framework (P-EPR), which seeks to effectively rank APR tools for repairing different bugs. P-EPR is the first non-learning-based APR ensemble method that is novel in its exploitation of repair patterns as a major source of knowledge for ranking APR tools and its reliance on a dynamic update strategy that enables it to immediately exploit and benefit from newly derived repair results. Experimental results show that P-EPR outperforms existing strategies significantly both in flexibility and effectiveness.},
  keywords={Measurement;Costs;Computer bugs;Maintenance engineering;Software;Ensemble learning;Testing;program repair;ensemble strategy},
  doi={10.1145/3597503.3623310},
  ISSN={1558-1225},
  month={April},}@ARTICLE{10659742,
  author={Zhou, Xin and Xu, Bowen and Kim, Kisub and Han, DongGyun and Nguyen, Hung Huu and Le-Cong, Thanh and He, Junda and Le, Bach and Lo, David},
  journal={IEEE Transactions on Software Engineering}, 
  title={Leveraging Large Language Model for Automatic Patch Correctness Assessment}, 
  year={2024},
  volume={50},
  number={11},
  pages={2865-2883},
  abstract={Automated Program Repair (APR) techniques have shown more and more promising results in fixing real-world bugs. Despite the effectiveness, APR techniques still face an overfitting problem: a generated patch can be incorrect although it passes all tests. It is time-consuming to manually evaluate the correctness of generated patches that can pass all available test cases. To address this problem, many approaches have been proposed to automatically assess the correctness of patches generated by APR techniques. These approaches are mainly evaluated within the cross-validation setting. However, for patches generated by a new or unseen APR tool, users are implicitly required to manually label a significant portion of these patches (e.g., 90% in 10-fold cross-validation) in the cross-validation setting before inferring the remaining patches (e.g., 10% in 10-fold cross-validation). To mitigate the issue, in this study, we propose LLM4PatchCorrect, the patch correctness assessment by adopting a large language model for code. Specifically, for patches generated by a new or unseen APR tool, LLM4PatchCorrect does not need labeled patches of this new or unseen APR tool for training but directly queries the large language model for code to get predictions on the correctness labels without training. In this way, LLM4PatchCorrect can reduce the manual labeling effort when building a model to automatically assess the correctness of generated patches of new APR tools. To provide knowledge regarding the automatic patch correctness assessment (APCA) task to the large language model for code, LLM4PatchCorrect leverages bug descriptions, execution traces, failing test cases, test coverage, and labeled patches generated by existing APR tools, before deciding the correctness of the unlabeled patches of a new or unseen APR tool. Additionally, LLM4PatchCorrect prioritizes labeled patches from existing APR tools that exhibit semantic similarity to those generated by new APR tools, enhancing the accuracy achieved by LLM4PatchCorrect for patches from new APR tools. Our experimental results showed that LLM4PatchCorrect can achieve an accuracy of 84.4% and an F1-score of 86.5% on average although no labeled patch of the new or unseen APR tool is available. In addition, our proposed technique significantly outperformed the prior state-of-the-art.},
  keywords={Computer bugs;Codes;Task analysis;Large language models;Feature extraction;Training;Manuals;Automatic patch correctness assessment;large language models of code;in-context learning},
  doi={10.1109/TSE.2024.3452252},
  ISSN={1939-3520},
  month={Nov},}@ARTICLE{10683998,
  author={Zhu, Huijuan and Yang, Lei and Wang, Liangmin and Sheng, Victor S.},
  journal={IEEE Transactions on Services Computing}, 
  title={A Survey on Security Analysis Methods of Smart Contracts}, 
  year={2024},
  volume={17},
  number={6},
  pages={4522-4539},
  abstract={Smart contracts have gained extensive adoption across diverse industries, including finance, supply chain, and the Internet of Things. Nevertheless, the surge in security incidents of smart contracts over recent years has led to substantial economic losses. Therefore, ensuring the security of smart contracts has become a critical and complex challenge in both academic and industrial domains. Based on 539 real-world security incidents in the Ethereum platform and audit reports from 10 authoritative auditing institutions, we summarize 27 types of exploited security vulnerabilities and draw insights into their principles, typical cases, relevant research and recommended prevention strategies. Besides, we also gather 7 other potentially threatening vulnerability types as supplements. On this basis, we conduct an in-depth analysis of the root causes of vulnerabilities and further formulate eight safety practical rules. Moreover, we perform a comprehensive review of 178 recent papers on smart contract security analysis, classifying detection methods into formal verification, fuzz testing, machine learning, program analysis, and others. For each category, we seize the specific detection tools and analyze them comprehensively. Then, we conduct an extensive analysis and synthesis from various angles, presenting a comprehensive overview of the current research landscape in smart contract security detection. We also discuss current on-chain and off-chain repair methods. Finally, this review outlines major challenges and highlights potential areas for future research in this field.},
  keywords={Smart contracts;Security;Blockchains;Open source software;Cryptocurrency;Prevention and mitigation;Reviews;Smart contracts;blockchain;ethereum;security analysis;vulnerabilities},
  doi={10.1109/TSC.2024.3463394},
  ISSN={1939-1374},
  month={Nov},}@INPROCEEDINGS{11140502,
  author={Liu, Yunhua and Du, Shaohui and Chen, Jian and Zhang, Wei and Yang, Xianzhi and Li, Shijie},
  booktitle={2025 4th International Symposium on Robotics, Artificial Intelligence and Information Engineering (RAIIE)}, 
  title={Secure Repair Techniques for Embedded Operating Systems Based on Trusted Cloud Environments}, 
  year={2025},
  volume={},
  number={},
  pages={339-344},
  abstract={As an embedded system with similar computer architecture, its operating environment is changeable, resources are limited, and tasks overlap among adjacent nodes, resulting in memory fragmentation when processing complex tasks, which makes the system need to defend against both physical and software attacks. Software-based control flow inspection adds additional staking codes to each basic block and fails to take into account the compromised data of the entire system, making the repair success rate low. The dimensions of embedded operating system security repair are refined, and the levels and strategies of repair are determined based on the characteristics of embedded operating system security vulnerabilities. By replacing PM codes with random blocks, a trusted cloud environment is constructed. In combination with regenerative code technology, a secure reconstruction of the regenerative code is carried out to repair and restore the damaged data of the embedded operating system in the trusted cloud environment, and the credibility of the execution of the regenerative code after the embedded system equipment is powered on is ensured. Separate different security domains according to the principle of least permission, isolate and repair the internal vulnerabilities of the operating system, and realize the security repair of the embedded operating system at the isolation and repair level. The experimental results show that this technology has better safety repair effect and can be applied in real life.},
  keywords={Cloud computing;Codes;Embedded systems;Maintenance engineering;Robot sensing systems;Software;Real-time systems;Software reliability;Safety;Security;Trusted Cloud Environment;Embedded Operations;Security Remediation Techniques;Remediation Dimension;Regeneration Codes},
  doi={10.1109/RAIIE65740.2025.11140502},
  ISSN={},
  month={June},}@INPROCEEDINGS{10771256,
  author={Wang, Jian and Liu, Shangqing and Xie, Xiaofei and Siow, Jingkai and Liu, Kui and Li, Yi},
  booktitle={2024 IEEE 35th International Symposium on Software Reliability Engineering (ISSRE)}, 
  title={Ratchet: Retrieval Augmented Transformer for Program Repair}, 
  year={2024},
  volume={},
  number={},
  pages={427-438},
  abstract={Automated Program Repair (APR) presents the promising momentum of releasing developers from the burden of manual debugging tasks by automatically fixing bugs in various ways. Recent advances in deep learning inspire many works in employing deep learning techniques to fixing buggy programs. However, several challenges remain unaddressed: (1) state-of-the-art fault localization techniques often require additional artifacts, such as bug-triggering test cases or bug reports. These artifacts are not always available in the early development phases; (2) Sequence-to-Sequence model-based APR often requires additional contexts with high quality to generate patches. Yet, it is challenging to identify high-quality contexts that are not common in programs.In this paper, with the redundancy assumption in program repair, we propose a dual deep learning-based APR tool, RATCHET, for localizing (RATCHET-FL) and repairing (Ratchet-PG) buggy programs. Ratchet-FL localizes buggy statements based on the feature learned by a simple BiLSTM model from the code, without any bug-triggering test cases or bug reports. Ratchet-PG relies on our proposed retrieval augmented transformer to learn the historical patches and generate patches for fixing bugs. We evaluate the effectiveness of Ratchet with in-the-lab DrRepair dataset and in-the-wild dataset Ratchet-DS (curated in this work). Our experimental results show that Ratchet outperforms state-of-the-art deep learning approaches on fault localization with 39.8-96.4% accuracy and patch generation with 18.4-46.4% repair accuracy.},
  keywords={Location awareness;Deep learning;Accuracy;System performance;Source coding;Computer bugs;Termination of employment;Maintenance engineering;Transformers;Software reliability},
  doi={10.1109/ISSRE62328.2024.00048},
  ISSN={2332-6549},
  month={Oct},}@INPROCEEDINGS{10554908,
  author={Plein, Laura and Ouédraogo, Wendkûuni C. and Klein, Jacques and Bissyandé, Tegawendé F.},
  booktitle={2024 IEEE/ACM 46th International Conference on Software Engineering: Companion Proceedings (ICSE-Companion)}, 
  title={Automatic Generation of Test Cases Based on Bug Reports: a Feasibility Study with Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={360-361},
  abstract={Tests suites are a key ingredient in various software automation tasks. Recently, various studies [4] have demonstrated that they are paramount in the adoption of latest innovations in software engineering, such as automated program repair (APR) [3]. Test suites are unfortunately often too scarce in software development projects. Generally, they are provided for regression testing, while new bugs are discovered by users who then describe them infor-mally in bug reports. In recent literature, a new trend of research in APR has attempted to leverage bug reports in generate-and-validate pipelines for program repair. Even in such cases, when an APR tool generates a patch candidate, if test cases are unavailable, developers must manually validate the patch, leading to a threat to validity.},
  keywords={Technological innovation;Computer bugs;Pipelines;Maintenance engineering;Market research;Software;Task analysis},
  doi={10.1145/3639478.3643119},
  ISSN={2574-1934},
  month={April},}@ARTICLE{10375771,
  author={Zhang, Hao and Jiao, Jiao and Zhao, Tianheng and Zhao, Enshuang and Li, Lanhui and Li, Guihua and Zhang, Borui and Qin, Qing-Ming},
  journal={IEEE/ACM Transactions on Computational Biology and Bioinformatics}, 
  title={GERWR: Identifying the Key Pathogenicity- Associated sRNAs of Magnaporthe Oryzae Infection in Rice Based on Graph Embedding and Random Walk With Restart}, 
  year={2024},
  volume={21},
  number={2},
  pages={227-239},
  abstract={Rice blast, caused by Magnaporthe oryzae(M.oryzae), is a destructive rice disease that reduces rice yield by 10% to 30% annually. It also affects other cereal crops such as barley, wheat, rye, millet, sorghum, and maize. Small RNAs (sRNAs) play an essential regulatory role in fungus-plant interaction during the fungal invasion, but studies on pathogenic sRNAs during the fungal invasion of plants based on multi-omics data integration are rare. This paper proposes a novel approach called Graph Embedding combined with Random Walk with Restart (GERWR) to identify pathogenic sRNAs based on multi-omics data integration during M.oryzae invasion. By constructing a multi-omics network (MRMO), we identified 29 pathogenic sRNAs of rice blast fungus. Further analysis revealed that these sRNAs regulate rice genes in a many-to-many relationship, playing a significant regulatory role in the pathogenesis of rice blast disease. This paper explores the pathogenic factors of rice blast disease from the perspective of multi-omics data analysis, revealing the inherent connection between pathogenic factors of different omics. It has essential scientific significance for studying the pathogenic mechanism of rice blast fungus, the rice blast fungus-rice model system, and the pathogen-host interaction in related fields.},
  keywords={Diseases;Prediction algorithms;Proteins;Genetics;Pathogenesis;  $Magnaporthe\ oryzae$  ;rice;multi-omics;sRNA;random walk with restart},
  doi={10.1109/TCBB.2023.3348080},
  ISSN={1557-9964},
  month={March},}@INPROCEEDINGS{11375673,
  author={Wang, Zhixiang and Ma, Xingjun and Jiang, Yu-Gang},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={BadPatch: Diffusion-Based Generation of Physical Adversarial Patches}, 
  year={2025},
  volume={},
  number={},
  pages={6303-6313},
  abstract={Physical adversarial patches printed on clothing can enable individuals to evade person detectors, but most existing methods prioritize attack effectiveness over stealthiness, resulting in aesthetically unpleasing patches. While generative adversarial networks and diffusion models can produce more natural-looking patches, they often fail to balance stealthiness with attack effectiveness and lack flexibility for user customization. To address these limitations, we propose BadPatch, a novel diffusion-based framework for generating customizable and naturalistic adversarial patches. Our approach allows users to start from a reference image (rather than random noise) and incorporates masks to create patches of various shapes, not limited to squares. To preserve the original semantics during the diffusion process, we employ Null-text inversion to map random noise samples to a single input image and generate patches through Incomplete Diffusion Optimization (IDO). Our method achieves attack performance comparable to state-of-the-art non-naturalistic patches while maintaining a natural appearance. Using BadPatch, we construct AdvTshirt-1K, the first physical adversarial T-shirt dataset comprising over a thousand images captured in diverse scenarios. AdvT-shirt-1K can serve as a useful dataset for training or testing future defense methods. The code and datasets are available at https://github.com/Wwangb/BadPatch.},
  keywords={Training;Shape;Noise;Semantics;Diffusion processes;Object detection;Generative adversarial networks;Diffusion models;Optimization;Testing;adversarial attack},
  doi={10.1109/ICCVW69036.2025.00655},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{10537280,
  author={Y, Chaithanya Goud and Vamsi V, Hari and T, Nithya and T, Sravan and P, Jhansi},
  booktitle={2024 2nd International Conference on Networking and Communications (ICNWC)}, 
  title={Augmentation of Dynamic Stability Using Power System Stabilizer Utilizing Fuzzy Logic Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={The power system operates within a dynamic environment, susceptible to disruptions that can lead to instability if not managed effectively. Maintaining steady state stability is crucial to prevent system failure. Voltage regulators play a key role in this stability maintenance by receiving auxiliary signals from various sources, including deviations and stabilizing power. Traditionally, power system stabilizers (PSSs) have relied on lead-lag compensation mechanisms, which require meticulous gain adjustments to accommodate different operating conditions. However, this conventional approach struggles to ensure stability across diverse loading scenarios, posing a significant challenge in designing stabilizers that perform consistently well.One proposed solution to this challenge is fuzzy logic control, which offers a promising alternative to conventional methods. Fuzzy logic control does not rely heavily on precise mathematical models of the system and instead leverages linguistic information to adaptively respond to operational parameters. This approach holds potential for achieving robust performance across a range of operating conditions, addressing the inherent difficulty in designing stabilizers that excel universally.The primary focus of this research is to address the complexity associated with designing stabilizers capable of maintaining stability under varying mechanical input conditions. Specifically, we aim to develop a system that demonstrates stable behavior even in the presence of up to a five percent change in mechanical input. By exploring the application of fuzzy logic control in this context, we seek to overcome the limitations of traditional methods and enhance the stability and reliability of electric power systems.},
  keywords={Fuzzy logic;Regulators;Power system dynamics;Power system stability;Control systems;Stability analysis;Mathematical models;Excitation Control System;Synchronous Generator Model;Automatic Voltage Regulator (AVR);Power System Stabilizer;Fuzzy Control System},
  doi={10.1109/ICNWC60771.2024.10537280},
  ISSN={},
  month={April},}@INPROCEEDINGS{10917368,
  author={S, Kalimuthukumar. and Shanumugapriya, S. and Reddy, Y. Amarnath and Ruth Esther, K. and Charan, G. Giri},
  booktitle={2024 4th International Conference on Soft Computing for Security Applications (ICSCSA)}, 
  title={A Preventive Method for Temperature Management in The Fireworks Sector}, 
  year={2024},
  volume={},
  number={},
  pages={678-682},
  abstract={The creation of fireworks holds great significance in Sivakasi. The chemical process utilized in the manufacture of firecrackers results in multiple casualties because the chemicals brush against one another and explode when the room temperature abruptly rises. The high ambient temperature at the factory—69 degrees Celsius, according to some reports—may have contributed to the explosion. In a firecracker factory, implementing a temperature control system with an alarm indicator can help lower the number of fatalities. The industrial room temperature is regulated by means of this temperature control system. As a result, in order to control every device, to employ an Arduino Uno to process and transmit input data and a temperature sensor to measure the ambient temperature. The concept incorporates three LEDs to show the industrial room's current temperature. The three LED colors are red (hazardous), blue (average), and green (normal). To make it easier to read the temperature range in the factory, and also added an LCD. Workers have claimed that firecrackers spontaneously catch fire in the summertime due to chemical interactions. A bell is activated to notify all factory workers during such instances, and a water motor has been fitted to manage the workplace fire. The food sector and other chemical industries also use this gadget.},
  keywords={Temperature sensors;Temperature measurement;Temperature distribution;Light emitting diodes;Production facilities;Liquid crystal displays;Explosions;Temperature control;Sensors;Chemicals;AVR Micro controller;Temperature control;DC motor;Fire Sensors},
  doi={10.1109/ICSCSA64454.2024.00116},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10616952,
  author={Satheesan, Sreelakshmi and T T, Anilkumar},
  booktitle={2024 International Conference on Advancements in Power, Communication and Intelligent Systems (APCI)}, 
  title={Coordinated Control of PSS and SSSC Using Ant Colony Optimization}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Small signal stability refers to the power system’s ability to maintain synchronism when subjected to minor disturbances. Instabilities that may occur in two main forms: a slow increase in rotor angle due to not enough synchronizing torque, and rotor oscillations with increasing size due to not enough damping torque. To solve these problems, generators are equipped with PSSs, which improve the damping of low-frequency oscillations, usually between 0.2 to 3.0 Hz, making the power system more stable. Simultaneously, the SSSC as damping controller, also can contributes to power flow control and voltage stability by dynamically regulating line impedance. However, a proper coordination between PSSs and SSSC is essential for extracting the effect of combined operation. In this paper both PSS and SSSC are effectively coordinated by optimising their parameters using ACO algorithm. Also, this paper compares the stability of the test system with coordinated operation of PSS and SSSC using ACO and PSO algorithm. A two area multimachine system is taken as test system which is analysed under various operating conditions. The coordination of PSS and SSSC using ACO ensures a more stable operation under various operating conditions.},
  keywords={Damping;Torque;Regulators;Rotors;Power system stability;Stability analysis;Voltage control;Ant Colony Optimization(ACO);Automatic Voltage Regulator (AVR);Power System Stabilizer (PSS);Particle Swarm Optimization (PSO);Static Synchronous Series Compensators (SSSC)},
  doi={10.1109/APCI61480.2024.10616952},
  ISSN={},
  month={June},}@INPROCEEDINGS{10548220,
  author={H. T., Manohara and Anjaneyya and Kumar S, Dileep and S S, Venkatesh},
  booktitle={2024 Third International Conference on Distributed Computing and Electrical Circuits and Electronics (ICDCECE)}, 
  title={Novel Shunt Capacitor Based Industrial Power Management Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The aim of proposed work is to minimize the real-time power consumption and thus reduce the power cost in industries and establishments by making utilize of shunt capacitors. Reactive Power represents the electrical power that transmits back and forth between the phase conductors and the neutral conductor of a 3 - Φ network, but does not perform any mechanical work. A greater than of a reactive power, the device consumes the more apparent power, thus decreases. Power factor means that the ratio of working power in the circuit to apparent power to the load or k W /kVAR. All industrial loads, including the induction motors, have reasonably minimum power factors. Motors account for roughly 60 % of utility loads, resulting in a low power factor for the system. These motors have a low power factor based on load level. These motors power factor range from 0.30 to 0.95, depending on their working conditions and size. The power factor (PF) is the key for deal with industrial power systems, utilities and end users. Our proposed works is control the industrial loads using Microcontroller based controller by feeding the time lagging between zero voltage pulses (ZVP) and zero current pulses (ZCP) produced by proper operation amplifier circuit working. The proposed model achieves significantly 20 % to 22 % improvement in energy minimization against the existing model subject to different types of loads.},
  keywords={Reactive power;Costs;Microcontrollers;Electricity;Capacitors;Urban areas;Conductors;Power Factor;Reactive Power;Apparent Power;Power compensation;Shunt Capacitors;Industrial applications;AVR Microcontroller},
  doi={10.1109/ICDCECE60827.2024.10548220},
  ISSN={},
  month={April},}@INPROCEEDINGS{10741751,
  author={Tacke, Jonathan and Roberson, Dakota and Cook, Dallin},
  booktitle={2024 56th North American Power Symposium (NAPS)}, 
  title={Loop-Shaped Compensator for a High-Performance Synchronous Machine Power System Stabilizer}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The delivery of well-regulated electric power is essential for the reliable functioning of modern society. Voltage is regulated around a nominal frequency, i.e., 50 or 60 Hz, with a tight tolerance with some variation across regulatory jurisdiction. Electrical machinery and sensitive electronics can be removed from operation or severely damaged if frequency is allowed to deviate. To aid in the suppression of frequency oscillation at low frequencies, power system stabilizers are used to regulate generator rotor speed. With the increased penetration of inverter-based resources, aggregate power system inertia continues to decrease, and frequency swings are more severe. Therefore, the performance demands of power system stabilizers are increasing. In this work, a novel high-gain power system stabilizer is de-signed using Bode loop-shaping design techniques. The resulting stabilizer is shown to enhance frequency oscillation damping by two orders of magnitude when compared to an industry standard design when subject to a step torque disturbance. Impacts on voltage regulation are also discussed. Comparisons are made in the frequency domain using quantitative measures of performance for both frequency and voltage regulation and are verified using Simulink software.},
  keywords={Voltage measurement;Torque;Software packages;Frequency-domain analysis;Power system stability;Software measurement;Voltage control;Synchronous machines;Oscillators;Standards;PSS;AVR;Frequency Regulation;Primary Frequency Response;Frequency Domain Control},
  doi={10.1109/NAPS61145.2024.10741751},
  ISSN={2833-003X},
  month={Oct},}@INPROCEEDINGS{10585010,
  author={Shyan, Hatesh and Manisha and Singh, Kulvinder},
  booktitle={2024 International Conference on Computational Intelligence and Computing Applications (ICCICA)}, 
  title={A Proposed Method to Extend One-Bit of the Parallel Interface in a Digital to Analog Conversion Circuit by Adding an External Device}, 
  year={2024},
  volume={1},
  number={},
  pages={242-247},
  abstract={In this paper, we propose a method to extend one bit to a parallel interface type Digital to Analog conversion circuit by using an external device. The examination of the Digital to Analog conversion circuit's principle is conducted in order to perform the aforementioned extension. Additionally, an analysis is carried out to identify the problems that arise when extending one bit using additional individual devices. Subsequently, a bit extension system for the Digital to Analog conversion device is proposed, utilizing an operational amplifier circuit. This method is utilising the high-precision characteristics of the operational amplifier, which affects the size of the output waveform only even when an error occurs in the device, and the voltage reversal phenomenon occurring between the bits doesn’t take place. To verify the effectiveness of the method proposed, we constructed the circuitry for experiment and measured the absolute voltage and relative error of the output waveform. According to the experimental results, it was confirmed that only 0.0756% error occurred on average compared to the 12-bit class Digital to Analog converter. According to these results, we confirmed that one bit extension is possible by adding a small number of individual devices.},
  keywords={Operational amplifiers;Performance evaluation;Voltage measurement;Digital-analog conversion;Measurement uncertainty;Production;Size measurement;AVR;DAC;microcontroller;CMOS;inverting amplifier;non-inverting amplifier},
  doi={10.1109/ICCICA60014.2024.10585010},
  ISSN={},
  month={May},}@INPROCEEDINGS{10805635,
  author={Ansari, Nadia Mustaqim and Iqbal, Kashan and Tariq, Talha and Iqbal, Rizwan},
  booktitle={2024 Global Conference on Wireless and Optical Technologies (GCWOT)}, 
  title={Design & Implementation of Crop Monitoring Using WSN}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Agricultural cultivation is an essential requirement for the survival and well-being of the human species. Lack of care or incorrect assessment of various growth and productivity-related metrics leads to a significant loss of production. The wireless crop monitoring system needs a portable, user-friendly, accurate, and automatic data generator for various critical metrics. This paper presents the temperature, humidity, soil moisture, and air quality monitoring of soil conditions and atmosphere for efficient crop growth. The parameters listed above will be monitored using Wireless Sensor Networks (WSNs). This research resolves the issue of excessive water supply by assessing soil moisture. Monitoring temperature allows for the estimation of a plant's water requirements. Monitoring air quality allows for the maintenance of healthy air quality.},
  keywords={Temperature sensors;Wireless communication;Temperature measurement;Measurement;Wireless sensor networks;Soil moisture;Crops;Humidity;Air quality;Monitoring;WSN;crop growth;AVR},
  doi={10.1109/GCWOT63882.2024.10805635},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10569250,
  author={Lazaro, Jose B. and Pabiania, Maribelle D. and Bayonito, Cedric Lawrenze P. and Cabit, Jhed Patrick M. and Fernando, Kate Carolyn L. and Jocson, John Rafael L. and Park, Adrian Kuk Chong S. and Piñera, Clarenzz Bryan S. and Roll, Angelica C. and Solis, Kim Kerwin L.},
  booktitle={2024 16th International Conference on Computer and Automation Engineering (ICCAE)}, 
  title={Implementation of a Single Cycle Datapath for the Design of a Low-process Control in XC3S500E}, 
  year={2024},
  volume={},
  number={},
  pages={730-734},
  abstract={This paper outlines the design of a low-process control system for embedded systems applications, utilizing a RISC- V processor. The design incorporates functional units of a single-cycle Datapath and a control unit developed in Verilog HDL. Focus on testing RISC- V instructions to achieve low-process control in embedded systems applications by employing proper instruction mnemonics. The approach enhances the low-process control and efficiency in embedded systems applications and system design through single-cycle control. The designed low-process control proves valuable by computing the processor time (T) needed in instruction execution. Low-process control 1 exhibits an 88.21 % improvement over an A VR processor control, and low-process control 2 demonstrates a 49.43% improvement, thereby ensuring efficient process control. The findings contribute to the understanding of RISC- V architecture implementation in an FPGA platform, featuring LED visualization to depict equivalent machine code generated in a single-cycle process. This study advances the theoretical framework of system optimization and control with the use of FPGA platforms.},
  keywords={Embedded systems;Process control;Computer architecture;Control systems;Hardware;Timing;Hardware design languages;risc-v;single-cycle data path;spartan 3e xc3s500e fpga;avr;low-process control},
  doi={10.1109/ICCAE59995.2024.10569250},
  ISSN={2154-4360},
  month={March},}@INPROCEEDINGS{10609037,
  author={Golafshani, Amin Rahimnezhad and Pairo, Hamidreza and Mohamadian, Sobhan and Buccella, Concettina and Cecati, Carlo},
  booktitle={2024 International Symposium on Power Electronics, Electrical Drives, Automation and Motion (SPEEDAM)}, 
  title={Efficiency Optimization of Induction Motor by Automatic Voltage Regulator of Synchronous Generator Based on Search-based Method}, 
  year={2024},
  volume={},
  number={},
  pages={686-691},
  abstract={This article proposes a new method to optimize the efficiency of a 7.5 kW induction motor connected to a synchronous generator. The Synchronous generator is a part of an emergency power system supposed to provide power for the induction motor. In this proposed method, the efficiency of induction motor is optimized by the automatic voltage regulator of synchronous generator under different loads. The centerpiece of automatic voltage regulator is a DC/DC buck converter which feeds excitation winding. Due to improvement of induction motor efficiency, the cost of generation is significantly reduced. In the proposed method, a search-based method is utilized to adjust the output voltage of synchronous generator in order to find the maximum efficiency of induction motor. Furthermore, losses equations are presented which are applied in efficiency calculation. As a result of not using speed sensor, the motor equations are used to estimate the motor slip in each step of search method. Results of the proposed method is presented to verify the method performance using MATLAB/Simulink.},
  keywords={Induction motors;Regulators;Buck converters;Windings;Synchronous generators;Mathematical models;Automatic voltage control;Efficiency Optimization;Automatic Voltage Regulator (AVR);search method;induction motor;emergency power system},
  doi={10.1109/SPEEDAM61530.2024.10609037},
  ISSN={2835-8457},
  month={June},}@INPROCEEDINGS{11470827,
  author={Sahoo, Subhadra and Jena, Narendra Kumar and Kasturi, Kumari and Sahu, Binod Kumar},
  booktitle={2026 4th Odisha International Conference on Electrical Power Engineering, Communication and Computing Technology (ODICON)}, 
  title={Voltage and Frequency Stabilisation of A Deregulated Power System Using Multi-Stage Controller}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={In the present scenario, there is continuous increase in electricity demand in almost all sectors of industries. This huge load requirement is to be satisfied only by introduction of renewable energy sources. But the RES units due to lack of inertia and again due to uncertain inputs makes the system more unstable and complicated. Hence it becomes a great challenge to maintain the system stability of large interconnected power system in the presence of the RES units. Further to satisfy the consumers by providing reliable supply with less cost the systems are modified to a horizontally integrated system commonly known as deregulated system. In such complex system to maintain the voltage and frequency at a desired level, more reliable and efficient secondary controllers are to be designed. In this work, a two stage PID+1PI controller is designed for the dynamic stability of a two-area hydro-thermal-wind power system. Its result is compared with result of PID controller and proves its better performance. The controller parameters are selected through Selfish Herd Optimisation technique. The robustness of the controller is validated by inserting a random load.},
  keywords={Feeds;Antennas;Oscillators;Choppers (circuits);Filtering;Diodes;Light emitting diodes;Circuits and systems;Circuits;Filters;PID+1PI Controller;AVR;ALFC;Renewable-Energy-Sources},
  doi={10.1109/ODICON66687.2026.11470827},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10913910,
  author={Castillo-Arellano, Juan L. and Badaoui, Mohamed and Ruiz-Vega, Daniel},
  booktitle={2024 IEEE PES Generation, Transmission and Distribution Latin America Conference and Industrial Exposition (GTDLA)}, 
  title={Angular and Voltage Power System Stability Analysis Considering the Uncertainty of Load Magnitude}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a new approach for the analysis of angular and voltage stability of power systems, considering the uncertainty of the load magnitude, which is represented by the Ornstein-Uhlenbeck stochastic process. The uncertainty is considered in both, the initial stages of operation (power flow) and at each integration step of the time-domain simulation. The proposed approach performs the stability assessment of the N-1 contingencies of the IEEE 9-bus 3-machine test power system, and shows that considering the uncertainty of the load in the stability assessment, could change its results. It additionally allowed an initial test of the robustness of the ANFIS automatic voltage regulator.},
  keywords={Uncertainty;Stability criteria;Contingency management;Stochastic processes;Power system stability;Robustness;Transient analysis;Voltage control;Time-domain analysis;Oscillators;stochastic stability analysis; angular power system stability;voltage stability;N-1 stability analysis;Ornstein-Uhlenbeck process;ANFIS avr},
  doi={10.1109/GTDLA61236.2024.10913910},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10902354,
  author={Simms, Stan R. and Braga, Gabriel and Farr, Thomas A.},
  booktitle={2024 IEEE IAS Pulp and Paper Industry Conference (PPIC)}, 
  title={Real-Time Controller HIL Simulations for Motor Starting Studies}, 
  year={2024},
  volume={},
  number={},
  pages={67-79},
  abstract={In this paper a virtual plant is combined with the hardware controllers of a reduced voltage soft-starter and adjustable frequency motor drive to simulate motor starting interactions. During across the line motor starts, as well as reduced voltage starting, a sag condition typically occurs as the shaft comes up to full speed. In industrial power systems adjacent loads such as adjustable frequency motor drives may be impacted by this transient disturbance. The situation can be further aggravated when the common bus is fed from a back-up diesel-generator set. Using a real-time controller hardware-in-the-loop simulator this starting condition will be examined. The goal is to determine if the power flow remains in the safe operating area of the diesel-generator set and capture how the adjustable frequency drive's hardware controller reacts to the disturbance. Multiple starting scenarios are examined including reduced voltage primary reactor starting, reduced voltage solid-state soft-starter starting, and the number of parallel generators to determine how the adjustable frequency drive already operating a motor responds.},
  keywords={Shafts;Voltage fluctuations;Generators;Real-time systems;Hardware;Voltage control;Transient analysis;Protection;Inductors;Relays;adjustable frequency drive (AFD);automatic voltage regulation (AVR);field-programmable gate array (FPGA);hardware-in-the-loop (HIL);point of common coupling (PCC);real-time controller hardware-in-the-loop (RT cHIL);reduced voltage soft starter (RVSS);wound rotor induction motor (WRIM)},
  doi={10.1109/PPIC57149.2024.10902354},
  ISSN={2575-7555},
  month={June},}@INPROCEEDINGS{11081366,
  author={Tanzeem, Saniya and Ujwala, G.},
  booktitle={2025 International Conference on Advances in Modern Age Technologies for Health and Engineering Science (AMATHE)}, 
  title={Power Quality Enhancement in Grid-Connected Solar PV and Battery Energy Storage Systems Using STBC Controller with CSA Algorithm}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper proposes a robust approach for managing nonlinear power flow in microgrids by integrating a super twisting-based backstepping controller (STBC) with the Circle Search Algorithm (CSA) for maximum power point tracking (MPPT). By means of grid-connected solar photovoltaic (PV) systems with battery energy storage, the proposed solution eliminates the limitations of conventional MPPT algorithms, which suffer under quickly changing atmospheric conditions due to the nonlinear behavior of PV modules. Although the CSA MPPT approach efficiently recovers maximum power from the solar PV system, the STBC controller provides dependable battery charge and discharge operations and eliminates nonlinearities in solar power producing. Comparative analysis using CSA-PI and CSA-STSMC controllers shows the value of the STBC controller in reducing Total Harmonic Distortion (THD) and increasing power quality in the grid and battery system. Resilience of the proposed system, faster tracking speed, and better convergence to low error levels are shown by simulations run in a MATLAB/Simulink environment. The results show that the STBC-based approach considerably improves system stability and power extraction, therefore providing a practical means to improve the power quality in microgrids containing renewable energy sources.},
  keywords={Maximum power point trackers;Total harmonic distortion;Renewable energy sources;Power quality;Microgrids;Power system stability;Control systems;Stability analysis;Batteries;Resilience;PV Array;MPPT;BES;DEGS;AVR;Neutral Current Mitigation;Power Quality},
  doi={10.1109/AMATHE65477.2025.11081366},
  ISSN={},
  month={April},}@INPROCEEDINGS{11272868,
  author={Simms, Stan R. and Braga, Gabriel and Farr, Thomas A.},
  booktitle={2024 IEEE-IAS/PCA Cement Industry Conference (IAS/PCA)}, 
  title={Real-Time Controller HIL Simulation for Motor Starting Studies}, 
  year={2024},
  volume={},
  number={},
  pages={1-12},
  abstract={In this paper a virtual plant is combined with the hardware controllers of a reduced voltage soft-starter and adjustable frequency motor drive to simulate motor starting interactions. During across the line motor starts, as well as reduced voltage starting, a sag condition typically occurs as the shaft comes up to full speed. In industrial power systems adjacent loads such as adjustable frequency motor drives may be impacted by this transient disturbance. The situation can be further aggravated when the common bus is fed from a back-up diesel-generator set. Using a real-time controller hardware-in-the-loop simulator this starting condition will be examined. The goal is to determine if the power flow remains in the safe operating area of the diesel-generator set and capture how the adjustable frequency drive’s hardware controller reacts to the disturbance. Multiple starting scenarios are examined including reduced voltage primary reactor starting, reduced voltage solid-state soft-starter starting, and the number of parallel generators to determine how the adjustable frequency drive already operating a motor responds.},
  keywords={Shafts;Voltage fluctuations;Motors;Generators;Real-time systems;Hardware;Voltage control;Transient analysis;Protection;Inductors;adjustable frequency drive (AFD);automatic voltage regulation (AVR);hardware-in-the-loop (HIL);point of common coupling (PCC);real-time controller hardware-in-the-loop (RT cHIL);reduced voltage soft starter (RVSS)},
  doi={10.1109/IAS/PCA57664.2024.11272868},
  ISSN={2155-9155},
  month={April},}@INPROCEEDINGS{11510940,
  author={Maheswari, N. Uma and Prabhakaran, A.K. and Vignesh, R. Raja and Prakash, T. Ram and Sanju, S.},
  booktitle={2026 9th International Conference on Inventive Computation Technologies (ICICT)}, 
  title={SmartCode AI: A Hybrid Static Analysis and Ensemble Transformer Framework for Secure Code Review and Automated Remediation}, 
  year={2026},
  volume={},
  number={},
  pages={1640-1647},
  abstract={Application security vulnerabilities continue to dominate the threat landscape, contributing to nearly seventy percent of reported security breaches. The growing volume of software applications, combined with increasing architectural complexity, has significantly expanded the attack surface. Traditional Static Application Security Testing (SAST) tools remain widely adopted; however, existing approaches suffer from critical limitations. High false positive rates, often ranging between sixty and eighty percent, create alert fatigue and reduce developer trust. Pattern-based detection mechanisms lack contextual understanding of business logic, leading to misclassification of safe code as vulnerable. The absence of automated remediation further compounds the issue, as developers must manually interpret findings and design secure fixes. This manual effort increases remediation time, delays deployment cycles, and introduces inconsistency in patch quality. Limited scalability and integration flexibility also hinder continuous security monitoring across large repositories. The proposed SmartCode AI methodology addresses these challenges through a hybrid architecture integrating rule-based static analysis with an ensemble of transformer-based deep learning models. Initial candidate detection ensures broad vulnerability coverage, while contextual verification performed by multiple models significantly reduces false positives. Consensus-driven validation enhances reliability and minimizes inconsistent predictions. Automated patch generation further transforms vulnerability management from detection-only to detection-and-repair. Multi-layer validation ensures syntactic correctness, security compliance, and functional preservation before presenting fixes. A scalable microservices deployment model supports concurrent analysis of large repositories, reducing remediation time from days to hours. Benchmark evaluations demonstrate substantial improvement in precision, recall, F1-score, and patch success rate, validating the effectiveness of the integrated framework.},
  keywords={Modeling;Codes;Signal detection;Security;Transformers;Architecture;Computer architecture;Machine learning;Printing;Software;Software Security;Static Analysis;Ensemble Transformer Models;Vulnerability Detection;Automated Patch Generation;Secure Code Review;SmartVulnBench},
  doi={10.1109/ICICT68280.2026.11510940},
  ISSN={2767-7788},
  month={April},}@INPROCEEDINGS{10734644,
  author={Jiang, Shengbei and Zhang, Jiabao and Chen, Wei and Wang, Bo and Zhou, Jianyi and Zhang, Jie M.},
  booktitle={2024 IEEE/ACM International Workshop on Large Language Models for Code (LLM4Code)}, 
  title={Evaluating Fault Localization and Program Repair Capabilities of Existing Closed-Source General-Purpose LLMs}, 
  year={2024},
  volume={},
  number={},
  pages={75-78},
  abstract={Automated debugging is an emerging research field that aims to automatically find and repair bugs. In this field, Fault Localization (FL) and Automated Program Repair (APR) gain the most research efforts. Most recently, researchers have adopted pre-trained Large Language Models (LLMs) to facilitate FL and APR and their results are promising. However, the LLMs they used either vanished (such as Codex) or outdated (such as early versions of GPT). In this paper, we evaluate the performance of recent commercial closed-source general-purpose LLMs on FL and APR, i.e., ChatGPT 3.5, ERNIE Bot 3.5, and IFlytek Spark 2.0. We select three popular LLMs and evaluate them on 120 real-world Java bugs from the benchmark Defects4J. For FL and APR, we designed three kinds of prompts for each, considering different kinds of information. The results show that these LLMs could successfully locate 53.3% and correctly fix 12.5% of these bugs.CCS CONCEPTS• Software and its engineering → Search-based software engineering; Software testing and debugging.},
  keywords={Location awareness;Software testing;Large language models;Computer bugs;Debugging;Maintenance engineering;Chatbots;Software;Sparks;Software engineering;Large Language Model;Fault Localization;Program Repair;Software Debugging},
  doi={},
  ISSN={},
  month={April},}@INPROCEEDINGS{11334503,
  author={Wang, Jian and Xie, Xiaofei and Hu, Qiang and Liu, Shangqing and Yu, Jiongchi and Kong, Jiaolong and Li, Yi},
  booktitle={2025 40th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={Defects4C: Benchmarking Large Language Model Repair Capability with C/C++ Bugs}, 
  year={2025},
  volume={},
  number={},
  pages={254-265},
  abstract={Automated Program Repair (APR) plays a critical role in enhancing the quality and reliability of software systems. While substantial progress has been made in Java-based APR, largely facilitated by benchmarks like Defects4J, there remains a significant gap in research on C/C++ program repair, despite the widespread use of C/C++ and the prevalence of associated vulnerabilities. This gap is primarily due to the lack of high-quality, open-source benchmarks tailored for C/C++.To address this issue, we introduce Defects4C, a comprehensive and executable benchmark specifically designed for C/C++ program repair. Our dataset is constructed from real-world C/C++ repositories and includes a large collection of bug-relevant commits (9M in total), 248 high-quality buggy functions, and 102 vulnerable functions, all paired with test cases for reproduction. These resources enable rigorous evaluation of repair techniques and support the retraining of learning-based approaches for enhanced performance.Using Defects4C, we conduct a comprehensive empirical study evaluating the effectiveness of 24 state-of-the-art large language models (LLMs) in repairing C/C++ faults. Our findings offer valuable insights into the strengths and limitations of current LLM-based APR techniques in this domain, highlighting both the need for more robust methods and the critical role of Defects4C in advancing future research.},
  keywords={Large language models;Computer bugs;Maintenance engineering;Benchmark testing;Software systems;Software reliability;Software engineering;c++;program repair;benchmark;llm},
  doi={10.1109/ASE63991.2025.00029},
  ISSN={2643-1572},
  month={Nov},}@ARTICLE{10787389,
  author={Zhang, Jinghua and Liu, Li and Gao, Kai and Hu, Dewen},
  journal={IEEE Transactions on Neural Networks and Learning Systems}, 
  title={A Forward and Backward Compatible Framework for Few-Shot Class-Incremental Pill Recognition}, 
  year={2025},
  volume={36},
  number={6},
  pages={9837-9851},
  abstract={Automatic pill recognition (APR) systems are crucial for enhancing hospital efficiency, assisting visually impaired individuals, and preventing cross-infection. However, most existing deep learning-based pill recognition systems can only perform classification on classes with sufficient training data. In practice, the high cost of data annotation and the continuous increase in new pill classes necessitate the development of a few-shot class-incremental pill recognition (FSCIPR) system. This article introduces the first FSCIPR framework, discriminative and bidirectional compatible few-shot class-incremental learning (DBC-FSCIL). It encompasses forward-compatible and backward-compatible learning components. In forward-compatible learning, we propose an innovative virtual class generation strategy and a center-triplet (CT) loss to enhance discriminative feature learning. These virtual classes serve as placeholders in the feature space for future class updates, providing diverse semantic knowledge for model training. For backward-compatible learning, we develop a strategy to synthesize reliable pseudo-features of old classes using uncertainty quantification, facilitating data replay (DR) and knowledge distillation (KD). This approach allows for the flexible synthesis of features and effectively reduces additional storage requirements for samples and models. Additionally, we construct a new pill image dataset for FSCIL and assess various mainstream FSCIL methods, establishing new benchmarks. Our experimental results demonstrate that our framework surpasses existing state-of-the-art (SOTA) methods.},
  keywords={Power capacitors;Medical diagnostic imaging;Training;Computer vision;Hospitals;Computed tomography;Computational modeling;Benchmark testing;Visualization;Uncertainty;Automatic pill recognition (APR);class-incremental learning (CIL);computer vision;few-shot learning (FSL);pill dataset},
  doi={10.1109/TNNLS.2024.3497956},
  ISSN={2162-2388},
  month={June},}@ARTICLE{11262768,
  author={Yu, Lei and Wang, Hongnian and Yin, Changchun and Mo, Xiuwen and Guo, Yuhang and Wang, Yazhou},
  journal={IEEE Transactions on Antennas and Propagation}, 
  title={Contraction High-Order Born Approximation for LWD Azimuthal Propagation Resistivity With Grooved Drill Collar and Calibration for Compensated Signal}, 
  year={2026},
  volume={74},
  number={1},
  pages={656-670},
  abstract={The contraction high-order Born approximation (CHBA) based on the 3-D finite volume method (3-D FVM) in the cylindrical coordinate system is implemented for logging while drilling (LWD) azimuthal propagation resistivity (APR) with a grooved drill collar. The rigorously convergent contraction operator of CHBA guarantees efficient and high-precision electromagnetic (EM) simulation of an arbitrary perturbed model under a known reference model. In addition, in the case of exponentially perturbed conductivity models, multimodel simulations are reduced to solving multitransmitter EM fields in the known reference model by the CHBA. Due to the obvious advantages of CHBA in multimodel and multisource simulations, it is applied to efficiently establish a correction library for drill collar and borehole environment. The efficiency is increased by more than three times compared to the model-by-model method for the specific library. By investigating the numerical responses in the correction library, we find that the borehole with high-resistivity mud has little effect on the compensated responses, and only the calibration for drill collar effect is needed. However, the azimuthal response suffers from very strong nonlinearities, requiring specific corrections. On the basis of these findings, the air-hang calibration method is validated, and the accuracy of compensated resistivity proves the feasibility of the air-hang calibration method over different resistivity intervals, which provides a theoretical basis for practical application.},
  keywords={Conductivity;Libraries;Calibration;Three-dimensional displays;Ferrites;Scattering;Receiving antennas;Transmitting antennas;Solid modeling;Numerical models;3-D finite volume method (FVM);air-hang calibration method;contraction high-order Born approximation (CHBA);grooved drill collar;logging while drilling (LWD) azimuthal propagation resistivity (APR)},
  doi={10.1109/TAP.2025.3632911},
  ISSN={1558-2221},
  month={Jan},}@ARTICLE{11197044,
  author={Bobadilla, Sofia and Jin, Monica and Monperrus, Martin},
  journal={IEEE Transactions on Software Engineering}, 
  title={Do Automated Fixes Truly Mitigate Smart Contract Exploits?}, 
  year={2026},
  volume={52},
  number={1},
  pages={100-115},
  abstract={Automated Program Repair (APR) for smart contract security promises to automatically mitigate smart contract vulnerabilities responsible for billions in financial losses. However, the true effectiveness of this research in addressing smart contract exploits remains uncharted territory. This paper bridges this critical gap by introducing a novel and systematic experimental framework for evaluating exploit mitigation of program repair tools for smart contracts. We qualitatively and quantitatively analyze 20 state-of-the-art APR tools using a dataset of 143 vulnerable smart contracts, for which we manually craft 91 executable exploits. We are the very first to define and measure the essential “exploit mitigation rate”, giving researchers and practitioners a real sense of effectiveness. Our findings reveal substantial disparities in the state of the art, with an exploit mitigation rate ranging from a low of 29% to a high of 74%. Our study identifies systemic limitations, such as inconsistent functionality preservation, that must be addressed in future research on program repair for smart contracts.},
  keywords={Smart contracts;Maintenance engineering;Codes;Source coding;Blockchains;Prevention and mitigation;Manuals;Static analysis;Systematic literature review;Formal verification},
  doi={10.1109/TSE.2025.3618123},
  ISSN={1939-3520},
  month={Jan},}@INPROCEEDINGS{10773661,
  author={Kado, Chihiro and Tsuchiya, Tatsuhiro},
  booktitle={2024 IEEE International Conference on Consumer Electronics-Asia (ICCE-Asia)}, 
  title={Initial Attempt at Automated Vulnerability Fixing of Obfuscated Smart Contracts Using a Large Language Model}, 
  year={2024},
  volume={},
  number={},
  pages={1-3},
  abstract={Countermeasures against vulnerabilities are essential for the security of smart contracts. Some recent studies have focused on automated vulnerability repair using large language models (LLMs). However, the ability of LLMs to fix unknown contracts is still unclear. To address this problem, we applied Code Llama LLM to a real-world smart contract with a vulnerability and its obfuscated version, assuming that the obfuscated version could be considered an unknown contract. We obtained three fixes generated by the LLM for each contract. Of these three, one fix was successful for each contract. While some fixes removed the vulnerability, they also altered the functionality of the contract. No clear difference was observed between the original and obfuscated contracts in terms of the LLM's repairing capability.},
  keywords={Solid modeling;Codes;Large language models;Smart contracts;Maintenance engineering;Solids;Security;Large language model;automated fix;Ethereum smart contract;vulnerability;obfuscation},
  doi={10.1109/ICCE-Asia63397.2024.10773661},
  ISSN={},
  month={Nov},}
