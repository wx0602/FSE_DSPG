  pages={1-3},
  abstract={A novel multi-octave VHF transmitter using outphasing modulator and digital power amplfier(P A) is proposed and demonstrated. The digital outphasing signals are generated using a high speed analog comparator and a universal I/Q modulator, and then a pair of digital PAs are adopted to amplify the modulated signal, which reaches about 2.5W with a bandwidth from 20MHz to 225MHz. Finally, a wideband RF transformer is used to combine the two paths digital P A. The prototype achieves - 40.2 adjacent channel leakage ratio (ACLR) and 1.56% error vector magnitude (EVM) for a 64QAM modulated signal with 5.52 dB P APR at 4 MHz bandwidth (BW).},
  keywords={Radio frequency;Microwave technology;Transmitters;Millimeter wave technology;Modulation;Prototypes;Peak to average power ratio;all-digital transmitter;multi-Octave;outphasing modulator;digital PA;RF transformer},
  doi={10.1109/ICMMT61774.2024.10671892},
