  year={2024},
  volume={24},
  number={23},
  pages={40148-40148},
  abstract={In the paper [1], following corrections should be made: 1. Figure Caption Corrections: Fig. 1. This illustration reveals (a) noninvasive monitoring of blood SpO2 as illustrated in [49, Fig. 4] and (b) HR using the MAX30102 sensor through photoplethysmography [50]. Fig. 3. Process Flowchart - Device Design with MAX-30102, MLX90614, ESP32 and Display Screen (the human temperature distribution part is illustrated in [52, Fig. 8]) 2. Text Correction: This processing involves filtering out noise and other artifacts to ensure the accuracy of the SpO2 and heart rate readings, as shown in Fig. 1(a) (as illustrated in [49, Fig. 4]) and Fig. 1(b) [50]. The sensor’s ability to provide accurate and real-time health data without the need for invasive procedures is a major benefit, making it easier for individuals to monitor their health and for healthcare professionals to gather vital patient data in a variety of settings [51]. The Wireless Body Sensor Network Device, illustrated in Fig. 3, is ingeniously designed with three core components for advanced health monitoring. It utilizes two sophisticated sensors: the MAX-30102 for monitoring vital signs, including blood oxygen levels and heart rate, and the MLX90614 for noninvasive body temperature measurement. The human temperature distribution part is illustrated in [52, Fig. 8]. 3. Acknowledgement Corrections We would like to thank Dr. Nan Zhao and Dr. Lei Guan for guidance and help in measurement. We would also like to acknowledge the use of Canva for designing of some elements in illustration figures. 4. Reference Correction: [49] S. Viciano-Tudela, S. Sendra, J. Lloret, J. Tomas, and J. Belda-Ramirez, "Development of a low-cost pulse oximeter for taking medical-scientific parameters to monitor remote patients," Electronics, vol. 11, no. 19, p. 3061, 2022. [50] Instructables, Guide to using MAX30102 heart rate and oxygen sensor, Available from, https://www.instructables.com/Guide-to-Using-MAX30102-Heart-Rate-and-Oxygen-Sens/. (Accessed: 24-Sep-2024). [51] S. Karolcik, D. K. Ming, S. Yacoub, A. H. Holmes, and P. Georgiou, "A multi-site, multi-wavelength PPG platform for continuous noninvasive health monitoring in hospital settings," IEEE Trans. Biomed. Circuits Syst., vol. 17, no. 2, pp. 349–361, Apr. 2023. [52] K. Kojima et al., "Risk management of heatstroke based on fast computation of temperature and water loss using weather data for exposure to ambient heat and solar radiation," IEEE Access, vol. 6, pp. 3774-3785, 2018.},
  keywords={Monitoring;Temperature measurement;Biomedical monitoring;Temperature sensors;Heart rate;Wireless communication;Temperature distribution;Water heating;Solar heating;Machine learning},
  doi={10.1109/JSEN.2024.3476941},
  ISSN={1558-1748},
  month={Dec},}@ARTICLE{10314489,
  author={Gupta, Shourya and Li, Shuo and Calhoun, Benton H.},
  journal={IEEE Transactions on Very Large Scale Integration (VLSI) Systems}, 
  title={Scalable All-Analog LDOs With Reduced Input Offset Variability Using Digital Synthesis Flow in 65-nm CMOS}, 
  year={2024},
  volume={32},
  number={1},
  pages={190-194},
  abstract={The design and verification process for analog circuits can be long and tedious, wherein designers rely heavily on manual effort to create circuits and draw layouts, thereby limiting turn-around-time and design scale and increasing costs. Various previous works have tried to solve this issue by leveraging digital automated place-and-route (APR) tools, but they involve replacing analog elements with digital counterparts, thereby dampening performance. In this work, we propose a digital flow-based approach to design all-analog circuits that dramatically speeds up the design and layout process while retaining the benefits of true analog topologies and demonstrate the performance for three low-dropout regulators (LDOs). Fabricated in 65-nm CMOS, measurement results show that the generated LDOs achieve up to 99.95% peak current efficiency, a figure-of-merit (FOM) of 4.6 ps, and up to 63.93% reduction in input offset variability with respect to their manually designed counterparts.},
  keywords={Layout;Analog circuits;Manuals;Very large scale integration;Transistors;Design automation;Transient response;Analog circuit design automation;digital synthesis;high efficiency;input offset;low power;low-dropout regulator (LDO);place-and-route;transient response},
  doi={10.1109/TVLSI.2023.3328978},
  ISSN={1557-9999},
  month={Jan},}@INPROCEEDINGS{11052531,
  author={Khan, Ghazi and Roth, Thomas E.},
  booktitle={2025 International Applied Computational Electromagnetics Society Symposium (ACES)}, 
  title={Simulating the Impact of Microwave Control Pulses on Multi-Qubit Superconducting Circuit Quantum Devices Through Maxwell-Schrödinger Modeling Methods}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={Superconducting quantum computers are poised to revolutionize computation by leveraging quantum mechanics to surpass the capabilities of classical computers. However, despite progress toward achieving quantum advantage, major engineering obstacles remain before these systems can be deployed for real-world applications. A critical challenge lies in developing efficient modeling techniques for improving quantum control through microwave pulse schemes. Traditional methods often prove inadequate, either due to the computational inefficiency of full-wave electromagnetics simulations or the impracticality of manual curve-fitting techniques. To enable the large-scale modeling necessary for advancing quantum hardware, new and scalable approaches must be developed that overcome these limitations. In this work, we extend previous Maxwell-Schrödinger modeling techniques (T. E. Roth and S. T. Elkin, “Maxwell-Schrödinger Modeling of a Superconducting Qubit Coupled to a Transmission Line Network,” IEEE Journal on Multiscale and Multi-physics Computational Techniques, vol. 9, Jan. 2024) to simulate coupled superconducting transmon qubits embedded in transmission line networks which are stimulated through microwave control pulses. These microwave pulses allow these superconducting architectures to perform quantum gate operations that are the basis of the quantum computing revolution. Coupled qubits, in particular, are critical components of quantum devices, enabling multi-qubit gates that generate entanglement, which is a fundamental requirement for practical quantum algorithms. Our method specifically addresses transmon qubits operating in the dispersive regime, where the frequencies of transmission line resonators used to couple qubits together are far detuned from the qubits' transition frequencies. Building upon the self-consistent equations of motion introduced in the original work, we enhance the framework by integrating the multi-qubit exchange coupling rate. This parameter plays a crucial role in capturing quantum effects essential for both the deliberate implementation of multi-qubit gates and the evaluation of unintended quantum crosstalk. Leveraging our previous formulation (G. Khan and T. E. Roth, “Field-Based Formalism for Calculating Multiqubit Exchange Coupling Rates for Transmon Qubits,” Phys. Rev. Applied, vol. 22, 064084, Dec. 2024), we provide an efficient method for calculating this rate, enabling more accurate modeling of quantum interactions in complex qubit systems. This formulation relies on the impedance response of the superconducting quantum circuit, a key advantage since impedance responses can be efficiently computed using classical electromagnetic tools. By leveraging this approach, we showcase fundamental operations such as the cross-resonance gate (C. Rigetti and M. Devoret, “Fully Microwave-Tunable Universal Gates in Superconducting Qubits with Linear Couplings and Fixed Transition Frequencies,” Physical Review B, vol. 81, 134507, Apr. 2010). Further, we demonstrate our method's capability to model complex multi-qubit interactions, while also highlighting the critical role of self-consistent interactions in the Maxwell-Schrödinger framework. When these superconducting devices are stimulated via microwave pulses to perform quantum gates, these interactions between the qubits and the transmission line resonators can significantly alter the state dynamics. By advancing robust simulation tools that can accurately model these interactions, our efforts can help support the design of precise quantum control operations in future devices.},
  keywords={Couplings;Power transmission lines;Computational modeling;Qubit;Superconducting transmission lines;Logic gates;Microwave theory and techniques;Microwave circuits;Integrated circuit modeling;Superconducting microwave devices},
  doi={10.23919/ACES66556.2025.11052531},
  ISSN={},
  month={May},}@INPROCEEDINGS{11297554,
  author={Nagy, Balázs and Orosz, Péter and Bozsó, Katica and Skopkó, Tamás},
  booktitle={2025 21st International Conference on Network and Service Management (CNSM)}, 
  title={Enhancing DDoS Detection: A Novel Real-World Dataset for Generalizable Cross-Domain Training}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Researchers working on DDoS detection encounter significant challenges, primarily due to the lack of robust datasets. Existing publicly available datasets are mostly synthetic, mixed, or severely limited. For example, the most cited studies since 2020 have relied on an aggregation of three synthetic datasets, none of which includes up-to-date YouTube and streaming traffic that constitute a significant portion of end-user data. This paper introduces four diverse datasets under the name SCLDDOS2024, collected from 8 Aug, 2022 to 26 Apr, 2024 on various commercial networks using uniform methods and tools. These datasets can significantly enhance DDoS research by supporting and validating the generalization of detection models. The datasets were collected using commercially available DDoS protection solutions and, although not optimal for all research purposes due to real-world data collection constraints, our analysis shows that even simple machine learning models, when paired with effective feature engineering, can achieve high accuracy with SCLDDOS2024. This work highlights the potential of SCLDDOS2024 to transform DDoS detection research by providing richer, more diverse real-world data.},
  keywords={Training;Accuracy;Video on demand;Machine learning;Transforms;Data models;Web sites;Security;Computer crime;Synthetic data;DDoS detection;Intrusion detection and prevention;DDoS;DDoS dataset;Machine learning;Security automation},
  doi={10.23919/CNSM67658.2025.11297554},
  ISSN={2165-963X},
  month={Oct},}@INPROCEEDINGS{10907044,
  author={Khan, Ghazi and Roth, Thomas E.},
  booktitle={2025 United States National Committee of URSI National Radio Science Meeting (USNC-URSI NRSM)}, 
  title={Maxwell-Schrödinger Modeling of Multi-Qubit Effects in a Superconducting Circuit Quantum Device}, 
  year={2025},
  volume={},
  number={},
  pages={5-5},
  abstract={Creating effective modeling strategies to simulate quantum circuit initialization, control, and readout is essential for making practical quantum computers. Current modeling approaches are often limited because they utilize full-wave computational electromagnetics tools inefficiently or depend on user-intensive curve-fitting approaches, both untenable to the massive scaling up required to model useful quantum devices. In this work, we build upon previous Maxwell-Schrödinger methods (T. E. Roth and S. T. Elkin, “Maxwell-Schrödinger Modeling of a Superconducting Qubit Coupled to a Transmission Line Network,” IEEE Journal on Multiscale and Multiphysics Computational Techniques, vol. 9, Jan. 2024) by extending them to model coupled superconducting transmon qubits embedded in transmission line networks. Coupled qubits play a prominent role in quantum devices. They are essential for multi-qubit gates that generate entanglement, which is necessary for any practical quantum computing algorithm. Our method is pertinent for the common case of transmons operating in the dispersive regime where the operating frequency of the electromagnetic (EM) resonator is far detuned from the transition frequencies of the qubits coupled to it. We start from the self-consistent equations of motion developed in the original work. These equations treat the system semi-classically, meaning the EM effects are incorporated classically while the transmon dynamics are evaluated quantum mechanically. We build upon this system by incorporating the multi-qubit exchange coupling rate into the formalism. This quantity characterizes the quantum effects needed to design intentional multi-qubit gates, but also is important in assessing unintentional quantum crosstalk that occurs. This exchange coupling rate can be efficiently evaluated through our prior work (G. Khan and T. E. Roth, “Field-Based Formalism for Calculating Multi-Qubit Exchange Coupling Rates for Transmon Qubits,” arXiv preprint arXiv:2406.05473, 2024), where we developed a simple formula that depended on the impedance response of the superconducting quantum circuit. We then use this methodology to simulate realistic quantum circuit topologies found in the literature and demonstrate basic control operations like the cross-resonance (CR) gate (C. Rigetti and M. Devoret, “Fully Microwave-Tunable Universal Gates in Superconducting Qubits with Linear Couplings and Fixed Transition Frequencies,” Physical Review B, vol. 81, 134507, Apr., 2010.). We further show that accounting for the self-consistent interactions in our Maxwell-Schrödinger framework is key for designing high-fidelity gates, as shown in Fig. 1.},
  keywords={Couplings;Power transmission lines;Qubit;Superconducting transmission lines;Resonant frequency;Logic gates;Mathematical models;Integrated circuit modeling;Quantum circuit;Superconducting microwave devices},
  doi={10.23919/USNC-URSINRSM66067.2025.10907044},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11109757,
  author={Zunino, Alessandro and Garrè, Giacomo and Perego, Eleonora and Zappone, Sabrina and Donato, Mattia and Vastenhouw, Nadine and Vicidomini, Giuseppe},
  booktitle={2025 Conference on Lasers and Electro-Optics Europe & European Quantum Electronics Conference (CLEO/Europe-EQEC)}, 
  title={Structured Detection for Enhanced Resolution and Optical Sectioning Microscopy}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={Image scanning microscopy (ISM) is revolutionizing laser scanning fluorescence microscopy. Replacing the bucket detector used in conventional confocal systems with an array of detectors provides access to additional spatial information below the diffraction scale [1]. Single photon avalanche diode (SPAD) array detectors are becoming the tool of choice for ISM thanks to their single-photon sensitivity and excellent temporal resolution, which enables the measurement of fast fluorescence dynamics [2]. ISM systems produce a multi-dimensional dataset, which can be seen as a collection of confocal-like images, one for each sensitive element of the detector array. Therefore, the reconstruction of a single image requires a tailored algorithm. Traditional approaches, such as adaptive pixel reassignment (APR) and multi-image deconvolution, enhance the lateral resolution, surpassing the diffraction limit up to a factor of two [3]. However, these methods underperform with thick samples, which produce a defocused background that reduces the contrast and hides high-resolution details. The conventional solution consists of limiting the size of the detector, which acts as a pinhole. However, it cannot fully remove out-of-focus light and deteriorates the in-focus signal-to-noise ratio (SNR). In this work, we demonstrate that the raw ISM dataset inherently informs about the axial position of the emitter, paving the way for computational optical sectioning. We propose a comprehensive algorithm - named super-resolution optical sectioning ISM (s2ISM) - to invert the physical image formation model of ISM. Our algorithm discards out-of-focus light and reconstructs only the in-focus plane while enhancing the SNR and lateral resolution.},
  keywords={Optical diffraction;Stimulated emission;Diffraction;Detectors;Fluorescence;Optical imaging;Velocity measurement;Image reconstruction;Signal to noise ratio;Single-photon avalanche diodes},
  doi={10.1109/CLEO/Europe-EQEC65582.2025.11109757},
  ISSN={2833-1052},
  month={June},}@INPROCEEDINGS{11052490,
  author={Argyropoulos, Christos},
  booktitle={2025 International Applied Computational Electromagnetics Society Symposium (ACES)}, 
  title={Quantum Multiphysics Modeling of Metallic Surfaces and Nanostructures Under Femtosecond Laser Illumination}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={Femtosecond lasers can strongly interact with metallic surfaces and nanostructures leading to surface processing and hot electron generation. Recently, we theoretically studied (L. Khosravi Khorashad and C. Argyropoulos, “Unraveling the temperature dynamics and hot electron generation in tunable gap-plasmon metasurface absorbers,” Nanophotonics, vol. 11, issue 17, pp. 4037–4052, Apr. 2022) the non-equilibrium dynamics of hot electron relaxation processes in metallic (plasmonic) metasurface absorbers when excited by femtosecond lasers. Strong light–matter interactions combined with quantum effects at the nanoscale are dominant in these nano configurations. A quantum hydrodynamic nonlocal model approach was employed to accurately predict the induced electric field distribution confined in the ultrathin dielectric nanogap. The utilized hydrodynamic model considered electron-electron repulsion which resulted in quantum electron pressure in the system. This approach led to a more accurate calculation of the induced electric field in the dielectric spacer nanogap considering the electric field spillage into the metallic sections of the metasurface. Additionally, we calculated the hot electron generation rate (non-thermalized electrons) using a formula based on the quantum dynamics of equation of motion and the density matrix theory. We utilized the two-temperature model (TTM) coupled with the nonlocal model for the first time to compute the time dependent electron and lattice temperature ultrafast non-equilibrium dynamics. The TTM allowed us to demonstrate temperature dynamics of hot electrons and their transition into thermal carriers at various laser illumination timescales from femto to nano seconds. We further demonstrated the resulted tunable ultrafast transient absorption response as a function of wavelength and time which can be useful in the emerging field of time-variant nanophotonics.},
  keywords={Laser theory;Nanophotonics;Surface emitting lasers;Metasurfaces;Laser modes;Mathematical models;Nanostructures;Electric fields;Surface treatment;Electrons},
  doi={10.23919/ACES66556.2025.11052490},
  ISSN={},
  month={May},}@INPROCEEDINGS{11420119,
  author={Khan, Ghazi and Roth, Thomas E.},
  booktitle={2025 IEEE CNC-USNC-URSI North American Radio Science Meeting (Joint with AP-S Symposium)}, 
  title={Evaluating State Dynamics of Multi-Qubit Superconducting Circuit Quantum Devices Through Maxwell-Schrödinger Modeling}, 
  year={2025},
  volume={},
  number={},
  pages={3280-3280},
  abstract={Quantum computers are a revolutionary technology that promises to utilize quantum effects in order to achieve an unprecedented level of performance boost over traditional computers. While this technology has made great strides in achieving the so-called “quantum advantage” there are significant engineering challenges that must be resolved before these systems can be used for practical applications. Chief among these challenges is the need to develop efficient modeling strategies for simulating quantum circuit initialization, control, and readout. Existing approaches often fall short due to their inefficient use of full-wave computational electromagnetics tools or reliance on labor-intensive curve-fitting methods-both unsuitable for the extensive scaling required to model useful quantum devices. In this work, we extend previous Maxwell-Schrödinger modeling techniques (T. E. Roth and S. T. Elkin, “Maxwell-Schrödinger Modeling of a Superconducting Qubit Coupled to a Transmission Line Network,” IEEE Journal on Multiscale and Multiphysics Computational Techniques, vol. 9, Jan. 2024) to simulate coupled superconducting transmon qubits embedded in transmission line networks. Coupled qubits are critical components of quantum devices, enabling multi-qubit gates that generate entanglement-a fundamental requirement for practical quantum algorithms. Our method specifically addresses transmon qubits operating in the dispersive regime, where the resonator frequency is far detuned from the qubits' transition frequencies. Starting from the self-consistent equations of motion presented in the original work, we extend the framework by incorporating the multiqubit exchange coupling rate. This parameter, which characterizes quantum effects necessary for intentional multi-qubit gates and the assessment of unintentional quantum crosstalk, can be efficiently calculated using our prior formulation (G. Khan and T. E. Roth, “Field-Based Formalism for Calculating Multiqubit Exchange Coupling Rates for Transmon Qubits,” Phys. Rev. Applied, vol. 22, 064084, Dec. 2024). This formula depends on the impedance response of the superconducting quantum circuit, which is particularly advantageous because impedance responses are straightforward to calculate using classical electromagnetic tools. We apply this methodology to simulate realistic quantum circuit topologies commonly found in the literature, showcasing fundamental operations such as the cross-resonance (CR) gate (C. Rigetti and M. Devoret, “Fully Microwave-Tunable Universal Gates in Superconducting Qubits with Linear Couplings and Fixed Transition Frequencies,” Physical Review B, vol. 81, 134507, Apr. 2010). By employing this approach, we demonstrate the capability to model complex multi-qubit interactions, while also highlighting the critical role of self-consistent interactions in the Maxwell-Schrödinger framework. These interactions can significantly impact the state dynamics of the qubits and therefore are essential for achieving precise control and robust gate fidelity, which are necessary for practical quantum computation.},
  keywords={Couplings;Power transmission lines;Computational modeling;Qubit;Superconducting transmission lines;Resonant frequency;Logic gates;Integrated circuit modeling;Quantum circuit;Superconducting microwave devices},
  doi={10.23919/CNC-USNC-URSI64444.2025.11420119},
  ISSN={2573-3036},
  month={July},}@INPROCEEDINGS{10632386,
  author={Saleem, A. and Tan, S.},
  booktitle={2024 IEEE INC-USNC-URSI Radio Science Meeting (Joint with AP-S Symposium)}, 
  title={Multilayer Artificial Neural Network for Predicting the RIS-Assisted 3D-GBSM Channel Model Characteristics in Vehicle-to-Vehicle Environments}, 
  year={2024},
  volume={},
  number={},
  pages={158-158},
  abstract={Vehicle-to- Vehicle (V2V) communication is critical to the implementation of Intelligent Transport Systems, which aim to improve traffic efficiency, road safety, and the overall driving experience. Traditional channel models (J. Nuckelt, et.al., “Geometry-based Path Interpolation for Rapid Ray-Optical Modeling of Vehicular Channels,” In Proc. EuCAP, Apr. 2015,pp. 1–5) rely on classical electromagnetic field propagation theory and geometric optics concepts to provide reliable predictions. However, these methods are complex and inefficient, with well-recognized drawbacks. In contrast, approaches using Artificial Neural Network (ANN) channel modelling methods (L. Azpilicueta, et.al, “A Ray Launching-Neural Network Approach for Radio Wave Propagation Analysis in Complex Indoor Environments,” IEEE Trans. Ant. Propag. vol. 62, no. 5, pp. 2777–2786, Feb. 2014 ) effectively reduce model complexity and computation time.},
  keywords={Interpolation;Computational modeling;Propagation;Vehicular ad hoc networks;Artificial neural networks;Reliability theory;Optics},
  doi={10.23919/INC-USNC-URSI61303.2024.10632386},
  ISSN={2573-3036},
