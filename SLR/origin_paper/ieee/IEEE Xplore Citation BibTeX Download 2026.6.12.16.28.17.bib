  month={April},}@INPROCEEDINGS{10475750,
  author={Micev, Mihailo and Ćalasan, Martin and Radulović, Milovan},
  booktitle={2024 28th International Conference on Information Technology (IT)}, 
  title={optimization of voltage controller parameters considering the real model of the automatic voltage regulation system}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper deals with the optimal tuning of a voltage controller for a real model of the automatic voltage regulation (AVR) system of a synchronous generator. The real simulation model of the automatic voltage regulation system is developed in MATLAB Simulink software and is based on the technical documentation of real generator in hydropower plant Perucica. Optimal parameters of the proportional-integral (PI) controller with anti-windup protection, which is used for voltage regulation of real generator, are estimated using equilibrium optimizer (EO) algorithm. The comparative analysis with parameters used for voltage controller in real hydropower plant is carried out.},
  keywords={Transient response;PI control;Software packages;Hydroelectric power generation;Documentation;Mathematical models;Generators},
  doi={10.1109/IT61232.2024.10475750},
  ISSN={2836-3744},
  month={Feb},}@INPROCEEDINGS{11036228,
  author={Ayaz, Muhammad and Baig, Uroosa and Baig, Dur-e-Zehra and Dawood, Marrium and Awais, Muhammad},
  booktitle={2025 International Conference on Emerging Power Technologies (ICEPT)}, 
  title={Optimizing Voltage Control in Power Systems: An Artificial Neural Network Approach for Improved Performance and Stability}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The aim of this paper is to design an Artificial Neural Network (ANN) based PID controller for Automatic Voltage Regulation (AVR) that guarantees a stable and high-quality electric power supply to consumers, in contrast to the conventional PID controller. The proposed control methodology is tailored to handle the intricate and dynamic behaviors of distribution systems. The adopted methodology requires extensive input and output datasets to train the ANN. The ANN has three inputs, i.e., error (E), change in error (C E), integral of error (1 E), and one manipulated output mk(KT). The simulation analyses demonstrate that the ANN-based PID controller enhances accuracy, resilience to disturbances, and adaptability to changes in system parameters. The performance for conventional and ANN-based PID is measured employing mean square error (MSE). Results indicate that the MSE is 9.9168 × 10–7and RMSE is 9.9583 × 10–4 • Thus, ANN-based PID outperforms compared to the conventional PID controller.},
  keywords={Transient response;Power system dynamics;Power system control;Artificial neural networks;Power system stability;Control systems;Stability analysis;Steady-state;Voltage control;Transient analysis;Voltage Control;Artificial Neural Networks;Automatic Voltage Regulator;Transient Response;Machine Learning},
  doi={10.1109/ICEPT66058.2025.11036228},
  ISSN={},
  month={April},}@ARTICLE{10779513,
  author={Phillipson, Kevin J. and Rywalt, Michael G. and Chatterjee, Baibhab and Schwartz, Eric M. and Stitt, Greg},
  journal={IEEE Embedded Systems Letters}, 
  title={Novel Toolset for Efficient Hardwired Micro-Op Translation in Embedded Microarchitectures}, 
  year={2024},
  volume={16},
  number={4},
  pages={373-376},
  abstract={Modern SoCs require increasingly complex embedded control deep within their numerous sub-blocks without adding significant die area. This motivated the creation of  $\mu $ RTL, a novel toolset for systematically designing efficient pipelined implementations of embedded instruction sets originally intended for multicycle execution.  $\mu $ RTL utilizes hardwired micro-op translation, a technique commonly used in the instruction decoders of large super-scalar microprocessors, however this technique has been overlooked for designing smaller, more efficient embedded microprocessors. Furthermore, the tools to develop instruction decoders with micro-op translation are proprietary and the techniques are trade secrets. The  $\mu $ RTL toolset is open-source and this letter clearly presents the methodology. The methodology emphasizes direct opcode decoding from multiple synthesized Verilog blocks versus traditional microprogramming which uses sequential decoding from a ROM. Our results show that a pipelined  $\mu $ RTL microarchitecture achieves a 21.8% reduction in size compared to a hardwired multicycle implementation of the same instruction set. Additionally, the performance of 0.75 DMIPS/MHz surpasses the RISC-V PicoRV32 by 44.2% and the AVR RISC by 82.9%. These improvements in performance, power, and area are of interest to embedded system architects.},
  keywords={Microarchitecture;Reduced instruction set computing;Embedded systems;Microprocessors;Decoding;IP networks;Hardware design languages;Read only memory;Microprogramming;Embedded microarchitecture;instruction decode;micro-assembler;microcode;micro-op;pipelining},
  doi={10.1109/LES.2024.3447695},
  ISSN={1943-0671},
  month={Dec},}@INPROCEEDINGS{10607726,
  author={Dombale, Anita and Thakare, Chetan and Thorve, Mahesh and Suryavanshi, Vedant and Ubale, Anjali and Chavan, Tanishq and Zagade, Swayam},
  booktitle={2024 4th International Conference on Pervasive Computing and Social Networking (ICPCSN)}, 
  title={Biometric Authentication System for Two Wheeler}, 
  year={2024},
  volume={},
  number={},
  pages={696-699},
  abstract={This project is created to fulfil only one purpose that is to create an authentication system based on biometrics, the most common type of biometrics is fingerprint. It is designed to reduce and prevent the theft of two wheelers. This also provides the user a keyless interface increasing its accessibility. The ignition system is replaced with fingerprint start system. The fingerprints are identified and stored in templates of binary codes which are acquired on the basis of special features of fingerprint. The project consists of the AVR microcontroller Arduino uno r3, the fingerprint module R307, and the GSM Module sim800L. The fingerprint Module R307 can store up to 127 fingerprints. once the fingerprints are stored the r307 interacts with the Arduino and process that information if the fingerprint matches with the user, then the Arduino controller sends signal to relay module to start the ignition system. f the fingerprint does not matches the Arduino sends a message to the user as "someone has tried to access your bike" via GSM module. The proposed model mimics the self-start of bike with a DC motor. Additionally, access to the two-wheeler is available via a keypad, which has a four-digit password, allowing users’ family or relatives to access the model other than the user.},
  keywords={GSM;Pervasive computing;Social networking (online);Computational modeling;Biological system modeling;Authentication;Process control;Arduino UNO;R307;GSM;Arduino IDE;Biometrics;keypad},
  doi={10.1109/ICPCSN62568.2024.00116},
  ISSN={},
  month={May},}@INPROCEEDINGS{10704175,
  author={Shaik, Hussain and Kusuma, G. and Yadlapati, Kishore},
  booktitle={2024 International Conference on Emerging Techniques in Computational Intelligence (ICETCI)}, 
  title={Frequency Domain Parameters of a Two-Area Automatic Generation Control System}, 
  year={2024},
  volume={},
  number={},
  pages={281-287},
  abstract={During the dynamic operation of a power system, unpredictable changes in load result in deviations in both frequency and voltage from their intended levels, posing challenges such as line tripping and the threat of blackouts. To address these issues, the implementation of automatic generation control is es-sential, which comprises two critical components: load frequency control (LFC) and an automatic voltage regulator (AVR). This study aims to delve into the exploration of adjustments in the system dynamics of a two-area load-frequency control system. The investigation entails analyzing modifications in the bode diagram caused by fluctuations in PID controller parameters. The variations in frequency domain parameters were identified and examined both with and without control.},
  keywords={Automatic frequency control;Regulators;Fluctuations;System dynamics;Frequency-domain analysis;Power system dynamics;Automatic generation control;Automatic voltage control;Computational intelligence;Load frequency control;LFC;Automatic Gen-eration Control;AGC;bode plot;transfer function coefficients;MATLAB;proportional;integral;differential (PID) con-troller;dynamic behaviour},
  doi={10.1109/ICETCI62771.2024.10704175},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10987216,
  author={K, Vishnuvardhan Reddy and Bhattacharya, Samya Deb and Gowra, Ramakanth Naidu and Chandrakar, Saurabh},
  booktitle={2024 23rd National Power Systems Conference (NPSC)}, 
  title={Implementation and Performance Evaluation of Diode Failure Detection Algorithm of Diode Failure Detection Relay for Brushless Excitation System}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Brushless Excitation Systems have been widely used in Synchronous Generators as it reduces the losses, maintenance and improves the reliability of the system by eliminating the usage of commutator, brushes and slip rings. Rotating diode bridge rectifier is the main part of brushless excitation system. Due to aging phenomenon and continuous process regime, the diode in the rotating bridge rectifier can fail either due to open circuit or short circuit. If such a failure prolonged, the Automatic Voltage Regulator (AVR) as well as the Exciter winding can be damaged. This paper briefly describes the structure of Brushless Excitation System technology and its operation. The paper presents the modeling of Brushless Excitation System in Real Time Digital Simulator (RTDS) and simulations carried out to study the behavior of system during the diode open circuit condition and short circuit condition in a rotating bridge rectifier. It describes the technique/principle established for detecting a diode failure condition and its validation using RTDS. It also describes the suitable hardware architecture consisting of Field Programmable Gate Array (FPGA) & Processor module chosen to implement the developed diode failure detection algorithm. The paper summarizes the implementation of developed algorithm on hardware and the performance evaluation carried out through Hardware-In-Loop (HIL) testing using RTDS. It also presents the various tests carried out to evaluate the performance of developed detection relay on test bed of Brushless Excitation System.},
  keywords={Performance evaluation;Software algorithms;Rectifiers;Bridge circuits;Hardware;Real-time systems;Software;Relays;Field programmable gate arrays;Testing;Static Excitation System (SES);Brushless Excitation System;Real Time Digital Simulator (RTDS);Diode Failure Detection Relay;Rotating Diode Bridge Rectifier;Exciter},
  doi={10.1109/NPSC61626.2024.10987216},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11386602,
  author={Nijhawan, Vaibhav and Verma, Ayush and Ahluwalia, Aneesh and Sharma, Akshat},
  booktitle={2025 5th International Conference on Advancement in Electronics & Communication Engineering (AECE)}, 
  title={Design of Health Monitoring System Using IoT}, 
  year={2025},
  volume={},
  number={},
  pages={938-942},
  abstract={Different devices are used to collect several parameters of human beings like temperature, SPO2 levels, pulse rate, et cetera. These instruments are used in evaluation of health conditions. It will display and store the gathered data, settling on an exact choice on information gathered, and informing the doctor, if necessary. This is an exigent task today. In the proposed system, an IOT- AVR microcontroller-based health monitoring system with Bluetooth is embedded in it to gather and examine the data acquired from the sensors. A health monitoring system with Arduino Uno will store the collected data on the bluetooth terminal app available on the Play Store. This system will help the patient in identifying critical situations early on. This fusion of IOT- arduino & bluetooth is an intuitive way to re-introduce IOT in Healthcare Monitoring and is very cost-effective. Arduino Uno not only gathers all data from the sensors but also transfers data into an app via bluetooth.},
  keywords={Bluetooth;Pulse measurements;Instruments;Medical services;Sensor systems;Sensors;Mobile applications;Monitoring;ARDUINO UNO;Health Monitoring;Bluetooth;SPO2},
  doi={10.1109/AECE67531.2025.11386602},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11095945,
