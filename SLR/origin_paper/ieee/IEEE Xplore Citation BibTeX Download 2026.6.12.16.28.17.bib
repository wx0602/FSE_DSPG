  month={Oct},}@INPROCEEDINGS{10471136,
  author={Ma, Chuantao and Xiao, Jing and Lu, Jing},
  booktitle={2024 IEEE 4th International Conference on Power, Electronics and Computer Applications (ICPECA)}, 
  title={Research on Intelligent Control System of Electrical and Electronic Technology of Computer Big Data Optoelectronic Communication}, 
  year={2024},
  volume={},
  number={},
  pages={1124-1129},
  abstract={The photoelectric communication remote control system is realized by combining AVR microcontroller with virtual instrument. This design is composed of temperature control module, DC drive module and PC control module. The system uses ADN8830 with high temperature control precision as the main control element. Through the research of temperature control network and power amplifier circuit control system is formed. With ADN2830 as the core, the high precision digital potentiometer is used to accurately adjust the injection current of the laser through serial connection and parallel. The human-machine interface of PC is realized by C# programming. The control part of PC completes the overall control of the entire electrical circuit through serial communication. The slave end is the actuator, which determines the communication criteria between nodes according to the application-level protocol of CAN Kingdom. The experimental results show that this scheme can achieve 0.01°C temperature control accuracy and 0.01 mA temperature control accuracy, and can realize stable operation of nulsed laser well.},
  keywords={Temperature sensors;Temperature measurement;Power supplies;Microcontrollers;Instruments;Real-time systems;Temperature control;Communication protocol;upper computer interface;real-time monitoring;laser chaos;precise control;temperature control module},
  doi={10.1109/ICPECA60615.2024.10471136},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11278301,
  author={Akhtari, Shahram and Dehchil, Mohammadali Narooie and Akhtari, Ali},
  booktitle={2025 29th International Electrical Power Distribution Conference (EPDC)}, 
  title={Damping Enhancement Strategy in Microgrids Using High-Pass Filter-Based Virtual Synchronous Generator}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Ensuring frequency stability in low-inertia microgrids with a substantial integration of renewable energy sources (RES) presents a considerable challenge. To address this issue, the utilization of virtual synchronous generators (VSGs) has been proposed. VSGs provide inertial and damping responses by emulating the operation of conventional synchronous generators, thus earning their name. This paper presents an updated structure of the virtual synchronous generator that replicates the behavior of a conventional synchronous generator equipped with automatic voltage regulator (AVR) and power system stabilizer (PSS) control loops. Furthermore, an optimal high-pass filter for improved transient damping is integrated into the control methodology to enhance the dynamic performance of the microgrid. This approach is employed to improve microgrid dynamic stability and performance against transient disturbances. To assess the effectiveness of the proposed method, comparative simulations are conducted in the MATLAB/Simulink environment, and the obtained results demonstrate an enhanced damping response through the proposed communication-less control strategy.},
  keywords={Damping;Renewable energy sources;Torque;Regulators;Power system dynamics;Microgrids;Power system stability;Synchronous generators;Stability analysis;Transient analysis;Damping torque;microgrid;virtual synchronous generator;synchronizing torque;transient damping},
  doi={10.1109/EPDC67173.2025.11278301},
  ISSN={2833-9053},
  month={Oct},}@INPROCEEDINGS{10863749,
  author={Do, Ngoc-Tuan and Nguyen, Huu Minh and Hoang, Van-Phuc},
  booktitle={2024 IEEE International Workshop on Technologies for Defense and Security (TechDefense)}, 
  title={Enhancing Performance of Deep Learning Based Non-Profiled Side-Channel Attack Using Multi-Output and Transfer Learning}, 
  year={2024},
  volume={},
  number={},
  pages={374-379},
  abstract={Multi-output deep learning based side-channel analysis (MO-DLSCA) has been introduced to improve the performance of non-profiled side-channel attacks (SCA) using deep learning. MO-DLSCA requires only one training process to reveal a subbyte of the secret key. In non-profiled SCA scenarios, attack techniques like Differential Power Analysis (DPA), Correlation Power Analysis (CPA), or MO-DLSCA must undergo the same process to attack different target devices, even if they share the same properties. This paper introduces a new SCA technique that leverages a multi-output deep learning neural network and transfer learning to enhance the performance of non-profiled SCA on targets with similar properties to the original target. Specifically, we demonstrate the advantage of our method in nonprofiled attacks over power traces collected from AVR XMEGA microcontrollers using ChipWhisperer. The experimental results show that our technique requires only $10 \%$ of the power traces compared to the first target to reveal the subbyte key in the second target. Additionally, the attack time for the second target is reduced significantly, approximately by a factor of 5.7, compared to the conventional MO-DLSCA technique.},
  keywords={Deep learning;Performance evaluation;Training;Correlation;Microcontrollers;Conferences;Transfer learning;Neural networks;Side-channel attacks;Security},
  doi={10.1109/TechDefense63521.2024.10863749},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10773881,
  author={Kim, Youngdeok and Han, Seunghyeon and Lee, Jong Weon and Kim, Deog Young and Park, Hangue},
  booktitle={2024 IEEE International Conference on Consumer Electronics-Asia (ICCE-Asia)}, 
  title={Commercial-Off-the-Shelf (COTS) Wearable Elbow Joint Angle Measurement System}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Measuring joint angles is crucial for kinematic analysis of human movement. The measurement of range of motion (ROM) is particularly essential for evaluation of a patient's joint function in physical therapy and rehabilitation. Physical therapists and physicians typically use a mechanical goniometer to measure joint angles in clinical settings. However, this measurement is often limited by low accuracy, limited resolution, and observation error. This study presents a commercial-off-the-shelf (COTS) wearable elbow joint angle measurement system, which would enhance the measurement accuracy. The accuracy of the system was evaluated in two test setups: 1) desktop test setup without human subjects and 2) wearable test setup with human subjects. In the test without human subjects, the angle measurement was repeated for five times at the angles varied from 60° to 180° by 10° increments. In the test with human subjects, nine healthy human subjects participated in the experiment. Three representative elbow joint angles between 60° and 180° were measured for 10 times at each subject (60°, 120°, and 180°). The average error of the measured angle was 0.52±0.34 % (AVR±STE) at the desktop test without human subjects. The average error of the measured angle at the test with nine human subjects was -0.29±0.10%. These results indicate that the presented system can measure the elbow joint angle in high accuracy and consistency.},
  keywords={Accuracy;Atmospheric measurements;Measurement uncertainty;Medical treatment;Kinematics;Particle measurements;Motion measurement;Elbow;Motion control;Read only memory;Joint angle measurement;Motor rehabilitation;Wearable;Goniometer},
  doi={10.1109/ICCE-Asia63397.2024.10773881},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11484623,
  author={Kasukurthi, Rambabu and Naik, R Srinu},
  booktitle={2025 IEEE International Conference on Communication Networks and Computing (CNC)}, 
  title={Ultra-Capacitor-Based Dynamic Support for Thermal-DSTS Systems with BSA-Optimized PITIDN Control for Enhanced V&F Stability}, 
  year={2025},
  volume={},
  number={},
  pages={1435-1440},
  abstract={This paper presents a novel ultra-capacitor-based dynamic support system for thermal-Dish-stirling solar thermal system (DSTS), ensuring enhanced voltage and frequency (V&F) stability. A Bird Swarm Algorithm (BSA)-optimized Proportional-Integral-Tilt-Integral-Derivative-Filter (PI-TIDN) controller is proposed. The proposed PI-TIDN controller shows its superiority over PIDN and TIDN controller. Also, thermal systems with BSA technique exhibit superior performance over other optimization techniques. Moreover, the impact of DSTS shows better performance over thermal systems. Further, systems with ultra-capacitor exhibit better dynamics thermal-DSTS units. Furthermore, the impact of AVR loop is studied over LFC system and shows better dynamics.},
  keywords={Capacitors;Voltage multipliers;Power capacitors;Filtering;Supercapacitors;Filters;Communication networks;Receivers;Protocols;HTTP;DSTS;BSA;ultra-capacitor;LFC;TIDN},
  doi={10.1109/CNC68716.2025.11484623},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11255544,
  author={Sahoo, Subhadra and Jena, Narendra Kumar and Tak, Neha and Kasturi, Kumari and Sahu, Binod Kumar and Kumar Debnath, Manoj},
  booktitle={2025 IEEE 5th International Conference on Sustainable Energy and Future Electric Transportation (SEFET)}, 
  title={Coordinated Frequency and Voltage Control in a Hybrid Power System Integrating Wind Energy}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In modern power systems, integrating renewable energy sources maintaining stability remains a critical challenge. This paper presents a two-area interconnected system with the most dynamic renewable energy source i.e wind energy sources integrated in each area and the model is designed using Matlab/Simulink. To address the impact of load variations on both active and reactive power, an Automatic Voltage Regulator (AVR) loop is integrated with the Automatic Load Frequency Control (ALFC) loop to stabilize system voltage and frequency. A fuzzy logic-based PI controller is proposed as secondary controller to mitigate frequency and voltage deviations, and its performance is compared with a robust PID controller. The selection of controller gain parameters is optimized using a novel technique known as Selfish Herd Optimization (SHO) to enhance dynamic response and system stability. The robustness of the proposed control approach is validated by introducing a variable load disturbance in Area-1. Simulation results demonstrate the effectiveness of the proposed methodology in ensuring stable operation under varying load conditions.},
  keywords={Renewable energy sources;Automatic frequency control;Regulators;Wind energy;Transportation;Power system stability;Automatic voltage control;Stability analysis;Hybrid power systems;Optimization;Fuzzy Control;Automatic Voltage Regulator;Selfish Herd Optimization;Wind Energy;Load Frequency Control;Optimal Control},
  doi={10.1109/SEFET65155.2025.11255544},
  ISSN={},
  month={July},}@INPROCEEDINGS{11100188,
  author={Huang, Wenbo and Tian, Xi and Deng, Ding and Ma, Pengcheng and Song, Bin},
  booktitle={2025 5th International Conference on Machine Learning and Intelligent Systems Engineering (MLISE)}, 
  title={Cross-Devices Side-Channel Attacks: An Attack Paradigm Based on Adversarial Training}, 
  year={2025},
  volume={},
  number={},
  pages={166-170},
  abstract={Deep-learning SCAs can recover secrets from power or EM traces even with countermeasures, but they typically assume the same or homogeneous devices, limiting real-world use. We propose an adversarial training-based cross-devices attack paradigm and design a discriminator learning rate scheduling mechanism to improve adversarial convergence under heterogeneous settings, enabling neural network models with the capability to perform side-channel attacks across heterogeneous devices. On a heterogeneous STM32 → AVR setting, it lowers guessing entropy by about 80%, demonstrating robust, unsupervised generalisation across devices.},
  keywords={Training;Performance evaluation;Limiting;Neural networks;Side-channel attacks;Machine learning;Entropy;Modeling;Intelligent systems;Field programmable gate arrays;Cross-devices side-channel attack;Heterogeneous devices;Adversarial training},
  doi={10.1109/MLISE66443.2025.11100188},
  ISSN={},
  month={June},}@INPROCEEDINGS{11101787,
  author={Sahin, Erdinc and Ayas, Mustafa Sinasi},
  booktitle={2025 9th International Symposium on Innovative Approaches in Smart Technologies (ISAS)}, 
  title={Design of a PID Controller with a Predictive Term for Voltage Level Regulation in a Power System}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={This study proposes the design of a proportional-integral-derivative (PID) controller with the predictive term (PPID) for an automatic voltage regulator (AVR) in a power system. The predictive term (PT) is integrated into an optimized PID controller in order to increase the overall closed-loop system performance. The optimal settings of the PT are utilized by the jellyfish search optimizer (JSO) to minimize the integral of time-weighted absolute error (ITAE) criteria. The performance of the proposed controller is then compared to the classical PID controller by considering time-domain characteristics and disturbance rejection analysis. The results demonstrate the effectiveness of the proposed controller, both numerically and graphically, and a $27 \%$ achievement in objective function value is obtained.},
  keywords={Jellyfish;Regulators;Benchmark testing;Linear programming;Regulation;Power systems;PD control;Closed loop systems;Time-domain analysis;Optimization;PID controller with predictive term;time-domain analysis;disturbance rejection;jellyfish optimization;automatic voltage regulation},
  doi={10.1109/ISAS66241.2025.11101787},
  ISSN={},
  month={June},}@INPROCEEDINGS{11452015,
  author={Filimonov, Nikita Yu. and Laypanov, Ilyas R. and Timoshkova, Polina V. and Gulnev, Dmitrii S. and Sabanov, Alexey S.},
  booktitle={2026 ElCon Conference of Young Researchers in Power, Energy & Industry Applications (ElCon-PEIA)}, 
  title={Simulation of the Excitation System of Synchronous Generators of Marine Electric Power Systems}, 
  year={2026},
