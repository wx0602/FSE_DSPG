@INPROCEEDINGS{10724658,
  author={Chauhan, Ganpat Singh and Garg, Neeraj and Nahta, Ravi and Meena, Yogesh Kumar},
  booktitle={2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={Refined Neural Attention Network for Aspect Phrases Retrieval in Opinion Mining}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Recent advances in deep learning have seen accomplishments in a variety of academic fields, notably text processing, image processing, machine translation, and social network screening. On numerous social media platforms, a lot of user-generated content is accessible. that can be applied to precisely analyze opinions in light of evolving market conditions. In sentiment analysis at aspect-level, the aspect phrase retrieval (APR) operation finds the users’ intended topics in the content of the document. The bulk of aspect retrieval techniques are context or domain dependent. Additionally, due to a lack of topical and situational expertise, it is challenging to pinpoint the most important domain-specific element phrases. Due to their inability to recognize noun phrase relationships as time passes, the present extraction techniques have no way to determine several essential aspect terms. This study suggests using linguistic patterns with deep attention network to improve the APR problem. Findings from investigations and tests are analyzed across a variety of factors on common review datasets.},
  keywords={Deep learning;Sentiment analysis;Social networking (online);Reviews;Image processing;User-generated content;Neural networks;Linguistics;Machine translation;Text processing;aspect phrase retrieval;attention model;opinion mining;natural language processing},
  doi={10.1109/ICCCNT61001.2024.10724658},
  ISSN={2473-7674},
  month={June},}@INPROCEEDINGS{11428715,
  author={Hu, Yanhua and Ye, Hao and Yin, Longqian},
  booktitle={2025 5th International Conference on Energy, Power and Electrical Engineering (EPEE)}, 
  title={Analysis of System Performance with Various Working Fluid Pairs of the Dual-Loop Organic Rankine Cycle}, 
  year={2025},
  volume={},
  number={},
  pages={274-279},
  abstract={Based on the dual-loop organic Rankine cycle (DORC), the thermodynamic, economic and environmental performance models of the system are constructed, and the system performance of the DORC with various working fluid pairs is analyzed by taking the net output power, the heat transfer area required per unit of net output power (APR) and the annual equivalent $\text{CO}_{2}$ emission reduction(AER) as the thermodynamic performance indicator, the economic performance indicator and the environmental performance indicator, respectively. In this study, 24 candidate working fluid pairs are used as the working fluid of the DORC. The thermodynamic performance is the optimal when the working fluid pair is toluene/R124, with a maximum net output power of 28.212 kW. When the working fluid pair is cyclohexane/R143a, the economic performance is the optimal, with the minimum APR value is $8.0938 \mathrm{m}^{2} / \text{kW}$. When the working fluid pair is toluene/R124, the environmental performance is the optimal, with the maximum AER is $6.0418 \times 10^{5}$.},
  keywords={Economics;Electrical engineering;Thermodynamics;Fluids;System performance;Biological system modeling;Benchmark testing;Power generation;Optimization;Heat transfer;Dual-loop organic Rankine cycle;Working fluid pair;System performance},
  doi={10.1109/EPEE67527.2025.11428715},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11228132,
  author={Chen, Xinrao and Zhang, Taiping and Chen, Xinyu and Li, Jiaxuan},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Adaptive Semantic Anchoring for Enhanced Generalized Few-Shot Semantic Segmentation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Generalized Few-Shot Semantic Segmentation (GFSS) extends Few-Shot Segmentation by utilizing abundant base class samples and limited novel class annotations to simultaneously segment both base and novel classes. Unlike traditional FSS, which assumes class-matched query-support pairs, GFSS removes this restriction,providing greater flexibility and practicality for segmentation tasks in real-world scenarios. However, existing GFSS methods often face two major challenges: first, due to the scarcity of novel class annotations, their prototypes tend to overfit to low-level texture features, resulting in poor generalization. Second, fixed prototypes within the prototype-query matching strategies struggle to adapt to diverse semantic contexts. To address these challenges, we propose Adaptive Semantic Anchoring for Enhanced Generalized Few-Shot Semantic Segmentation, which incorporates two complementary modules: Semantic diffusion enhancement(SDE) and anchor-based prototype refinement(APR). Specifically, SDE suppresses low-level texture dependencies through gradient-based diffusion, ensuring robust high-level semantic representations across classes. Meanwhile, APR adaptively refines class prototypes using high-confidence anchor pixels, combining local details with global semantics to enhance segmentation accuracy. Extensive experiments on the PASCAL-5i and COCO-20i benchmarks demonstrate that our method significantly outperforms state-of-the-art approaches.},
  keywords={Accuracy;Annotations;Semantic segmentation;Semantics;Neural networks;Prototypes;Benchmark testing;Robustness;Faces;Generalized Few-Shot Semantic Segmentation;Prototype Learning;Image Segmentation},
  doi={10.1109/IJCNN64981.2025.11228132},
  ISSN={2161-4407},
  month={June},}@ARTICLE{11400534,
  author={Kosarevych, Rostyslav and Lutsyk, Oleksiy and Rusyn, Bohdan and Pits, Natalia and Maksymyuk, Taras and Volosin, Marcel},
  journal={IEEE Access}, 
  title={Adaptive Patch Reshaping for Edge-Based Semantic Segmentation in Remote Sensing}, 
  year={2026},
  volume={14},
  number={},
  pages={38951-38964},
  abstract={Accurate boundary detection between distinct classes is a major challenge in the semantic segmentation of remote sensing images. A widely used strategy involves dividing large images into patches for classification, which requires carefully prepared training, test, and validation datasets. When the resolution of the input image exceeds that of the available labels, upsampling the labels to match the image resolution often leads to suboptimal results. To address this issue, we propose an alternative approach, Adaptive Patch Reshaping (APR), that subdivides both the input image and label patches, then reassigns them to classes according to an information-theoretic criterion. By reshaping patches based on their similarity to representative class characteristics, this method constructs a new training set from the original one. Experimental results using Sentinel-2 imagery demonstrate that the proposed technique, implemented with a lightweight CNN, achieved a classification precision of 89% for the training set, 86% for the test set, and 81% for the validation set. Furthermore, comparative analysis confirms that APR improves the delineation of boundaries between regions, yielding higher F1-scores and Structural Similarity Index values compared to standard patch-based baselines.},
  keywords={Remote sensing;Semantic segmentation;Training;Accuracy;Image resolution;Spatial resolution;Land surface;Computational modeling;Feature extraction;Weak supervision;Convolutional neural networks;remote sensing images;semantic segmentation},
  doi={10.1109/ACCESS.2026.3666289},
  ISSN={2169-3536},
  month={},}@ARTICLE{11027079,
  author={Wouters, Laurine and Minten, Lennert and Orlowska, Marta and Caenen, Annette and Duchenne, Jürgen and Voigt, Jens-Uwe and D’Hooge, Jan},
  journal={IEEE Open Journal of Ultrasonics, Ferroelectrics, and Frequency Control}, 
  title={The Impact of Valve Stenosis and Replacement on Wave Characteristics in Cardiac Shear Wave Elastography}, 
  year={2025},
  volume={5},
  number={},
  pages={114-118},
  abstract={Cardiac shear wave elastography (SWE) is a non-invasive technique to assess myocardial stiffness, based on the speed of waves that travel through the heart after valve closure. The wave physics underlying natural SWE remains incompletely understood. Therefore, we investigated the impact of wave excitation sources on 3 wave propagation aspects – wave amplitude (determined as wave acceleration magnitude), temporal wave width and speed. SWE was applied to 17 patients with aortic stenosis (AS), 13 AS patients that underwent transcatheter aortic valve implantation (TAVI), 10 AS patients that underwent surgical aortic valve replacement (AVR) and 18 age-matched healthy volunteers (HV). Absolute wave acceleration was lower in AS, TAVI and AVR patients compared to HV (1.5±0.60 vs 2.8±1.1 m/s2; p=0.001; 1.6±0.78 vs 2.8±1.1 m/s2; p=0.010; 1.7±0.66 vs 2.8±1.1 m/s2; p=0.015). Wave acceleration amplitude (measured as negative peak acceleration of the tissue) correlated with wave speed (r=0.388; p=0.003), implying that absolute wave acceleration is smaller in a stiffer heart. Subgroup analysis showed that the correlation between wave peak acceleration and speed is less steep in AS patients vs. HV (slopes: 0.23 vs 0.47 s). This implies that stenotic valves generate a wave with a lower acceleration magnitude compared to native valves. Further, temporal wave width was lower in TAVI patients vs. HV (8.7±2.3 vs 12.5±3.0 ms; p=0.002) and there was no difference in wave speed after aortic valve closure (AVC) between the groups. To conclude, wave acceleration magnitude and width offer additional insights into SWE physics next to wave speed and should be verified in a larger cohort.},
  keywords={Valves;Myocardium;Propagation;Elastography;Echocardiography;Accelerometers;Frequency control;Diseases;Cardiology;Shear wave elastography;cardiology;aortic stenosis;wave physics;wave speed;wave amplitude;temporal wave width},
  doi={10.1109/OJUFFC.2025.3577142},
  ISSN={2694-0884},
  month={},}@INPROCEEDINGS{10800191,
  author={Dev, Soumik and Ahmed, Anis},
  booktitle={2024 IEEE International Conference on Power, Electrical, Electronics and Industrial Applications (PEEIACON)}, 
  title={A Comparative Analysis Between $\text {H}_{\infty}$ and Sliding Mode Controllers on Automatic Voltage Regulator System}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This study addresses the design of two robust controller types for automatic voltage regulators (AVRs): $\text {H}_{\infty}$ and sliding mode controllers (SMC). Two AVR transfer function models were studied- the third-order model and the second-order approximate model. The AVR's performance criteria included rise time, settling time, overshoot percentage, and ITAE (Integral Time Absolute Error). A tan hyperbolic function was used to lessen the chattering effect in SMC. In terms of parametric uncertainties, SMC was found more robust than the H-infinity controller. The effect of injecting disturbance in the system was also studied. The entire design and simulation was done through the MATLAB Simulink software.},
  keywords={Transient response;Regulators;Uncertainty;Software packages;Transfer functions;H infinity control;Automatic voltage control;MATLAB;Automatic voltage regulator;controller;Sliding mode controller;chattering},
  doi={10.1109/PEEIACON63629.2024.10800191},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10509207,
  author={Bhat, Asif Mushtaq and Sinha, Sreyam},
  booktitle={2024 IEEE Applied Power Electronics Conference and Exposition (APEC)}, 
  title={A Variable Compensation Rectifier with Enhanced Compensation Capability for Coupling Variations in Wireless Power Transfer Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1207-1212},
  abstract={This paper introduces a new variable compensation rectifier (VCR) for mitigating coupling variations in wireless power transfer (WPT) systems. The proposed VCR allows a WPT system to achieve continuous compensation and a constant output power over wide range of misalignments and air-gap variations without having to change the system’s operating frequency. The VCR can achieve substantially higher compensation range compared to that of the recently proposed active variable reactance (AVR) rectifier while allowing an inherently simpler control technique. The paper also outlines a systematic methodology to design a VCR-based capacitive WPT system with a desired maximum compensation range. A proof-of-concept prototype VCR based system is developed and compared with an AVR based system. The VCR based system is demonstrated to achieve two times wider compensation range while maintaining the nominal output power.},
  keywords={Couplings;Wireless communication;Systematics;Air gaps;Rectifiers;Prototypes;Wireless power transfer;wireless power transfer;variable compensation rectifier;coupling variation;misalignment},
  doi={10.1109/APEC48139.2024.10509207},
  ISSN={2470-6647},
  month={Feb},}@INPROCEEDINGS{10625215,
  author={Mahapatra, Mou Das and Konar, Kuntal and Mahato, Surajit and Kumar, Vikash and Dey, Pritam},
  booktitle={2024 IEEE International Conference on Information Technology, Electronics and Intelligent Communication Systems (ICITEICS)}, 
  title={Fuzzy PID Controller Design for Enhanced Voltage Regulation in Automatic Voltage Regulator System}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper presents a comprehensive investigation into the application of a fuzzy proportional-integral-derivative (FPID) controller for improving voltage regulation in automatic voltage regulator (AVR) systems. The conventional Proportional-Integral-Derivative (PID) control strategy is augmented with fuzzy logic (FL) to address the challenges associated with nonlinearities, uncertainties, and dynamic variations in power systems. This paper delves into the design process, including the selection of appropriate fuzzy sets, membership functions (MF), and rule base construction. Special emphasis is placed on the tuning of fuzzy parameters to optimize the controller's performance in voltage regulation tasks. Comparative studies are conducted to evaluate the FPID controller against traditional PID, simple fuzzy controllers (FCs), and recently published literature to showcase its superior adaptability in scenarios where precise system models are challenging to attain. Simulation results are obtained in MATLAB/SIMULINK to demonstrate the efficacy of the FPID controller in maintaining voltage stability, reducing settling time, overshooting, improving the transient response of the AVR system, and contributing to its robustness in the presence of changing system time constants.},
  keywords={Fuzzy logic;Transient response;Uncertainty;Regulators;Power system stability;Automatic voltage control;Robustness;Automatic Voltage Regulator;Proportional-Integral-Derivative Controller;Fuzzy Controller;Fuzzy Proportional-Integral-Derivative Controller;Transient Analysis},
  doi={10.1109/ICITEICS61368.2024.10625215},
  ISSN={},
  month={June},}@INPROCEEDINGS{10846269,
  author={Chen, Wen-Hu and Yang, Ya-Ze and Zhang, Chuan-Ke},
  booktitle={2024 IEEE China International Youth Conference on Electrical Engineering (CIYCEE)}, 
  title={Delay-Dependent Stability of SMIB with Two Types of Excitation Controllers}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={Remote signals become available for designing a wide-area controllers in power system which introduces time delays into the control loop from the latency of communication networks. Moreover, fault of measurement sensors for local signals can be converted to delays in the signal measurement loop. This paper examines the stability of power systems with time delay by calculating the delay margin, which represents the maximum delay a system can tolerate before becoming unstable, considering delays from two sources. A stability criterion, utilizing Lyapunov theory and linear matrix inequalities, is proposed to calculate the delay margin for both constant and time-varying delays. Case studies focus on a single-machine infinite-bus (SMIB) power system with various exciters, such as AVR and AVR+PSS exciter controllers. Comparison the impact of time delays for different excitation controllers and relationship between the controller gains and delay margin are addressed. Accuracy of delay margin calculated is demonstrated by simulation studies, which also compare the delay tolerance of different exciters.},
  keywords={Electrical engineering;Power measurement;Delay effects;Stability criteria;Power system stability;Generators;Delays;Sensors;Linear matrix inequalities;Time-varying systems;-Time delays;delay-dependent stability;Lyapunov functional;matrix-injection method},
  doi={10.1109/CIYCEE63099.2024.10846269},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11070231,
  author={Ayaz, Muhammad and Baig, Uroosa and Awais, Muhammad},
  booktitle={2025 International Conference on Emerging Technologies in Electronics, Computing, and Communication (ICETECC)}, 
  title={Enhancing Power Grid Resilience with Adaptive ANN-Based Voltage Control Strategies}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Resilience in power systems is crucial for maintaining stability and ensuring reliable voltage regulation under disturbances and uncertainties. This paper presents an Artificial Neural Network (ANN)-based PID controller for Automatic Voltage Regulation (AVR) that enhances system resilience by improving adaptability and disturbance rejection. Unlike conventional PID controllers, the proposed ANN-based control strategy dynamically adjusts to system variations, making it robust against load changes, parameter fluctuations, and transient disturbances. Simulation results demonstrate that the ANN-based controller significantly reduces overshoot, improves settling time, and enhances steady-state accuracy. The resilience analysis confirms that ANN-based control exhibits superior disturbance rejection and faster recovery compared to traditional PID, ensuring stable voltage regulation in modern power grids. These findings highlight the potential of machine learning-based control strategies in improving the robustness of AVR systems, making them more reliable in dynamic and uncertain environments.},
  keywords={Transient response;Power system dynamics;Artificial neural networks;Power system stability;Stability analysis;Steady-state;Power system reliability;Voltage control;Transient analysis;Resilience;Voltage Control;Artificial Neural Networks;Automatic Voltage Regulator;Transient Response;Machine Learning},
  doi={10.1109/ICETECC65365.2025.11070231},
  ISSN={},
  month={April},}@INPROCEEDINGS{11279256,
  author={Ahmed, Islam and Suid, Mohd Helmi and Ahmad, Mohd Ashraf and Ahmad, Salmiah and Jusof, Mohd Falfazli Mat and Tumari, Zaidi Mohd},
  booktitle={2025 IEEE 9th International Conference on Software Engineering & Computer Systems (ICSECS)}, 
  title={A Nonlinear Sine Cosine Algorithm Approach to Designing a One-Degree-of-Freedom Sigmoid PID Controller for Automatic Voltage Regulators}, 
  year={2025},
  volume={},
  number={},
  pages={237-242},
  abstract={This paper presents a robust one-degree-offreedom (1-DoF) Sigmoid-based Proportional-IntegralDerivative (SPID) controller optimized using the Nonlinear Sine Cosine Algorithm (NSCA) for an Automatic Voltage Regulator (AVR) system. Conventional PID controllers often struggle with parameter variations and external disturbances, affecting the AVR stability and performance. The proposed SPID controller addresses these challenges by enhancing the system’s robustness and dynamic response through nonlinear sigmoid functions. The NSCA efficiently fine-tunes the controller parameters, balancing exploration and exploitation in the optimization process. Simulation results demonstrate that the SPID controller outperforms conventional PID and other metaheuristic-tuned controllers, achieving up to 59.57% faster settling time, 100% reduction in overshoot, and 69.41% lower steady-state error. This approach significantly improves the voltage regulation in power systems, enhancing stability and reliability under varying load conditions, and offers a robust solution for real world power system applications},
  keywords={Regulators;Simulation;Heuristic algorithms;Power system dynamics;Process control;Power system stability;Stability analysis;Automatic voltage control;Robustness;Tuning;Automatic Voltage Regulator;Sigmoid PID Control;Metaheuristic Optimization;Nonlinear Sine Cosine Algorithm},
  doi={10.1109/ICSECS65227.2025.11279256},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11048249,
  author={Dasgupta, Sohom and Sakthivel, R},
  booktitle={2025 International Conference on Recent Advances in Electrical, Electronics, Ubiquitous Communication, and Computational Intelligence (RAEEUCCI)}, 
  title={Artificial Intelligence based Test Vector Reordering for Optimal Test Power Reduction}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Analysis of Systems-on-Chip (SoC) built around cores with IP faces significant challenges in minimizing test power, especially during external testing. Techniques such as "don’t care bit filling" and "test vector reordering" have proven effective for reducing switching activity without requiring modifications to the internal structure or employing specialist tools for testing, making them suitable for IP cores with hidden structures. This paper proposes a Low Power Artificial Intelligence-Based Vector Reordering (LPAVR) method which combines the A* algorithm for Path Finding and Minimum Hamming Distance together to optimize test vector sequences and minimize capture power at the input side. The proposed AVR method fills don’t care bits in the test vectors strategically and reorders them that is fed into the design under testing. A series of X bits is replaced based on adjacent non-X entries to ensure uniformity and minimize transitions. Empirical results demonstrate an average switching activity reduction of 34% for combinational circuit and 18% for sequential circuits. By optimizing the order of test vectors and strategically filling X bits, AVR enhances the low-power testing process for combinational circuits. This approach effectively addresses the increasing power minimization challenges posed by process technology scaling, providing a practical solution for test engineers and SoC designers.},
  keywords={Switches;Benchmark testing;Very large scale integration;Minimization;Vectors;Filling;Combinational circuits;IP networks;Artificial intelligence;Switching circuits;Don't Care Bit Filling;Low Power Artificial Intelligence based Vector Reordering (LPAVR);Power Reduction;Dynamic Switching Activity Minimization},
  doi={10.1109/RAEEUCCI63961.2025.11048249},
  ISSN={},
  month={April},}@INPROCEEDINGS{10741802,
  author={Gandara-Mendez, Diego and Mandal, Paras},
  booktitle={2024 56th North American Power Symposium (NAPS)}, 
  title={Undergraduate Research on DER Integration and Advanced Control Strategies for Grid Disturbance}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={With the global push towards cleaner energy, the integration of distributed energy resources (DERs) and the implementation of advanced control strategies are becoming crucial for modernization of electric grids. DERs not only help reduce the carbon footprint of the grid but also play a crucial role in enhancing grid resilience. This paper highlights the importance of research at the undergraduate level in the area of DER integration and microgrid energy management systems and investigates the impact of integrating DERs into electric grid using PowerWorld Simulator, and for which, the Hawaii Synthetic Case 37-Buses is utilized. The focus of the paper also lies in the effectiveness of control strategies such as Automatic Generation Control (AGC) and Automatic Voltage Regulation (AVR) in managing the microgrid islanding while the network is experiencing a disturbance scenario. The implementation of AGC and AVR within the microgrids reduces the response time required for the network to stabilize. Test results demonstrate the significant improvements in the response time of distribution networks due to the integration of DERs, advanced control strategies, and microgrid implementation.},
  keywords={Time-frequency analysis;Voltage fluctuations;Fluctuations;Microgrids;Automatic generation control;Power system stability;Stability analysis;Distributed power generation;Time factors;Resilience;Distributed energy resources;frequency and voltage stability;islanded microgrid;PowerWorld Simulator;undergraduate research},
  doi={10.1109/NAPS61145.2024.10741802},
  ISSN={2833-003X},
  month={Oct},}@INPROCEEDINGS{11393197,
  author={Cui, Xi and Xi, Caixia and Fu, Yuhe and Zhao, Lihang and Wang, Pengyu and Wu, Jialiang},
  booktitle={2025 7th International Conference on Electrical Engineering and Control Technologies (CEECT)}, 
  title={Enhancing LVRT Performance of Solar PV Plants Using Voltage Reference from Coal-Fired Units}, 
  year={2025},
  volume={},
  number={},
  pages={83-87},
  abstract={The paper comes up with an enhanced low-voltage ride-through (LVRT) strategy for utility-scale PV plants, specifically aimed to weak-grid scenarios, where the abandoned mining areas are reused by equipping with solar farms. By cooperating the AVR function of coal-fired power plants with the PV inverter’s LVRT control, the strategy generates a smoother and more stable q-axis current during grid faults, especially during the unbalanced and unsevere grid faults, due to the stable voltage as the reference. After fault recovered, the synchronous machine’s inertia and AVR function also participate in lowering PCC-voltage oscillations, yielding a faster and steadier recovery. Simulation results demonstrate that the proposed strategy significantly extends allowable ride-through duration and meets the requirements.},
  keywords={Photovoltaic systems;Reactive power;Simulation;Solar farms;Power system stability;Stability analysis;Time factors;Voltage control;Standards;Oscillators;LVRT;Solar PV Plants;Coal-Fired Units;Mining sites},
  doi={10.1109/CEECT67814.2025.11393197},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11490248,
  author={Alam, Sazidul and Ahmed Limon, Md. Faiyaj and Momin, Md. Abdul and Islam, Md. Nahidul and Abanthi, Sraboni Acharjee and Iqbal, Md. Shahid},
  booktitle={2025 28th International Conference on Computer and Information Technology (ICCIT)}, 
  title={Whale Optimization Algorithm Based Tuning of PD-PI-PID Controller for Automatic Voltage Regulator Systems}, 
  year={2025},
  volume={},
  number={},
  pages={676-681},
  abstract={This paper presents novel cascade PD-PI-PID controllers in Automatic Voltage Regulator (AVR) systems using Whale Optimization Algorithm (WOA). The stability and dynamic performance of AVRs are critical for reliable operation in power generation, yet conventional PID tuning techniques often yield suboptimal transient response and poor robustness under parameter uncertainties. In this study, a two-phase metaheuristic approach is employed: first, Particle Swarm Optimization (PSO) is used to evaluate and select the optimal cascade controller structure; then, several modern algorithms including WOA are utilized to finely tune the selected controller's parameters. The effectiveness of WOA is assessed using the Integral of Time-weighted Absolute Error (ITAE) as the objective function. Comparative simulations demonstrate that WOA-tuned PD-PI-PID controllers achieve superior performance, with significantly reduced ITAE, minimal overshoot, and faster settling time compared to controllers tuned with other optimization methods. Moreover, extensive robustness analysis under $\pm 25\%$ and $\pm 50\%$ variations in critical AVR parameters validates the controller's resilience to system uncertainties. The results confirm that integrating cascade controller design with advanced metaheuristic optimization, specifically WOA, offers a practical and highly effective solution for enhancing voltage regulation and dynamic stability in power systems.},
  keywords={Radio broadcasting;Frequency modulation;Protocols;HTTP;Modulation;Radio broadcasting;Radio access networks;Regional area networks;Routing;Communication systems;automatic voltage regulator;cascade controller;whale optimization algorithm;transient response;robustness},
  doi={10.1109/ICCIT68739.2025.11490248},
  ISSN={2474-9656},
  month={Dec},}@INPROCEEDINGS{11066008,
  author={Cao, Xuanyu and Zhang, Jiaxing and Zheng, Peifeng and Bu, Shuai and Cheng, Keshu},
  booktitle={2025 5th International Symposium on Computer Technology and Information Science (ISCTIS)}, 
  title={Global Cybersecurity Situation Assessment Combining K-means Clustering and Cybersecurity Index}, 
  year={2025},
  volume={},
  number={},
  pages={614-617},
  abstract={Against the backdrop of the increasing complexity of global cybersecurity threats, this paper proposes an evaluation method that combines the dynamic weighted K-means clustering algorithm with the cybersecurity index. The algorithm dynamically adjusts the cluster center and number through an adaptive learning mechanism, and assigns dynamic weights based on the importance of cybersecurity indicators. The experiment collects cybersecurity data from 30 countries and regions around the world, covering 12 dimensions, including attack frequency, vulnerability repair rate, etc., and constructs a data set with a sample size of $\mathbf{5, 0 0 0}$. The accuracy, recall, $\mathbf{F 1}$ value, and clustering stability standard deviation are used as evaluation indicators to compare the proposed algorithm with the traditional K-means clustering algorithm and DBSCAN algorithm. The results show that the accuracy of the proposed algorithm is $\mathbf{9 2. 3 \%}$, an increase of 18.6% over the traditional K-means algorithm; the recall rate is 89.7%, an increase of 15.2%; the $F 1$ value reaches 91.0%, an increase of 16.8%; the clustering stability standard deviation is reduced to 0.12, a decrease of 42.9% over the traditional algorithm. The constructed assessment model can accurately divide high-risk, medium-risk and low-risk network security areas, providing a scientific and quantitative basis for the formulation of global network security strategies.},
  keywords={Adaptive learning;Accuracy;Sensitivity;Heuristic algorithms;Stability criteria;Clustering algorithms;Network security;Indexes;Computer security;Standards;Dynamic weight K-means clustering;network security index;global network security situation assessment;adaptive learning;assessment model},
  doi={10.1109/ISCTIS65944.2025.11066008},
  ISSN={},
  month={May},}@INPROCEEDINGS{11035720,
  author={He, Haichang and Zhou, Zhehong and Li, Yanchao},
  booktitle={2025 4th International Conference on Distributed Computing and Electrical Circuits and Electronics (ICDCECE)}, 
  title={A Security Warning Method for Inter Group Information in Cyberspace based on Grover Algorithm}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The improvement of information security is one of the necessary requirements to achieve sustainable development and has become the focus of attention. Based on the Grover algorithm, this paper will evaluate the efficiency of cybersecurity early warning in the information industry. In the research process, this paper first collects and preprocesses the information between groups, and then carries out a comprehensive implementation and upgrade optimization of the Grover algorithm. Finally, based on the Grover algorithm, the information security early warning efficiency score of the information industry is calculated. The final inter-group information showed that the information industry had the highest comprehensive efficiency score, with a score of 0.902. The conclusion shows that the information industry has outstanding performance in cyberspace efficiency and vulnerability repair. This results show that the upgraded and optimized Grover algorithm can play an important role in the early warning of information security between groups in cyberspace.},
  keywords={Information industry;Cyberspace;Information security;Maintenance engineering;Permission;Recording;Reliability;Sustainable development;Protection;Optimization;grover algorithm;cyberspace;inter-group information security;early warning},
  doi={10.1109/ICDCECE65353.2025.11035720},
  ISSN={},
  month={April},}@INPROCEEDINGS{11396517,
  author={Amoah, Alfred and Liu, Yan},
  booktitle={2025 32nd Asia-Pacific Software Engineering Conference (APSEC)}, 
  title={XRepair - Unifying Retrieval, Repair, and Evaluation for Explainable LLM-Based Vulnerability Fixes}, 
  year={2025},
  volume={},
  number={},
  pages={1001-1004},
  abstract={This paper presents XRepair, a web-based tool for automated and explainable software vulnerability repair. XRepair integrates retrieval, generation, and evaluation into a single interactive framework. It augments large language models (LLMs) with knowledge retrieved from CWE/CVE datasets through both embedding-based and graph-based strategies. XRepair enables repairs that are contextualized with vulnerability metadata and related examples. The tool provides end-to-end functionalities, including users inputting a CWE/CVE identifier and vulnerable code snippet, configuring the retrieval strategy and LLM, and receiving repair recommendations. Unlike patch-only systems, the recommendations consist of an issue description, explicit repair guidance, and concrete code diffs. To assess repair quality, XRepair incorporates an LLM-as-a-Judge evaluation framework that scores outputs across five criteria, namely relevance, completeness, correctness, identification of vulnerable code, and guidance. This design supports reproducible comparison of retrieval strategies and produces transparent recommendations. Built using both the strategy and factory design patterns, XRepair allows new retrieval algorithms and data sources to be added. The tool and documentation are publicly available with a tool for comparative evaluation and practical application of explainable vulnerability repairs. The demo for XRepair can be accessed at https://youtu.be/5IcGzNJXAY.},
  keywords={Codes;Foundation models;Soft sensors;Large language models;Documentation;Maintenance engineering;Metadata;Production facilities;Software engineering;Software code vulnerability;retrieval strategy;foundation model},
  doi={10.1109/APSEC66846.2025.00116},
  ISSN={2640-0715},
  month={Dec},}@INPROCEEDINGS{10888760,
  author={Sun, Jingkai and Zhang, Qiang and Wang, Jiaxu and Cao, Jiahang and Cheng, Hao and Xu, Renjing},
  booktitle={ICASSP 2025 - 2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Event Masked Autoencoder: Point-wise Action Recognition with Event-Based Cameras}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Dynamic vision sensors (DVS) are bio-inspired devices that capture visual information in the form of asynchronous events, which encode changes in pixel intensity with high temporal resolution and low latency. These events provide rich motion cues that can be exploited for various computer vision tasks, such as action recognition. However, most existing DVS-based action recognition methods lose temporal information during data transformation or suffer from noise and outliers caused by sensor imperfections or environmental factors. To address these challenges, we propose a novel framework that preserves and exploits the spatiotemporal structure of event data for action recognition. Our framework consists of two main components: 1) a point-wise event masked autoencoder (MAE) that learns a compact and discriminative representation of event patches by reconstructing them from masked raw event camera points data; 2) an improved event points patch generation algorithm that leverages an event data inlier model and point-wise data augmentation techniques to enhance the quality and diversity of event points patches. To the best of our knowledge, our approach introduces the pre-train method into event camera raw points data for the first time, and we propose a novel event points patch embedding to utilize transformer-based models on event cameras.},
  keywords={Visualization;Autoencoders;Speech recognition;Vision sensors;Cameras;Transformers;Data models;Spatiotemporal phenomena;Voltage control;Speech processing},
  doi={10.1109/ICASSP49660.2025.10888760},
  ISSN={2379-190X},
  month={April},}@INPROCEEDINGS{10635802,
  author={Kundu, Soumya Snigdha and Mo, Yuanhan and Srikijkasemwat, Nicharee and Papież, Bartłomiej W.},
  booktitle={2024 IEEE International Symposium on Biomedical Imaging (ISBI)}, 
  title={Spinal Osteophyte Detection Via Robust Patch Extraction on Minimally Annotated X-Rays}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The development and progression of arthritis is strongly associated with osteophytes, which are small and elusive bone growths. This paper presents one of the first efforts towards automated spinal osteophyte detection in spinal X-rays. A novel automated patch extraction process, called SegPatch, has been proposed based on deep learning-driven vertebrae segmentation and the enlargement of mask contours. A final patch classification accuracy of 84.5% is secured, surpassing a baseline tiling-based patch generation technique by 9.5%. This demonstrates that even with limited annotations, Seg-Patch can deliver superior performance for detection of tiny structures such as osteophytes. The proposed approach has potential to assist clinicians in expediting the process of manually identifying osteophytes in spinal X-ray.},
  keywords={Training;Accuracy;Annotations;Magnetic resonance imaging;X-rays;Bones;Arthritis;Keypoint Identification;Osteophyte Detection;Patch Extraction},
  doi={10.1109/ISBI56570.2024.10635802},
  ISSN={1945-8452},
  month={May},}@INPROCEEDINGS{11514038,
  author={Li, Xiaoxi and Zhao, Yubao},
  booktitle={4th International Conference on Data Analytics, Computing and Artificial Intelligence (ICDACAI 2025)}, 
  title={Design of deep learning model for automatic identification and repair of vulnerabilities in complex software systems}, 
  year={2026},
  volume={2025},
  number={},
  pages={1229-1234},
  abstract={The sequence model ignores the code structure information, which leads to high false alarm rate, Graph Neural Network (GNN) has insufficient semantic modeling of data dependence, and production repair lacks the verification mechanism of security constraints and does not realize the closed loop of detection-repair-verification. Therefore, this paper proposes the framework of Multimodal Graph Attention Network (MGAT) to realize the automatic identification and repair of complex software vulnerabilities. Firstly, the framework extracts abstract syntax tree (AST) and control flow graph (CFG) through static analysis, constructs joint graph structure, and designs attention mechanism to capture syntax details and control dependencies synchronously. Node features are initialized by CodeBERT pre-training model to integrate code semantic apriori. Secondly, the comparative learning mechanism is introduced, and the InfoNCE loss function is used to construct positive and negative sample pairs to enhance the generalization ability of the model to the mutation vulnerability pattern, Finally, based on reinforcement learning (RL), the patch generation is modeled as a sequential decision-making process, and a three-stage reward mechanism is designed to ensure the correctness of the repair and avoid introducing new vulnerabilities. Experiments on Devign data set show that the F1 score of MGAT vulnerability detection reaches 84.6%, which is 5.3 percentage points higher than the optimal baseline CodeBERT. The patch module achieves 85.0% vulnerability elimination rate, and 94.5% generated patches can be verified by compilation. The framework provides an effective solution for automatic security reinforcement of complex software systems through multi-modal feature depth fusion and multi-stage verification mechanism.},
  keywords={},
  doi={10.1049/icp.2026.0394},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11384886,
  author={Xi, Hailong and Ru, Le and Tian, Jiwei and Wang, Wenfei},
  booktitle={2025 7th International Conference on Robotics, Intelligent Control and Artificial Intelligence (RICAI)}, 
  title={MSEC: Multi-Scale Entropy Consistency for Partial Occlusion Robust Adversarial Patches Against UAV Detection}, 
  year={2025},
  volume={},
  number={},
  pages={911-915},
  abstract={Low-altitude unmanned aerial vehicle (UAV) visual perception systems are widely used in fields such as security and inspection. However, their deep learning models are vulnerable to attacks by physical adversarial patches. Due to the special operating environment of UAVs, the adversarial patches deployed on the target surface are prone to local damage caused by occlusions such as stains, reflections, and shadows, resulting in a decline in attack effectiveness. The root cause of this vulnerability lies in the fact that the attack features of adversarial patches generated by traditional methods may be overly concentrated at certain key points, creating a “single point failure” risk. This paper proposes an adversarial patch generation method based on MultiScale Entropy Consistency (MSEC). The core of this method is to use entropy from information theory as a measure of feature dispersion. By constraining the spatial distribution of patch pixels, it enforces the generated patches to maintain high and consistent entropy values at multiple spatial scales. Experimental results show that, under the condition of local interference, the decline in the Attack Success Rate (ASR) of the proposed method is significantly reduced, demonstrating superior attack robustness. This research provides new ideas and practical solutions for deploying reliable adversarial attacks under complex physical conditions.},
  keywords={Printing;Autonomous aerial vehicles;Reliability engineering;Entropy;Robustness;Reflection;Security;Robots;Visual perception;Testing;Unmanned Aerial Vehicle;Visual Perception;Adversarial Attack;Robustness;Multi-Scale Entropy},
  doi={10.1109/RICAI68060.2025.11384886},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10555595,
  author={Silva, André and Saavedra, Nuno and Monperrus, Martin},
  booktitle={2024 IEEE/ACM 21st International Conference on Mining Software Repositories (MSR)}, 
  title={GitBug-Java: A Reproducible Benchmark of Recent Java Bugs}, 
  year={2024},
  volume={},
  number={},
  pages={118-122},
  abstract={Bug-fix benchmarks are essential for evaluating methodologies in automatic program repair (APR) and fault localization (FL). However, existing benchmarks, exemplified by Defects4J, need to evolve to incorporate recent bug-fixes aligned with contemporary development practices. Moreover, reproducibility, a key scientific principle, has been lacking in bug-fix benchmarks. To address these gaps, we present GitBug-Java, a reproducible benchmark of recent Java bugs. GitBug-Java features 199 bugs extracted from the 2023 commit history of 55 notable open-source repositories. The methodology for building GitBug-Java ensures the preservation of bug-fixes in fully-reproducible environments. We publish GitBug-Java at https://github.com/gitbugactions/gitbug-java.},
  keywords={Location awareness;Java;Computer bugs;Benchmark testing;Maintenance engineering;Feature extraction;Software;Software Bugs;Bug Benchmark;Reproducibility;Bug Database;Java Benchmark;Software Testing;Program Analysis},
  doi={},
  ISSN={2574-3864},
  month={April},}@INPROCEEDINGS{10554948,
  author={Saavedra, Nuno and Silva, André and Monperrus, Martin},
  booktitle={2024 IEEE/ACM 46th International Conference on Software Engineering: Companion Proceedings (ICSE-Companion)}, 
  title={GitBug-Actions: Building Reproducible Bug-Fix Benchmarks with GitHub Actions}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Bug-fix benchmarks are fundamental in advancing various sub-fields of software engineering such as automatic program repair (APR) and fault localization (FL). A good benchmark must include recent examples that accurately reflect technologies a nd development practices of today. To be executable in the long term, a benchmark must feature test suites that do not degrade over-time due to, for example, dependencies that are no longer available. Existing benchmarks fail in meeting both criteria. For instance, Defects4J, one of the foremost Java benchmarks, last received an update in 2020. Moreover, full-reproducibility has been neglected by the majority of existing benchmarks. In this paper, we present GitBug-Actions: a novel tool for building bug-fix benchmarks with modern and fully-reproducible bug-fixes. GITBuG-ACTIONS relies on the most popular CI platform, GitHub Actions, to detect bug-fixes and smartly locally execute the CI pipeline in a controlled and reproducible environment. To the best of our knowledge, we are the first torely on G it Hub Actions to collect bug-fixes. To demonstrate our toolchain, we deploy GITBuG-ACTIONS to build a proof-of-concept Go bug-fix benchmark containing executable, fully-reproducible bug-fixes from different repositories. A video demonstrating GITBuG-AcTIONS is available at: https://youtu.be/aBWwa1sJYBs.},
  keywords={Location awareness;Java;Buildings;Pipelines;Benchmark testing;Maintenance engineering;Minimization;Software Bugs;Bug Benchmark;Bug Database;Reproducibility;Software Testing;Program Analysis;GitHub Actions},
