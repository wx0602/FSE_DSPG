abstract = {Digital otoscopes are medical devices used to examine the ear and used by physicians in primary and special care settings. The objective of this study is to provide a comprehensive review of literature of digital otoscope adoption in tele-otology and determine the factors that influenced its adoption. Different literature on digital otoscope adoption in tele-otology were identified using Google Scholar in compliance with the guidelines of PRISMA 2020. Out of 151 journals in the literature bank only 21 journals have qualified. These studies were analysed and 9 major factors for the adoption of digital otoscopes in tele-otology were identified.}
}
@article{THABET2024169,
