abstract = {The study outlined in this paper assesses the implementation of Attribute-Based Encryption as a key encapsulation mechanism, culminating in a proposed end-to-end encryption solution for a cloud-based IoT management system and further simulation of migration to Kyber Post-Quantum Cryptography (PQC) key encapsulation mechanism. Though extensively used for efficiently gathering and sharing video surveillance data, these systems also collect telemetry information, which includes sensitive data. This paper presents a comprehensive study that examines the current understanding, methodologies, and challenges associated with supporting the End-to-End Encryption (E2EE) approach to ensure the confdentiality of telemetry data.}
}
@article{ABAY20241027,
