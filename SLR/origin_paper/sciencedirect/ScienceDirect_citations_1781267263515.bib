abstract = {This research investigates Moroccan consumers' attitudes and readiness to embrace AI-powered Customer Relationship Management (CRM) and assistance systems, within the context of their unique cultural and technological landscape. Utilizing a cross-sectional survey approach with a diverse sample of 4,614 respondents, this study examines factors influencing AI adoption, including cultural dimensions, technological infrastructure, trust, and concerns. The findings inform businesses operating in Morocco, contribute to theoretical knowledge on technology adoption, and offer insights into AI adoption in diverse cultural settings.}
}
@article{BASHIR20251783,
title = {Parkinson’s Disease Detection: A Machine Learning Based Model},
journal = {Procedia Computer Science},
volume = {259},
pages = {1783-1792},
year = {2025},
note = {Sixth International Conference on Futuristic Trends in Networks and Computing Technologies (FTNCT06), held in Uttarakhand, India},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.04.133},
