issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2024.06.266},
url = {https://www.sciencedirect.com/science/article/pii/S1877050924015096},
author = {Solomon Gebru Abay and Filipa Lima and Luc Geurts and José Camara and João Pedrosa and António Cunha},
keywords = {Glaucoma, Portable ophthalmoscope, Retina, Quality Assessment, D-Eye, Circle Hough Transform, YOLO},
abstract = {Low-cost smartphone-compatible portable ophthalmoscopes can capture visuals of the patient’s retina to screen several ophthalmological diseases like glaucoma. The images captured have lower quality and resolution than standard retinography devices but enough for glaucoma screening. Small videos are captured to improve the chance of inspecting the eye properly; however, those videos may not always have enough quality for screening glaucoma, and the patient needs to repeat the inspection later. In this paper, a method for automatic assessment of the quality of videos captured using the D-Eye lens is proposed and evaluated with a personal dataset with 539 videos. Based on two methods developed for retina localization on the images/frames, the Circle Hough Transform method with a precision of 78,12% and the YOLOv7 method with a precision of 99,78%, the quality assessment method automatically decides on the quality of the video by measuring the number of frames of good-quality in each video, according to the chosen threshold.}
}
@article{HASAN2026111673,
title = {Virtual inertia emulation in islanded microgrids using a time-series disturbance observer for frequency stabilization},
journal = {International Journal of Electrical Power & Energy Systems},
volume = {176},
pages = {111673},
year = {2026},
issn = {0142-0615},
doi = {https://doi.org/10.1016/j.ijepes.2026.111673},
url = {https://www.sciencedirect.com/science/article/pii/S0142061526001158},
author = {Md. Mahmudul Hasan and M.S. Rana and Tasnim Sarker Joyeeta and Fariya Tabassum},
keywords = {Disturbance observer, Energy storage, Frequency stabilization, Microgrid, Optimization, Virtual inertia},
abstract = {Virtual inertia emulation (VIE) regulates the power exchange of energy storage devices (ESDs) to suppress the rate of change of frequency (RoCoF) and enhance frequency stability in low-inertia power systems. However, existing VIE strategies predominantly rely on damping augmentation or tuned controllers, which exhibit limited capability in rejecting fast-varying and aggregated disturbances arising from renewable intermittency and load fluctuations. To address this limitation, this paper primarily proposes the integration of a time-series disturbance observer (TSDOB) into the VIE loop of an islanded microgrid. The TSDOB estimates the total power disturbance as a time-series polynomial, enabling real-time disturbance reconstruction and compensation. To facilitate effective cancellation of the estimated disturbance, a PD-based dynamic inversion of the ESD dynamics is employed as a supporting feedforward mechanism. A baseline tilt–integral–derivative (TID) controller, optimally tuned using a hybrid PEO-GA algorithm, is incorporated to ensure nominal frequency regulation, resulting in a two-degree-of-freedom control architecture. Simulation results demonstrate that the proposed TSDOB-aided VIE framework significantly enhances frequency stabilization without increasing ESD energy throughput. Compared with the PEO-GA-TID and H∞ controllers, the proposed scheme reduces the maximum frequency deviation by 93.46% and 99.55%, respectively, and achieves 99.57% and 99.97% reductions in the integral of absolute error (IAE) of frequency deviation under real wind and solar power variations. Furthermore, under high-frequency disturbances up to 10 Hz, the proposed method attains at least a 79.12% reduction in frequency IAE relative to the baseline PEO-GA-TID controller, highlighting the effectiveness of the TSDOB in mitigating both fast- and slow-varying disturbances.}
}
@article{WITKOWSKI20242627,
title = {Enhancing efficiency in recurrent reinforcement learning for automated data-driven investment},
journal = {Procedia Computer Science},
volume = {246},
pages = {2627-2634},
year = {2024},
note = {28th International Conference on Knowledge Based and Intelligent information and Engineering Systems (KES 2024)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2024.09.435},
url = {https://www.sciencedirect.com/science/article/pii/S187705092402475X},
author = {Tomasz Witkowski},
keywords = {Recurrent reinforcement learning, Financial modelling, Sharpe ratio optimization, Efficiency in machine learning, Automated investment strategies, Reinforcement Learning, Deep learning},
abstract = {In this study, we introduce a novel approach for training Recurrent Reinforcement Learning (RRL) agents for automated, data-driven investment tasks. The primary goal of this paper is to provide a Proof of Concept for the approach. Our method has demonstrated the ability to achieve Sharpe Ratio (SR) values comparable to those of classical online RRL while accelerating the training process by a factor of 24.6. This training method is model-agnostic and input-agnostic, enhancing its flexibility with complex model architectures. However, a significant limitation is the assumption that the agent’s actions influence rewards but do not affect the rest of the environment. This assumption may hinder generalisation to some non-financial tasks. This study advances the field of RRL by improving efficiency and facilitating more complex experimental schemes.}
}
@article{ABDULLAH2025503,
title = {Examining the factors contributing to travel mode choices during the COVID-19 pandemic using explainable machine learning},
journal = {Procedia Computer Science},
volume = {257},
pages = {503-510},
year = {2025},
note = {The 16th International Conference on Ambient Systems, Networks and Technologies Networks (ANT)/ the 8th International Conference on Emerging Data and Industry 4.0 (EDI40)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.03.065},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925008014},
author = {Muhammad Abdullah},
keywords = {mode choice, travel behavior, pandemic, explainable machine learning, artificial intelligence},
abstract = {The COVID-19 pandemic greatly affected individuals’ travel behavior, particularly their mode preferences. Due to the risk of infection, people began avoiding public transport and shifted toward private transport. Existing studies primarily focused on accurately predicting individuals’ mode choices during the pandemic. This study aims to identify the factors contributing to these choices. Ten different machine learning classification models were developed and evaluated, with Random Forest and Support Vector Machines marginally outperforming other classifiers. Explainable machine learning approaches, Gini importance and SHAP analysis, found income and education to be the most significant contributors to mode choices. Individuals with low income were more likely to choose shared transport over solo transport. Similarly, individuals with low education levels are more likely to opt for shared transport. Older individuals exhibited a positive association with shared transport mode choice, while younger individuals tended to prefer solo transport modes. Males were more likely to choose shared transport than females. These findings can assist urban and transport planners in efficiently planning and operating transport systems during pandemics.}
}
@article{MUMTAZ2026606,
title = {IoT-Enabled Machine Learning Framework for Strawberry Yield Prediction with Mobile Decision Support},
journal = {Procedia Computer Science},
volume = {280},
pages = {606-613},
year = {2026},
note = {The 17th International Conference on Ambient Systems, Networks and Technologies Networks (ANT)/ the 9th International Conference on Emerging Data and Industry 4.0 (EDI40)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2026.04.077},
url = {https://www.sciencedirect.com/science/article/pii/S1877050926010902},
author = {Asia Mumtaz and Ahmad Shukri {Mohd Noor} and Muhammad Rabbah Khan and Ammara Bano and Ahmad Muhaimin and Muhammad Shamel Mohamad and Che Akmal {Che Yahya}},
keywords = {Smart Agriculture, IoT-Based Soil Monitoring, Strawberry Yield Prediction, Machine Learning, Random Forest, Soil pH, Moisture, EC Sensors, Arduino-Nano Microcontroller, Real-Time Data Acquisition},
abstract = {Smart agriculture increasingly relies on real-time monitoring and data-driven decision support to improve crop productivity. Strawberry cultivation, in particular, is sensitive to soil and environmental variations that must be monitored accurately. Traditional soil testing methods are slow, costly, and infrequent, limiting farmers’ ability to respond effectively to changing field conditions. Existing IoT-based solutions often lack integrated prediction capabilities or realtime decision support. This study presents an integrated IoT and machine learning framework for real-time soil monitoring and strawberry yield prediction. To ensure real-time data transmission and accessibility we employ 4502C pH, SKU-SN-0070 moisture, and RS-485 Ec sensors, with Arduino-nano microcontroller which serves as a hub for monitoring the various soil characteristics efficiently and relaying this information to the mobile application. A network of low-cost sensors measures pH, moisture, and electrical conductivity, while a mobile application provides instant access to field data and alerts. Soil data collected from strawberry fields in Jhelum were used to train and evaluate multiple machine learning algorithms for yield classification and analysis. The Random Forest model achieved the highest classification accuracy of 99.95%, outperforming Sequential Minimal Optimization (SMO), Naïve Bayes, and Bagging. The availability of multiple algorithms and the possibility of working with larger datasets in the future provide a means of creating significant comparisons. Targeting various fruit varieties would also be beneficial.}
}
@article{GUO2025112563,
