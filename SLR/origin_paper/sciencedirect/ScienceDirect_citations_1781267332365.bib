note = {The 10th International Conference on Computer Science and Computational Intelligence 2025},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.08.280},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925026250},
author = {David Habsara Hareva and James Adhitthana and I Made Murwantara and Kusno Prasetya and  Hery},
keywords = {Indoor Air Quality, Internet of Things, Sensors, Air Quality Index, Progressive Web Application},
abstract = {Imagine a family relaxing at home, unaware that invisible carbon monoxide is silently accumulating from a faulty heater. Indoor air pollution, often two to five times worse than outdoor air, claims 3.8 million lives annually due to respiratory and cardiovascular diseases. Yet, many lack the tools to detect these hidden threats. This study introduces the Indoor Air Quality System (IAQS), an Internet of Things (IoT)-based solution that empowers users to monitor and visualize air quality in real time. Combining Arduino microcontrollers, environmental sensors, and a user-friendly Progressive Web Application (PWA) built with JavaScript, HTML, and CSS, the IAQS adopts the U.S. Air Quality Index (AQI) and proposes a novel indoor scoring system to address the lack of global indoor standards. Rigorous testing, including 37-unit tests, 57 integration tests, and usability evaluations with five participants, achieved 100% accuracy in AQI, air quality score, and Humidex calculations, and 95% in truncated mean computations. Deployed in a polluted industrial area and a clean residential suburb, the IAQS maintained a data transfer error rate below 10%, demonstrating reliability. By translating complex data into actionable insights, the IAQS offers a scalable, affordable tool to safeguard indoor environments.}
}
@article{FERNANDES20241393,
title = {Which project management knowledge areas do SME’s managers value the most? - The case of Lourinhã municipality},
journal = {Procedia Computer Science},
volume = {239},
pages = {1393-1400},
year = {2024},
note = {CENTERIS – International Conference on ENTERprise Information Systems / ProjMAN - International Conference on Project MANagement / HCist - International Conference on Health and Social Care Information Systems and Technologies 2023},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2024.06.311},
url = {https://www.sciencedirect.com/science/article/pii/S1877050924015540},
author = {Jorge Fernandes and Vanda Lima},
keywords = {SMEs, Project management, Project manager, SME manager, Knowledge areas},
abstract = {SMEs play a significant role in economic activity through employment, innovation, and growth, undertaking projects as an engine to survive. However, project management standards are considered bureaucratical for those environments of scarce resources where the manager usually act as project manager. Therefore, due to unfamiliarity or resource constraints, managers may perform the processes they are most familiar with or that are easier to perform instead of those with a higher impact on project success. Hence, this study aims to understand the degree of knowledge, importance, and extent of use of each knowledge area to the SMEs managers in Lourinhã municipality in order to provide training guidelines to foster the development of the region’s SMEs. Quantitative research was undertaken with a survey for the empirical research. Results show a nescience regarding Project Management; that areas with a strong link to costs are prioritized; and that SMEs managers learn and understand the importance of project management practices mainly by applying them. Introductory level workshops and the creation of entity to support managers on project management practice were proposed.}
}
@article{COSTA20242243,
title = {Artificial Intelligence in primary care: Intelligent risk predicting platform for non-communicable chronic diseases},
journal = {Procedia Computer Science},
volume = {239},
pages = {2243-2250},
year = {2024},
note = {CENTERIS – International Conference on ENTERprise Information Systems / ProjMAN - International Conference on Project MANagement / HCist - International Conference on Health and Social Care Information Systems and Technologies 2023},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2024.06.415},
url = {https://www.sciencedirect.com/science/article/pii/S1877050924016594},
author = {Oberdan Costa and Luis Borges Gouveia},
keywords = {Chronic diseases, Machine learning, Artificial Intelligence;. Health, Multi-label classification},
abstract = {Chronic Non-Communicable Diseases with multifactorial and non-infectious characteristics in their origin have been a matter of growing concern for society and governments, as they put people at greater risk of complications, disability, and death. They are the leading cause of death worldwide, i.e. a global threat to health. Modern medicine relies heavily on a variety of biochemical, behavioral, clinical, etc. data to advance the chronic diseases field. Machine learning techniques have a wide range of applications, for example for diabetes classifications, phenotypic resistance of whole genomic sequences and heart disease. These approaches, in general, concentrate efforts on a single Chronic Non-Communicable Diseases. Thus, identifying multiple chronic diseases simultaneously is an open challeng. Our study demonstrated that the intelligent risk prediction platform for non-communicable chronic diseases using Multi-Label Classification methods can be used to model multiple Chronic Non-Communicable Diseases. We use ensemble methods developed on top of algorithm adaptation techniques, including Random Forest, Extra Trees and Decision Tree Classifiers. Among the models in the experiment, the Random Forest achieved the best accuracy and F1-score performance with 96.16% and 90.48%, respectively. Our results suggest that the platform is promising and can be used to support medical teams in the early diagnosis of Chronic Non-Communicable Diseases, allowing them to provide adequate treatment options to patients in a timely manner in primary care, as well as contributing to reducing the risk of complications, disability, and deaths by Chronic Non-Communicable Diseases.}
}
@article{A2026100614,
title = {Supervised Attention Multi-Scale Temporal Convolutional Network for Profit Prediction Utilizing a Financial Accounting Information System},
journal = {Big Data Research},
pages = {100614},
year = {2026},
issn = {2214-5796},
doi = {https://doi.org/10.1016/j.bdr.2026.100614},
url = {https://www.sciencedirect.com/science/article/pii/S2214579626000262},
author = {Sathiyaraj A and Geetha C and Ramkumar Devendiran and Sudhakar Reddy N},
keywords = {Profit Prediction, Financial Accounting Systems, Deep Learning, Temporal Convolutional Networks, Bio-Inspired Optimization, Feature Selection},
abstract = {Financial profit prediction within Financial Accounting Information Systems (FAIS) requires models that not only deliver accurate forecasts but also provide interpretable rationales suitable for decision-making. A supervised-attention multiscale temporal convolutional Network (SA-MSTCN) framework is proposed that integrates targeted preprocessing, heuristic feature selection and a nature-inspired optimizer to enhance predictive performance on a large Chinese stock-market dataset sourced from Kaggle. Missing values were addressed through confidence partitioning and salient features were selected via a localized sampling heuristic prior to model training. The model weights were refined using a population-based search strategy. Empirical evaluation against three state-of-the-art baselines demonstrates substantial improvements with 20.36%, 28.42% and 15.27% higher accuracy; 29.36%, 18.42% and 30.17% higher coefficient of determination; and 22.36%, 35.42% and 28.17% lower mean absolute percentage error compared with existing methods respectively. The approach is particularly suited to batch forecasting tasks such as quarterly and annual profit projections with implications for interpretability, deployment within FAIS workflows and possibilities for further validation and reproducibility are discussed.}
}
@article{BHARAT2024100307,
title = {Secure and efficient prediction of electric vehicle charging demand using α2-LSTM and AES-128 cryptography},
journal = {Energy and AI},
volume = {16},
pages = {100307},
year = {2024},
issn = {2666-5468},
doi = {https://doi.org/10.1016/j.egyai.2023.100307},
url = {https://www.sciencedirect.com/science/article/pii/S2666546823000794},
author = {Manish Bharat and Ritesh Dash and K. Jyotheeswara Reddy and A.S.R. Murty and Dhanamjayulu C. and S.M. Muyeen},
keywords = {Charging demand forecasting, Deep neural network, Electric vehicles, LSTM, Peak demand management},
abstract = {In recent years, there has been a significant surge in demand for electric vehicles (EVs), necessitating accurate prediction of EV charging requirements. This prediction plays a crucial role in evaluating its impact on the power grid, encompassing power management and peak demand management. In this paper, a novel deep neural network based on α2 -LSTM is proposed to predict the demand for charging from electric vehicles at a 15-minute time resolution. Additionally, we employ AES-128 for station quantization and secure communication with users. Our proposed algorithm achieves a 9.2% reduction in both the Root Mean Square Error (RMSE) and the mean absolute error compared to LSTM, along with a 13.01% increase in demand accuracy. We present a 12-month prediction of EV charging demand at charging stations, accompanied by an effective comparative analysis of Mean Absolute Percentage Error (MAPE) and Mean Percentage Error (MPE) over the last five years using our proposed model. The prediction analysis has been conducted using Python programming.}
}
@article{YOU2024102260,
title = {DeepScraper: A complete and efficient tweet scraping method using authenticated multiprocessing},
journal = {Data & Knowledge Engineering},
volume = {149},
pages = {102260},
year = {2024},
issn = {0169-023X},
doi = {https://doi.org/10.1016/j.datak.2023.102260},
url = {https://www.sciencedirect.com/science/article/pii/S0169023X23001209},
author = {Jaebeom You and Kisung Lee and Hyuk-Yoon Kwon},
keywords = {Crawling, Tweets, Multiprocessing, Authentication},
abstract = {In this paper, we propose a scraping method for collecting tweets, which we call DeepScraper. DeepScraper provides the complete scraping for the entire tweets written by a certain group of users or them containing search keywords with a fast speed. To improve the crawling speed of DeepScraper, we devise a multiprocessing architecture while providing authentication to the multiple processes based on the simulation of the user access behavior to Twitter. This allows us to maximize the parallelism of crawling even in a single machine. Through extensive experiments, we show that DeepScraper can crawl the entire tweets of 99 users, which amounts to 5,798,052 tweets while Twitter standard API can crawl only 243,650 tweets of them due to the constraints of the number of tweets to scrape. In other words, DeepScraper could collect 23.7 times more tweets for the 99 users than the standard API. We also show the efficiency of DeepScraper. First, we show the effect of the authenticated multiprocessing by showing that it increases the crawling speed from 2.03∼10.57 times as the number of running processes increases from 2 to 32 compared to DeepScraper with a single process. Then, we compare the crawling speed of DeepScraper with the existing studies. The result shows that DeepScraper is compared to even Twitter standard APIs and Twitter4J while DeepScraper can scrape much more tweets than them. Furthermore, DeepScraper is much faster than Twitter Scrapy roughly 3.69 times while both can scrape the entire tweets for the target users or keywords.}
}
@article{V2024107977,
title = {A novel attention-based cross-modal transfer learning framework for predicting cardiovascular disease},
journal = {Computers in Biology and Medicine},
volume = {170},
pages = {107977},
year = {2024},
issn = {0010-4825},
doi = {https://doi.org/10.1016/j.compbiomed.2024.107977},
url = {https://www.sciencedirect.com/science/article/pii/S0010482524000611},
author = {Jothi Prakash V. and Arul Antran Vijay S. and Ganesh Kumar P. and Karthikeyan N.K.},
keywords = {Cross-modal transfer learning, Cardiovascular disease prediction, Attention mechanisms, Multimodal feature fusion, Transformer based models},
abstract = {Cardiovascular disease (CVD) remains a leading cause of death globally, presenting significant challenges in early detection and treatment. The complexity of CVD arises from its multifaceted nature, influenced by a combination of genetic, environmental, and lifestyle factors. Traditional diagnostic approaches often struggle to effectively integrate and interpret the heterogeneous data associated with CVD. Addressing this challenge, we introduce a novel Attention-Based Cross-Modal (ABCM) transfer learning framework. This framework innovatively merges diverse data types, including clinical records, medical imagery, and genetic information, through an attention-driven mechanism. This mechanism adeptly identifies and focuses on the most pertinent attributes from each data source, thereby enhancing the model’s ability to discern intricate interrelationships among various data types. Our extensive testing and validation demonstrate that the ABCM framework significantly surpasses traditional single-source models and other advanced multi-source methods in predicting CVD. Specifically, our approach achieves an accuracy of 93.5%, precision of 92.0%, recall of 94.5%, and an impressive area under the curve (AUC) of 97.2%. These results not only underscore the superior predictive capability of our model but also highlight its potential in offering more accurate and early detection of CVD. The integration of cross-modal data through attention-based mechanisms provides a deeper understanding of the disease, paving the way for more informed clinical decision-making and personalized patient care.}
}
@article{BELLENGER2024183,
title = {The emotional metaverse: exploring the benefits of predicting emotion from 3D avatars},
journal = {Procedia Computer Science},
volume = {232},
pages = {183-190},
year = {2024},
note = {5th International Conference on Industry 4.0 and Smart Manufacturing (ISM 2023)},
