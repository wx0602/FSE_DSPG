keywords = {Digital Transformation, Artificial Intelligence, Enterprise Architecture, Digital Innovation},
abstract = {Sustainable innovation is one of most crucial and important elements for digital transformation in the alignment with artificial intelligence (AI) strategies these days. In this paper, the pathways of digital transformation with several case studies are explained and analyzed. On the basis of case studies with digital transformation and innovation, the AIDAF for promoting sustainable innovation is evaluated with efficient pathways of digital transformation and proposed for the near future.}
}
@article{HAREVA2025278,
title = {A Cloud-Based System for Visualizing Indoor Air Quality using AQI Guidelines},
journal = {Procedia Computer Science},
volume = {269},
