@article{BERNSTEINER20251147,
title = {Design principles of real time students’ performance monitoring in simulation-based business education},
journal = {Procedia Computer Science},
volume = {266},
pages = {1147-1154},
year = {2025},
note = {The 12th International Conference on Information Technology and Quantitative Management (ITQM 2025)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.08.142},
url = {https://www.sciencedirect.com/science/article/pii/S187705092502455X},
author = {Reinhard Bernsteiner and Christian Ploder and Yalin Su and Juanqiong Gou and Xiaodan Yu},
keywords = {Simulation-based business education, Real-time performance monitoring, Design principles},
abstract = {Online simulation games have transformed business education by offering experiential learning opportunities. However, they face challenges like suboptimal student engagement and unclear learning pathways. This study aims to address these issues by proposing design principles for real - time student performance monitoring systems (S - PMS) in simulation - based business education. We first discuss the current state of simulation - based business education, highlighting its benefits and limitations. Then, we explore three methods of implementing real - time performance monitoring: formative assessment via sequential level progression, click - stream analysis for behavioral tracking, and epistemic network analysis for knowledge integration. Based on this, we present four design principles. The Multi - Layered Data Capture for Knowledge Dimension Mapping principle focuses on tracking interactions across different knowledge dimensions. The Dynamic Cognitive Process Profiling principle differentiates hierarchical cognitive processes. The Adaptive Feedback Engine for Personalized Learning Pathways principle provides tailored support according to students’ individual needs. The Contextualized Visualization for Epistemic Transparency principle makes complex learning interactions interpretable. These principles are grounded in the integration of knowledge dimensions and cognitive processes, aiming to enhance the effectiveness of monitoring systems. Overall, this study offers a framework for developing S - PMS, but further research is needed to validate these principles in diverse scenarios and explore the integration of emerging technologies.}
}
@article{BERHILI202499,
title = {Intrusion Detection Systems in IoT Based on Machine Learning: A state of the art},
journal = {Procedia Computer Science},
volume = {251},
pages = {99-107},
year = {2024},
note = {15th International Conference on Emerging Ubiquitous Systems and Pervasive Networks / 14th International Conference on Current and Future Trends of Information and Communication Technologies in Healthcare EUSPN/ICTH 2024},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2024.11.089},
url = {https://www.sciencedirect.com/science/article/pii/S1877050924033234},
author = {Mohammed BERHILI and Omar CHAIEB and Mohammed BENABDELLAH},
keywords = {Intrusion Detection System, Anomaly Detection, Machine Learning, Deep Learning, Feature Selection, Internet of Things},
abstract = {Nowadays, connected devices are progressively integrating our lifestyle, known as the Internet of Things (IoT). There are several domains where these IoT can be found, including industry, smart cities, energy, healthcare, smart homes, and so on. These devices bring with them a host of security threats, due to their many weaknesses such as limited resources and the fact that it is often out of date. This is why researchers have progressively turned to innovative techniques to face these threats, such as Intrusion Detection Systems (IDS). In addition, IDS can be enhanced through machine learning (ML), which improves detection accuracy, adapts to new and evolving threats, identifies unknown threats, reduces false positives, and more. In this study, we conduct a review of the recent articles focusing on the integration of IDS and ML. Each method is evaluated based on attributes such as feature selection method, algorithms used, detection and false positive rates, security threats, and so on. This involves presenting a critical analysis of each approach. Furthermore, we present the most prevalent datasets containing deliberate attacks on test IoT networks. In addition, we cover the anomaly detection-based IDS method in depth, focusing on papers that use ML. Subsequently, we engage in a discussion by comparing all methods and identifying open re-search questions. As a result, summarized tables are provided to highlight each model.}
}
@article{SINGH202563,
title = {Reliability of IoT Systems for Fire Detection},
journal = {Procedia Computer Science},
volume = {256},
pages = {63-70},
year = {2025},
note = {CENTERIS - International Conference on ENTERprise Information Systems / ProjMAN - International Conference on Project MANagement / HCist - International Conference on Health and Social Care Information Systems and Technologies},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.02.096},
url = {https://www.sciencedirect.com/science/article/pii/S1877050925004533},
author = {Khushwant Singh and Mohit Yadav and Dheerdhwaj Barak and Fernando Moreira},
keywords = {Smart homes, fire, Multi-sensor, Wireless sensor networks, Reliability of IoT system},
abstract = {In this paper, a smart IoT system including the software and hardware aspects of its design, as well as its operation in the context of a city or a building, along with its advantages, disadvantages, and potential applications, all with a focus on fire safety have been analyzed. Based on the results of the aforementioned research, it is clear that an IoT-based fire system may be tailored to the specific requirements of each individual situation. The major focus of the study is on the planning and evaluation of a WSN that can detect house fires in their earliest stages. The authors address the crucial issue of giving rapid-fire alerts by including a broad range of sensors in the wireless sensor network. In order to provide precise, real-time fire detection, the wireless sensor network (WSN) is constructed from tiny, low-power sensor devices that have sensors able to sense their surroundings. Using the Global System for Mobile Communications (GSM) to reduce the number of false alarms is one strategy the authors propose for coping with sensor malfunctions. The reliability of IoT (Internet of Things) systems for fire detection has been a topic of interest and continuous improvement. IoT-based fire detection systems have the potential to offer numerous benefits, such as real-time monitoring, remote management, and data-driven insights. However, their reliability depends on several factors, including technology, implementation, and maintenance. This research aids in the enhancement of residential community safety by improving the early detection and prevention of house fires.}
}
@article{KANSAL202470,
title = {ResNet-50 vs. EfficientNet-B0: Multi-Centric Classification of Various Lung Abnormalities Using Deep Learning},
journal = {Procedia Computer Science},
volume = {235},
pages = {70-80},
year = {2024},
note = {International Conference on Machine Learning and Data Engineering (ICMLDE 2023)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2024.04.007},
url = {https://www.sciencedirect.com/science/article/pii/S1877050924006768},
author = {Kajal Kansal and Tej Bahadur Chandra and Akansha Singh},
keywords = {Lung Diseases, Classification, Deep Learning, ResNet-50, Efficient-B0},
abstract = {Lung abnormalities are among the significant contributors to morbidity and mortality worldwide. It induces symptoms like coughing, sneezing, fever, breathlessness, etc., which, if left untreated, may lead to death. In current clinical practice, chest X-ray (CXR) images are widely preferred to diagnose different lung abnormalities. However, the pathological tests are time-consuming, expensive and require domain experts. On the other hand, diagnosis through CXR images is manual and subject to inter-observer and intra-observer variability. The recent advancement in deep learning (DL) algorithms may be employed to address these challenges. However, the selection of correct algorithms along with finetuned parameters is challenging. In this study, we comprehensively compared the performance of two state-of-the-art DL algorithms, Resnet-50 and Efficient-B0. These two models are pervasively used in literature and have shown promising classification performance. The performance of the used algorithms is validated using the multi-centric dataset from Kaggle (having Covid-19, Normal, Pneumonia classes) and Mendeley chest X-ray dataset (having Normal, Pneumonia-Bacterial, Pneumonia-Viral, Covid-19 classes). Upon training the algorithms with a mini-batch size 32 and a maximum epoch of 40 using training data, we achieved 0.9807 and 0.9874 accuracy for Kaggle Dataset and Mendeley Dataset, respectively. Similarly, we achieved 0.9962 and 9.9978 for Kaggle dataset and Mendeley dataset for test data, respectively. From the result, it is evident that the EfficientNet-B0 model outperformed the multi-centric datasets.}
}
@article{ANNE202472,
