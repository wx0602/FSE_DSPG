@inproceedings{10.1145/3664647.3680791,
author = {Xu, Wanru and Miao, Zhenjiang and Tian, Yi and Cen, Yigang and Wan, Lili and Xiaole, Ma},
title = {Probabilistic Distillation Transformer: Modelling Uncertainties for Visual Abductive Reasoning},
year = {2024},
isbn = {9798400706868},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3664647.3680791},
doi = {10.1145/3664647.3680791},
abstract = {Visual abduction reasoning aims to find the most plausible explanation for incomplete observations, and suffers from inherent uncertainties and ambiguities, which mainly stem from the latent causal relations, incomplete observations, and the reasoning itself. To address this, we propose a probabilistic model named Uncertainty-Guided Probabilistic Distillation Transformer (UPD-Trans) to model uncertainties for Visual Abductive Reasoning. In order to better discover the correct cause-effect chain, we model all the potential causal relations into a unified reasoning framework, thus both the direct relations and latent relations are considered. In order to reduce the effect of the stochasticity and uncertainty for reasoning: 1) we extend the deterministic Transformer to a probabilistic Transformer by considering those uncertain factors as Gaussian random variables and explicitly modeling their distribution; 2) we introduce a distillation mechanism between the posterior branch with complete observations and the prior branch with incomplete observations to transfer posterior knowledge. Evaluation results on the benchmark datasets, consistently demonstrate the commendable performance of our UPD-Trans, with significant improvements after latent relation modeling and uncertainty modeling.},
booktitle = {Proceedings of the 32nd ACM International Conference on Multimedia},
pages = {8865–8873},
numpages = {9},
keywords = {distillation mechanism, probabilistic transformer, uncertainty modelling, visual abductive reasoning},
location = {Melbourne VIC, Australia},
series = {MM '24}
}

@inproceedings{10.1145/3626203.3670569,
author = {Kimera, Rodgers and Whalen, Christopher J and Economou, Matthew X.},
title = {HPC Journey in a Resource Constrained Environment: A case of The African Center of Excellence in Bioinformatics and Data Intensive Science, Uganda.},
year = {2024},
isbn = {9798400704192},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3626203.3670569},
doi = {10.1145/3626203.3670569},
abstract = {Bioinformatics and scientific research and analyses requires high computation power. To be able to perform computationally heavy tasks we need to exploit parallel-computing and cluster-computing systems, deploying processors, distributed and shared memory framework, and multiple disks. Another requirement for bioinformatics is storage. Large data sets have been generated and collected over the years from Africa and European genetics in plants, animals, and humans. Such datasets demand high storage space which ordinary desktop computers cannot support. High Performance Computing (HPC) utilizing cluster computing renders analyses on large data sets tractable. However, setting up, configuring, maintaining, and operating HPC infrastructure in Resource Constrained Environments (RCE) is still a challenge. Here we summarize the configurations, opportunities, usage and results, challenges and lessons learnt while deploying an HPC Cluster at the African Center of Excellence in Bioinformatics and Data Intensive Science, Uganda.},
booktitle = {Practice and Experience in Advanced Research Computing 2024: Human Powered Computing},
articleno = {97},
numpages = {3},
keywords = {Bioinformatics, Computer Nodes, Datasets, HPC Infrastructure, Networking, Storage},
location = {Providence, RI, USA},
series = {PEARC '24}
}

@inproceedings{10.1145/3686490.3686526,
author = {Zhang, Lingyin},
title = {Reconstructing ECG from BCG for Non-Contact Cardiac Monitoring Using Bidirectional LSTM},
year = {2024},
isbn = {9798400717192},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3686490.3686526},
doi = {10.1145/3686490.3686526},
abstract = {The ballistocardiogram (BCG) offers an economically efficient and non-intrusive health monitoring approach, while the electrocardiogram (ECG) stands as the gold standard for diagnosing cardiovascular diseases. The combination of these two methods can achieve the objective of long-term, non-contact cardiac monitoring, holding significant importance for the prevention and early diagnosis of cardiovascular diseases. Therefore, a bidirectional long short term memory (BiLSTM) network is proposed to establish an end-to-end mapping model from BCG signals to ECG signals. The proposed model introduces prior knowledge of heartrate into the construction of BCG signal samples to select optimal model parameters, further enhancing ECG reconstruction performance. It effectively addresses challenges in the current task of reconstructing ECG from BCG, such as fusion of data collected by multiple sensors and how to learn time series efficiently. At the same time, a synchronous signal acquisition system including BCG and ECG was constructed in this paper, and the performance of the proposed model was tested and evaluated using open-source datasets and self-collected datasets respectively. The data included signal waveforms of healthy people and people with cardiovascular diseases under various conditions, which fully verified the robustness and generalization performance of the proposed model. In this paper, the t-SNE algorithm was used to visualize the model performance, and the regression accuracy of the model was evaluated by three quantitative indicators: mean absolute error, relative root-mean-square error and Pearson correlation coefficient. The results of the model were 0.179, 0.00185 and 0.896 on the open dataset, and 0.382, 0.00504 and 0.851 on the self-collected dataset, respectively. In comparison to existing methods for reconstructing ECG from BCG, the deep regression approach presented in this paper demonstrates excellent performance on both open-source datasets and self-collected datasets. The model exhibits strong fitting and generalization capabilities, positively impacting the early warning and treatment of cardiovascular diseases.},
booktitle = {Proceedings of the 2024 7th International Conference on Signal Processing and Machine Learning},
pages = {242–251},
numpages = {10},
keywords = {Ballistocardiogram, Bidirectional LSTM, ECG reconstructing, Electrocardiogram, cardiac monitoring, multi-sensor fusion, time-series feature learning},
location = {Qingdao, China},
series = {SPML '24}
}

@article{10.14778/3665844.3665845,
author = {Xiong, Haoran and Zhang, Hang and Wang, Zeyu and He, Zhenying and Wang, Peng and Wang, X. Sean},
title = {CIVET: Exploring Compact Index for Variable-Length Subsequence Matching on Time Series},
year = {2024},
issue_date = {May 2024},
publisher = {VLDB Endowment},
volume = {17},
number = {9},
issn = {2150-8097},
url = {https://doi.org/10.14778/3665844.3665845},
doi = {10.14778/3665844.3665845},
abstract = {Nowadays the demands for managing and analyzing substantially increasing collections of time series are becoming more challenging. Subsequence matching, as a core subroutine in time series analysis, has drawn significant research attention. Most of the previous works only focus on matching the subsequences with equal length to the query. However, many scenarios require support for efficient variable-length subsequence matching. In this paper, we propose a new representation, Uniform Piecewise Aggregate Approximation (UPAA) with the capability of aligning features for variable-length time series while remaining the lower bounding property. Based on UPAA, we present a compact index structure by grouping adjacent subsequences and similar subsequences respectively. Moreover, we propose an index pruning algorithm and a data filtering strategy to efficiently support variable-length subsequence matching without false dismissals. The experiments conducted on both real and synthetic datasets demonstrate that our approach achieves considerably better efficiency, scalability, and effectiveness than existing approaches.},
journal = {Proc. VLDB Endow.},
month = may,
pages = {2123–2135},
numpages = {13}
}

@inproceedings{10.1109/SC41406.2024.00030,
author = {Sol\'{o}rzano, Ana Luisa Veroneze and Sato, Kento and Yamamoto, Keiji and Shoji, Fumiyoshi and Brandt, Jim M. and Schwaller, Benjamin and Walton, Sara Petra and Green, Jennifer and Tiwari, Devesh},
title = {Toward Sustainable HPC: In-Production Deployment of Incentive-Based Power Efficiency Mechanism on the Fugaku Supercomputer},
