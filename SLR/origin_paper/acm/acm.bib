publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3630138.3630465},
doi = {10.1145/3630138.3630465},
abstract = {Recent years, the safety requirements for preventing fuel tank explosion have become increasingly strict. In order to prove that a certain type of civil aircraft meets these relevant requirements, a certain type of civil aircraft company has designed a wing tank with sufficient safety margin for the model aircraft based on the comparison of electromagnetic environment simulation and full-aircraft test. In the whole aircraft test, the lightning current density on the typical fuel tank structure, the current/voltage on the fuel pipeline inside the wing and other system components, and the induced current/voltage from the fixed leading and trailing edges to the wing box are measured by injecting a large current of 1-3KA. It is an important part of the lightning protection design and verification of a certain type of aircraft fuel tank system to obtain the lightning environment data of the aircraft fuel tank system through the test and verify the validity of the simulation data.},
