@inproceedings{10.1145/3604479.3604516,
author = {Fernandes, Filipe A and Castro, Diego C B and Rodrigues, Claudia S C and Werner, Claudia M L},
title = {Evaluating User Experience of a Software Engineering Education Virtual Environment},
year = {2024},
isbn = {9798400700026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3604479.3604516},
doi = {10.1145/3604479.3604516},
abstract = {Immersive Learning is a research topic that has the potential to improve learning outcomes. Through immersive environments, students have access to new ways of viewing and interacting, providing more engagement in learning. Therefore, the objective of this work is to present the development of a Virtual Environment (VE) prototype to support Software Engineering Education. An experimental study was carried out with 4 experts in eXtended Reality and it was found that the environment meets the purpose for which it has been designed and indicates that VE can provide satisfactory levels of VR experiences. In addition to the results, our contribution lies in evaluating the user experience in isolation since it can indicate the reduction of bias when verifying the influence of VE on learning outcomes.},
booktitle = {Proceedings of the 24th Symposium on Virtual and Augmented Reality},
pages = {137–141},
numpages = {5},
keywords = {immersive learning, software engineering education, user experience, virtual environment},
location = {Natal, RN, Brazil},
series = {SVR '22}
}

