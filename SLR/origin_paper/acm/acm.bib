@inproceedings{10.1145/3627673.3680066,
author = {Ban, Girim and Yun, Hyeonseok and Lee, Banseok and Sung, David and Woo, Simon S.},
title = {Deep Journey Hierarchical Attention Networks for Conversion Predictions in Digital Marketing},
year = {2024},
isbn = {9798400704369},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3627673.3680066},
doi = {10.1145/3627673.3680066},
abstract = {In digital marketing, precise audience targeting is crucial for campaign efficiency. However, digital marketing agencies often struggle with incomplete user profiles and interaction details from Advertising Identifier (ADID) data in user behavior modeling. To address this, we introduce the Deep Journey Hierarchical Attention Networks (DJHAN). This novel method enhances conversion predictions by leveraging heterogeneous action sequences associated with ADIDs and encapsulating these interactions into structured journeys. These journeys are hierarchically aggregated to effectively represent ADID's behavioral attributes. Moreover, DJHAN incorporates three specialized attention mechanisms: temporal attention for time-sensitive contexts, action attention for emphasizing key behaviors, and journety attention for highlighting influential journeys in the purchase conversion process. Emprically, DJHAN surpasses state-of-the-art (SOTA) models across three diverse datasets, including real-world data from NasMedia, a leading media representative in Asia. In backtesting simulations with three advertisers, DJHAN outperforms existing baselines, achieving the highest improvements in Conversion Rate (CVR) and Return on Ad Spend (ROAS) across three advertisers, demonstrating its practical potential in digital marketing.},
booktitle = {Proceedings of the 33rd ACM International Conference on Information and Knowledge Management},
pages = {4358–4365},
numpages = {8},
keywords = {advertising, audience targeting, conversion prediction, digital marketing, user behavior modeling},
location = {Boise, ID, USA},
series = {CIKM '24}
}

@inproceedings{10.1145/3605098.3635978,
author = {Kaur, Harpreet and Young, Scott Ryan and Pirvu, Marius and Kent, Kenneth Blair},
title = {Lightweight Compilation of Method Invocation Bytecodes in Java},
year = {2024},
isbn = {9798400702433},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3605098.3635978},
doi = {10.1145/3605098.3635978},
abstract = {Method invocation bytecodes are a fundamental aspect of class methods and object interactions in object-oriented programming languages. However, their traditional interpretation and compilation techniques often introduce significant overhead, impacting the execution efficiency of applications. Template-based Just-In-Time compilation is a lightweight approach in Eclipse OpenJ9 that leverages pre-defined templates to convert frequently executed code fragments into machine code, significantly cutting down startup times. This paper extends the template-based approach to compilation of method invocation bytecodes in Java, aimed at reducing the overhead associated with compiling methods and improving the overall runtime performance. To demonstrate the effectiveness of the proposed approach, a prototype implementation is developed and evaluated against the industry-standard DaCapo benchmark suite. The evaluation reveals promising results, showcasing notable performance gains in terms of reduced memory footprint, faster startup times, and improved overall execution efficiency. This research contributes to the ongoing efforts in enhancing the performance of Java bytecodes' execution and eventually the Java applications. The insights gained from this study are expected to inspire further research in the domain of bytecode compilation, ultimately benefiting the broader language development community.},
booktitle = {Proceedings of the 39th ACM/SIGAPP Symposium on Applied Computing},
pages = {1114–1121},
numpages = {8},
keywords = {bytecodes, compilation, interpretation, optimizing compiler, template-based compiler},
location = {Avila, Spain},
series = {SAC '24}
}

