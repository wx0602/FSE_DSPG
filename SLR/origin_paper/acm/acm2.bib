@inproceedings{10.1145/3784828.3785160,
author = {Yoshida, Kohei and Yamaki, Hayato and Honda, Hiroki and Sato, Kento and Miwa, Shinobu},
title = {Combining System- and User-Level Approaches to Improving Energy Efficiency in GPU-Based Supercomputers},
year = {2026},
isbn = {9798400723285},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3784828.3785160},
doi = {10.1145/3784828.3785160},
abstract = {Energy efficiency has become a critical challenge in modern GPU-based heterogeneous supercomputing systems, where power consumption continues to rise with increasing system scale and computational demand. Traditional research on energy-efficient supercomputing has mainly focused on system-level approaches, such as energy-aware scheduling, power capping, and variation-aware job management. In contrast, user-level optimization, where users improve energy efficiency through job-level decisions such as compiler or runtime configuration, remains underexplored despite its growing importance in production systems. This study investigates the potential of user-level optimization through compiler selection and its combination with system-level scheduling. We first evaluate the impact of GCC versions on the execution time and energy consumption of PolyBench programs. Then, we quantitatively assess a user-level approach that selects the optimal compiler version for each job based on the workload traces collected in TSUBAME3.0. Finally, we combine the above user-level optimization with the system-level scheduler called VAHRM to evaluate their combined effectiveness in a GPU-based heterogeneous environment. Our experimental results show that selecting appropriate GCC versions can reduce energy consumption by up to 29% compared to the latest version. Furthermore, we show that the solo use of compiler selection can achieve an improvement of up to 4.2% (4.0% on average) in system’s energy efficiency without performance degradation. Finally, we show that combining compiler selection with VAHRM yields a total energy reduction of 6.3%, which means that coordinated system- and user-level optimization can achieve greater energy efficiency than either approach alone.},
booktitle = {Proceedings of the Supercomputing Asia and International Conference on High Performance Computing in Asia Pacific Region Workshops},
pages = {22–30},
numpages = {9},
keywords = {energy efficiency, heterogeneous supercomputing, GPU-based systems, compiler optimization, user-level optimization},
location = {
},
series = {SCA/HPCAsiaWS '26}
}

