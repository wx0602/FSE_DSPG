doi = {10.1145/3733054.3733091},
abstract = {This study developed a psychological support guarantee system based on the mental health problems of college students. Through the multi-level system design, including psychological evaluation, early warning and intervention, psychological counseling and counseling, and data management and analysis module, the comprehensive monitoring and intervention of students' psychological status are realized. The system uses advanced algorithms, such as principal component analysis (PCA), convolutional neural network (CNN), long and short-term memory network (LSTM), and Bayesian optimization (Bayesian Optimization), to ensure the accuracy and effectiveness of the evaluation and intervention. The results of performance test and functional test show that the system is excellent in response speed, concurrent processing ability, resource use efficiency and data processing performance, and has efficient, stable and safe operation ability, which provides reliable psychological support for college students. The research shows that this system has an important application value in improving the precision and effectiveness of mental health services.},
booktitle = {Proceedings of the 2025 International Conference on Intelligent Systems, Automation and Control},
pages = {205–209},
numpages = {5},
keywords = {Rosa ink trace test, college students, psychological support guarantee, system development},
location = {
},
series = {ISAC '25}
}

@inproceedings{10.1145/3718751.3718844,
author = {Li, Michael and Ye, Yuli and Jiang, Liwen and Su, Yuwei and Li, Hanyu},
title = {Security Mechanism Based Automotive Software Update Management Strategy},
year = {2025},
isbn = {9798400709753},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3718751.3718844},
doi = {10.1145/3718751.3718844},
abstract = {With the continuous increase of in vehicle software functions, vehicle manufacturers need to constantly update and upgrade their vehicle software systems to meet ever-changing safety and regulatory requirements. The existing management strategies suffer from slow response and weak risk avoidance ability in dealing with complex and ever-changing security risks. Software update have become an important means to improve vehicle performance, fix vulnerabilities, and enhance security. The complexity and functional diversity of in vehicle software have increased, making software upgrade management crucial. This article aims to explore the importance of automotive software upgrade management, analyze existing software upgrade management methods and tools, and reduce the occurrence of automotive accidents. This article compares the effectiveness of the designed upgrade management system through quantitative analysis and experimental methods. The experimental results show that the maximum security value of software upgrade management is 95%, and the minimum also exceeds 80%.},
booktitle = {Proceedings of the 2024 4th International Conference on Big Data, Artificial Intelligence and Risk Management},
pages = {584–589},
numpages = {6},
keywords = {Automotive Software Update Activities, Management Strategies, Security Mechanisms, System Construction},
location = {
},
series = {ICBAR '24}
}

@inproceedings{10.1145/3745238.3745376,
author = {Zheng, Ziyao and Cai, Xiangyun and Wang, Shuyan and Yang, Yuting},
title = {Research and design of IOT device firmware upgrade system based on BLE},
year = {2025},
isbn = {9798400712791},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3745238.3745376},
doi = {10.1145/3745238.3745376},
abstract = {Over-the-air (OTA) firmware updates are a primary means of software iteration and upgrade for IoT devices. By leveraging wireless transmission, OTA updates enable the convenient and scalable upgrade of hundreds or even thousands of devices. However, despite its convenience, OTA updates pose significant security risks during the upgrade process. Additionally, prolonged upgrade sessions can disrupt the normal operation of devices. Furthermore, application-based firmware updates require substantial memory resources, rendering remote upgrades impractical for devices with limited storage capacity. To address these challenges, this paper proposes a secure, efficient, and universal remote firmware upgrade solution.},
booktitle = {Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence},
pages = {880–886},
numpages = {7},
keywords = {Bluetooth Low Energy, Data Compression, Firmware Upgrade, Security Model},
