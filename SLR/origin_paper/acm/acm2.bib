@inproceedings{10.1145/3800000.3800150,
author = {Li, Yan-song and Wang, Sheng-Jin},
title = {Restructuring Effects of AIGC on the Content Industry Value Chain of E-commerce Platforms Based on a Grey Weighted Markov Model},
year = {2026},
isbn = {9798400720703},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3800000.3800150},
doi = {10.1145/3800000.3800150},
abstract = {Based on the practical application demands of Generative AI Content (AIGC) technology within the content industry value chain of e-commerce platforms, this paper employs Porter's value chain theory to construct a Grey Weighted Markov Model (GWMM) for dynamic evolutionary analysis of the three core stages—content production, dissemination, and consumption. Using six months of empirical data from Chinese e-commerce platforms, we compare composite efficiency metrics under “with AIGC” versus “without AIGC” scenarios, thereby revealing the structural restructuring effects driven by AIGC. The findings show that in the production stage, following AIGC implementation, the probability of transitioning from low to medium efficiency reaches 100%, the self-stabilization rate from medium to high efficiency is 75%, and the risk of reverting from high efficiency drops to zero; in the dissemination stage, the self-stabilization rate at medium efficiency increases from 50% to 75%, effectively suppressing cyclical downturns; and in the consumption stage, the performance improvement path is smoother, with predictions indicating a stable transition into high efficiency. The GWMM demonstrates outstanding capability in trend forecasting and state-transition analysis under small-sample, multi-indicator fusion conditions, offering a powerful tool for capturing the nonlinear evolution of content ecosystems. This study not only provides quantitative support for content-strategy optimization and risk management on e-commerce platforms but also offers new methodological insights for value-chain restructuring empowered by AIGC.},
booktitle = {Proceedings of the 2025 6th International Conference on Big Data Economy and Information Management},
pages = {976–983},
numpages = {8},
keywords = {AIGC, Content Ecosystem, E-commerce Platforms, Grey-weighted Markov chain model, Industry Restructuring, Value Chain Theory},
location = {
},
series = {BDEIM '25}
}

@inproceedings{10.1145/3772318.3791048,
author = {Chen, Yuning and Frank, Adam and Pschetz, Larissa},
title = {Chewing It Over: Revealing Tensions And New Directions For More-Than-Human Relational Ethics Through Speculative Design},
year = {2026},
isbn = {9798400722783},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772318.3791048},
doi = {10.1145/3772318.3791048},
abstract = {HCI research increasingly engages with relational notions of ethics, such as care, felt and transcorporeal ethics, as new paradigms for design. Here, we discuss these relational notions in the context of multispecies design, extending it to incorporate Acampora’s concept of Corporal Compassion, which grounds ethics on a shared sense of livingness and vulnerabilities across beings. In order to elicit corporal compassion towards microorganisms, we designed a dining-theatre intervention, which invited participants to ingest and assign moral values to dishes prepared with speculative human-microbial hybrid cells originated from beings exposed to similar levels of bodily distress. Tried with 47 participants in 7 sessions, the work surfaced the idiosyncrasies behind participants’ moral frameworks, and how socialised prescriptive frameworks of ethics sometimes acted as closure towards relational approaches. We discuss how HCI could rethink traditional frameworks of ethics in ways that support relationality, while calling for researchers to make space for moral hesitation.},
booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {1056},
numpages = {17},
keywords = {More-than-Human, Relational Ethics, Felt Ethics, Speculative Design, Transcorporeality, Corporal Compassion, Moral Deliberation, Biodesign, Multispecies Design, Human-Food Interaction},
location = {
},
series = {CHI '26}
}

@inproceedings{10.1145/3766918.3766944,
author = {Huang, Rui and Zhao, Zimo and Chen, Siwen and Wu, Xiaoyu and Zhao, J. Leon},
title = {Wealth-Voyager: Navigating IntelligentWealth Management with a Multi-Agent Framework},
year = {2025},
isbn = {9798400716027},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3766918.3766944},
doi = {10.1145/3766918.3766944},
abstract = {Rising demand for hyper-personalized wealth management is increasingly unmet by traditional advisory models, which suffer from limitations in scalability, cost-efficiency, and objectivity. While recent AI-driven solutions show promise, they often remain fragmented, focusing on isolated tasks and lacking a unified architecture that integrates long-term strategy with dynamic behavioral adaptation. To bridge this gap, we introduce Wealth-Voyager, a multi-agent framework that synergizes strategic asset allocation with adaptive tactical adjustments. Our system’s architecture uniquely combines AlphaForge, a quantitative engine for establishing a long-term strategic portfolio, with DualAdvisor, a novel Belief-Desire-Intention (BDI) grounded role-playing simulation that interactively manages user-specific behavioral biases in response to real-time events. Our proof-of-concept case study, conducted under live market conditions, demonstrated the efficacy of this integrated approach. The system’s adaptive tactical adjustments outperformed a passive baseline, converting a marginal gain into a more substantial return while reducing portfolio volatility. Our work presents a blueprint for a new class of financial co-pilots that integrate quantitative rigor with interactive, cognitively-aware guidance, enhancing both decision quality and user trust.},
booktitle = {Proceedings of the 2025 International Conference on Generative Artificial Intelligence for Business},
pages = {156–165},
numpages = {10},
keywords = {Generative large language models (LLMs), Multi-agent systems, Behavioral finance, Portfolio optimization, Personalized advisory},
location = {
},
series = {GAIB '25}
}

