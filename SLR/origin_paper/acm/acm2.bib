doi = {10.1145/3766918.3766976},
abstract = {This paper proposes a trajectory tracking control scheme for redundant manipulator integrating with learning from demonstration (LfD). A double-dynamic movement primitive (DMP) is introduced to model robot motion, including a baseline DMP for learning to generate the desired trajectory, and a virtual DMP for generating a reference trajectory, which can compensate for the effect caused by task uncertainties by designing the coupling term and time scaling factor in DMP model. Besides, a kinematics feedback controller of adaptive gain for redundant manipulator is designed to track the position and orientation trajectory in Cartesian space. The proposed method applies the double-DMP model to realize the adaptation at both planning level and control level. Without a complex controller design, it improves the tracking performance of the demonstrated trajectory under task uncertainties, which is convenient for a practical environment. The experiments have been carried out on a Kinova robot, the results have confirmed the validity of the proposed method.},
