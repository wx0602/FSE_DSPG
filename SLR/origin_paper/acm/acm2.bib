@inproceedings{10.1145/3800973.3801049,
author = {Chen, Kaifan and Jia, Kun},
title = {CVT-FoMO: A Framework for the Association Between Creator Induction Strategies and Collective FoMO in Cryptocurrency Video Subtitles},
year = {2026},
isbn = {9798400722103},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3800973.3801049},
doi = {10.1145/3800973.3801049},
abstract = {To address the scarcity of fine-grained, dual-source data in cryptocurrency FoMO research, we introduce CVT-FoMO, a bilingual dataset of 16,187 transcript-comment pairs. We further propose an optimized prompting strategy integrating Role-Playing (RP), Few-Shot (FS), and Chain-of-Thought (CoT). Experimentsdemonstrate that this strategy achieves an 85% human win rate, significantly outperforming baselines. Further analysis reveals distinct asset-specific FoMO drivers (e.g., value anxiety for Bitcoin vs. meme-narratives for Dogecoin) and validates an “Induction–Resonance” mechanism, where creator agendas are statistically amplified by audience interactions (k = 0.28). This study provides a robust benchmark for sentiment analysis and platform risk governance.},
