}

@inproceedings{10.1145/3801359.3801385,
author = {Wang, Jin Yong and Wang, Lei and Liu, Shihai and Lin, He},
title = {Deep Learning Control of Steam–Molten Salt Energy Networks},
year = {2026},
isbn = {9798400722158},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801359.3801385},
doi = {10.1145/3801359.3801385},
abstract = {Coal-fired power plants equipped with molten salt thermal energy storage systems can deliver flexible peak-shaving and frequency regulation services. The integrated steam-molten salt energy network features challenging nonlinear and constrained behavior. Conventional PID and linear model predictive control (MPC) cannot fully utilize the flexibility of the network. They can also lead to violations of pressure and temperature constraints during fast ramping. To address this challenge, a novel control framework is introduced. It leverages deep learning for the steam-molten salt energy network. The method formulates the network as a graph. Nodes denote steam headers, heat exchangers, and molten salt tanks, while edges denote mass and heat transfer links. A graph neural network (GNN) with gated recurrent units serves as the surrogate dynamic model. This model is trained using historical operation data and high-fidelity simulations. We embed the learned GNN within an MPC scheme. The scheme continuously optimizes steam extraction rates, valve positions, and molten salt energy flows while adhering to all system constraints. A hierarchical structure uses the GNN-MPC as a supervisory controller and keeps existing local PID loops in the distributed control system. Simulation studies are conducted on a representative coal-fired unit with molten salt thermal energy storage. The proposed controller is compared against baseline PID and linear MPC schemes. Results demonstrate that GNN-MPC reduces steam pressure and power tracking errors. It also lowers fuel consumption, enhances constraint satisfaction, and maintains a practical architecture for industrial use, thereby improving overall operational flexibility.},
booktitle = {Proceedings of the 2026 2nd International Conference on Big Data, Communication Technology and Computer Applications},
pages = {154–159},
numpages = {6},
keywords = {Model predictive control, Graph neural networks, Deep learning control, Molten salt thermal energy storage, Coal-fired power plants, Steam networks, Flexible operation.},
location = {
},
series = {BDCTA '26}
}

@article{10.1145/3799453,
author = {Cao, Yusheng and Hassan, Taha and Patel, Jaitun V. and McCrickard, D. Scott},
title = {Trail Triage: Identifying Collaborative Workflows in Trail Management Assisted by Crowdsourced Reports},
year = {2026},
issue_date = {March 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {10},
number = {1},
url = {https://doi.org/10.1145/3799453},
doi = {10.1145/3799453},
abstract = {Trail management is a complex, distributed endeavor that requires coordination among conservancies, government agencies, and local trail clubs to ensure visitor safety, environmental stewardship, and the protection of historical resources. Despite its importance, there has been limited systematic research on understanding or supporting the collaborative workflows that sustain this work. To help bridge this gap, we conducted interviews with 10 trail managers involved in or familiar with field operations across five major U.S. long-distance trails. A thematic analysis of the transcripts reveals that trail management spans a wide array of responsibilities, including volunteer coordination, resource allocation, hazard sense-making, and on-the-ground fieldwork. We identify institutional inefficiencies that surface during four distinct stages of the temporal collaborative sense-making process as managers interpret and act upon hiker-submitted reports of trail hazards. We conclude by outlining design implications for field reporting and decision-support systems that better align with the realities of volunteer-based, resource-constrained trail organizations, supporting more timely and coordinated action across distributed stakeholders.},
journal = {Proc. ACM Hum.-Comput. Interact.},
month = mar,
articleno = {GROUP018},
numpages = {26},
keywords = {trail management, crowd-sourced reporting, volunteer coordination, temporal sense-making}
}

