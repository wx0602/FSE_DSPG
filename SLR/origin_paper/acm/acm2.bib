@inproceedings{10.1145/3765766.3765774,
author = {Yonezawa, Tomoko and Moriyama, Kuya and Fujii, Ryosuke and Nishiguchi, Yuto},
title = {Acupressure Robot Synchronized with User Respiratory Phase for Mood Enhancement},
year = {2026},
isbn = {9798400721786},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3765766.3765774},
doi = {10.1145/3765766.3765774},
abstract = {This study investigates an acupressure robot system that synchronizes pressing and releasing actions with the user’s respiratory phases to support mood enhancement. Using a custom-built breathing sensor to estimate abdominal breathing, the system performs acupressure at specific timings, such as press start, peak pressure, and release end, aligned with inhalation or exhalation states. Unlike conventional massage systems, the proposed system introduces a form of underconscious human-robot interaction, where tactile stimulation is subtly coordinated with the user’s physiological rhythms. Subjective mood evaluations before and after the intervention under various timing conditions suggested reductions in tension and fatigue, particularly when both pressing and releasing were in the exhalation phase of the user’s breathing. While further validation is needed, these findings suggest the potential of respiratory-phase-based acupressure as a non-pharmacological method to promote psychological well-being through embodied entrainment. These insights may also broaden the potential roles of robots in affective and embodied interaction with humans.},
booktitle = {Proceedings of the 13th International Conference on Human-Agent Interaction},
pages = {87–94},
numpages = {8},
keywords = {Acupressure robot, finger-pressure massage, physical contact, robot, breathing conditions},
location = {
},
series = {HAI '25}
}

@inproceedings{10.1109/SCW63240.2024.00172,
author = {Jolivel, Th\'{e}o and Tessier, Fran\c{c}ois and Monniot, Julien and Pallez, Guillaume},
title = {Mosaic: Detection and Categorization of I/O Patterns in HPC Applications},
year = {2025},
isbn = {9798350355543},
publisher = {IEEE Press},
url = {https://doi.org/10.1109/SCW63240.2024.00172},
doi = {10.1109/SCW63240.2024.00172},
abstract = {With the gap between computing power and I/O performance growing ever wider on HPC systems, it is becoming crucial to optimize how applications perform I/O on storage resources. To achieve this, a good understanding of application I/O behavior is an essential preliminary step. In this paper, we introduce MOSAIC, a method for categorizing applications according to their I/O behavior. We first propose an abstraction for characterizing I/O operations in terms of periodicity, temporality and metadata access. We then present a set of segmentation-based techniques for quickly and automatically detecting meaningful data access patterns. In the end, MOSAIC is able to characterize a full set of real-world I/O traces from the Blue Waters supercomputer with 92% accuracy.},
booktitle = {Proceedings of the SC '24 Workshops of the International Conference on High Performance Computing, Network, Storage, and Analysis},
pages = {1311–1319},
numpages = {9},
keywords = {I/O, analysis, characterization, traces},
location = {Atlanta, GA, USA},
series = {SC-W '24}
}

