@inproceedings{10.1145/3786484.3786526,
author = {Liu, Yisheng and Wang, Leran and Tang, Zhan and Zhang, Chong},
title = {A Comparative Study of China's National Image Before and After the COVID-19 Pandemic Based on Twitter Text Mining},
year = {2026},
isbn = {9798400721267},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786484.3786526},
doi = {10.1145/3786484.3786526},
abstract = {In the era of economic globalization, a nation’s image has emerged as a crucial element of its soft power, garnering increased government attention. Despite China’s considerable achievements in shaping its image since its establishment, the COVID-19 outbreak, exacerbated by anti-China forces distorting facts, led to a tarnishing of China’s national image. This study explores the shifts in China’s image pre and post-pandemic, offering valuable empirical insights for enhancing its global image. Utilizing Twitter data, the paper employs text classification techniques to categorize sentiments into sovereignty, territory, population, enterprise, and government. Analysis reveals that during the initial stages of the pandemic, the international community displayed a negative sentiment towards China’s population, government, and enterprises, marked by criticism and doubt. However, proactive measures and support from the Chinese government contributed to a gradual recovery of international sentiment, stabilizing at levels close to those observed before the pandemic.},
