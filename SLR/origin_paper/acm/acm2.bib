@inproceedings{10.1145/3785706.3785890,
author = {Xing, Ziheng},
title = {From Calendar Effects to Market Sentiment: A Hybrid Non-Parametric and ARMA-GARCH Investigation of Singapore Stock Market Data},
year = {2026},
isbn = {9798400719516},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785706.3785890},
doi = {10.1145/3785706.3785890},
abstract = {Calendar effects refer to the phenomenon where asset returns systematically deviate from randomness at certain specific calendar time points. This paper utilizes daily return data from the Singapore stock market, spanning from January 2000 to July 2005, as a sample to investigate the presence, significance, and time-varying nature of calendar effects, which encompass the day-of-the-week effect, month-of-the-year effect, and holiday effect. This paper uses the non-parametric tests (Kruskal-Wallis and Tukey HSD tests) and construct ARMA-GARCH models. This paper finds that the Singapore stock market exhibits a significant ``Monday negative effect”, ``August negative effect”, and a significantly positive return on the first trading day after holidays. Furthermore, the rolling window analysis reveals that these effects exhibit distinct time-varying characteristics and may be influenced by major economic events, institutional changes, and shifts in market structure. The research results indicate that the Singapore stock market is not entirely efficient. Calendar effects can act as a proxy for market sentiment, liquidity changes, and institutional influences, offering a reference for investors in strategy formulation and for market supervision.},
booktitle = {Proceedings of the 2025 2nd International Conference on Digital Economy and Computer Science},
pages = {1171–1178},
numpages = {8},
keywords = {ARMA-GARCH model, Calendar effects, Day-of-the-week effect, Holiday effect, Month-of-the-year effect, Rolling window analysis},
location = {
},
series = {DECS '25}
}

@article{10.1145/3744653,
author = {Nezhadettehad, Alireza and Zaslavsky, Arkady and Rakib, Abdur and Shaikh, Siraj Ahmed and Loke, Seng W. and Huang, Guang-Li and Hassani, Alireza},
title = {Predicting Next Useful Location with Context-Awareness: The State-of-the-Art},
year = {2025},
issue_date = {October 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {16},
number = {5},
issn = {2157-6904},
url = {https://doi.org/10.1145/3744653},
doi = {10.1145/3744653},
abstract = {Predicting the future location of mobile objects reinforces location-aware services with proactive intelligence and helps businesses and decision-makers with better planning and near real-time scheduling in different applications such as traffic congestion control, location-aware advertisements and monitoring public health and well-being. Recent developments in smartphone and location sensors technology and the prevalence of using location-based social networks alongside the improvements in AI and machine learning techniques provide an excellent opportunity to exploit massive amounts of historical and real-time contextual information to recognise mobility patterns and achieve more accurate and intelligent predictions. This unique survey provides a comprehensive overview of the next useful location prediction problem with context-awareness and the related studies. First, we explain the concepts of context and context-awareness and define the next location prediction problem. Then we analyse more than 30 studies in this field concerning the prediction method, the challenges addressed, the datasets and metrics used for training and evaluating the model and the types of context incorporated. Finally, we discuss the advantages and disadvantages of different approaches, focusing on the usefulness of the predicted location and identifying the open challenges and future work on this subject.},
journal = {ACM Trans. Intell. Syst. Technol.},
month = aug,
articleno = {105},
numpages = {35},
keywords = {Location prediction, Context-awareness, Location-awareness, Mobility prediction}
}

