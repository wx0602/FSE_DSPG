}

@inproceedings{10.1145/3748522.3779969,
author = {Rodriguez-Vega, Marcos and Escanez-Exposito, Daniel and Caballero-Gil, Pino},
title = {Privacy Preserving Distributed QML with QKD-Aware Scheduling for Quantum Networks},
year = {2026},
isbn = {9798400722943},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3748522.3779969},
doi = {10.1145/3748522.3779969},
abstract = {This work introduces a novel distributed Quantum Machine Learning (QML) scheme that integrates differential privacy methods to enable secure and efficient classification. The approach begins with the computation of an embedding that, given a seed, is randomly segmented into multiple sub-vectors. Each segment is perturbed with noise to enforce differential privacy and is then reduced in dimensionality via Principal Component Analysis (PCA). This PCA addresses the parameter limitations of QML. The reduced embeddings are distributed to multiple QML centers, where they are processed by a QML classifier. To obtain a final prediction, individual decisions from each center are combined through an aggregation mechanism. All classical information communications between the server and QML centers are encrypted and protected by a Quantum Key Distribution (QKD) network between these nodes. This scheme enables training and inference in distributed QML settings while robustly preserving privacy. Empirical evaluations show that the method maintains competitive accuracy with fewer quantum resources, paving the way for practical and scalable deployments of QML in real-world quantum computing context.},
booktitle = {Proceedings of the 41st ACM/SIGAPP Symposium on Applied Computing},
pages = {1351–1358},
numpages = {8},
keywords = {distributed quantum computing, quantum machine learning, privacy preserving, differential privacy, quantum network},
location = {Grand Hotel Palace, Thessaloniki, Greece},
series = {SAC '26}
}

@inproceedings{10.1145/3696410.3714746,
author = {Chen, Baiqi and Lyu, Jiawei and Wu, Tingmin and Baruwal Chhetri, Mohan and Bai, Guangdong},
title = {Semantics-Aware Cookie Purpose Compliance},
year = {2025},
isbn = {9798400712746},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3696410.3714746},
doi = {10.1145/3696410.3714746},
abstract = {Websites commonly display cookie banners to inform users about the use and purposes of cookies. However, they may still, whether intentionally or unintentionally (e.g., due to third-party libraries imported), mis-declare cookies that may be abused for tracking. In this work, we introduce COOVER (&lt;u&gt;coo&lt;/u&gt;kie &lt;u&gt;v&lt;/u&gt;alue examin&lt;u&gt;er&lt;/u&gt;) to assess the non-compliance between the website-declared purpose and the semantic-intended purpose of cookies (denoted as potential cookie purpose violation ). We advocate that the value of the cookie is a more reliable indicator of its semantic-intended purpose compared to other features such as expiration time. COOVER decomposes the cookie value into primitive segments representing minimal semantic units, and fine-tunes a GPT-3.5 model to automatically interpret their value-inferred semantics. Based on the interpretation, it classifies cookies into four GDPR-defined purposes. COOVER achieves an F1 score of 95%, significantly outperforming other methods. We employ COOVER to analyze Alexa Top 1k websites to understand the status quo of potential cookie purpose violation on the web. Remarkably, out of 15,339 cookies across these websites, only 3.1% quality as truly necessary cookies, while 44.1% of websites suffer from issues of potential purpose violation.},
booktitle = {Proceedings of the ACM on Web Conference 2025},
pages = {1602–1613},
numpages = {12},
keywords = {cookie policy, cookies, privacy compliance},
location = {Sydney NSW, Australia},
series = {WWW '25}
}

