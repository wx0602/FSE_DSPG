@inproceedings{10.1145/3712256.3726419,
author = {Maci\k{a}\.{z}ek, Jakub and Przewozniczek, Michal and Schwaab, Jonas},
title = {Seeking and leveraging alternative variable dependency concepts in gray-box-elusive bimodal land-use allocation problems},
year = {2025},
isbn = {9798400714658},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3712256.3726419},
doi = {10.1145/3712256.3726419},
abstract = {Solving land-use allocation problems can help us to deal with some of the most urgent global environmental issues. Since these problems are NP-hard, effective optimizers are needed to handle them. The knowledge about variable dependencies allows for proposing such tools. However, in this work, we consider a real-world multi-objective problem for which standard variable dependency discovery techniques are inapplicable. Therefore, using linkage-based variation operators is unreachable. To address this issue, we propose a definition of problem-dedicated variable dependency. On this base, we propose obtaining masks of dependent variables. Using them, we construct three novel crossover operators. The results concerning real-world test cases show that introducing our propositions into two well-known optimizers (NSGA-II, MOEA/D) dedicated to multi-objective optimization significantly improves their effectiveness.},
booktitle = {Proceedings of the Genetic and Evolutionary Computation Conference},
pages = {1406–1414},
numpages = {9},
keywords = {land-use allocation, multi-objective optimization, variable dependency, gray-box optimization, genetic algorithms, evolutionary algorithms, optimization},
location = {NH Malaga Hotel, Malaga, Spain},
series = {GECCO '25}
}

@inproceedings{10.1145/3731459.3774481,
author = {Nisi, Valentina and Ferreira, Marta and Pschetz, Larissa},
title = {Sketching More-than-human Times: Rethinking Temporal Representations through Embodied, Entangled, and Deep time},
year = {2026},
isbn = {9798400718687},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3731459.3774481},
doi = {10.1145/3731459.3774481},
abstract = {Temporal representations can have a socio-political impact and change how we see the world and design technologies. In this pictorial, we depart from a critique to classic representations of time that have long guided thinking in Western industrialised societies and design. Through the process of designing the More-than-Human Temporal Ontologies booklet, we describe a journey through practical engagements with the multiple ways time can be seen as created and creating more-than-human worlds. By embodying, imagining and sketching multiple expressions of more-than-human times, and by using these to appropriate, critique and expand representations of times, we propose the final outcome of the booklet as a tool for HCI and design researchers to structure dialogues and understanding of time and temporalities in more inclusive and expansive ways.},
booktitle = {Proceedings of the Twentieth International Conference on Tangible, Embedded, and Embodied Interaction},
articleno = {49},
numpages = {14},
keywords = {Design futuring, Embodied, Morethan-human, Noticing, Posthuman design methods, Temporalities},
