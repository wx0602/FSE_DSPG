doi = {10.1145/3724504.3724613},
abstract = {The design and application research of engineering management information system based on cloud service aims at improving the efficiency and quality of engineering project management. In this study, the overall structure of the system is designed by layered method, including infrastructure layer, platform layer, engineering layer, presentation layer and user layer to ensure the scalability, reliability and efficiency of the system. The functional design of the system is divided into login module, administrator operation module and ordinary user operation module to realize efficient management of huge data in engineering. The logical structure design of database supports the efficient operation of engineering data management system, improves the efficiency of data processing, and ensures the accurate transmission and efficient utilization of information. Through practical application, the system has been popularized and applied in various projects under construction, which has improved the efficiency and quality of project management. The research shows that the engineering management information system based on cloud service has good application effect and provides strong support for improving the efficiency and quality of project management.},
booktitle = {Proceedings of the 2024 2nd International Conference on Information Education and Artificial Intelligence},
pages = {659–664},
