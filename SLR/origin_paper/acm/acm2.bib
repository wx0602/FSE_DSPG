@inproceedings{10.1145/3712255.3734250,
author = {Przewozniczek, Michal W. and Frej, Bartosz and Komarnicki, Marcin M.},
title = {On Defining and Discovering Non-Symmetrical Dependencies},
year = {2025},
isbn = {9798400714641},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3712255.3734250},
doi = {10.1145/3712255.3734250},
abstract = {Effective and efficient optimization of real-world problems using Genetic Algorithms depends on the quality of masks used by variation operators. A high-quality variation mask groups variables which have a joint non-linear or non-monotonical influence on function value. In gray-box optimization, the dependencies are known a priori, while in black-box, they are discovered as a part of the optimization process. For both, variable dependency is typically considered as a symmetric relation, i.e., if variable a depends on b, then it is assumed that b depends on a. However, a thorough analysis of large-scale instances of an NP-complete real-world optimization problem shows that a variable dependency relation does not have to be symmetrical. Therefore, we present the concept of directional dependencies and the Directional Direct Linkage Empirical Discovery (2DLED). 2DLED discovers both dependency types (symmetrical and non-symmetrical) and tells them from each other. More details concerning 2DLED, directional dependencies and their utilization can be found in the original work [7].},
booktitle = {Proceedings of the Genetic and Evolutionary Computation Conference Companion},
pages = {53–54},
numpages = {2},
keywords = {linkage learning, empirical linkage learning, real-world problem optimization, problem decomposition},
location = {NH Malaga Hotel, Malaga, Spain},
series = {GECCO '25 Companion}
}

@inproceedings{10.1145/3716895.3716992,
author = {Zeng, Chaoquan and Luo, Wei and Chen, Hao and Wang, Senlin and Dai, Lingfeng},
title = {Convert Orthogonal Leads VCG to 12-Lead ECG Signals with a Novel Deep Learning Method},
year = {2025},
isbn = {9798400718007},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3716895.3716992},
doi = {10.1145/3716895.3716992},
abstract = {Electrocardiogram (ECG) and Vectorcardiogram (VCG) are essential in diagnosing heart diseases. Combining both VCG and ECG signals can significantly improve the accuracy of heart disease diagnosis. However, due to the intricacy of the devices and the additional leads required to be placed on the patient, it is inconvenient to capture these two signals simultaneously. To obtain both signals at once, this work presents a U-Net network that integrates residual blocks and gate attention mechanisms to convert VCG signals into 12-lead ECG signals. The experimental results demonstrate a high degree of similarity between the 12-lead ECG signals derived from the proposed approach and the original 12-lead signals.},
booktitle = {Proceedings of the 5th International Conference on Artificial Intelligence and Computer Engineering},
pages = {547–551},
numpages = {5},
keywords = {Attention, Electrocardiogram (ECG), U-Net, Vectorcardiogram (VCG)},
location = {
},
series = {ICAICE '24}
}

