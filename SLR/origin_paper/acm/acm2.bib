doi = {10.1145/3736426.3736495},
abstract = {An evaluation method for quality objective trends is proposed, which is based on the Analytic Hierarchy Process (AHP) and multiple evaluation factors. Firstly, a weight analysis method is introduced to determine the weights of various quality indicators within the quality objective system. Then, the quality status of the indicators is analyzed through multiple evaluation factors, and a comprehensive calculation is performed to obtain the trend evaluation. Finally, the effectiveness of the proposed method is verified using the quality objective data of a certain enterprise from the first quarter of 2024.},
