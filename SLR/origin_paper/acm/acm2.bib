@inproceedings{10.1145/3723178.3723290,
author = {Rahman, Minhajur and Yeasmin, Tania and Hasan, Mohammad Mahmudul},
title = {STM32-Based Obstacle Avoiding Line Follower Robot},
year = {2025},
isbn = {9798400713828},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3723178.3723290},
doi = {10.1145/3723178.3723290},
abstract = {A line follower robot detects and follows a visual line on the floor. Enhancing it with obstacle detection using ultrasonic sensors transforms it from a basic system into an advanced autonomous robot capable of intelligent navigation. This paper presents the design and development of an STM32-based robot with both line-following and object-avoidance capabilities. The research is motivated by the robot’s versatile applications in military, delivery, transportation, and healthcare, as well as its potential to enhance public transport, industrial automation, household tasks, and safety in hazardous environments. Experimental results show that the robot can accurately follow lines and avoid real-time obstacles, though challenges remain with complex paths. This research offers a cost-effective solution for combining line-following and object-avoidance functionalities. Future research could explore advanced control algorithms and machine learning techniques to enhance navigation robustness and intelligence.},
booktitle = {Proceedings of the 3rd International Conference on Computing Advancements},
pages = {847–853},
numpages = {7},
keywords = {STM32, Robot, Line-following, Object-avoidance, Microcontroller, Infrared Sensors, Ultrasonic Sensors},
location = {
},
series = {ICCA '24}
}

@inproceedings{10.1145/3746273.3760200,
author = {Blettery, Emile and Gouet-Brunet, Valerie and de Luca, Livio},
title = {Composed Image Retrieval For Visual Localization: Evaluation For Architectural Contents},
year = {2025},
isbn = {9798400720550},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746273.3760200},
doi = {10.1145/3746273.3760200},
abstract = {This article investigates the problem of visual localization with image retrieval in the context of heritage structuring and documentation, leveraging an extensive image dataset collected during the restoration of Notre-Dame de Paris. To address the challenges of image retrieval for localization, we present a retrieval pipeline, called CIR4Loc, based on the composed image retrieval (CIR) paradigm, introducing textual modifiers that refine retrieval towards configurations more suited for localization. By bridging the gap between visual and spatial retrieval, this approach ensures the selection of images that are both visually relevant and spatially distributed to improve localization, and more precisely, camera pose estimation. We demonstrate the effectiveness of this proposal in a real-world heritage context, specifically the scientific site related to the restoration of Notre-Dame de Paris, emphasizing the necessity of retrieval strategies explicitly tailored for spatially aware localization.},
booktitle = {Proceedings of the 7th International Workshop on AnalySis, Understanding and ProMotion of HeritAge Contents},
pages = {31–40},
numpages = {10},
keywords = {composed image retrieval, image retrieval, localization, digital humanities},
location = {Ireland},
series = {SUMAC '25}
}

